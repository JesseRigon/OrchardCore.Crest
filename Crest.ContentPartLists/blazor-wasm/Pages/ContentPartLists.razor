@page "/ContentTypes/ContentPartLists"
@using System.Net.Http.Json
@using Crest.Components.Model
@using Crest.Components.Models
@using Crest.Components.Options
@using Crest.Components.Primitives
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T
@inject Microsoft.JSInterop.IJSRuntime Js
@implements IAsyncDisposable

@* Fills the admin content area: the page never scrolls as a whole - the left list's
   items and the detail pane's body are the scrollable regions. *@
<CrestStack Gap="1rem" data-testid="content-part-lists-page" Style="height: 100%;">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["Content Part Lists"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["Named sets of choices that content types can use. Rename or hide the entries you do not need, and add your own."]" />
        </CrestStack>
        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <CrestButton Text="@T["New content part list"]" Icon="add" Click="StartCreateList" Disabled="@IsBusy" />
            <CrestButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" />
        </CrestStack>
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    @if (IsLoading)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (Lists.Length == 0)
    {
        <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["No content part lists yet."]</CrestAlert>
    }
    else
    {
        @* Plain flex row, not CrestRow/CrestColumn: the master-detail region must
           inherit the page's remaining height (flex: 1, min-height: 0) so the panes
           can hand scrolling to their inner regions. *@
        <div style="display: flex; flex-wrap: wrap; gap: 1rem; flex: 1 1 auto; min-height: 0; align-items: stretch;">
            <div data-testid="content-part-list-index" style="flex: 0 1 350px; min-width: 16rem; min-height: 0; display: flex;">
                <CrestModelList TItem="ContentPartListModel"
                                Title="@T["Lists"]"
                                Items="@Lists"
                                SelectedKey="@SelectedKey"
                                KeySelector="@(list => list.Key)"
                                TextSelector="@(list => list.DisplayText)"
                                DescriptionSelector="@(list => T["{0} options", list.Options.Length])"
                                Select="@((ContentPartListModel list) => SelectListAsync(list))"
                                ShowCreate="true"
                                CreateText="@T["New"]"
                                Create="StartCreateList"
                                IsBusy="@IsLoading"
                                MinWidth="16rem"
                                MaxWidth="350px"
                                EmptyText="@T["No content part lists yet."]" />
            </div>

            <div style="flex: 1 1 480px; min-width: 0; min-height: 0; display: flex;">
                @if (Selected is null)
                {
                    <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["Select an content part list."]</CrestAlert>
                }
                else
                {
                    <CrestDetailPane TestId="content-part-list-detail" Style="flex: 1 1 auto;">
                        <Header>
                            <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
                                <CrestStack Gap="0.25rem">
                                    <CrestText TextStyle="TextStyle.H5" Text="@Selected.DisplayText" />
                                    <CrestText TextStyle="TextStyle.Caption" Text="@($"{Selected.Key} · {Selected.Source}")" />
                                    <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        @if (SelectedDataLocked)
                                        {
                                            <CrestBadge Text="@(Selected.DataLock == "Module" ? T["Categories locked by module"] : T["Categories locked"])" BadgeStyle="BadgeStyle.Warning" data-testid="data-lock-badge" />
                                        }
                                        @if (SelectedEditLocked)
                                        {
                                            <CrestBadge Text="@(Selected.EditLock == "Module" ? T["Read-only (module)"] : T["Read-only"])" BadgeStyle="BadgeStyle.Danger" data-testid="edit-lock-badge" />
                                        }
                                    </CrestStack>
                                </CrestStack>
                                @if (Selected.Source != "Module" && !SelectedEditLocked)
                                {
                                    @if (ConfirmingDelete)
                                    {
                                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                            <CrestButton Text="@T["Confirm delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteListAsync" Disabled="@IsBusy" data-testid="confirm-delete-list" />
                                            <CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmingDelete = false)" Disabled="@IsBusy" />
                                        </CrestStack>
                                    }
                                    else
                                    {
                                        <CrestButton Text="@T["Delete list"]" Icon="delete" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmingDelete = true)" Disabled="@IsBusy" data-testid="delete-list" />
                                    }
                                }
                            </CrestStack>

                            @* Lock controls: tenant-authority only, super admin permission
                               enforced server-side. Module-placed locks render as fixed. *@
                            <CrestStack Gap="0.5rem" data-testid="content-part-list-locks">
                                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                    <CrestSwitch Value="@SelectedDataLocked" Change="@(value => SetLockAsync(dataLock: (bool)value))"
                                                 Disabled="@(IsBusy || Selected.DataLock == "Module")" data-testid="data-lock-switch" />
                                    <CrestStack Gap="0">
                                        <CrestText TextStyle="TextStyle.Body2" Text="@T["Lock categories & data"]" />
                                        <CrestText TextStyle="TextStyle.Caption" Text="@T["Freezes categories and category assignments (logic evaluates against them). Labels, visibility, order and adding options stay available - new options must use an existing category."]" />
                                    </CrestStack>
                                </CrestStack>
                                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                    <CrestSwitch Value="@SelectedEditLocked" Change="@(value => SetLockAsync(editLock: (bool)value))"
                                                 Disabled="@(IsBusy || Selected.EditLock == "Module")" data-testid="edit-lock-switch" />
                                    <CrestStack Gap="0">
                                        <CrestText TextStyle="TextStyle.Body2" Text="@T["Lock all editing"]" />
                                        <CrestText TextStyle="TextStyle.Caption" Text="@T["Makes the list read-only for this tenant: no relabels, no hiding, no reordering, no new options, no deletion."]" />
                                    </CrestStack>
                                </CrestStack>
                                @* The content type new options are created as - custom data
                                   fields live on it. Machine surface: frozen under either lock,
                                   and the server refuses retargeting a populated list. *@
                                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" data-testid="option-content-type">
                                    <CrestFormField Text="@T["Option type"]">
                                        <CrestDropDown Value="@SelectedOptionType" TValue="string" Data="@OptionTypeChoices" TextProperty="Label" ValueProperty="Value"
                                                       Change="@(value => SetOptionTypeAsync(value as string))"
                                                       Disabled="@(IsBusy || SelectedEditLocked || SelectedDataLocked || OptionTypes.Length == 0)"
                                                       Style="min-width: 11rem;" data-testid="option-content-type-dropdown" />
                                    </CrestFormField>
                                    <CrestText TextStyle="TextStyle.Caption" Style="max-width: 24rem;"
                                               Text="@T["New options are created as this content type; its custom fields become the list's extra columns. Changeable while the list is empty (or already of that type)."]" />
                                </CrestStack>
                                @if (SelectedFields.Length > 0)
                                {
                                    @* Per-field lock designation, chosen by the admin building the
                                       list. The designation is itself machine surface: frozen while
                                       either lock is active. *@
                                    <CrestStack Gap="0.5rem" data-testid="option-field-locks">
                                        @foreach (var field in SelectedFields)
                                        {
                                            var current = field;
                                            <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                <CrestSwitch Value="@current.DataLocked" Change="@(value => SetFieldLockAsync(current, (bool)value))"
                                                             Disabled="@(IsBusy || SelectedEditLocked || SelectedDataLocked)"
                                                             data-testid="@($"field-lock-{current.Name}")" />
                                                <CrestStack Gap="0">
                                                    <CrestText TextStyle="TextStyle.Body2" Text="@T["Treat {0} as machine data", current.DisplayName]" />
                                                    <CrestText TextStyle="TextStyle.Caption" Text="@T["On: this field freezes with the categories & data lock, like Category and Value. Off: it stays editable like the labels."]" />
                                                </CrestStack>
                                            </CrestStack>
                                        }
                                    </CrestStack>
                                }
                            </CrestStack>
                        </Header>
                        <ChildContent>
                            <CrestDataGrid Data="@Selected.Options" TItem="OptionModel" AllowPaging="false" Responsive="true" class="content-part-list-grid" data-testid="option-grid">
                                <Columns>
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Position"]" Width="6rem">
                                        <Template Context="option">
                                            @* The index is read-only here by design: the manual order is
                                               edited by dragging the handle, never by typing a number. *@
                                            <span class="option-row__handle"
                                                  draggable="@((IsBusy || SelectedEditLocked) ? "false" : "true")"
                                                  data-option-key="@option.Key"
                                                  title="@(SelectedEditLocked ? T["The list is locked for editing"] : T["Drag to reorder"])"
                                                  style="cursor: @(SelectedEditLocked ? "default" : "grab"); display: inline-flex; align-items: center; gap: 0.4rem;">
                                                <span aria-hidden="true" style="letter-spacing: -0.1em;">⠿</span>
                                                <CrestText TextStyle="TextStyle.Caption" Text="@option.Position.ToString()" />
                                            </span>
                                        </Template>
                                    </CrestDataGridColumn>
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Label"]">
                                        <Template Context="option">
                                            @* Value must be bound, not just seeded: the text box short-circuits
                                               a change when the incoming text equals its current Value, so an
                                               unbound (null) Value swallows the first edit entirely. *@
                                            <CrestTextBox Value="@LabelDraft(option)"
                                                          ValueChanged="@(value => OnLabelChanged(option, value))"
                                                          Change="@(value => RelabelAsync(option, value))"
                                                          Disabled="@(IsBusy || SelectedEditLocked)"
                                                          Style="width: 100%;" />
                                        </Template>
                                    </CrestDataGridColumn>
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Plural label"]">
                                        <Template Context="option">
                                            @* Display-only like the singular label, so it stays editable
                                               under a data lock. Blank = no distinct plural: readers fall
                                               back to the singular, which the placeholder shows. *@
                                            <CrestTextBox Value="@PluralDraft(option)"
                                                          ValueChanged="@(value => OnPluralChanged(option, value))"
                                                          Change="@(value => RepluralizeAsync(option, value))"
                                                          Placeholder="@option.DisplayText"
                                                          Disabled="@(IsBusy || SelectedEditLocked)"
                                                          Style="width: 100%;" />
                                        </Template>
                                    </CrestDataGridColumn>
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Key"]">
                                        @* The key is what code matches on, so it is shown but never editable -
                                           renaming the label is always safe, renaming the key would not be. *@
                                        <Template Context="option"><CrestText TextStyle="TextStyle.Caption" Text="@option.Key" /></Template>
                                    </CrestDataGridColumn>
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Value"]">
                                        <Template Context="option">
                                            @if (SelectedDataLocked || SelectedEditLocked)
                                            {
                                                @* The machine value is machine surface, frozen by a data
                                                   lock like category assignments - read-only, not disabled. *@
                                                <CrestText TextStyle="TextStyle.Body2" Text="@(option.Value ?? "—")" />
                                            }
                                            else
                                            {
                                                @* Blank = the key is the option's only machine datum. *@
                                                <CrestTextBox Value="@ValueDraft(option)"
                                                              ValueChanged="@(value => OnValueChanged(option, value))"
                                                              Change="@(value => RevalueAsync(option, value))"
                                                              Disabled="@IsBusy"
                                                              Style="width: 100%;" />
                                            }
                                        </Template>
                                    </CrestDataGridColumn>
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Category"]">
                                        <Template Context="option">
                                            @if (SelectedDataLocked || SelectedEditLocked)
                                            {
                                                @* Category assignments are the machine surface a data lock
                                                   freezes - read-only, not merely disabled. *@
                                                <CrestText TextStyle="TextStyle.Body2" Text="@option.Category" />
                                            }
                                            else
                                            {
                                                @* Same draft pattern as Label. Clearing the box files the option
                                                   back under Uncategorized - the server never stores a blank. *@
                                                <CrestTextBox Value="@CategoryDraft(option)"
                                                              ValueChanged="@(value => OnCategoryChanged(option, value))"
                                                              Change="@(value => RecategorizeAsync(option, value))"
                                                              Disabled="@IsBusy"
                                                              Style="width: 100%;" />
                                            }
                                        </Template>
                                    </CrestDataGridColumn>
                                    @foreach (var field in SelectedFields)
                                    {
                                        var current = field;
                                        <CrestDataGridColumn TItem="OptionModel" Title="@current.DisplayName">
                                            <Template Context="option">
                                                @if (SelectedEditLocked || (current.DataLocked && SelectedDataLocked))
                                                {
                                                    @* A DataLocked field is machine surface, frozen by the
                                                       data lock like Category/Value - read-only, not disabled. *@
                                                    <CrestText TextStyle="TextStyle.Body2" Text="@(FieldValue(option, current) ?? "—")" />
                                                }
                                                else if (current.Type == "BooleanField")
                                                {
                                                    @* Typed editor: the wire format stays stringified; the
                                                       server's accessor stores the typed value. *@
                                                    <CrestSwitch Value="@ParseBool(FieldValue(option, current))"
                                                                 Change="@(value => SetFieldAsync(option, current, (bool)value ? "true" : "false"))"
                                                                 Disabled="@IsBusy" />
                                                }
                                                else if (current.Type == "NumericField")
                                                {
                                                    <CrestNumeric TValue="decimal?"
                                                                  Value="@ParseDecimal(FieldValue(option, current))"
                                                                  Change="@(value => SetFieldAsync(option, current, value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty))"
                                                                  Disabled="@IsBusy"
                                                                  Style="width: 100%;" />
                                                }
                                                else
                                                {
                                                    @* Same draft pattern as the other columns; blank clears. *@
                                                    <CrestTextBox Value="@FieldDraft(option, current)"
                                                                  ValueChanged="@(value => OnFieldChanged(option, current, value))"
                                                                  Change="@(value => SetFieldAsync(option, current, value))"
                                                                  Disabled="@IsBusy"
                                                                  Style="width: 100%;" />
                                                }
                                            </Template>
                                        </CrestDataGridColumn>
                                    }
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Source"]" Width="8rem">
                                        <Template Context="option">
                                            <CrestBadge Text="@option.Source" BadgeStyle="@(option.Source == "Module" ? BadgeStyle.Info : BadgeStyle.Secondary)" />
                                        </Template>
                                    </CrestDataGridColumn>
                                    <CrestDataGridColumn TItem="OptionModel" Title="@T["Visible"]" Width="8rem">
                                        <Template Context="option">
                                            <CrestSwitch Value="@(!option.Hidden)" Change="@(value => SetHiddenAsync(option, !(bool)value))" Disabled="@(IsBusy || SelectedEditLocked)" />
                                        </Template>
                                    </CrestDataGridColumn>
                                </Columns>
                            </CrestDataGrid>

                            @if (!SelectedEditLocked)
                            {
                                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                                    <CrestFormField Text="@T["Key"]">
                                        <CrestTextBox @bind-Value="NewOptionKey" Placeholder="@T["Net30"]" Disabled="@IsBusy" />
                                    </CrestFormField>
                                    <CrestFormField Text="@T["Label"]">
                                        <CrestTextBox @bind-Value="NewOptionLabel" Placeholder="@T["Net 30"]" Disabled="@IsBusy" />
                                    </CrestFormField>
                                    <CrestFormField Text="@T["Plural label (optional)"]">
                                        <CrestTextBox @bind-Value="NewOptionPlural" Placeholder="@NewOptionLabel" Disabled="@IsBusy" />
                                    </CrestFormField>
                                    <CrestFormField Text="@T["Value (optional)"]">
                                        <CrestTextBox @bind-Value="NewOptionValue" Disabled="@IsBusy" />
                                    </CrestFormField>
                                    @foreach (var field in SelectedFields)
                                    {
                                        var current = field;
                                        <CrestFormField Text="@current.DisplayName">
                                            @if (current.Type == "BooleanField")
                                            {
                                                <CrestSwitch Value="@ParseBool(NewFieldDraft(current))"
                                                             Change="@(value => NewFieldDrafts[current.Name] = (bool)value ? "true" : "false")"
                                                             Disabled="@IsBusy" />
                                            }
                                            else if (current.Type == "NumericField")
                                            {
                                                <CrestNumeric TValue="decimal?"
                                                              Value="@ParseDecimal(NewFieldDraft(current))"
                                                              Change="@(value => NewFieldDrafts[current.Name] = value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                                                              Disabled="@IsBusy" />
                                            }
                                            else
                                            {
                                                <CrestTextBox Value="@NewFieldDraft(current)"
                                                              ValueChanged="@(value => NewFieldDrafts[current.Name] = value ?? string.Empty)"
                                                              Disabled="@IsBusy" />
                                            }
                                        </CrestFormField>
                                    }
                                    @if (SelectedDataLocked)
                                    {
                                        @* The category vocabulary is frozen under a data lock: tenant
                                           additions pick from the list's existing categories. *@
                                        <CrestFormField Text="@T["Category"]">
                                            <CrestDropDown @bind-Value="NewOptionCategory" TValue="string" Data="@CategoryChoices"
                                                           TextProperty="Label" ValueProperty="Value" Disabled="@IsBusy" />
                                        </CrestFormField>
                                    }
                                    else
                                    {
                                        <CrestFormField Text="@T["Category (optional)"]">
                                            <CrestTextBox @bind-Value="NewOptionCategory" Placeholder="@T["Uncategorized"]" Disabled="@IsBusy" />
                                        </CrestFormField>
                                    }
                                    <CrestButton Text="@T["Add option"]" Icon="add" Click="AddOptionAsync" Disabled="@IsBusy" data-testid="add-option" />
                                </CrestStack>
                            }
                        </ChildContent>
                    </CrestDetailPane>
                }
            </div>
        </div>
    }

    @if (IsCreatingList)
    {
        <CrestCard data-testid="new-content-part-list">
            <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                <CrestFormField Text="@T["Key"]">
                    <CrestTextBox @bind-Value="NewListKey" Placeholder="@T["sales.channel"]" Disabled="@IsBusy" />
                </CrestFormField>
                <CrestFormField Text="@T["Name"]">
                    <CrestTextBox @bind-Value="NewListName" Placeholder="@T["Sales channel"]" Disabled="@IsBusy" />
                </CrestFormField>
                <CrestButton Text="@T["Create"]" Click="CreateListAsync" Disabled="@IsBusy" />
                <CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => IsCreatingList = false)" Disabled="@IsBusy" />
            </CrestStack>
        </CrestCard>
    }
</CrestStack>

@code {
    private ContentPartListModel[] Lists { get; set; } = [];
    private string? SelectedKey { get; set; }
    private ContentPartListModel? Selected => Lists.FirstOrDefault(list => list.Key == SelectedKey);

    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private bool IsCreatingList { get; set; }
    private string? ErrorMessage { get; set; }

    private string NewOptionKey { get; set; } = string.Empty;
    private string NewOptionLabel { get; set; } = string.Empty;
    private string NewOptionPlural { get; set; } = string.Empty;
    private string NewOptionValue { get; set; } = string.Empty;
    private string NewOptionCategory { get; set; } = string.Empty;
    private string NewListKey { get; set; } = string.Empty;
    private string NewListName { get; set; } = string.Empty;

    private bool ConfirmingDelete { get; set; }

    private sealed record Choice(string Label, string Value);

    private static bool LockActive(string? value) => value is not (null or "" or "None");

    private bool SelectedDataLocked => LockActive(Selected?.DataLock);
    private bool SelectedEditLocked => LockActive(Selected?.EditLock);

    private OptionFieldModel[] SelectedFields => Selected?.Fields ?? [];

    private string[] OptionTypes = [];

    private string SelectedOptionType => string.IsNullOrWhiteSpace(Selected?.OptionContentType) ? "Option" : Selected!.OptionContentType!;

    private OptionTypeChoice[] OptionTypeChoices => [.. OptionTypes.Select(type => new OptionTypeChoice(type, type))];

    private sealed record OptionTypeChoice(string Label, string Value);

    private async Task SetOptionTypeAsync(string? contentType)
    {
        if (Selected is null || string.IsNullOrWhiteSpace(contentType)
            || string.Equals(contentType, SelectedOptionType, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/crest/content-part-lists/{Uri.EscapeDataString(Selected.Key)}/option-content-type",
                new { ContentType = contentType });
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T["Content Part Lists"], T["Option type set to {0}.", contentType]);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    // The frozen category vocabulary a data-locked list constrains additions to.
    private Choice[] CategoryChoices => Selected is null
        ? []
        : [.. Selected.Options
            .Select(option => option.Category)
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(category => category, StringComparer.CurrentCultureIgnoreCase)
            .Select(category => new Choice(category, category))];

    protected override Task OnInitializedAsync() => LoadAsync();

    private DotNetObjectReference<ContentPartLists>? DotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Same split as the admin menu editor: browser drag events live in
            // crest.contentPartLists.js; the typed payload comes back through
            // OnOptionDropped. The JS re-queries the selector per event, so grid
            // re-renders need no re-init.
            DotNetRef ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("crestContentPartLists.init", ".content-part-list-grid", DotNetRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("crestContentPartLists.dispose");
        }
        catch
        {
            // The circuit/runtime may already be gone during teardown.
        }

        DotNetRef?.Dispose();
    }

    /// <summary>Drop callback from crest.contentPartLists.js: move the dragged option to
    /// <paramref name="newIndex"/> and persist the full manual order.</summary>
    [JSInvokable]
    public async Task OnOptionDropped(string optionKey, int newIndex)
    {
        if (Selected is null || SelectedEditLocked || IsBusy)
        {
            return;
        }

        var keys = Selected.Options.Select(option => option.Key).ToList();
        var from = keys.FindIndex(key => string.Equals(key, optionKey, StringComparison.OrdinalIgnoreCase));
        if (from < 0)
        {
            return;
        }

        keys.RemoveAt(from);
        // The drop index was computed against the list WITH the dragged row still in
        // place; removing an earlier row shifts everything after it left by one.
        var target = Math.Clamp(newIndex > from ? newIndex - 1 : newIndex, 0, keys.Count);
        keys.Insert(target, optionKey);

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/order", new { Keys = keys }),
            T["Order updated."],
            LoadAsync);
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Lists = await Http.GetFromJsonAsync<ContentPartListModel[]>("api/crest/content-part-lists") ?? [];
            SelectedKey = Lists.Any(list => list.Key == SelectedKey) ? SelectedKey : Lists.FirstOrDefault()?.Key;

            try
            {
                OptionTypes = await Http.GetFromJsonAsync<string[]>("api/crest/content-part-lists/option-types") ?? [];
            }
            catch
            {
                // Without the listing the dropdown just stays disabled.
                OptionTypes = [];
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectList(string key)
    {
        SelectedKey = key;
        LabelDrafts.Clear();
        PluralDrafts.Clear();
        ValueDrafts.Clear();
        CategoryDrafts.Clear();
        FieldDrafts.Clear();
        NewFieldDrafts.Clear();
        ConfirmingDelete = false;
    }

    private Task SelectListAsync(ContentPartListModel list)
    {
        SelectList(list.Key);
        return Task.CompletedTask;
    }

    // Local edit buffer per option, keyed by option key. The grid re-renders on every
    // keystroke, so the text box needs a bound Value that reflects what was typed
    // rather than the last saved label.
    private Dictionary<string, string> LabelDrafts { get; } = new(StringComparer.Ordinal);

    private string LabelDraft(OptionModel option) =>
        LabelDrafts.TryGetValue(option.Key, out var draft) ? draft : option.DisplayText;

    private void OnLabelChanged(OptionModel option, string? value) =>
        LabelDrafts[option.Key] = value ?? string.Empty;

    // Same buffering as labels, for the plural column. The saved value renders as
    // empty when the option has no distinct plural (the placeholder shows the
    // singular fallback).
    private Dictionary<string, string> PluralDrafts { get; } = new(StringComparer.Ordinal);

    private string PluralDraft(OptionModel option) =>
        PluralDrafts.TryGetValue(option.Key, out var draft) ? draft : option.DisplayTextPlural ?? string.Empty;

    private void OnPluralChanged(OptionModel option, string? value) =>
        PluralDrafts[option.Key] = value ?? string.Empty;

    private async Task RepluralizeAsync(OptionModel option, string? plural)
    {
        if (Selected is null || (plural ?? string.Empty) == (option.DisplayTextPlural ?? string.Empty))
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            // An empty string CLEARS the plural (back to the singular fallback);
            // omitting the property would leave it unchanged instead.
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/options/{Uri.EscapeDataString(option.Key)}",
                new { DisplayText = (string?)null, Position = (int?)null, Hidden = (bool?)null, DisplayTextPlural = plural ?? string.Empty }),
            T["Plural label updated."],
            async () =>
            {
                PluralDrafts.Remove(option.Key);
                await LoadAsync();
            });
    }

    // Same buffering for the machine-value column; blank clears back to "the key is
    // the only datum". Editable only while the list is neither data- nor edit-locked.
    private Dictionary<string, string> ValueDrafts { get; } = new(StringComparer.Ordinal);

    private string ValueDraft(OptionModel option) =>
        ValueDrafts.TryGetValue(option.Key, out var draft) ? draft : option.Value ?? string.Empty;

    private void OnValueChanged(OptionModel option, string? value) =>
        ValueDrafts[option.Key] = value ?? string.Empty;

    private async Task RevalueAsync(OptionModel option, string? value)
    {
        if (Selected is null || (value ?? string.Empty) == (option.Value ?? string.Empty))
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/options/{Uri.EscapeDataString(option.Key)}",
                new { DisplayText = (string?)null, Position = (int?)null, Hidden = (bool?)null, Value = value ?? string.Empty }),
            T["Value updated."],
            async () =>
            {
                ValueDrafts.Remove(option.Key);
                await LoadAsync();
            });
    }

    // Custom data field drafts, keyed by option key + field name (the separator can
    // appear in neither: option keys reject non-alphanumerics, field names are C#
    // technical names).
    private Dictionary<string, string> FieldDrafts { get; } = new(StringComparer.Ordinal);

    // Add-row values for custom fields, keyed by field name.
    private Dictionary<string, string> NewFieldDrafts { get; } = new(StringComparer.Ordinal);

    private static string FieldDraftKey(OptionModel option, OptionFieldModel field) => $"{option.Key}\u0001{field.Name}";

    private static string? FieldValue(OptionModel option, OptionFieldModel field) =>
        option.Fields is not null && option.Fields.TryGetValue(field.Name, out var value) ? value : null;

    private string FieldDraft(OptionModel option, OptionFieldModel field) =>
        FieldDrafts.TryGetValue(FieldDraftKey(option, field), out var draft) ? draft : FieldValue(option, field) ?? string.Empty;

    private void OnFieldChanged(OptionModel option, OptionFieldModel field, string? value) =>
        FieldDrafts[FieldDraftKey(option, field)] = value ?? string.Empty;

    private string NewFieldDraft(OptionFieldModel field) =>
        NewFieldDrafts.TryGetValue(field.Name, out var draft) ? draft : string.Empty;

    // Typed-cell parsing: the wire format is stringified (the server's accessor
    // owns the typed conversion), these only shape the editors' bound values.
    private static bool ParseBool(string? value) => bool.TryParse(value, out var flag) && flag;

    private static decimal? ParseDecimal(string? value) =>
        decimal.TryParse(value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var number)
            ? number
            : null;

    private async Task SetFieldAsync(OptionModel option, OptionFieldModel field, string? value)
    {
        if (Selected is null || (value ?? string.Empty) == (FieldValue(option, field) ?? string.Empty))
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            // A blank entry CLEARS the field, matching the plural/Value contract.
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/options/{Uri.EscapeDataString(option.Key)}",
                new { DisplayText = (string?)null, Position = (int?)null, Hidden = (bool?)null, Fields = new Dictionary<string, string?> { [field.Name] = value ?? string.Empty } }),
            T["{0} updated.", field.DisplayName],
            async () =>
            {
                FieldDrafts.Remove(FieldDraftKey(option, field));
                await LoadAsync();
            });
    }

    private async Task SetFieldLockAsync(OptionFieldModel field, bool dataLocked)
    {
        if (Selected is null)
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/fields/{Uri.EscapeDataString(field.Name)}",
                new { DataLocked = dataLocked }),
            T["Field lock updated."],
            LoadAsync);
    }

    // Same buffering as labels: the grid re-renders per keystroke, so category boxes
    // need a draft that shadows the saved value while typing.
    private Dictionary<string, string> CategoryDrafts { get; } = new(StringComparer.Ordinal);

    private string CategoryDraft(OptionModel option) =>
        CategoryDrafts.TryGetValue(option.Key, out var draft) ? draft : option.Category;

    private void OnCategoryChanged(OptionModel option, string? value) =>
        CategoryDrafts[option.Key] = value ?? string.Empty;

    private void StartCreateList()
    {
        IsCreatingList = true;
        NewListKey = string.Empty;
        NewListName = string.Empty;
    }

    private async Task CreateListAsync()
    {
        await SendAsync(
            () => Http.PostAsJsonAsync("api/crest/content-part-lists", new { Key = NewListKey, DisplayText = NewListName }),
            T["Content part list created."],
            async () =>
            {
                IsCreatingList = false;
                SelectedKey = NewListKey.Trim();
                await LoadAsync();
            });
    }

    private async Task AddOptionAsync()
    {
        if (Selected is null)
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PostAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/options",
                new { Key = NewOptionKey, DisplayText = NewOptionLabel, Position = Selected.Options.Length, Category = NewOptionCategory, DisplayTextPlural = NewOptionPlural, Value = NewOptionValue }),
            T["Option added."],
            async () =>
            {
                NewOptionKey = string.Empty;
                NewOptionLabel = string.Empty;
                NewOptionPlural = string.Empty;
                NewOptionValue = string.Empty;
                NewOptionCategory = string.Empty;
                await LoadAsync();
            });
    }

    private async Task RecategorizeAsync(OptionModel option, string? category)
    {
        if (Selected is null || category == option.Category)
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/options/{Uri.EscapeDataString(option.Key)}",
                new { DisplayText = (string?)null, Position = (int?)null, Hidden = (bool?)null, Category = category ?? string.Empty }),
            T["Option recategorized."],
            async () =>
            {
                CategoryDrafts.Remove(option.Key);
                await LoadAsync();
            });
    }

    private async Task SetLockAsync(bool? dataLock = null, bool? editLock = null)
    {
        if (Selected is null)
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/locks",
                new { DataLock = dataLock, EditLock = editLock }),
            T["Lock updated."],
            LoadAsync);
    }

    private async Task DeleteListAsync()
    {
        if (Selected is null)
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.DeleteAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}"),
            T["Content part list deleted."],
            async () =>
            {
                ConfirmingDelete = false;
                SelectedKey = null;
                await LoadAsync();
            });
    }

    private async Task RelabelAsync(OptionModel option, string? displayText)
    {
        if (Selected is null || string.IsNullOrWhiteSpace(displayText) || displayText == option.DisplayText)
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/options/{Uri.EscapeDataString(option.Key)}",
                new { DisplayText = displayText, Position = (int?)null, Hidden = (bool?)null }),
            T["Option renamed."],
            async () =>
            {
                // Drop the draft so the reloaded server value is what renders from here
                // on - otherwise the buffer would shadow later changes from elsewhere.
                LabelDrafts.Remove(option.Key);
                await LoadAsync();
            });
    }

    private async Task SetHiddenAsync(OptionModel option, bool hidden)
    {
        if (Selected is null)
        {
            return;
        }

        var listKey = Selected.Key;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/crest/content-part-lists/{Uri.EscapeDataString(listKey)}/options/{Uri.EscapeDataString(option.Key)}",
                new { DisplayText = (string?)null, Position = (int?)null, Hidden = (bool?)hidden }),
            hidden ? T["Option hidden."] : T["Option shown."],
            LoadAsync);
    }

    private async Task SendAsync(Func<Task<HttpResponseMessage>> send, string successMessage, Func<Task> onSuccess)
    {
        IsSaving = true;
        ErrorMessage = null;

        try
        {
            using var response = await send();
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T["Content Part Lists"], successMessage);
            await onSuccess();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}
