@using BlazingOrchard.Admin.DisplayManagement
@using BlazingOrchard.Admin.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@using Radzen.Blazor

@for (var index = 0; index < Items.Length; index++)
{
    var item = Items[index];
    var icon = item.Icon;
    var renderFlyout = ShouldRenderFlyout(item);

    @if (renderFlyout)
    {
        <RadzenPanelMenuItem @key="item.StableKey"
                             Text="@item.Text"
                             Value="@item.StableKey"
                             Path="@GetPath(item)"
                             Target="@item.Target"
                             class="@GetItemClass(item)">
            <Template>
                <span class="@GetItemContentClass(item)"
                      @onmouseover="@(args => OpenFlyout(item, args))"
                      @onmouseout="CloseFlyoutSoon">
                    <AdminMenuSubIcon Icon="@icon" />
                    <span class="rz-navigation-item-text">@item.Text</span>
                    <RadzenIcon Icon="chevron_right" class="admin-menu-sidebar__flyout-trigger" title="Open submenu" />
                </span>
            </Template>
        </RadzenPanelMenuItem>
    }
    else
    {
        <RadzenPanelMenuItem @key="item.StableKey"
                             Text="@item.Text"
                             Value="@item.StableKey"
                             Path="@GetPath(item)"
                             Target="@item.Target"
                             Expanded="@IsExpanded(item)"
                             ExpandedChanged="@(expanded => SetExpanded(item, expanded))"
                             class="@GetItemClass(item)">
            <Template>
                <span class="@GetItemContentClass(item)">
                    @if (Level == 0)
                    {
                        <AdminMenuIcon Icon="@icon" />
                    }
                    else
                    {
                        <AdminMenuSubIcon Icon="@icon" />
                    }
                    <span class="rz-navigation-item-text">@item.Text</span>
                </span>
            </Template>
            <ChildContent>
                @if (item.HasChildren)
                {
                    <AdminMenuPanelItems Items="item.Items" Level="@(Level + 1)" ActiveItemKey="@ActiveItemKey" ActiveItemLink="@ActiveItemLink" ExpandedItemKeys="ExpandedItemKeys" ExpandedChanged="ExpandedChanged" FlyoutOpened="FlyoutOpened" FlyoutCloseRequested="FlyoutCloseRequested" />
                }
            </ChildContent>
        </RadzenPanelMenuItem>
    }
}

@code {
    [Parameter]
    public DisplayMenuItem[] Items { get; set; } = [];

    [Parameter]
    public int Level { get; set; }

    [Parameter]
    public string? ActiveItemKey { get; set; }

    [Parameter]
    public string? ActiveItemLink { get; set; }

    [Parameter]
    public ISet<string> ExpandedItemKeys { get; set; } = new HashSet<string>();

    [Parameter]
    public Action<string, bool>? ExpandedChanged { get; set; }

    [Parameter]
    public Action<DisplayMenuItem, MouseEventArgs>? FlyoutOpened { get; set; }

    [Parameter]
    public Func<Task>? FlyoutCloseRequested { get; set; }

    private bool IsExpanded(DisplayMenuItem item) => item.HasChildren && !ShouldRenderFlyout(item) && ExpandedItemKeys.Contains(item.StableKey);

    private void SetExpanded(DisplayMenuItem item, bool expanded)
    {
        if (item.HasChildren && !ShouldRenderFlyout(item))
        {
            ExpandedChanged?.Invoke(item.StableKey, expanded);
        }
    }

    private void OpenFlyout(DisplayMenuItem item, MouseEventArgs args) => FlyoutOpened?.Invoke(item, args);

    private Task CloseFlyoutSoon() => FlyoutCloseRequested?.Invoke() ?? Task.CompletedTask;

    private static string? GetPath(DisplayMenuItem item)
    {
        if (item.HasChildren || !item.HasLink || item.Link == "#")
        {
            return null;
        }

        return item.Link;
    }

    private bool ShouldRenderFlyout(DisplayMenuItem item) => ShouldRenderFlyout(Level, item);

    private static bool ShouldRenderFlyout(int level, DisplayMenuItem item) => level >= 2 && item.HasChildren;

    private string GetItemClass(DisplayMenuItem item)
    {
        var itemClass = $"admin-menu-sidebar__item admin-menu-sidebar__item--level-{Level}";
        return ShouldRenderFlyout(item) ? itemClass + " admin-menu-sidebar__item--has-flyout" : itemClass;
    }

    private string GetItemContentClass(DisplayMenuItem item)
    {
        var itemClass = "admin-menu-sidebar__item-content";
        if (IsCurrentActiveItem(item))
        {
            itemClass += " admin-menu-sidebar__item-content--active";
        }
        else if (item.HasLink)
        {
            itemClass += " admin-menu-sidebar__item-content--not-active";
        }

        return itemClass;
    }

    private bool IsCurrentActiveItem(DisplayMenuItem item)
    {
        if (!item.HasLink || string.IsNullOrWhiteSpace(ActiveItemLink))
        {
            return false;
        }

        return item.StableKey == ActiveItemKey || string.Equals(NormalizePathOnly(item.Link!), NormalizePathOnly(ActiveItemLink), StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePathOnly(string value)
    {
        var path = value.Split('?', 2)[0].Split('#', 2)[0].Trim();
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        path = path.StartsWith('/') ? path : '/' + path;
        return path.TrimEnd('/');
    }
}
