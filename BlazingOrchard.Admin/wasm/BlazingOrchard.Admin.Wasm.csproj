<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>BlazingOrchard.Admin</AssemblyName>
    <RootNamespace>BlazingOrchard.Admin</RootNamespace>
    <OrchardCoreCompatibilityVersion>3.0.0</OrchardCoreCompatibilityVersion>
    <BlazingSecurityPatch>0</BlazingSecurityPatch>
    <BlazingBugPatch>0</BlazingBugPatch>
    <BlazingOrchardVersion>$(OrchardCoreCompatibilityVersion).$(BlazingSecurityPatch).$(BlazingBugPatch)</BlazingOrchardVersion>
    <VersionPrefix>$(OrchardCoreCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(OrchardCoreCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(BlazingOrchardVersion)</AssemblyInformationalVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Api\**\*.cs" />
    <Compile Include="Components\**\*.cs" />
    <Compile Include="DisplayManagement\**\*.cs" />
    <Compile Include="Options\**\*.cs" />
    <Compile Include="Theme\**\*.cs" />
    <Compile Include="Program.cs" />
    <Content Include="wwwroot\**\*" Exclude="wwwroot\.gitkeep" />
    <RazorComponent Include="App.razor" />
    <RazorComponent Include="Components\**\*.razor" />
    <RazorComponent Include="DisplayManagement\**\*.razor" />
    <RazorComponent Include="Pages\**\*.razor" />
    <None Include="_Imports.razor" />
    <Watch Include="**\*.cs;**\*.razor;wwwroot\**\*" Exclude="bin\**;obj\**;**\bin\**;**\obj\**" />
    <Watch Remove="bin\**;obj\**;**\bin\**;**\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BlazingOrchard.Components\BlazingOrchard.Components.csproj" />
    <ProjectReference Include="..\..\BlazingOrchard.Icons\BlazingOrchard.Icons.csproj" />
    <!-- Auto-import Blazing component libraries contributed by Orchard modules. -->
    <BlazingModuleWasmProject Include="..\..\..\*\blazor-wasm\*.csproj" />
    <ProjectReference Include="@(BlazingModuleWasmProject)" />
  </ItemGroup>

  <Target Name="GenerateBlazingModuleAssemblyRegistry" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)Generated" />
    <ItemGroup>
      <_BlazingModuleAssemblyRegistryLine Include="using System.Reflection%3B" />
      <_BlazingModuleAssemblyRegistryLine Include="namespace BlazingOrchard.Admin%3B" />
      <_BlazingModuleAssemblyRegistryLine Include="internal static class BlazingModuleAssemblyRegistry" />
      <_BlazingModuleAssemblyRegistryLine Include="{" />
      <_BlazingModuleAssemblyRegistryLine Include="    public static IReadOnlyList&lt;Assembly&gt; Assemblies { get%3B } = Load()%3B" />
      <_BlazingModuleAssemblyRegistryLine Include="    private static IReadOnlyList&lt;Assembly&gt; Load()" />
      <_BlazingModuleAssemblyRegistryLine Include="    {" />
      <_BlazingModuleAssemblyRegistryLine Include="        var assemblies = new List&lt;Assembly&gt;()%3B" />
      <_BlazingModuleAssemblyRegistryLine Include="@(BlazingModuleWasmProject-&gt;'        TryAdd(assemblies, &quot;%(Filename)&quot;)%3B')" />
      <_BlazingModuleAssemblyRegistryLine Include="        return assemblies.Distinct().ToArray()%3B" />
      <_BlazingModuleAssemblyRegistryLine Include="    }" />
      <_BlazingModuleAssemblyRegistryLine Include="    private static void TryAdd(List&lt;Assembly&gt; assemblies, string assemblyName)" />
      <_BlazingModuleAssemblyRegistryLine Include="    {" />
      <_BlazingModuleAssemblyRegistryLine Include="        try" />
      <_BlazingModuleAssemblyRegistryLine Include="        {" />
      <_BlazingModuleAssemblyRegistryLine Include="            assemblies.Add(Assembly.Load(assemblyName))%3B" />
      <_BlazingModuleAssemblyRegistryLine Include="        }" />
      <_BlazingModuleAssemblyRegistryLine Include="        catch" />
      <_BlazingModuleAssemblyRegistryLine Include="        {" />
      <_BlazingModuleAssemblyRegistryLine Include="        }" />
      <_BlazingModuleAssemblyRegistryLine Include="    }" />
      <_BlazingModuleAssemblyRegistryLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Generated\BlazingModuleAssemblyRegistry.g.cs" Lines="@(_BlazingModuleAssemblyRegistryLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Generated\BlazingModuleAssemblyRegistry.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CopyBlazingOrchardIconAssets" AfterTargets="Build">
    <ItemGroup>
      <_BlazingOrchardIconAsset Include="..\..\BlazingOrchard.Icons\wwwroot\icons.css" />
      <_BlazingOrchardIconAsset Include="..\..\BlazingOrchard.Icons\wwwroot\icons.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_BlazingOrchardIconAsset)" DestinationFolder="$(TargetDir)wwwroot" SkipUnchangedFiles="true" />
  </Target>

</Project>
