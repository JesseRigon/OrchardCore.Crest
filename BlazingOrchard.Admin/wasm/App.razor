@using Microsoft.AspNetCore.Components.Routing
@using BlazingOrchard.Admin.Components.Admin
@using Radzen
@using Radzen.Blazor

<RadzenNotification />

<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@BlazingModuleAssemblyRegistry.Assemblies">
    <Found Context="routeData">
        @if (IsShelllessRoute(routeData))
        {
            <RouteView RouteData="@routeData" />
        }
        else
        {
            <BlazingAppContainer>
                <RouteView RouteData="@routeData" />
            </BlazingAppContainer>
        }
    </Found>
    <NotFound>
        <LegacyAdminFrame />
    </NotFound>
</Router>

@code {
    private static bool IsShelllessRoute(RouteData routeData)
        => string.Equals(routeData.PageType.Name, "Login", StringComparison.Ordinal)
            || string.Equals(routeData.PageType.Name, "Home", StringComparison.Ordinal);
}
