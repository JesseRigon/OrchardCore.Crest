@using BlazingOrchard.Admin.DisplayManagement
@using Radzen
@using Radzen.Blazor
@inject NavigationManager Navigation

<RadzenSidebar class="admin-menu-sidebar">
    <RadzenStack Gap="0.75rem" class="admin-menu-sidebar__content">
        @if (DisplayManager is null)
        {
            <RadzenText TextStyle="TextStyle.Body2" Text="Display manager is unavailable." />
        }
        else if (Menu is null)
        {
            <RadzenText TextStyle="TextStyle.Body2" Text="Loading admin menu..." />
        }
        else
        {
            @if (DisplayManager.Manifest?.AdminSettings.DisplayMenuFilter == true)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="admin-menu-sidebar__filter-row">
                    <RadzenTextBox @bind-Value="MenuFilter" @oninput="UpdateMenuFilter" Placeholder="Search Menu" Style="width: 100%;" />
                    @if (HasQuickAddItems)
                    {
                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" class="admin-menu-sidebar__quickadd-button" Click="OpenQuickAdd" title="Quick Add" />
                    }
                </RadzenStack>
            }
            else if (HasQuickAddItems)
            {
                <button type="button" class="admin-menu-sidebar__quickadd-row" @onclick="OpenQuickAdd" title="Quick Add">
                    <span class="admin-menu-sidebar__item-content">
                        <RadzenIcon Icon="celebration" class="rz-navigation-item-icon" />
                        <span class="rz-navigation-item-text">Quick Add</span>
                    </span>
                    <RadzenIcon Icon="add" class="admin-menu-sidebar__quickadd-add-icon" />
                </button>
            }

            <RadzenPanelMenu class="admin-menu-sidebar__menu">
                <AdminMenuPanelItems Items="VisibleMenuItems" ExpandedItemKeys="ExpandedItemKeys" ExpandedChanged="SetExpanded" />
            </RadzenPanelMenu>

            @if (VisibleMenuItems.Length == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" Text="No admin menu items returned." />
            }

            @if (IsQuickAddOpen)
            {
                <div class="admin-menu-sidebar__quickadd-popover" role="dialog" aria-modal="true" aria-label="Quick Add">
                    <div class="admin-menu-sidebar__quickadd-header">
                        <span class="admin-menu-sidebar__item-content">
                            <RadzenIcon Icon="celebration" class="rz-navigation-item-icon" />
                            <span class="rz-navigation-item-text">Quick Add</span>
                        </span>
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" class="admin-menu-sidebar__quickadd-button" Click="CloseQuickAdd" title="Close Quick Add" />
                    </div>
                    <RadzenPanelMenu class="admin-menu-sidebar__menu admin-menu-sidebar__quickadd-menu">
                        <AdminMenuPanelItems Items="QuickAddItems" ExpandedItemKeys="ExpandedItemKeys" ExpandedChanged="SetExpanded" />
                    </RadzenPanelMenu>
                </div>
            }
        }
    </RadzenStack>
</RadzenSidebar>

@code {
    [CascadingParameter]
    public DisplayManager? DisplayManager { get; set; }

    private readonly HashSet<string> ExpandedItemKeys = [];
    private DisplayMenu? LastMenu;
    private string? MenuFilter { get; set; }
    private bool IsQuickAddOpen { get; set; }

    private DisplayMenu? Menu => DisplayManager?.AdminMenu;
    private DisplayMenuItem? QuickAddSource => Menu is null ? null : FindQuickAddSource(Menu.Items);
    private DisplayMenuItem[] QuickAddItems => QuickAddSource?.Items ?? [];
    private bool HasQuickAddItems => DisplayManager?.Manifest?.AdminSettings.DisplayNewMenu == true && QuickAddItems.Length > 0;
    private DisplayMenuItem[] SidebarMenuItems => Menu is null ? [] : RemoveQuickAddSource(Menu.Items);
    private DisplayMenuItem[] VisibleMenuItems => string.IsNullOrWhiteSpace(MenuFilter) ? SidebarMenuItems : FilterItems(SidebarMenuItems, MenuFilter);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Menu, LastMenu))
        {
            LastMenu = Menu;
            SyncExpandedItemsWithMenu();
        }

        if (!HasQuickAddItems)
        {
            IsQuickAddOpen = false;
        }
    }

    private void SetExpanded(string key, bool expanded)
    {
        if (expanded)
        {
            ExpandedItemKeys.Add(key);
        }
        else
        {
            ExpandedItemKeys.Remove(key);
        }
    }

    private void OpenQuickAdd()
    {
        if (!HasQuickAddItems)
        {
            return;
        }

        IsQuickAddOpen = true;
        foreach (var item in Flatten(QuickAddItems).Where(item => item.HasChildren))
        {
            ExpandedItemKeys.Add(item.StableKey);
        }
    }

    private void CloseQuickAdd()
    {
        IsQuickAddOpen = false;
    }

    private void SyncExpandedItemsWithMenu()
    {
        if (Menu is null)
        {
            ExpandedItemKeys.Clear();
            return;
        }

        var visibleKeys = Flatten([.. SidebarMenuItems, .. QuickAddItems]).Select(item => item.StableKey).ToHashSet(StringComparer.Ordinal);
        ExpandedItemKeys.RemoveWhere(key => !visibleKeys.Contains(key));
        ExpandActiveAncestors(SidebarMenuItems);
    }

    private void UpdateMenuFilter(ChangeEventArgs args)
    {
        MenuFilter = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(MenuFilter))
        {
            foreach (var item in Flatten(VisibleMenuItems).Where(item => item.HasChildren))
            {
                ExpandedItemKeys.Add(item.StableKey);
            }
        }
    }

    private static DisplayMenuItem[] FilterItems(DisplayMenuItem[] items, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return items;
        }

        return items
            .Select(item => FilterItem(item, query))
            .Where(item => item is not null)
            .Cast<DisplayMenuItem>()
            .ToArray();
    }

    private static DisplayMenuItem? FilterItem(DisplayMenuItem item, string query)
    {
        var children = FilterItems(item.Items, query);
        var isMatch = item.Text.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (item.Link?.Contains(query, StringComparison.OrdinalIgnoreCase) == true);

        return isMatch || children.Length > 0
            ? item with { Items = children }
            : null;
    }

    private bool ExpandActiveAncestors(IEnumerable<DisplayMenuItem> items)
    {
        var hasActiveItem = false;

        foreach (var item in items)
        {
            var childIsActive = ExpandActiveAncestors(item.Items);
            var itemIsActive = IsActive(item);

            if (childIsActive || itemIsActive)
            {
                hasActiveItem = true;
                if (item.HasChildren)
                {
                    ExpandedItemKeys.Add(item.StableKey);
                }
            }
        }

        return hasActiveItem;
    }

    private bool IsActive(DisplayMenuItem item)
    {
        if (!item.HasLink)
        {
            return false;
        }

        var current = '/' + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        var link = item.Link!.StartsWith('/') ? item.Link : '/' + item.Link;
        return current.Equals(link, StringComparison.OrdinalIgnoreCase)
            || current.StartsWith(link.TrimEnd('/') + '/', StringComparison.OrdinalIgnoreCase);
    }

    private static DisplayMenuItem? FindQuickAddSource(IEnumerable<DisplayMenuItem> items)
    {
        foreach (var item in items)
        {
            if (IsQuickAddSource(item))
            {
                return item;
            }

            var child = FindQuickAddSource(item.Items);
            if (child is not null)
            {
                return child;
            }
        }

        return null;
    }

    private static DisplayMenuItem[] RemoveQuickAddSource(IEnumerable<DisplayMenuItem> items) => items
        .Where(item => !IsQuickAddSource(item))
        .Select(item => item with { Items = RemoveQuickAddSource(item.Items) })
        .ToArray();

    private static bool IsQuickAddSource(DisplayMenuItem item) =>
        string.Equals(item.Key, "new", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(item.Id, "new", StringComparison.OrdinalIgnoreCase) ||
        (item.Classes.Any(className => string.Equals(className, "new", StringComparison.OrdinalIgnoreCase)) &&
            string.Equals(item.Text, "New", StringComparison.OrdinalIgnoreCase));

    private static IEnumerable<DisplayMenuItem> Flatten(IEnumerable<DisplayMenuItem> items)
    {
        foreach (var item in items)
        {
            yield return item;
            foreach (var child in Flatten(item.Items))
            {
                yield return child;
            }
        }
    }
}
