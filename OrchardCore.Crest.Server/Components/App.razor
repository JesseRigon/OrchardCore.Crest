@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Options
@using global::Crest
@using global::Crest.Admin
@using global::Crest.Site.Client

@*
    Phase 8: theme-dispatching document root, mounted via Startup.cs's
    routes.MapRazorComponents<App>() - the single Blazor Web App host document for
    every Crest theme. Which theme's document renders is a per-request decision:
    BlazorAdminThemeMiddleware authorizes admin/login page requests, rewrites their
    path to the canonical (prefix-stripped) form MapRazorComponents' route table
    understands, and stamps HttpContext.Items[CrestBlazorHosting.ShellBasePathItem]
    (see CrestBlazorHosting.cs) - that marker selects the Admin branch below. Every
    other request gets the Site branch, exactly what this file rendered before Phase 8.

    Routes (and every routable @page component) live in the WASM client assemblies
    (Site.Client / Admin.Client under the OrchardCore.Crest.Client entry), never here -
    the WASM runtime only has whatever assemblies it was compiled with; a Routes
    defined server-side resolves over the circuit but throws the moment
    InteractiveAuto switches to WASM. See docs/BlazorWeb.md.

    Admin head assets are tenant-root-absolute _content/* static-web-asset URLs
    (served by MapStaticAssets inside the tenant pipeline), deliberately independent
    of the admin <base href> and composed via Asset() on Orchard's tenant base so
    URL-prefixed tenants resolve them correctly - the old wasm/index.html +
    CopyCrestSharedAssets flattened copies are retired with the middleware's shell
    serving.
*@
@* lang reflects the culture the request-localization pipeline resolved for this
   request (tenant default / crest_culture cookie / user preference) - the SSR
   document must carry it so first-paint markup is correctly language-tagged
   before any interactive culture handling runs. *@
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (_isAdminShell)
    {
        <title>Crest</title>
        <base href="@_adminBaseHref" />
        <meta name="crest-tenant-base" content="@_tenantBasePath" />
        <link id="crest-radzen-theme" rel="stylesheet" href="@Asset("/_content/OrchardCore.Crest.Components/css/material-base.css")" />
        <link rel="stylesheet" href="@Asset("/OrchardCore.Resources/Vendor/fontawesome-free/css/all.min.css")" />
        <link rel="stylesheet" href="@Asset("/OrchardCore.Resources/Vendor/fontawesome-free/css/v4-shims.min.css")" />
        <link rel="stylesheet" href="@Asset("/OrchardCore.Resources/Vendor/fontawesome-free/css/v5-font-face.min.css")" />
        <link rel="stylesheet" href="@Asset("/_content/OrchardCore.Crest.Admin.Client/CrestAdmin.DesignSystem.Default.css")" />
        <link rel="stylesheet" href="@Asset("/_content/OrchardCore.Crest.Components/CrestComponents.css")" />
        <link rel="stylesheet" href="@Asset("/_content/OrchardCore.Crest.Components/OrchardCore.Crest.Components.bundle.scp.css")" />
        <link rel="stylesheet" href="@Asset("/_content/OrchardCore.Crest.Admin.Client/CrestAdmin.css")" />
        <link rel="stylesheet" href="@Asset("/_content/OrchardCore.Crest.Admin.Client/OrchardCore.Crest.Admin.Client.bundle.scp.css")" />
        <link rel="stylesheet" href="@Asset("/_content/OrchardCore.Crest.Icons/CrestIcons.css")" />
    }
    else
    {
        <base href="@(_tenantBasePath + "/")" />
        <meta name="crest-tenant-base" content="@_tenantBasePath" />
    }
    <HeadOutlet @rendermode="@_renderMode" />
</head>
<body>
    @if (_isAdminShell)
    {
        <AdminRoutes @rendermode="@_renderMode" />
        <script src="@Asset("/_content/OrchardCore.Crest.Admin.Client/crest.theme.js")"></script>
        <script src="@Asset("/_content/OrchardCore.Crest.Components/crest.components.js")"></script>
        <script src="@Asset("/_content/OrchardCore.Crest.Admin.Client/crest.adminMenus.js")"></script>
        <script src="@Asset("/_content/OrchardCore.Crest.Icons/icons.js")"></script>
        <script src="@Asset("/_content/OrchardCore.Crest.Components/Radzen.Blazor.js")"></script>
    }
    else
    {
        @* Site shell. Admin's Home.razor also declares @page "/" (meaning "this admin
           shell's own base", /Admin/ or /Login/) — both endpoints exist in the same
           shared Blazor Web App route table, but Crest.Routing.RouteGateMatcherPolicy
           (see docs/BlazorWeb.md's "Route reachability" section) vetoes whichever one
           doesn't own this request before endpoint selection completes, so only one of
           the two ever actually renders here. *@
        <Routes @rendermode="@_renderMode" />
    }
    <script src="@Asset("/_framework/blazor.web.js")"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    private IOptions<BlazorAdminThemeOptions> AdminThemeOptions { get; set; } = default!;

    private bool _isAdminShell;
    private string _adminBaseHref = "/";
    private string _tenantBasePath = "";
    private IComponentRenderMode _renderMode = RenderMode.InteractiveAuto;

    // Head/body asset URLs are tenant-root-absolute (deliberately independent of the
    // admin <base href> - see the header comment), composed on Orchard's tenant base
    // so they survive URL-prefixed tenants: "/_content/x" becomes "/tenant2/_content/x".
    private string Asset(string path) => _tenantBasePath + path;

    protected override void OnInitialized()
    {
        // Orchard's own layer of the request base: the tenant RequestUrlPrefix (plus
        // any host-level PathBase), WITHOUT Crest's admin shell base. For admin-shell
        // requests the middleware stashes the pre-shift value; for site requests
        // PathBase was never shifted, so it IS the tenant base.
        _tenantBasePath = HttpContext?.Items.TryGetValue(CrestBlazorHosting.TenantBasePathItem, out var tenantBase) == true
            && tenantBase is string tenantBasePath
                ? tenantBasePath.TrimEnd('/')
                : (HttpContext?.Request.PathBase.Value ?? "").TrimEnd('/');

        // Only the middleware's explicit marker selects the admin document - a raw
        // path check here would bypass its theme-selection and route-authorization
        // gates (an admin-path request without the marker means the middleware
        // deliberately declined: Blazor admin theme not selected for this tenant).
        if (HttpContext?.Items.TryGetValue(CrestBlazorHosting.ShellBasePathItem, out var value) == true
            && value is string shellBasePath
            && !string.IsNullOrWhiteSpace(shellBasePath))
        {
            _isAdminShell = true;
            // The middleware shifted the shell base into PathBase (tenant prefix +
            // shell base), so PathBase + "/" is the complete, composed base href -
            // the same value .NET 11's <BasePath /> component will derive from
            // NavigationManager.BaseUri once available (dotnet/aspnetcore#66388).
            _adminBaseHref = (HttpContext.Request.PathBase.Value ?? shellBasePath).TrimEnd('/') + "/";

            // The login shell is the render-mode exception: under InteractiveAuto's
            // first-visit server circuit, Login.razor's credential POST goes out on
            // the server-side loopback HttpClient - the auth Set-Cookie lands in that
            // handler, never in the browser, and the "successful" login leaves the
            // browser anonymous. InteractiveWebAssembly keeps the SSR-prerendered
            // form but runs the interactive phase in the browser, where the fetch's
            // Set-Cookie is stored by the browser exactly like the old WASM shell.
            if (string.Equals(shellBasePath, AdminThemeOptions.Value.LoginPath, StringComparison.OrdinalIgnoreCase))
            {
                _renderMode = RenderMode.InteractiveWebAssembly;
            }
        }
    }
}
