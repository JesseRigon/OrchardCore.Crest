<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>OrchardCore.Crest.Components</AssemblyName>
    <RootNamespace>Crest.Components</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Themes\**" />
    <Content Remove="Themes\**" />
    <EmbeddedResource Remove="Themes\**" />
    <None Remove="Themes\**" />
    <RazorGenerate Remove="Themes\**" />
    <RazorComponent Remove="Themes\**" />
  </ItemGroup>

  <!-- Full MIT-licensed component source now owned and compiled by Crest. -->
  <ItemGroup>
    <!-- Runtime assets are exposed from this project's canonical wwwroot. -->
    <EmbeddedResource Include="Components\Resources\Spreadsheet\theme1.xml" />
    <EmbeddedResource Update="Utilities\CrestStrings.resx">
      <ManifestResourceName>Crest.Components.Primitives.CrestStrings</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Utilities\CrestStrings.de.resx">
      <ManifestResourceName>Crest.Components.Primitives.CrestStrings.de</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Utilities\CrestStrings.es.resx">
      <ManifestResourceName>Crest.Components.Primitives.CrestStrings.es</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Utilities\CrestStrings.fr.resx">
      <ManifestResourceName>Crest.Components.Primitives.CrestStrings.fr</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Utilities\CrestStrings.it.resx">
      <ManifestResourceName>Crest.Components.Primitives.CrestStrings.it</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Utilities\CrestStrings.ja.resx">
      <ManifestResourceName>Crest.Components.Primitives.CrestStrings.ja</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
</Project>
