<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>OrchardCore.Crest.Components</AssemblyName>
    <RootNamespace>Crest.Components</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Themes\**" />
    <Content Remove="Themes\**" />
    <EmbeddedResource Remove="Themes\**" />
    <None Remove="Themes\**" />
    <RazorGenerate Remove="Themes\**" />
    <RazorComponent Remove="Themes\**" />
  </ItemGroup>

  <!-- Full MIT-licensed component source now owned and compiled by Crest. -->
  <ItemGroup>
    <!-- Runtime assets are exposed from this project's canonical wwwroot. -->
    <EmbeddedResource Include="Components\Resources\Spreadsheet\theme1.xml" />
    <!-- English-only compiled default (see plans/user-localization.md "Client string
         localization for .Admin"). Real translations come from OrchardCore's .po
         pipeline via Crest.Admin.Theme.CrestApiLocalizer at runtime - satellite .resx
         files per language were removed 2026-07-31: they shipped as separate compiled
         .resources.dll assemblies in the WASM bundle regardless of which cultures a
         given tenant actually supports, grew unboundedly as languages were added, and
         weren't editable without a recompile/redeploy. Do not add new
         CrestStrings.{culture}.resx files - add .po translation content instead. -->
    <EmbeddedResource Update="Utilities\CrestStrings.resx">
      <ManifestResourceName>Crest.Components.Primitives.CrestStrings</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
</Project>
