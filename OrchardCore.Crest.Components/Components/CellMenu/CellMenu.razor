@using Crest.Components.Primitives
@using Crest.Components.Primitives.Documents.Spreadsheet
@using Microsoft.AspNetCore.Components.Web
@using Crest.Components.Primitives.Rendering
@namespace Crest.Components.Primitives.Spreadsheet
<ul class="rz-menu rz-spreadsheet-cell-menu">
    <CellMenuItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_SortAscending)) ?? "Sort ascending") Icon="sort" Click=@OnSortAscendingAsync />
    <CellMenuItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_SortDescending)) ?? "Sort descending") Icon="sort" Click=@OnSortDescendingAsync />
    <CellMenuItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_ClearFilter)) ?? "Clear Filter") Icon="filter_alt_off" Click=@OnClearFilterAsync Disabled=@(!HasFilterApplied()) />
    <CellMenuItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_CustomFilter)) ?? "Custom filter...") Icon="filter_alt" Click=@OnCustomFilterAsync />
    <CellMenuItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_Top10FilterTooltip)) ?? "") Icon="leaderboard" Click=@OnTop10FilterAsync />
    <CellMenuItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_FilterAboveAverage)) ?? "") Icon="north_east" Click=@(() => OnDynamicFilterAsync(DynamicFilterType.AboveAverage)) />
    <CellMenuItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_FilterBelowAverage)) ?? "") Icon="south_east" Click=@(() => OnDynamicFilterAsync(DynamicFilterType.BelowAverage)) />
    <div class="rz-spreadsheet-cell-menu-filter">
        <CellMenuItem>
            <CrestCheckBox TValue="bool?" Value=@IsSelectAllChecked() Change=@OnSelectAllChanged TriState="true" Name="cellMenuSelectAll" />
            <CrestLabel Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_SelectAll)) ?? "(Select All)") Component="cellMenuSelectAll" />
        </CellMenuItem>
        @{
            var valueIndex = 0;
        }
        @foreach (var item in LoadAvailableValues())
        {
            var name = $"cellMenuValue{valueIndex++}";
            <CellMenuItem>
                <CrestCheckBox TValue="bool" Value=@IsValueSelected(item.Value) Change=@(isChecked => OnValueSelectionChanged(item.Value, isChecked)) Name=@name />
                <CrestLabel Text=@item.Text Component=@name />
            </CellMenuItem>
        }
        @if (ShouldShowBlankOption())
        {
            <CellMenuItem>
                <CrestCheckBox TValue="bool" Value=@IsBlankSelected() Change=@OnBlankSelectionChanged Name="cellMenuBlank" />
                <CrestLabel Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_Blank)) ?? "(Blank)") Component="cellMenuBlank" />
            </CellMenuItem>
        }
    </div>
    <CrestStack class="rz-spreadsheet-cell-menu-buttons" Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
        <CrestButton Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_Cancel)) ?? "Cancel") Click=@OnCancelFilterAsync ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
        <CrestButton Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_OK)) ?? "OK") Click=@OnApplyFilterAsync ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Disabled=@(!CanApplyFilter()) />
    </CrestStack>
</ul>
