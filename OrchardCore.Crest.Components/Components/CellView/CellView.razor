@using Microsoft.AspNetCore.Components.Web
@using Crest.Components.Primitives.Rendering
@using Crest.Components.Primitives.Documents.Spreadsheet
@inherits CellBase

@namespace Crest.Components.Primitives.Spreadsheet
@{
#pragma warning disable IL2111
}

<div class=@Class style=@Style data-row=@Row data-column=@Column title=@GetValidationTooltip()>
    @if (customRendererType is not null)
    {
        <DynamicComponent Type=@customRendererType Parameters=@GetRendererParameters() />
    }
    else if (cell?.Hyperlink is not null)
    {
        <a class="rz-spreadsheet-cell-hyperlink" href=@cell.Hyperlink.Url target="_blank" @onclick:stopPropagation>@GetDisplayValue()</a>
    }
    else
    {
        @GetDisplayValue()
    }
    @if (showCellMenu)
    {
        <CrestButton @ref=@cellMenuButton class="rz-spreadsheet-cell-chevron" Variant="Variant.Flat"
            ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" Icon="expand_more" Click=@OnToggleAsync />
    }
</div>
