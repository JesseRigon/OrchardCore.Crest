@using Crest.Components.Primitives
@using Crest.Components.Primitives.Documents.Spreadsheet
@inherits SpreadsheetDialogBase

@namespace Crest.Components.Primitives.Spreadsheet
<CrestStack Gap="1rem">
    <CrestStack Orientation="Orientation.Vertical" Gap="0.25rem">
        <CrestLabel Text=@L(nameof(CrestStrings.Spreadsheet_TableRange)) class="rz-text-subtitle2" />
        <RangePicker Value=@Draft.RangeFormula ValueChanged=@OnRangeFormulaChanged
            OnPickRequested=@OnRangePickRequested
            ShouldFocusOnLoad=@(FocusFieldId == RangeFieldId) />
    </CrestStack>

    <CrestStack Orientation="Orientation.Vertical" Gap="0.25rem">
        <CrestLabel Text=@L(nameof(CrestStrings.Spreadsheet_TableName)) Component="nameInput" class="rz-text-subtitle2" />
        <CrestTextBox Value=@Draft.Name Change=@OnNameChanged Name="nameInput" Style="width: 100%" />
    </CrestStack>

    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <CrestCheckBox Value=@Draft.HasHeaders Change=@OnHasHeadersChanged Name="hasHeadersCheck" TValue="bool" />
        <CrestLabel Text=@L(nameof(CrestStrings.Spreadsheet_TableHasHeaders)) Component="hasHeadersCheck" class="rz-text-subtitle2" />
    </CrestStack>

    <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End" class="rz-spreadsheet-dialog-actions">
        <CrestButton Text=@L(nameof(CrestStrings.Spreadsheet_Cancel)) ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
            Click=@OnCancel />
        <CrestButton Text=@L(nameof(CrestStrings.Spreadsheet_OK)) ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
            Disabled=@string.IsNullOrWhiteSpace(Draft.Name)
            Click=@OnOk />
    </CrestStack>
</CrestStack>

@code {
#nullable enable

    internal const string RangeFieldId = "Range";

    [Parameter] public InsertTableDraft Draft { get; set; } = default!;
    [Parameter] public string? FocusFieldId { get; set; }

    private void OnNameChanged(string value) => Draft.Name = value ?? string.Empty;
    private void OnHasHeadersChanged(bool value) => Draft.HasHeaders = value;
    private void OnRangeFormulaChanged(string? value) => Draft.RangeFormula = value ?? string.Empty;

    private void OnRangePickRequested()
    {
        DialogService.Close(new RangePickRequest(RangeFieldId, Draft.RangeFormula));
    }

    private void OnOk()
    {
        Draft.Name = Draft.Name.Trim();
        DialogService.Close(Draft);
    }
}
