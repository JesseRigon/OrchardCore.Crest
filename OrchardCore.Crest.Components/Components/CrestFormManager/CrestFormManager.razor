@namespace Crest.Components.Forms
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json.Nodes
@using Crest.Components.Models
@using Crest.Components.Options
@using Microsoft.AspNetCore.Components.Rendering
@using Crest.Components.Primitives
@inject HttpClient Http

@if (Content is null)
{
    <CrestText TextStyle="TextStyle.Body2" class="rz-color-secondary">No content data is available for this item.</CrestText>
}
else if (Metadata?.Parts is { Length: > 0 } parts)
{
    <CrestStack Gap="1rem" class="crest-form-manager">
        @foreach (var part in parts.Where(ShouldRenderPart))
        {
            <CrestFieldset Text="@part.DisplayName" AllowCollapse="true">
                <CrestStack Gap="0.75rem">
                    @foreach (var field in part.Fields
                        .OrderBy(field => field.Position ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                        .Where(field => IsFieldVisible(part.Name, field)))
                    {
                        <div class="crest-form-manager__field">
                            @RenderField(part, field)
                            @if (Errors.TryGetValue(FieldKey(part.Name, field.Name), out var error))
                            {
                                <CrestText TextStyle="TextStyle.Caption" class="rz-color-danger">@error</CrestText>
                            }
                        </div>
                    }
                </CrestStack>
            </CrestFieldset>
        }
    </CrestStack>
}
else
{
    <CrestText TextStyle="TextStyle.Body2" class="rz-color-secondary">This content type does not expose editable field metadata yet.</CrestText>
}

@code {
    [Parameter] public JsonNode? Content { get; set; }
    [Parameter] public CrestContentItemMetadata? Metadata { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private readonly Dictionary<string, string> Errors = new(StringComparer.Ordinal);

    public bool Validate()
    {
        Errors.Clear();

        foreach (var part in Metadata?.Parts?.Where(ShouldRenderPart) ?? [])
        {
            foreach (var field in part.Fields)
            {
                // A hidden field cannot be required: the user cannot see it, and the
                // server clears its value on save anyway.
                if (!field.Required || !IsFieldVisible(part.Name, field))
                {
                    continue;
                }

                var value = GetFieldPrimaryValue(part.Name, field);
                var isMissing = value is null
                    || value.GetValueKind() is System.Text.Json.JsonValueKind.Null
                    || value.GetValueKind() is System.Text.Json.JsonValueKind.String && string.IsNullOrWhiteSpace(value.GetValue<string>())
                    || value is JsonArray array && array.Count == 0;

                if (isMissing)
                {
                    Errors[FieldKey(part.Name, field.Name)] = $"{field.Label} is required.";
                }
            }
        }

        StateHasChanged();
        return Errors.Count == 0;
    }

    private RenderFragment RenderField(CrestContentPartMetadata part, CrestContentFieldMetadata field) => builder =>
    {
        var sequence = 0;
        builder.OpenComponent<CrestFormField>(sequence++);
        builder.AddAttribute(sequence++, "Text", field.Label);
        builder.AddAttribute(sequence++, "Style", "width: 100%;");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(childBuilder => RenderFieldInput(childBuilder, part.Name, field)));
        builder.CloseComponent();
    };

    private void RenderFieldInput(RenderTreeBuilder builder, string partName, CrestContentFieldMetadata field)
    {
        var sequence = 0;
        switch (field.FieldType)
        {
            case "NumericField":
                builder.OpenComponent<CrestNumeric<decimal?>>(sequence++);
                builder.AddAttribute(sequence++, "Value", GetDecimal(partName, field.Name));
                builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<decimal?>(this, value => SetFieldValue(partName, field.Name, "Value", value)));
                builder.AddAttribute(sequence++, "Disabled", Disabled);
                builder.AddAttribute(sequence++, "Style", "width: 100%;");
                builder.CloseComponent();
                break;
            case "BooleanField":
                builder.OpenComponent<CrestCheckBox<bool>>(sequence++);
                builder.AddAttribute(sequence++, "Value", GetBool(partName, field.Name));
                builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<bool>(this, value => SetFieldValue(partName, field.Name, "Value", value)));
                builder.AddAttribute(sequence++, "Disabled", Disabled);
                builder.CloseComponent();
                break;
            case "DateField":
            case "DateTimeField":
                builder.OpenComponent<CrestDatePicker<DateTime?>>(sequence++);
                builder.AddAttribute(sequence++, "Value", GetDateTime(partName, field.Name));
                builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<DateTime?>(this, value => SetFieldValue(partName, field.Name, "Value", value)));
                builder.AddAttribute(sequence++, "Disabled", Disabled);
                builder.AddAttribute(sequence++, "Style", "width: 100%;");
                builder.CloseComponent();
                break;
            case "OptionPickerField":
                builder.OpenComponent<CrestOptionPicker>(sequence++);
                builder.AddAttribute(sequence++, "SourceKey", PickerSettings(field)?["SourceKey"]?.GetValue<string>() ?? string.Empty);
                builder.AddAttribute(sequence++, "Columns", ParseColumns(PickerSettings(field)));
                builder.AddAttribute(sequence++, "SelectedIds", GetSelectedIds(partName, field.Name));
                builder.AddAttribute(sequence++, "SelectedIdsChanged", EventCallback.Factory.Create<IReadOnlyList<string>>(this, ids => SetSelectedIds(partName, field.Name, ids)));
                builder.AddAttribute(sequence++, "Multiple", PickerSettings(field)?["Multiple"]?.GetValue<bool>() ?? false);
                builder.AddAttribute(sequence++, "Required", field.Required);
                builder.AddAttribute(sequence++, "Placeholder", PickerSettings(field)?["Placeholder"]?.GetValue<string>() ?? string.Empty);
                builder.AddAttribute(sequence++, "Disabled", Disabled);
                // The attachment identifies itself; the server loads its filters and
                // resolves any ValueFrom against the state below.
                builder.AddAttribute(sequence++, "ContentType", Metadata?.ContentType);
                builder.AddAttribute(sequence++, "FieldName", field.Name);
                builder.AddAttribute(sequence++, "EditorState", BuildEditorState(field));
                builder.AddAttribute(sequence++, "TestId", $"picker-{partName}-{field.Name}");
                builder.CloseComponent();
                break;
            case "ContentPickerField":
                builder.OpenComponent<CrestTextBox>(sequence++);
                builder.AddAttribute(sequence++, "Value", GetPickerIds(partName, field.Name));
                builder.AddAttribute(sequence++, "Change", EventCallback.Factory.Create<string>(this, value => SetPickerIds(partName, field.Name, value)));
                builder.AddAttribute(sequence++, "Disabled", Disabled);
                builder.AddAttribute(sequence++, "Style", "width: 100%;");
                builder.CloseComponent();
                break;
            case "TextField":
            default:
                builder.OpenComponent<CrestTextBox>(sequence++);
                builder.AddAttribute(sequence++, "Value", GetString(partName, field.Name, "Text"));
                builder.AddAttribute(sequence++, "Change", EventCallback.Factory.Create<string>(this, value => SetFieldValue(partName, field.Name, "Text", value)));
                builder.AddAttribute(sequence++, "Disabled", Disabled);
                builder.AddAttribute(sequence++, "Style", "width: 100%;");
                builder.CloseComponent();
                break;
        }
    }

    private bool ShouldRenderPart(CrestContentPartMetadata part) => part.Fields.Length > 0;

    private JsonObject Root => Content as JsonObject ?? Content?.AsObject() ?? [];

    private JsonObject GetOrCreateField(string partName, string fieldName)
    {
        if (Root[partName] is not JsonObject part)
        {
            part = [];
            Root[partName] = part;
        }

        if (part[fieldName] is not JsonObject field)
        {
            field = [];
            part[fieldName] = field;
        }

        return field;
    }

    private JsonNode? GetFieldPrimaryValue(string partName, CrestContentFieldMetadata field)
    {
        var propertyName = field.FieldType switch
        {
            "ContentPickerField" => "ContentItemIds",
            "OptionPickerField" => "SelectedIds",
            "TextField" => "Text",
            _ => "Value"
        };

        return Root[partName]?[field.Name]?[propertyName];
    }

    // --- Option pickers -------------------------------------------------------

    private static JsonNode? PickerSettings(CrestContentFieldMetadata field) =>
        field.Settings?["OptionPickerFieldSettings"];

    private static IReadOnlyList<OptionPickerColumn> ParseColumns(JsonNode? pickerSettings)
    {
        if (pickerSettings?["Columns"] is not JsonArray columns)
        {
            return [];
        }

        return [.. columns
            .Select(column => column is null ? null : new OptionPickerColumn(
                column["Path"]?.GetValue<string>() ?? string.Empty,
                column["Label"]?.GetValue<string>() ?? column["Path"]?.GetValue<string>() ?? string.Empty,
                column["Width"]?.GetValue<string>(),
                column["Visible"]?.GetValue<bool>() ?? true,
                column["InChip"]?.GetValue<bool>() ?? false))
            .Where(column => column is not null && column.Path.Length > 0)
            .Select(column => column!)];
    }

    private IReadOnlyList<string> GetSelectedIds(string partName, string fieldName) =>
        Root[partName]?[fieldName]?["SelectedIds"] is JsonArray ids
            ? [.. ids.Select(id => id?.GetValue<string>()).Where(id => !string.IsNullOrWhiteSpace(id)).Select(id => id!)]
            : [];

    private void SetSelectedIds(string partName, string fieldName, IReadOnlyList<string> ids)
    {
        GetOrCreateField(partName, fieldName)["SelectedIds"] =
            new JsonArray([.. ids.Select(id => (JsonNode?)JsonValue.Create(id))]);
        Errors.Remove(FieldKey(partName, fieldName));
        // A parent's committed selection feeds dependent pickers (their EditorState
        // re-keys) and visibility conditions - drop resolved keys so both re-evaluate.
        ParentKeysCache.Clear();
        StateHasChanged();
    }

    /// <summary>
    /// The dependency values THIS picker's configured filters read (by ValueFrom), so
    /// the server can resolve its cascade. Built from the filters in the field's own
    /// settings - state changes re-render this, which is what re-queries a dependent
    /// picker when its parent commits.
    /// </summary>
    private IReadOnlyDictionary<string, string[]>? BuildEditorState(CrestContentFieldMetadata field)
    {
        if (PickerSettings(field)?["Filters"] is not JsonArray filters || filters.Count == 0)
        {
            return null;
        }

        var state = new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase);
        foreach (var filter in filters)
        {
            var valueFrom = filter?["ValueFrom"]?.GetValue<string>();
            if (string.IsNullOrWhiteSpace(valueFrom) || state.ContainsKey(valueFrom))
            {
                continue;
            }

            state[valueFrom] = ReadPathValues(valueFrom);
        }

        return state.Count == 0 ? null : state;
    }

    // Paths are "Field" (the type's implicit part) or "Part.Field", matching the
    // server's convention. A picker contributes its selected ids, scalars their value.
    private string[] ReadPathValues(string path)
    {
        var segments = path.Split('.', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length is 0 or > 2)
        {
            return [];
        }

        var partName = segments.Length == 2 ? segments[0] : Metadata?.ContentType ?? string.Empty;
        var node = Root[partName]?[segments[^1]];
        if (node is null)
        {
            return [];
        }

        if (node["SelectedIds"] is JsonArray ids)
        {
            return [.. ids.Select(id => id?.ToString()).Where(id => !string.IsNullOrWhiteSpace(id)).Select(id => id!)];
        }

        var scalar = (node["Text"] ?? node["Value"])?.ToString();
        return string.IsNullOrWhiteSpace(scalar) ? [] : [scalar];
    }

    // --- Field visibility -----------------------------------------------------

    // Resolved parent comparison values, keyed by "path|ids". A null value means a
    // resolve request is in flight; the field stays hidden until it lands rather
    // than flashing into view with an unverified condition.
    private readonly Dictionary<string, IReadOnlyList<string>?> ParentKeysCache = new(StringComparer.Ordinal);

    /// <summary>
    /// Evaluates a field's CrestFieldVisibilitySettings against the live form.
    /// Scalar parents compare their stored value; a picker parent's ids resolve to
    /// option KEYS through the server (the identity rule - conditions name keys,
    /// never ids or labels).
    /// </summary>
    private bool IsFieldVisible(string partName, CrestContentFieldMetadata field)
    {
        var settings = field.Settings?["CrestFieldVisibilitySettings"];
        var path = settings?["Path"]?.GetValue<string>();
        if (string.IsNullOrWhiteSpace(path))
        {
            return true;
        }

        var raw = ReadPathValues(path);
        var @operator = settings?["Operator"]?.GetValue<string>() ?? "Any";
        if (string.Equals(@operator, "Any", StringComparison.OrdinalIgnoreCase))
        {
            return raw.Length > 0;
        }

        if (raw.Length == 0)
        {
            return false;
        }

        string[] keys = settings?["Keys"] is JsonArray keyArray
            ? [.. keyArray.Select(key => key?.GetValue<string>()).Where(key => !string.IsNullOrWhiteSpace(key)).Select(key => key!)]
            : [];
        var parentValues = ResolveParentComparisonValues(path, raw);

        return parentValues is not null
            && parentValues.Any(value => keys.Any(key => string.Equals(key, value, StringComparison.OrdinalIgnoreCase)));
    }

    private IReadOnlyList<string>? ResolveParentComparisonValues(string path, string[] raw)
    {
        var parentField = FindFieldMetadata(path);
        if (parentField is null)
        {
            return raw;
        }

        if (!string.Equals(parentField.FieldType, "OptionPickerField", StringComparison.Ordinal))
        {
            // Scalar parents: the stored value IS the comparison value.
            return raw;
        }

        var sourceKey = PickerSettings(parentField)?["SourceKey"]?.GetValue<string>();
        if (string.IsNullOrWhiteSpace(sourceKey))
        {
            return [];
        }

        var cacheKey = $"{path}|{string.Join(',', raw)}";
        if (ParentKeysCache.TryGetValue(cacheKey, out var resolved))
        {
            return resolved;
        }

        // Mark in flight and resolve in the background; the re-render on completion
        // re-evaluates visibility with real keys.
        ParentKeysCache[cacheKey] = null;
        _ = ResolveParentKeysAsync(cacheKey, sourceKey, raw);
        return null;
    }

    private async Task ResolveParentKeysAsync(string cacheKey, string sourceKey, string[] ids)
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/crest/option-sources/resolve", new
            {
                SourceKey = sourceKey,
                Ids = ids,
                Columns = Array.Empty<string>(),
            });

            if (response.IsSuccessStatusCode)
            {
                var rows = await response.Content.ReadFromJsonAsync<OptionPickerRow[]>() ?? [];
                ParentKeysCache[cacheKey] = [.. rows
                    .Select(row => string.IsNullOrWhiteSpace(row.Key) ? row.Id : row.Key!)
                    .Where(value => !string.IsNullOrWhiteSpace(value))];
            }
            else
            {
                // Fail closed: an unresolvable parent must not reveal the field.
                ParentKeysCache[cacheKey] = [];
            }
        }
        catch
        {
            ParentKeysCache[cacheKey] = [];
        }

        StateHasChanged();
    }

    private CrestContentFieldMetadata? FindFieldMetadata(string path)
    {
        var segments = path.Split('.', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length is 0 or > 2)
        {
            return null;
        }

        var partName = segments.Length == 2 ? segments[0] : Metadata?.ContentType ?? string.Empty;
        var part = Metadata?.Parts?.FirstOrDefault(candidate =>
            string.Equals(candidate.Name, partName, StringComparison.OrdinalIgnoreCase));

        return part?.Fields.FirstOrDefault(candidate =>
            string.Equals(candidate.Name, segments[^1], StringComparison.OrdinalIgnoreCase));
    }

    private string? GetString(string partName, string fieldName, string propertyName)
        => Root[partName]?[fieldName]?[propertyName]?.GetValue<string>();

    private decimal? GetDecimal(string partName, string fieldName)
    {
        var node = Root[partName]?[fieldName]?["Value"];
        return node is null ? null : Convert.ToDecimal(node.GetValue<object>(), CultureInfo.InvariantCulture);
    }

    private bool GetBool(string partName, string fieldName)
        => Root[partName]?[fieldName]?["Value"]?.GetValue<bool>() == true;

    private DateTime? GetDateTime(string partName, string fieldName)
    {
        var node = Root[partName]?[fieldName]?["Value"];
        if (node is null)
        {
            return null;
        }

        if (node.GetValueKind() == System.Text.Json.JsonValueKind.String && DateTime.TryParse(node.GetValue<string>(), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsed))
        {
            return parsed;
        }

        return node.GetValue<DateTime>();
    }

    private string GetPickerIds(string partName, string fieldName)
    {
        var ids = Root[partName]?[fieldName]?["ContentItemIds"] as JsonArray;
        return ids is null
            ? string.Empty
            : string.Join(", ", ids.Select(id => id?.GetValue<string>()).Where(id => !string.IsNullOrWhiteSpace(id)));
    }

    private void SetPickerIds(string partName, string fieldName, string value)
    {
        var ids = new JsonArray(value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(id => JsonValue.Create(id)!)
            .ToArray<JsonNode?>());
        GetOrCreateField(partName, fieldName)["ContentItemIds"] = ids;
        Errors.Remove(FieldKey(partName, fieldName));
    }

    private void SetFieldValue<T>(string partName, string fieldName, string propertyName, T value)
    {
        GetOrCreateField(partName, fieldName)[propertyName] = JsonValue.Create(value);
        Errors.Remove(FieldKey(partName, fieldName));
    }

    private static string FieldKey(string partName, string fieldName) => $"{partName}.{fieldName}";
}
