@namespace Crest.Components.Inputs
@using System.Linq.Expressions
@using System.Reflection
@using Microsoft.AspNetCore.Components.Web
@typeparam TItem
@typeparam TValue

@* Crest-owned dropdown primitive. Its interaction model was informed by CrestDropDown
   (MIT), but it neither renders nor invokes the Crest dropdown component. *@

@if (Visible)
{
    <div @attributes="AdditionalAttributes"
         class="@CssClass"
         style="@Style"
         role="combobox"
         aria-haspopup="listbox"
         aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
         aria-disabled="@IsDisabled.ToString().ToLowerInvariant()"
         @onkeydown="HandleKeyDown"
         @onfocusin="HandleFocusIn"
         @onfocusout="HandleFocusOut">
        <button type="button"
                class="crest-dropdown__trigger"
                disabled="@IsDisabled"
                aria-label="@AriaLabel"
                @attributes="InputAttributes"
                @onclick="ToggleAsync">
            <span class="crest-dropdown__value">
                @if (Template is not null && SelectedEntry is not null)
                {
                    @Template(ToRenderContext(SelectedEntry, CrestDropDownSurface.Trigger))
                }
                else if (ShowValueLabel)
                {
                    @(SelectedEntry?.Label ?? Placeholder ?? string.Empty)
                }
            </span>
            @if (TriggerIcon is not null)
            {
                <span class="crest-dropdown__chevron" aria-hidden="true">@TriggerIcon</span>
            }
        </button>

        @if (AllowClear && HasValue && !IsDisabled)
        {
            <button type="button" class="crest-dropdown__clear" aria-label="@ClearAriaLabel" @onclick="ClearAsync">×</button>
        }

        @if (_isOpen)
        {
            <div class="crest-dropdown__popup" role="presentation">
                @if (HeaderTemplate is not null)
                {
                    <div class="crest-dropdown__header">@HeaderTemplate</div>
                }
                else if (AllowFiltering)
                {
                    <div class="crest-dropdown__filter">
                        <input @ref="_filterInput"
                               class="crest-dropdown__filter-input"
                               type="search"
                               value="@SearchText"
                               placeholder="@FilterPlaceholder"
                               aria-label="@SearchAriaLabel"
                               @oninput="FilterAsync" />
                    </div>
                }

                @if (FilteredEntries.Count > 0)
                {
                    <ul class="crest-dropdown__options" role="listbox" data-crest-dropdown-options>
                        @foreach (var entry in FilteredEntries)
                        {
                            <li role="none">
                                <div class="@GetOptionCssClass(entry)"
                                     role="option"
                                     tabindex="@(IsDisabled || entry.Disabled ? -1 : 0)"
                                     aria-selected="@IsSelected(entry).ToString().ToLowerInvariant()"
                                     aria-disabled="@((IsDisabled || entry.Disabled).ToString().ToLowerInvariant())"
                                     @onclick="() => SelectOnItemClickAsync(entry)">
                                    @if (Template is not null)
                                    {
                                        @Template(ToRenderContext(entry, CrestDropDownSurface.Option))
                                    }
                                    else
                                    {
                                        <span class="crest-dropdown__option-label">@entry.Label</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="crest-dropdown__empty">@(EmptyTemplate ?? EmptyContent)</div>
                }

                @if (FooterTemplate is not null)
                {
                    <div class="crest-dropdown__footer">@FooterTemplate</div>
                }
            </div>
        }
    </div>
}

@code {
    private sealed record Entry(TItem Item, TValue? Value, string Label, bool Disabled);

    private readonly List<Entry> _entries = [];
    private bool _isOpen;
    private bool _hasFocus;
    private ElementReference _filterInput;

    [Parameter] public IEnumerable<TItem>? Data { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue?>>? ValueExpression { get; set; }
    [Parameter] public EventCallback<TValue?> Change { get; set; }
    [Parameter] public EventCallback<TItem> SelectedItemChanged { get; set; }

    // These describe a data source only. An exterior label belongs to the caller.
    [Parameter] public string? LabelProperty { get; set; }
    [Parameter] public string? ValueProperty { get; set; }
    [Parameter] public string? DisabledProperty { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string ClearAriaLabel { get; set; } = "Clear selection";
    [Parameter] public string SearchAriaLabel { get; set; } = "Filter options";
    [Parameter] public string FilterPlaceholder { get; set; } = "Filter";
    [Parameter] public string? SearchText { get; set; }
    [Parameter] public EventCallback<string?> SearchTextChanged { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool AllowFiltering { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public bool OpenOnFocus { get; set; }
    [Parameter] public bool ClearSearchAfterSelection { get; set; }
    [Parameter] public bool ShowValueLabel { get; set; } = true;
    [Parameter] public bool SelectOnItemClick { get; set; } = true;
    [Parameter] public int FilterDelay { get; set; } = 300;
    [Parameter] public CrestDropDownFilterCaseSensitivity FilterCaseSensitivity { get; set; } = CrestDropDownFilterCaseSensitivity.CaseInsensitive;
    [Parameter] public CrestDropDownFilterOperator FilterOperator { get; set; } = CrestDropDownFilterOperator.Contains;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    // One caller-owned card template is rendered for both surfaces. The context tells
    // it whether it is the selected trigger value or a selectable listbox option.
    [Parameter] public RenderFragment<CrestDropDownRenderContext<TItem>>? Template { get; set; }
    [Parameter] public RenderFragment? TriggerIcon { get; set; }
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment? FooterTemplate { get; set; }
    [Parameter] public RenderFragment? EmptyTemplate { get; set; }
    [Parameter] public RenderFragment EmptyContent { get; set; } = builder => builder.AddContent(0, "No options found.");
    [Parameter] public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsDisabled => Disabled || ReadOnly;
    private bool HasValue => Value is not null && !EqualityComparer<TValue?>.Default.Equals(Value, default);
    private string CssClass => string.Join(' ', new[] { "crest-dropdown", _isOpen ? "crest-dropdown--open" : null, IsDisabled ? "crest-dropdown--disabled" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private Entry? SelectedEntry => _entries.FirstOrDefault(entry => EqualityComparer<TValue?>.Default.Equals(entry.Value, Value));
    private IReadOnlyList<Entry> FilteredEntries => _entries.Where(MatchesFilter).ToArray();

    protected override void OnParametersSet()
    {
        _entries.Clear();
        if (Data is null) return;

        foreach (var item in Data)
        {
            var rawValue = GetPropertyValue(item, ValueProperty) ?? item;
            _entries.Add(new Entry(
                item,
                ConvertValue(rawValue),
                GetPropertyValue(item, LabelProperty)?.ToString() ?? item?.ToString() ?? string.Empty,
                GetPropertyValue(item, DisabledProperty) is true));
        }
    }

    private async Task ToggleAsync()
    {
        if (IsDisabled) return;
        _isOpen = !_isOpen;
        if (_isOpen && AllowFiltering) await FocusFilterAsync();
    }

    private async Task HandleFocusIn()
    {
        _hasFocus = true;
        if (OpenOnFocus && !_isOpen && !IsDisabled)
        {
            _isOpen = true;
            if (AllowFiltering) await FocusFilterAsync();
        }
    }

    private async Task HandleFocusOut()
    {
        _hasFocus = false;
        await Task.Yield();
        if (!_hasFocus) _isOpen = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (IsDisabled) return;
        if (args.Key is "Enter" or " " or "ArrowDown")
        {
            _isOpen = true;
            if (AllowFiltering) await FocusFilterAsync();
        }
        else if (args.Key == "Escape") _isOpen = false;
    }

    private async Task FilterAsync(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString();
        await SearchTextChanged.InvokeAsync(SearchText);
    }

    private async Task SelectOnItemClickAsync(Entry entry)
    {
        if (SelectOnItemClick) await SelectAsync(entry);
    }

    private async Task SelectAsync(Entry entry)
    {
        if (IsDisabled || entry.Disabled) return;
        Value = entry.Value;
        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
        await SelectedItemChanged.InvokeAsync(entry.Item);
        if (ClearSearchAfterSelection)
        {
            SearchText = null;
            await SearchTextChanged.InvokeAsync(null);
        }
        _isOpen = false;
    }

    private async Task ClearAsync()
    {
        Value = default;
        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
        _isOpen = false;
    }

    private bool IsSelected(Entry entry) => EqualityComparer<TValue?>.Default.Equals(entry.Value, Value);
    private CrestDropDownRenderContext<TItem> ToRenderContext(Entry entry, CrestDropDownSurface surface) =>
        new(entry.Item, surface, IsSelected(entry), entry.Label);
    private string GetOptionCssClass(Entry entry) => string.Join(' ', new[] { "crest-dropdown__option", IsSelected(entry) ? "crest-dropdown__option--selected" : null, entry.Disabled ? "crest-dropdown__option--disabled" : null }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private bool MatchesFilter(Entry entry)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        var comparison = FilterCaseSensitivity == CrestDropDownFilterCaseSensitivity.CaseSensitive ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;
        return FilterOperator switch
        {
            CrestDropDownFilterOperator.StartsWith => entry.Label.StartsWith(SearchText, comparison),
            CrestDropDownFilterOperator.EndsWith => entry.Label.EndsWith(SearchText, comparison),
            CrestDropDownFilterOperator.Equals => entry.Label.Equals(SearchText, comparison),
            _ => entry.Label.Contains(SearchText, comparison),
        };
    }

    private async Task FocusFilterAsync()
    {
        await Task.Yield();
        await _filterInput.FocusAsync();
    }

    private static object? GetPropertyValue(object? item, string? property)
    {
        if (item is null || string.IsNullOrWhiteSpace(property)) return item;
        object? current = item;
        foreach (var segment in property.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (current is null) return null;
            current = current.GetType().GetProperty(segment, BindingFlags.Instance | BindingFlags.Public | BindingFlags.IgnoreCase)?.GetValue(current);
        }
        return current;
    }

    private static TValue? ConvertValue(object? raw)
    {
        if (raw is null) return default;
        if (raw is TValue typed) return typed;
        var target = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        if (target.IsEnum) return (TValue)Enum.Parse(target, raw.ToString() ?? string.Empty, true);
        return (TValue?)Convert.ChangeType(raw, target, System.Globalization.CultureInfo.InvariantCulture);
    }
}
