@using Crest.Components.Primitives
@using Crest.Components.Primitives.Spreadsheet
@using Crest.Components.Primitives.Documents.Spreadsheet
@inherits CrestSpreadsheetToolBase

@namespace Crest.Components.Primitives.Spreadsheet.Tools
<CrestSplitButton ButtonAriaLabel=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_MergeCells))) OpenAriaLabel=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_MergeCells))) title=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_MergeCells))) Click=@OnClick Icon="merge_type" Disabled=@IsDisabled Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small">
    <ChildContent>
        <CrestSplitButtonItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_MergeAndCenter)) ?? "Merge && Center") Value="merge-center" />
        <CrestSplitButtonItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_MergeCells)) ?? "Merge Cells") Value="merge" />
        <CrestSplitButtonItem Text=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_UnmergeCells)) ?? "Unmerge Cells") Value="unmerge" />
    </ChildContent>
</CrestSplitButton>

@code {
    protected override SpreadsheetFeature? Feature => SpreadsheetFeature.Merging;

    private async Task OnClick(CrestSplitButtonItem? item)
    {
        if (Worksheet is null || Worksheet.Selection.Cell == CellRef.Invalid || Spreadsheet is null)
        {
            return;
        }

        ICommand command = item?.Value switch
        {
            "merge" => new MergeCellsCommand(Worksheet, Worksheet.Selection.Range),
            "unmerge" => new UnmergeCellsCommand(Worksheet, Worksheet.Selection.Cell),
            _ => new MergeCellsCommand(Worksheet, Worksheet.Selection.Range, center: true),
        };

        await Spreadsheet.ExecuteAsync(command);
    }
}
