@inherits CrestComponent

@namespace Crest.Components.Primitives
<div class="rz-fabmenu" @ref="Element" @onclick:stopPropagation style="@Style">
    <CrestToggleButton Value="@isOpen"
                        ValueChanged="OnToggleChanged"
                        Click="OnFabClick"
                        Icon="@Icon"
                        ToggleIcon="@ToggleIcon"
                        ButtonStyle="@ButtonStyle"
                        ToggleButtonStyle="@ToggleButtonStyle"
                        Size="@Size"
                        Variant="@Variant"
                        Shade="@Shade"
                        ToggleShade="@ToggleShade"
                        Disabled="@Disabled"
                        AriaLabel="@AriaLabel"
                        AriaExpanded="@isOpen.ToString().ToLowerInvariant()"
                        AriaControls="@($"{GetId()}-items")"
                        AriaHasPopup="menu"
                        class="@ButtonClass"
                        style="@ButtonStyleCss">
    </CrestToggleButton>

    @if (isOpen)
    {
        <CrestStack onclick=@CloseAsync Orientation=@StackOrientation AlignItems=@StackAlignment Gap=@Gap class=@GetStackClasses() style=@ComputedItemsStyle ChildContent="@ChildContent" id=@($"{GetId()}-items") role="menu" />
    }
</div> 
