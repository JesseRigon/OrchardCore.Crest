@using Crest.Components.Primitives.Documents.Spreadsheet
@inherits CrestSpreadsheetFormatToggleToolBase

@namespace Crest.Components.Primitives.Spreadsheet.Tools
<CrestToggleButton AriaLabel=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_Italic))) title=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_Italic))) Value=@IsToggled ValueChanged=@OnToggledChangedAsync Icon="format_italic" Disabled=@IsDisabled Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
    ToggleVariant="Variant.Flat" ToggleButtonStyle="ButtonStyle.Primary" ToggleShade="Shade.Lighter" />

@code {
    protected override bool GetValue(Format format) => format.Italic;
    protected override Format WithValue(Format format, bool value) => format.WithItalic(value);
}
