@namespace Crest.Components.Inputs
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components
@using Radzen.Blazor

<RadzenColorPicker Value="@Value"
                   Change="OnChangeAsync"
                   ValueExpression="@ValueExpression"
                   Name="@Name"
                   Disabled="@Disabled"
                   Style="@Style"
                   Class="@CssClass"
                   ShowRGBA="@ShowRgba"
                   ShowHSV="@ShowHsv"
                   ShowColors="@ShowColors"
                   ShowButton="@ShowButton"
                   ButtonText="@ButtonText"
                   HexText="@HexText"
                   RedText="@RedText"
                   GreenText="@GreenText"
                   BlueText="@BlueText"
                   AlphaText="@AlphaText"
                   @attributes="AdditionalAttributes">
    @ChildContent
</RadzenColorPicker>

@code {
    // Centralized defaults for Orchard Crest UI Framework color pickers. When these become
    // tenant/app settings, update this component once and all callers inherit them.
    private const bool DefaultShowRgba = false;
    private const bool DefaultShowHsv = true;
    private const bool DefaultShowColors = true;
    private const bool DefaultShowButton = true;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Style { get; set; } = "width: 100%;";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public bool ShowRgba { get; set; } = DefaultShowRgba;
    [Parameter] public bool ShowHsv { get; set; } = DefaultShowHsv;
    [Parameter] public bool ShowColors { get; set; } = DefaultShowColors;
    [Parameter] public bool ShowButton { get; set; } = DefaultShowButton;

    [Parameter] public string ButtonText { get; set; } = "Apply";
    [Parameter] public string HexText { get; set; } = "Hex";
    [Parameter] public string RedText { get; set; } = "R";
    [Parameter] public string GreenText { get; set; } = "G";
    [Parameter] public string BlueText { get; set; } = "B";
    [Parameter] public string AlphaText { get; set; } = "A";

    private string? CssClass => string.IsNullOrWhiteSpace(Class)
        ? "crest-color-picker"
        : $"crest-color-picker {Class}";

    private async Task OnChangeAsync(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
