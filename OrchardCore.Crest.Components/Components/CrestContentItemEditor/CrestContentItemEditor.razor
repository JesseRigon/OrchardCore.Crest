@namespace Crest.Components.Model
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Crest.Components.Forms
@using Crest.Components.Models
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject HttpClient Http

<CrestCard class="crest-content-item-editor">
    <CrestStack Gap="1rem">
        <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <div>
                <CrestText TextStyle="TextStyle.H6" class="rz-m-0">@EditorTitle</CrestText>
                @if (Model?.ContentItem is not null)
                {
                    <CrestText TextStyle="TextStyle.Caption" class="rz-color-secondary">@Model.ContentItem.ContentType · @Model.ContentItem.ContentItemId</CrestText>
                }
            </div>
            <CrestStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                <CrestButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Click="LoadAsync" Disabled="IsBusy" title="Reload" />
                @if (ShowClose)
                {
                    <CrestButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Click="CloseAsync" title="Close" />
                }
            </CrestStack>
        </CrestStack>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <CrestAlert AlertStyle="AlertStyle.Danger" Summary="Content item action failed" Detail="@Error" />
        }

        @if (IsLoading)
        {
            <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Model?.ContentItem is null)
        {
            <CrestText TextStyle="TextStyle.Body2" class="rz-color-secondary">Select a content item to edit.</CrestText>
        }
        else
        {
            <CrestStack Gap="0.75rem">
                <CrestFormField Text="Display text" Style="width: 100%;">
                    <CrestTextBox @bind-Value="DisplayText" Style="width: 100%;" Disabled="IsSaving" />
                </CrestFormField>

                <CrestFormManager @ref="FormManager" Content="EditableContent" Metadata="Model.ContentItem.Metadata" Disabled="IsSaving" />

                <CrestFieldset Text="Advanced JSON preview" AllowCollapse="true" Collapsed="true">
                    <CrestTextArea Value="@ContentJson" Rows="12" Style="width: 100%; font-family: monospace;" ReadOnly="true" />
                </CrestFieldset>

                @if (ConfirmDelete)
                {
                    <CrestAlert AlertStyle="AlertStyle.Warning" Summary="Confirm delete" Detail="This removes the content item from latest/published listings. Click Delete again to confirm." />
                }

                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                    <CrestButton Icon="save" Text="Save draft" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" Disabled="IsSaving" />
                    <CrestButton Icon="publish" Text="Publish" ButtonStyle="ButtonStyle.Secondary" Click="PublishAsync" Disabled="IsSaving" />
                    <CrestButton Icon="content_copy" Text="Duplicate" ButtonStyle="ButtonStyle.Light" Click="DuplicateAsync" Disabled="IsSaving" />
                    <CrestButton Icon="delete" Text="Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="DeleteAsync" Disabled="IsSaving" />
                </CrestStack>
            </CrestStack>
        }
    </CrestStack>
</CrestCard>

@code {
    [Parameter] public string? ContentItemId { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<CrestModel> Saved { get; set; }
    [Parameter] public EventCallback<CrestModel> Duplicated { get; set; }
    [Parameter] public EventCallback<string> Deleted { get; set; }

    private CrestModel? Model { get; set; }
    private string? DisplayText { get; set; }
    private JsonNode? EditableContent { get; set; }
    private string ContentJson => EditableContent?.ToJsonString(new JsonSerializerOptions { WriteIndented = true }) ?? string.Empty;
    private string? LoadedContentItemId { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool ConfirmDelete { get; set; }
    private string? Error { get; set; }
    private CrestAntiforgeryToken? Token { get; set; }
    private CrestFormManager? FormManager { get; set; }

    private bool IsBusy => IsLoading || IsSaving;

    private string EditorTitle => !string.IsNullOrWhiteSpace(Title)
        ? Title!
        : Model?.ContentItem?.DisplayText ?? "Edit content item";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(LoadedContentItemId, ContentItemId, StringComparison.Ordinal))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        LoadedContentItemId = ContentItemId;
        Model = null;
        DisplayText = null;
        EditableContent = null;
        ConfirmDelete = false;
        Error = null;

        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        IsLoading = true;
        try
        {
            Model = await Http.GetFromJsonAsync<CrestModel>($"api/crest/model/content-items/{Uri.EscapeDataString(ContentItemId)}?latest=true");
            DisplayText = Model?.ContentItem?.DisplayText;
            EditableContent = Model?.ContentItem?.Content?.DeepClone();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveAsync() => await SaveAsync(publish: false);

    private async Task PublishAsync() => await SaveAsync(publish: true);

    private async Task SaveAsync(bool publish)
    {
        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        if (FormManager?.Validate() == false)
        {
            return;
        }

        var saved = await SendJsonAsync<CrestModel>(HttpMethod.Put, $"api/crest/model/content-items/{Uri.EscapeDataString(ContentItemId)}", new UpdateCrestContentItemRequest(DisplayText, EditableContent?.DeepClone(), publish));
        if (saved is not null)
        {
            Model = saved;
            DisplayText = saved.ContentItem?.DisplayText;
            EditableContent = saved.ContentItem?.Content?.DeepClone();
            await Saved.InvokeAsync(saved);
        }
    }

    private async Task DuplicateAsync()
    {
        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        var duplicate = await SendJsonAsync<CrestModel>(HttpMethod.Post, $"api/crest/model/content-items/{Uri.EscapeDataString(ContentItemId)}/duplicate", null);
        if (duplicate is not null)
        {
            await Duplicated.InvokeAsync(duplicate);
        }
    }

    private async Task DeleteAsync()
    {
        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        if (!ConfirmDelete)
        {
            ConfirmDelete = true;
            return;
        }

        using var response = await SendAsync(HttpMethod.Delete, $"api/crest/model/content-items/{Uri.EscapeDataString(ContentItemId)}", null);
        if (response.IsSuccessStatusCode)
        {
            var deletedId = ContentItemId;
            Model = null;
            LoadedContentItemId = null;
            ConfirmDelete = false;
            await Deleted.InvokeAsync(deletedId);
        }
    }

    private async Task CloseAsync() => await Closed.InvokeAsync();

    private async Task<T?> SendJsonAsync<T>(HttpMethod method, string url, object? body)
    {
        using var response = await SendAsync(method, url, body);
        return response.IsSuccessStatusCode
            ? await response.Content.ReadFromJsonAsync<T>()
            : default;
    }

    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string url, object? body)
    {
        IsSaving = true;
        Error = null;

        try
        {
            var request = new HttpRequestMessage(method, url);
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

            if (body is not null)
            {
                request.Content = JsonContent.Create(body);
            }

            var token = await GetAntiforgeryTokenAsync();
            request.Headers.Remove(token.HeaderName);
            request.Headers.TryAddWithoutValidation(token.HeaderName, token.RequestToken);

            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                Error = await response.Content.ReadAsStringAsync();
            }

            return response;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            throw;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task<CrestAntiforgeryToken> GetAntiforgeryTokenAsync()
    {
        if (Token is not null && !string.IsNullOrWhiteSpace(Token.RequestToken))
        {
            return Token;
        }

        Token = await Http.GetFromJsonAsync<CrestAntiforgeryToken>("api/crest/antiforgery/token")
            ?? new CrestAntiforgeryToken("RequestVerificationToken", string.Empty);

        return Token;
    }
}
