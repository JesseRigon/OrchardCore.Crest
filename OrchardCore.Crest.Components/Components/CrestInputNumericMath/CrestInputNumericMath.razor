@namespace Crest.Components.Inputs
@using System.Globalization
@using Crest.Components.Primitives

<CrestTextBox Value="@TextValue"
               Change="@OnTextChanged"
               Disabled="@Disabled"
               Placeholder="@Placeholder"
               Style="@Style"
               class="@CssClass" />

@code {
    [Parameter]
    public decimal Value { get; set; }

    [Parameter]
    public EventCallback<decimal> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string TextValue { get; set; } = string.Empty;
    private decimal LastValue { get; set; }

    private string CssClass => string.Join(' ', new[] { "crest-input-numeric-math", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override void OnParametersSet()
    {
        if (TextValue.Length == 0 || Value != LastValue)
        {
            LastValue = Value;
            TextValue = Format(Value);
        }
    }

    private async Task OnTextChanged(string? value)
    {
        TextValue = value ?? string.Empty;
        if (!NumericMathEvaluator.TryEvaluate(TextValue, out var result))
        {
            return;
        }

        LastValue = result;
        TextValue = Format(result);
        await ValueChanged.InvokeAsync(result);
    }

    private static string Format(decimal value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private sealed class NumericMathEvaluator
    {
        private readonly string _text;
        private int _position;

        private NumericMathEvaluator(string text)
        {
            _text = text;
        }

        public static bool TryEvaluate(string text, out decimal value)
        {
            value = 0;
            try
            {
                var parser = new NumericMathEvaluator(text);
                value = parser.ParseExpression();
                parser.SkipWhitespace();
                return parser._position == parser._text.Length;
            }
            catch
            {
                return false;
            }
        }

        private decimal ParseExpression()
        {
            var value = ParseTerm();
            while (true)
            {
                SkipWhitespace();
                if (Match('+'))
                {
                    value += ParseTerm();
                }
                else if (Match('-'))
                {
                    value -= ParseTerm();
                }
                else
                {
                    return value;
                }
            }
        }

        private decimal ParseTerm()
        {
            var value = ParseFactor();
            while (true)
            {
                SkipWhitespace();
                if (Match('*'))
                {
                    value *= ParseFactor();
                }
                else if (Match('/'))
                {
                    var divisor = ParseFactor();
                    if (divisor == 0)
                    {
                        throw new DivideByZeroException();
                    }

                    value /= divisor;
                }
                else
                {
                    return value;
                }
            }
        }

        private decimal ParseFactor()
        {
            SkipWhitespace();
            if (Match('+'))
            {
                return ParseFactor();
            }

            if (Match('-'))
            {
                return -ParseFactor();
            }

            if (Match('('))
            {
                var value = ParseExpression();
                SkipWhitespace();
                if (!Match(')'))
                {
                    throw new FormatException();
                }

                return value;
            }

            return ParseNumber();
        }

        private decimal ParseNumber()
        {
            SkipWhitespace();
            var start = _position;
            while (_position < _text.Length && (char.IsDigit(_text[_position]) || _text[_position] == '.'))
            {
                _position++;
            }

            if (start == _position)
            {
                throw new FormatException();
            }

            return decimal.Parse(_text[start.._position], NumberStyles.Number, CultureInfo.InvariantCulture);
        }

        private void SkipWhitespace()
        {
            while (_position < _text.Length && char.IsWhiteSpace(_text[_position]))
            {
                _position++;
            }
        }

        private bool Match(char value)
        {
            if (_position >= _text.Length || _text[_position] != value)
            {
                return false;
            }

            _position++;
            return true;
        }
    }
}
