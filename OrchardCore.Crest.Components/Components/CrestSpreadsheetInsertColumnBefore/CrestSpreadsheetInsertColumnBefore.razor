@using Crest.Components.Primitives.Spreadsheet
@using Crest.Components.Primitives.Documents.Spreadsheet
@inherits CrestSpreadsheetToolBase
@namespace Crest.Components.Primitives.Spreadsheet.Tools
<CrestButton aria-label=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_InsertColumnBefore))) Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click=@OnInsertColumnBeforeClick Icon="add_column_left" ButtonType="ButtonType.Button" Disabled=@IsDisabled
    title=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_InsertColumnBefore)) ?? "Insert Column Before") />
@code {
    protected override SpreadsheetFeature? Feature => SpreadsheetFeature.Editing;

    private async Task OnInsertColumnBeforeClick()
    {
        if (Worksheet is null || Spreadsheet is null)
        {
            return;
        }
        await Spreadsheet.ExecuteAsync(new InsertColumnCommand(Worksheet, Worksheet.Selection.Range.Start.Column));
    }
}
