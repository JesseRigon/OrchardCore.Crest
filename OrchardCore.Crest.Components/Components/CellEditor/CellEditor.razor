@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Crest.Components.Primitives.Spreadsheet
@using Crest.Components.Primitives.Documents.Spreadsheet
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

@namespace Crest.Components.Primitives.Spreadsheet
@{
#pragma warning disable IL2111
}

@if (Editor.Mode != EditMode.None)
{
<div class=@className style=@cellStyle>
    @if (customEditorType is not null)
    {
        <DynamicComponent Type=@customEditorType Parameters=@GetEditorParameters() />
    }
    else
    {
        <SheetEditor @bind-Value=@Editor.Value AutoFocus=@(Editor.Mode == EditMode.Cell) Blur=@(this.AsNonRenderingEventHandler(OnBlurAsync))
            Worksheet=@Worksheet Focus=@(this.AsNonRenderingEventHandler(OnFocus)) style=@editorStyle
            InputAttributes=@(new Dictionary<string, object> { { "aria-label", Spreadsheet.Localize(nameof(CrestStrings.Spreadsheet_CellEditorLabel)) } }) />
    }
</div>
}
