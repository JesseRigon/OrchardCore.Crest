@using System.Linq
@using Microsoft.AspNetCore.Components.Forms
@using Crest.Components.Primitives
@inherits FormComponent<string>
@namespace Crest.Components.Primitives
@if (Visible)
{
    <div @ref="@Element" style=@Style @attributes="Attributes" class="@GetCssClass()" id="@GetId()" role="group" aria-label="@AriaLabel">
        <div class="rz-helper-hidden-accessible">
            <input disabled="@Disabled" type="hidden" name="@Name">
        </div>
        <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="@Gap" class="rz-security-code-wrapper">
            @foreach (var index in Enumerable.Range(1, Count))
            {
                @if (Type == SecurityCodeType.Password)
                {
                    <CrestPassword Value="@ElementAt(index - 1)" Disabled="@Disabled" autocomplete="one-time-code" MaxLength="1" size="1" class="rz-security-code-input" aria-label="@GetInputAriaLabel(index)" />
                }
                else if (Type == SecurityCodeType.Numeric)
                {
                    <CrestTextBox inputmode="numeric" pattern="[0-9]*" Value="@ElementAt(index - 1)" Disabled="@Disabled" autocomplete="one-time-code" MaxLength="1" size="1" class="rz-security-code-input" aria-label="@GetInputAriaLabel(index)" />
                }
                else
                {
                    <CrestTextBox Value="@ElementAt(index - 1)" Disabled="@Disabled" autocomplete="one-time-code" MaxLength="1" size="1" class="rz-security-code-input" aria-label="@GetInputAriaLabel(index)" />
                }
            }
        </CrestStack>
    </div>
}
