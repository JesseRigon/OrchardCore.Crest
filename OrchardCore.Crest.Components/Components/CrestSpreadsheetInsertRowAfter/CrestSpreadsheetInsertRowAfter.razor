@using Crest.Components.Primitives.Spreadsheet
@using Crest.Components.Primitives.Documents.Spreadsheet
@inherits CrestSpreadsheetToolBase
@namespace Crest.Components.Primitives.Spreadsheet.Tools
<CrestButton aria-label=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_InsertRowBelow))) Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click=@OnInsertRowAfterClick Icon="add_row_below" ButtonType="ButtonType.Button" Disabled=@IsDisabled
    title=@(Spreadsheet?.Localize(nameof(CrestStrings.Spreadsheet_InsertRowBelow)) ?? "Insert Row Below") />
@code {
    protected override SpreadsheetFeature? Feature => SpreadsheetFeature.Editing;

    private async Task OnInsertRowAfterClick()
    {
        if (Worksheet is null || Spreadsheet is null)
        {
            return;
        }

        await Spreadsheet.ExecuteAsync(new InsertRowCommand(Worksheet, Worksheet.Selection.Range.End.Row + 1));
    }
}
