@using Crest.Components.Primitives
@using System.Globalization;
@using Microsoft.JSInterop
@inherits CrestComponent

@typeparam TItem
@implements IScheduler

@namespace Crest.Components.Primitives
@if (Visible)
{
    <CascadingValue Value="@this">
        @ChildContent
    </CascadingValue>
    <div @ref=Element style=@Style @attributes=@Attributes class=@GetCssClass() id=@GetId()>
        @if (ShowHeader)
        {
            <div class="rz-scheduler-nav">
                @if (ShowNavigationButtons || ShowTodayButton)
                {
                    <div class="rz-scheduler-nav-prev-next">
                        @if (ShowNavigationButtons)
                        {
                            <button type="button" tabindex="0" class="rz-button rz-prev" @onclick=@OnPrev title="@PrevText"
                                    aria-label="@PrevText">
                                <CrestIcon IconKey="iconify.mdi/current/default/chevron-left" />
                            </button>
                            <button type="button" tabindex="0" class="rz-button rz-next" @onclick=@OnNext title="@NextText"
                                    aria-label="@NextText">
                                <CrestIcon IconKey="iconify.mdi/current/default/chevron-right" />
                            </button>
                        }
                        @if (ShowTodayButton)
                        {
                            <button type="button" tabindex="0" class="rz-button rz-today" @onclick=@OnToday title="@TodayText"
                                    aria-label="@TodayText">@TodayText</button>
                        }
                    </div>
                }
                @if (ShowDateTitle)
                {
                    <div class="rz-scheduler-nav-title" aria-live="polite">@SelectedView?.Title</div>
                }
                <div class="rz-scheduler-nav-views">
                    @if (NavigationTemplate != null)
                    {
                        @NavigationTemplate
                    }
                    else
                    {
                        @foreach (var view in Views)
                        {
                            <CrestButton Click=@(args => OnChangeView(view)) Icon=@view.Icon Text=@view.Text
                                         aria-pressed="@(IsSelected(view) ? "true" : "false")"
                                         class="@($"{(IsSelected(view) ? " rz-state-active" : "")}")" />
                        }
                    }
                </div>
            </div>
        }
        @SelectedView?.Render()
    </div>
}
