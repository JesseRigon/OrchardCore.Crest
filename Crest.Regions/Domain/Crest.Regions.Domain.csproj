<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Crest.Regions.Domain</AssemblyName>
    <RootNamespace>Crest.Regions</RootNamespace>
  </PropertyGroup>
  <!-- Server-free: the addressing-map shape and the validation rules over it, shared by
