<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Crest.Regions</AssemblyName>
    <RootNamespace>Crest.Regions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;blazor-wasm/**/*.cs;Domain/**/*.cs" />
  </ItemGroup>

  <!-- Business Contexts, the geo tree and per-country addressing maps
       (plans/regions-and-locations.md). Geo standard data lives in the global store
       (Crest.Global); this module declares its schema and the tenant overlay. -->
  <ItemGroup>
    <PackageReference Include="OrchardCore.ContentFields" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.Contents" />
    <PackageReference Include="OrchardCore.Data" />
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="YesSql.Abstractions" />
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OrchardCore.Crest.Server/OrchardCore.Crest.csproj" />
    <ProjectReference Include="../Crest.Global/Crest.Global.csproj" />
    <ProjectReference Include="Domain/Crest.Regions.Domain.csproj" />
  </ItemGroup>

</Project>
