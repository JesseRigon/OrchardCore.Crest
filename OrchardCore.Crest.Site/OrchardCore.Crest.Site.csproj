<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OrchardCoreCompatibilityVersion>3.0.0</OrchardCoreCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(OrchardCoreCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(OrchardCoreCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(OrchardCoreCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\node_modules\**" />
    <EmbeddedResource Remove="wwwroot\node_modules\**" />
    <None Remove="wwwroot\node_modules\**" />
    <Compile Remove="tests\**\*.cs" />
    <!-- wasm\ is a sibling project (OrchardCore.Crest.Site.Client), not part of this
         one - without this, the SDK's default **/*.cs glob also sweeps in its
         generated obj\ output (duplicate AssemblyInfo/TargetFramework attributes,
         CS0579) and its own .razor/.cs sources. -->
    <Compile Remove="wasm\**\*.cs" />
    <Content Remove="wasm\**" />
    <EmbeddedResource Remove="wasm\**" />
    <None Remove="wasm\**" />
    <RazorGenerate Remove="wasm\**" />
    <RazorComponent Remove="wasm\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.ResourceManagement" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Users.Abstractions" />
    <PackageReference Include="OrchardCore.Users" />
    <PackageReference Include="OrchardCore.Menu" />
    <PackageReference Include="OrchardCore.Email.Abstractions" />
    <PackageReference Include="OrchardCore.Setup.Abstractions" />
    <PackageReference Include="OrchardCore.Setup" />
  </ItemGroup>

  <!-- Crest.Server is the single Blazor Web App host (API + SSR) for every Crest theme -
       it, not this project, calls AddRazorComponents()/AddInteractiveWebAssemblyComponents()
       and owns the App.razor/Routes.razor roots (see plans/blazor hybrid conversion.md).
       This project keeps its own page/layout components (Phase 5) and references
       Components/Icons to build them, plus its WASM half
       (wasm/OrchardCore.Crest.Site.Client.csproj) for @rendermode
       InteractiveWebAssembly/InteractiveAuto components - it just doesn't self-host. -->
  <ItemGroup>
    <ProjectReference Include="..\OrchardCore.Crest.Components\OrchardCore.Crest.Components.csproj" />
    <ProjectReference Include="..\OrchardCore.Crest.Icons\OrchardCore.Crest.Icons.csproj" />
    <ProjectReference Include="wasm\OrchardCore.Crest.Site.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="**\*.less;**\*.scss;" />
    <EmbeddedResource Remove="wwwroot\about.html" />
    <EmbeddedResource Remove="wwwroot\contact.html" />
    <EmbeddedResource Remove="wwwroot\gulpfile.js" />
    <EmbeddedResource Remove="wwwroot\index.html" />
    <EmbeddedResource Remove="wwwroot\package-lock.json" />
    <EmbeddedResource Remove="wwwroot\package.json" />
    <EmbeddedResource Remove="wwwroot\post.html" />
  </ItemGroup>

</Project>
