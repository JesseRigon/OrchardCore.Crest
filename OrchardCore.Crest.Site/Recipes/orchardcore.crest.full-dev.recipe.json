{
  "name": "OrchardCore.CrestFullDev",
  "displayName": "Orchard Crest - Full Dev Features",
  "description": "Enables the broad local Orchard/Crest feature set for deep development and testing. External provider features may still require their own runtime configuration.",
  "author": "Orchard Crest UI Framework",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": false,
  "categories": [
    "Crest",
