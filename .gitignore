# Orchard tenant/runtime data
App_Data/
appsettings.Development.json

# OrchardCore.Application.Cms.Targets' CopyPackageTranslationFiles build target copies
# translation .po files into a project-local "Localization/" folder on every build -
# regenerated content, not source. Only OrchardCore.Crest.Workflows.Web.BlazorServer
# references that package/SDK in this submodule, so scoped to just its directory (not a
# bare "Localization/" pattern) - every other Localization/ folder here (e.g.
# OrchardCore.Crest.Server/Localization/, OrchardCore.Crest.Site/Localization/) is
# genuine hand-authored .po source content and must stay tracked.
OrchardCore.Crest.Workflows/src/apps/OrchardCore.Crest.Workflows.Web.BlazorServer/Localization/

# Local databases
*.sqlite
*.sqlite3
*.db

# Playwright screenshot-diff output — base/ is the committed reference set,
# new/ is wiped and regenerated on every test run.
tests/playwright/output/new/
