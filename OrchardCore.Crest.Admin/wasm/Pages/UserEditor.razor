@page "/Admin/Users/Create"
@page "/Admin/Users/Edit/{Id}"
@using Crest.Admin.Api
@using Radzen
@using Radzen.Blazor
@inject IApi Api
@inject NavigationManager Navigation

<RadzenStack Gap="1rem" data-testid="user-editor-page">
    <RadzenText TextStyle="TextStyle.H4" Text="@(IsNew ? "Add User" : "Edit User")" />
    @if (Model is null) { <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" /> }
    else
    {
        <RadzenLabel Text="Username" Component="username" /><RadzenTextBox Name="username" @bind-Value="Model.UserName" Style="width:100%" />
        <RadzenLabel Text="Email" Component="email" /><RadzenTextBox Name="email" @bind-Value="Model.Email" Style="width:100%" />
        <RadzenLabel Text="Phone number" Component="phone" /><RadzenTextBox Name="phone" @bind-Value="Model.PhoneNumber" Style="width:100%" />
        <RadzenLabel Text="@(IsNew ? "Password" : "New password (leave blank to retain)")" Component="password" /><RadzenPassword Name="password" @bind-Value="Model.Password" Style="width:100%" />
        <RadzenCheckBox @bind-Value="Model.EmailConfirmed" Name="email-confirmed" /><label for="email-confirmed"> Email confirmed</label><br />
        <RadzenCheckBox @bind-Value="Model.IsEnabled" Name="user-enabled" /><label for="user-enabled"> Enabled</label>
        <RadzenLabel Text="Roles (comma-separated)" Component="roles" /><RadzenTextBox Name="roles" @bind-Value="Roles" Style="width:100%" />
        <RadzenStack Orientation="Orientation.Horizontal"><RadzenButton Text="Save" Icon="save" Click="SaveAsync" /><RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel" /></RadzenStack>
        @if (!string.IsNullOrWhiteSpace(Error)) { <RadzenText Style="color: var(--rz-danger)">@Error</RadzenText> }
    }
</RadzenStack>

@code {
    [Parameter] public string? Id { get; set; }
    private bool IsNew => string.IsNullOrWhiteSpace(Id);
    private CrestUserWrite? Model;
    private string? Roles;
    private string? Error;
    protected override async Task OnParametersSetAsync()
    {
        if (IsNew) { Model = new CrestUserWrite(null, null, null, false, true, [], null); return; }
        var user = await Api.Crest.Rest.Users.GetAsync(Id!);
        Model = user is null ? null : new CrestUserWrite(user.UserName, user.Email, user.PhoneNumber, user.EmailConfirmed, user.IsEnabled, user.Roles, null);
        Roles = user is null ? null : string.Join(", ", user.Roles);
    }
    private async Task SaveAsync()
    {
        if (Model is null) return;
        Error = null;
        Model.Roles = (Roles ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var saved = IsNew ? await Api.Crest.Rest.Users.CreateAsync(Model) : await Api.Crest.Rest.Users.SaveAsync(Id!, Model);
        if (saved is null) { Error = "The user could not be saved. Check the supplied values."; return; }
        Navigation.NavigateTo("/Admin/Users/Index");
    }
    private void Cancel() => Navigation.NavigateTo("/Admin/Users/Index");
}
