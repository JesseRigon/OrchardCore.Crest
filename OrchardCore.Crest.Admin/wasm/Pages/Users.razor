@page "/Users/Index"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="users-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <CrestText TextStyle="TextStyle.H4" Text="@T["Users"]" />
        <CrestButton Text="@T["Add User"]" Icon="person_add" Click="NavigateCreate" />
    </CrestStack>
    <CrestStack Orientation="Orientation.Horizontal" Gap=".5rem">
        <CrestTextBox @bind-Value="Search" Placeholder="@T["Search users"]" Style="width: 20rem" />
        <CrestDropDown @bind-Value="Status" Data="Statuses" TextProperty="Text" ValueProperty="Value" Style="width: 10rem" />
        <CrestButton Text="@T["Filter"]" Click="LoadAsync" />
    </CrestStack>
    @if (List is null) { <CrestProgressBar Mode="ProgressBarMode.Indeterminate" /> }
    else
    {
        <CrestText TextStyle="TextStyle.Body2" Text="@T["{0} users", List.Total]" />
        <CrestDataGrid Data="List.Items" TItem="CrestUser" AllowPaging="true" PageSize="50">
            <Columns>
                <CrestDataGridColumn TItem="CrestUser" Property="UserName" Title="@T["User Name"]" />
                <CrestDataGridColumn TItem="CrestUser" Property="Email" Title="@T["Email"]" />
                <CrestDataGridColumn TItem="CrestUser" Title="@T["Roles"]"><Template Context="user">@string.Join(", ", user.Roles)</Template></CrestDataGridColumn>
                <CrestDataGridColumn TItem="CrestUser" Title="@T["Status"]"><Template Context="user">@(user.IsEnabled ? T["Enabled"] : T["Disabled"])</Template></CrestDataGridColumn>
                <CrestDataGridColumn TItem="CrestUser" Title="@T["Actions"]"><Template Context="user"><CrestButton ButtonStyle="ButtonStyle.Light" Icon="edit" Click="@(()=>Edit(user.Id))" /><CrestButton ButtonStyle="ButtonStyle.Light" Icon="@(user.IsEnabled ? "block" : "check_circle")" Click="@(()=>ToggleAsync(user))" /><CrestButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="@(()=>DeleteAsync(user))" /></Template></CrestDataGridColumn>
            </Columns>
        </CrestDataGrid>
    }
</CrestStack>

@code {
    private CrestUserList? List;
    private string? Search;
    private string? Status;
    private object[] Statuses => [new { Text = T["All Users"], Value = "" }, new { Text = T["Enabled Users"], Value = "enabled" }, new { Text = T["Disabled Users"], Value = "disabled" }];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() => List = await Api.Crest.Rest.Users.ListAsync(Search, Status);
    private void NavigateCreate() => Navigation.NavigateTo("Users/Create");
    private void Edit(string id) => Navigation.NavigateTo($"Users/Edit/{Uri.EscapeDataString(id)}");
    private async Task ToggleAsync(CrestUser user) { await Api.Crest.Rest.Users.SetEnabledAsync(user.Id, !user.IsEnabled); await LoadAsync(); }
    private async Task DeleteAsync(CrestUser user) { await Api.Crest.Rest.Users.DeleteAsync(user.Id); await LoadAsync(); }
}
