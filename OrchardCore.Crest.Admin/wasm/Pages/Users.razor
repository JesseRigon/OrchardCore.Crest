@page "/Admin/Users/Index"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation

<CrestStack Gap="1rem" data-testid="users-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <CrestText TextStyle="TextStyle.H4" Text="Users" />
        <CrestButton Text="Add User" Icon="person_add" Click="NavigateCreate" />
    </CrestStack>
    <CrestStack Orientation="Orientation.Horizontal" Gap=".5rem">
        <CrestTextBox @bind-Value="Search" Placeholder="Search users" Style="width: 20rem" />
        <CrestDropDown @bind-Value="Status" Data="Statuses" TextProperty="Text" ValueProperty="Value" Style="width: 10rem" />
        <CrestButton Text="Filter" Click="LoadAsync" />
    </CrestStack>
    @if (List is null) { <CrestProgressBar Mode="ProgressBarMode.Indeterminate" /> }
    else
    {
        <CrestText TextStyle="TextStyle.Body2" Text="@($"{List.Total} users")" />
        <CrestDataGrid Data="List.Items" TItem="CrestUser" AllowPaging="true" PageSize="50">
            <Columns>
                <CrestDataGridColumn TItem="CrestUser" Property="UserName" Title="Username" />
                <CrestDataGridColumn TItem="CrestUser" Property="Email" Title="Email" />
                <CrestDataGridColumn TItem="CrestUser" Title="Roles"><Template Context="user">@string.Join(", ", user.Roles)</Template></CrestDataGridColumn>
                <CrestDataGridColumn TItem="CrestUser" Title="Status"><Template Context="user">@(user.IsEnabled ? "Enabled" : "Disabled")</Template></CrestDataGridColumn>
                <CrestDataGridColumn TItem="CrestUser" Title="Actions"><Template Context="user"><CrestButton ButtonStyle="ButtonStyle.Light" Icon="edit" Click="@(()=>Edit(user.Id))" /><CrestButton ButtonStyle="ButtonStyle.Light" Icon="@(user.IsEnabled ? "block" : "check_circle")" Click="@(()=>ToggleAsync(user))" /><CrestButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="@(()=>DeleteAsync(user))" /></Template></CrestDataGridColumn>
            </Columns>
        </CrestDataGrid>
    }
</CrestStack>

@code {
    private CrestUserList? List;
    private string? Search;
    private string? Status;
    private readonly object[] Statuses = [new { Text = "All users", Value = "" }, new { Text = "Enabled users", Value = "enabled" }, new { Text = "Disabled users", Value = "disabled" }];
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() => List = await Api.Crest.Rest.Users.ListAsync(Search, Status);
    private void NavigateCreate() => Navigation.NavigateTo("/Admin/Users/Create");
    private void Edit(string id) => Navigation.NavigateTo($"/Admin/Users/Edit/{Uri.EscapeDataString(id)}");
    private async Task ToggleAsync(CrestUser user) { await Api.Crest.Rest.Users.SetEnabledAsync(user.Id, !user.IsEnabled); await LoadAsync(); }
    private async Task DeleteAsync(CrestUser user) { await Api.Crest.Rest.Users.DeleteAsync(user.Id); await LoadAsync(); }
}
