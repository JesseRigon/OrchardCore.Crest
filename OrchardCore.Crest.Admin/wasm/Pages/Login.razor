@page "/login"
@using Crest.Admin.DisplayManagement
@using Crest.Admin.Options
@using Microsoft.AspNetCore.Components
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject DisplayManager DisplayManager
@inject CrestRoutingOptions Routing
@inject NavigationManager Navigation
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" Style="padding: 2rem;">
    <CrestText TextStyle="TextStyle.H3" Text="OrchardCore.Crest" />

    @if (DisplayManager.IsAuthenticated)
    {
        <CrestText Text="@string.Format(T.T("Login_SignedInAsFormat", "Signed in as {0}"), DisplayManager.User.UserName)" />
        <CrestButton Text="@T.T("Login_Logout", "Logout")" Click="LogoutAsync" Disabled="@DisplayManager.IsBusy" />
    }
    else
    {
        <CrestTemplateForm TItem="LoginForm" Data="@_login" Submit="@((LoginForm form) => LoginAsync(form))">
            <CrestStack Gap="0.75rem" Style="max-width: 22rem;">
                <CrestTextBox Name="UserName" @bind-Value="_login.UserName" Placeholder="@T.T("Login_UsernamePlaceholder", "Username or email")" />
                <CrestPassword Name="Password" @bind-Value="_login.Password" Placeholder="@T.T("Login_PasswordPlaceholder", "Password")" />
                <CrestCheckBox @bind-Value="_login.RememberMe" />
                <CrestButton ButtonType="ButtonType.Submit" Text="@T.T("Login_Submit", "Login")" Disabled="@DisplayManager.IsBusy" />
                @if (DisplayManager.ErrorMessage is not null)
                {
                    <CrestText TextStyle="TextStyle.Caption" Text="@DisplayManager.ErrorMessage" />
                }
            </CrestStack>
        </CrestTemplateForm>
    }
</CrestStack>

@code {
    private LoginForm _login = new();

    [SupplyParameterFromQuery(Name = "switchUser")]
    public bool SwitchUser { get; set; }

    [SupplyParameterFromQuery(Name = "userName")]
    public string? UserName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await DisplayManager.EnsureInitializedAsync();
        if (!string.IsNullOrWhiteSpace(UserName))
        {
            _login.UserName = UserName;
        }

        // Static SSR prerender: paint the form (or signed-in state) and stop - the
        // redirect/logout policy below belongs to the interactive phase, which re-runs
        // this init with the browser in the loop (see Home.razor for the same pattern).
        // LogoutAsync in particular is a cookie mutation: server-side it would POST over
        // the forwarded-cookie loopback client, whose Set-Cookie response never reaches
        // the browser, so the user would not actually be signed out - only the
        // browser-issued interactive request can clear the Orchard auth cookie.
        // EnsureInitializedAsync above still runs during prerender (it is
        // prerender-safe) so the form's culture/theme state renders correctly.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (DisplayManager.IsAuthenticated && SwitchUser)
        {
            await DisplayManager.LogoutAsync();
        }
        else if (DisplayManager.IsAuthenticated)
        {
            // Crossing from the login shell (base href = LoginPath) to the admin
            // shell (base href = AdminPath) requires a full reload so the browser
            // re-fetches index.html with the correct <base> tag - see
            // BlazorAdminThemeMiddleware's TryServeIndexHtmlAsync.
            Navigation.NavigateTo(Routing.AdminPath, forceLoad: true);
        }
    }

    private async Task LoginAsync(LoginForm form)
    {
        if (await DisplayManager.LoginAsync(form.UserName, form.Password, form.RememberMe))
        {
            Navigation.NavigateTo(Routing.AdminPath, forceLoad: true);
        }
    }

    private async Task LogoutAsync()
    {
        await DisplayManager.LogoutAsync();
        Navigation.NavigateTo(Routing.LoginPath);
    }

    private sealed class LoginForm
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }
}
