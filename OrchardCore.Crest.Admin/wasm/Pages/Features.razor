@page "/Features"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="features-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T.T("Features_Heading", "Features")" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T.T("Features_Description", "Enable and disable Orchard features for this tenant.")" />
        </CrestStack>
        <CrestButton Text="@T.T("Features_Refresh", "Refresh")" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" />
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    <CrestCard>
        <CrestStack Gap="0.85rem">
            <CrestRow Gap="0.75rem">
                <CrestColumn Size="12" SizeMD="6">
                    <CrestTextBox @bind-Value="SearchText" Placeholder="@T.T("Features_SearchPlaceholder", "Search name, ID, category, description, or dependency...")" Style="width: 100%;" data-testid="features-search" />
                </CrestColumn>
                <CrestColumn Size="12" SizeMD="3">
                    <CrestDropDown @bind-Value="StatusFilter" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" data-testid="features-status-filter" />
                </CrestColumn>
                <CrestColumn Size="12" SizeMD="3">
                    <CrestCheckBox @bind-Value="HideAlwaysEnabled" TValue="bool" />
                    <CrestLabel Text="@T.T("Features_HideAlwaysEnabled", "Hide always enabled")" Style="margin-left: 0.45rem;" />
                </CrestColumn>
            </CrestRow>

            <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <CrestText Text="@T.T("Features_BulkActions", "Bulk actions")" TextStyle="TextStyle.Subtitle2" />
                <CrestButton Text="@T.T("Features_Enable", "Enable")" Icon="check_circle" Size="ButtonSize.Small" Click="@(() => ApplyBulkAsync(BulkAction.Enable))" Disabled="@(!CanApplyBulk)" />
                <CrestButton Text="@T.T("Features_Disable", "Disable")" Icon="block" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => RequestBulkDisable())" Disabled="@(!CanApplyBulk)" />
                <CrestButton Text="@T.T("Features_Toggle", "Toggle")" Icon="swap_horiz" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="@(() => RequestBulkToggle())" Disabled="@(!CanApplyBulk)" />
                <CrestText Text="@(string.Format(T.T("Features_ShowingCountFormat", "Showing {0} of {1} features"), FilteredFeatures.Length, AllFeatures.Length))" TextStyle="TextStyle.Caption" class="features-count" />
            </CrestStack>
        </CrestStack>
    </CrestCard>

    @if (IsLoading)
    {
        <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <CrestProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <CrestText Text="@T.T("Features_Loading", "Loading features...")" />
        </CrestStack>
    }
    else if (FilteredFeatures.Length == 0)
    {
        <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T.T("Features_NoneFound", "Nothing here. The current search or filters returned no features.")</CrestAlert>
    }
    else
    {
        @foreach (var group in GroupedFeatures)
        {
            <section class="feature-group" data-testid="feature-category">
                <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.65rem">
                    <input type="checkbox" checked="@IsGroupSelected(group.Items)" @onchange="@((ChangeEventArgs args) => SelectGroup(group.Items, args.Value is true))" aria-label="@(string.Format(T.T("Features_SelectAllInCategoryFormat", "Select all features in {0}"), group.Category))" />
                    <CrestText TextStyle="TextStyle.H5" Text="@group.Category" />
                    <CrestBadge Text="@group.Items.Length.ToString()" BadgeStyle="BadgeStyle.Secondary" />
                </CrestStack>

                <CrestStack Gap="0.6rem">
                    @foreach (var feature in group.Items)
                    {
                        <CrestCard class="feature-card" data-feature-id="@feature.Id">
                            <div class="feature-card__selection">
                                <input type="checkbox" checked="@SelectedIds.Contains(feature.Id)" @onchange="@((ChangeEventArgs args) => SelectFeature(feature.Id, args.Value is true))" aria-label="@(string.Format(T.T("Features_SelectFeatureFormat", "Select {0}"), feature.Name))" />
                            </div>
                            <CrestStack Gap="0.45rem" class="feature-card__content">
                                <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <CrestText TextStyle="TextStyle.H6" Text="@feature.Name" />
                                    <CrestText TextStyle="TextStyle.Caption" Text="@feature.Id" />
                                    <CrestBadge Text="@(feature.Enabled ? T.T("Features_EnabledBadge", "Enabled") : T.T("Features_DisabledBadge", "Disabled"))" BadgeStyle="@(feature.Enabled ? BadgeStyle.Success : BadgeStyle.Light)" />
                                    @if (feature.AlwaysEnabled)
                                    {
                                        <CrestBadge Text="@T.T("Features_AlwaysEnabledBadge", "Always enabled")" BadgeStyle="BadgeStyle.Info" />
                                    }
                                    @if (feature.EnabledByDependencyOnly)
                                    {
                                        <CrestBadge Text="@T.T("Features_DependencyOnlyBadge", "Dependency only")" BadgeStyle="BadgeStyle.Warning" />
                                    }
                                </CrestStack>

                                @if (!string.IsNullOrWhiteSpace(feature.Description))
                                {
                                    <CrestText TextStyle="TextStyle.Body2" Text="@feature.Description" />
                                }

                                @if (feature.Dependencies.Length > 0)
                                {
                                    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                                        <CrestText Text="@T.T("Features_DependsOn", "Depends on:")" TextStyle="TextStyle.Caption" />
                                        @foreach (var dependency in feature.Dependencies)
                                        {
                                            <CrestBadge Text="@DependencyName(dependency)" BadgeStyle="@(IsDependencyAvailable(dependency) ? BadgeStyle.Secondary : BadgeStyle.Danger)" />
                                        }
                                    </CrestStack>
                                }
                            </CrestStack>

                            <div class="feature-card__actions">
                                @if (feature.Enabled)
                                {
                                    <CrestButton Text="@T.T("Features_Disable", "Disable")" Icon="block" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => RequestDisable(feature))" Disabled="@(IsBusy || !CanDisable(feature))" />
                                }
                                else
                                {
                                    <CrestButton Text="@T.T("Features_Enable", "Enable")" Icon="check_circle" Size="ButtonSize.Small" Click="@(() => SetFeatureAsync(feature, true))" Disabled="@(IsBusy || !CanEnable(feature))" />
                                }
                            </div>
                        </CrestCard>
                    }
                </CrestStack>
            </section>
        }
    }

    @if (Confirmation is not null)
    {
        <div class="feature-dialog-backdrop" data-testid="feature-confirm-dialog">
            <CrestCard class="feature-dialog">
                <CrestStack Gap="1rem">
                    <CrestText TextStyle="TextStyle.H5" Text="@Confirmation.Title" />
                    <CrestText Text="@Confirmation.Message" />
                    @if (Confirmation.Dependents.Length > 0)
                    {
                        <ul>
                            @foreach (var dependent in Confirmation.Dependents)
                            {
                                <li>@dependent</li>
                            }
                        </ul>
                    }
                    <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <CrestButton Text="@T.T("Features_Cancel", "Cancel")" ButtonStyle="ButtonStyle.Light" Click="CancelConfirmation" />
                        <CrestButton Text="@T.T("Features_Continue", "Continue")" ButtonStyle="ButtonStyle.Danger" Click="ConfirmAsync" Disabled="@IsBusy" />
                    </CrestStack>
                </CrestStack>
            </CrestCard>
        </div>
    }
</CrestStack>

@code {
    private Feature[] AllFeatures { get; set; } = [];
    private HashSet<string> SelectedIds { get; } = new(StringComparer.OrdinalIgnoreCase);
    private string SearchText { get; set; } = string.Empty;
    private string StatusFilter { get; set; } = "any";
    private bool HideAlwaysEnabled { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private bool CanApplyBulk => SelectedIds.Count > 0 && !IsBusy;
    private string? ErrorMessage { get; set; }
    private ConfirmationModel? Confirmation { get; set; }

    private FilterOption[] StatusOptions => [new("any", T.T("Features_AnyStatusOption", "Any status")), new("enabled", T.T("Features_EnabledOnlyOption", "Enabled only")), new("disabled", T.T("Features_DisabledOnlyOption", "Disabled only"))];

    private Feature[] FilteredFeatures => AllFeatures
        .Where(feature => !HideAlwaysEnabled || !feature.AlwaysEnabled)
        .Where(feature => StatusFilter switch
        {
            "enabled" => feature.Enabled,
            "disabled" => !feature.Enabled,
            _ => true,
        })
        .Where(MatchesSearch)
        .ToArray();

    private FeatureGroup[] GroupedFeatures => FilteredFeatures
        .GroupBy(feature => string.IsNullOrWhiteSpace(feature.Category) ? T.T("Features_UncategorizedGroup", "Uncategorized") : feature.Category)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .Select(group => new FeatureGroup(group.Key, group.OrderBy(feature => feature.Name, StringComparer.OrdinalIgnoreCase).ToArray()))
        .ToArray();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            AllFeatures = await Api.Crest.Rest.Features.ListAsync();
            SelectedIds.RemoveWhere(id => AllFeatures.All(feature => !string.Equals(feature.Id, id, StringComparison.OrdinalIgnoreCase)));
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private bool MatchesSearch(Feature feature)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        var term = SearchText.Trim();
        return feature.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || feature.Id.Contains(term, StringComparison.OrdinalIgnoreCase)
            || feature.Category.Contains(term, StringComparison.OrdinalIgnoreCase)
            || feature.Description.Contains(term, StringComparison.OrdinalIgnoreCase)
            || feature.ExtensionId.Contains(term, StringComparison.OrdinalIgnoreCase)
            || feature.Dependencies.Any(dependency => dependency.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private bool CanEnable(Feature feature) => !feature.EnabledByDependencyOnly && feature.Id is not "OrchardCore.Setup" and not "OrchardCore.AutoSetup";
    private bool CanDisable(Feature feature) => !feature.AlwaysEnabled && !feature.EnabledByDependencyOnly && !string.Equals(feature.Category, "Core", StringComparison.OrdinalIgnoreCase);
    private bool IsDependencyAvailable(string id) => AllFeatures.Any(feature => string.Equals(feature.Id, id, StringComparison.OrdinalIgnoreCase));
    private string DependencyName(string id) => AllFeatures.FirstOrDefault(feature => string.Equals(feature.Id, id, StringComparison.OrdinalIgnoreCase))?.Name ?? id;
    private string[] EnabledDependentNames(Feature feature) => AllFeatures
        .Where(candidate => candidate.Enabled && candidate.Dependencies.Contains(feature.Id, StringComparer.OrdinalIgnoreCase))
        .Select(candidate => candidate.Name)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private void SelectFeature(string id, bool selected)
    {
        if (selected) SelectedIds.Add(id); else SelectedIds.Remove(id);
    }

    private bool IsGroupSelected(Feature[] features) => features.Length > 0 && features.All(feature => SelectedIds.Contains(feature.Id));

    private void SelectGroup(Feature[] features, bool selected)
    {
        foreach (var feature in features) SelectFeature(feature.Id, selected);
    }

    private void RequestDisable(Feature feature)
    {
        Confirmation = new(
            string.Format(T.T("Features_DisableConfirmTitleFormat", "Disable {0}?"), feature.Name),
            T.T("Features_DisableConfirmMessage", "Disabling a feature can also disable features that depend on it."),
            EnabledDependentNames(feature),
            () => SetFeatureAsync(feature, false));
    }

    private void RequestBulkDisable() => RequestBulk(BulkAction.Disable);
    private void RequestBulkToggle() => RequestBulk(BulkAction.Toggle);

    private string BulkActionLabel(BulkAction action) => action switch
    {
        BulkAction.Enable => T.T("Features_Enable", "Enable"),
        BulkAction.Disable => T.T("Features_Disable", "Disable"),
        _ => T.T("Features_Toggle", "Toggle"),
    };

    private void RequestBulk(BulkAction action)
    {
        var selected = AllFeatures.Where(feature => SelectedIds.Contains(feature.Id)).ToArray();
        var dependents = selected.SelectMany(EnabledDependentNames).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
        Confirmation = new(
            string.Format(T.T("Features_BulkConfirmTitleFormat", "{0} {1} features?"), BulkActionLabel(action), selected.Length),
            T.T("Features_BulkConfirmMessage", "Feature changes can recycle the tenant and affect dependent features."),
            dependents,
            () => ApplyBulkAsync(action));
    }

    private void CancelConfirmation() => Confirmation = null;

    private async Task ConfirmAsync()
    {
        var action = Confirmation?.Action;
        Confirmation = null;
        if (action is not null) await action();
    }

    private async Task SetFeatureAsync(Feature feature, bool enable)
    {
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var succeeded = enable
                ? await Api.Crest.Rest.Features.EnableAsync(feature.Id)
                : await Api.Crest.Rest.Features.DisableAsync(feature.Id);
            if (!succeeded) throw new InvalidOperationException(string.Format(T.T("Features_ActionFailedFormat", "Orchard could not {0} {1}."), enable ? T.T("Features_EnableVerb", "enable") : T.T("Features_DisableVerb", "disable"), feature.Name));
            Notifications.Notify(NotificationSeverity.Success, T.T("Features_Heading", "Features"), string.Format(T.T("Features_ChangedFormat", "{0} was {1}."), feature.Name, enable ? T.T("Features_EnabledPastTense", "enabled") : T.T("Features_DisabledPastTense", "disabled")));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ApplyBulkAsync(BulkAction action)
    {
        var selected = AllFeatures.Where(feature => SelectedIds.Contains(feature.Id)).ToArray();
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            foreach (var feature in selected)
            {
                var enable = action == BulkAction.Enable || action == BulkAction.Toggle && !feature.Enabled;
                if (enable && CanEnable(feature)) await Api.Crest.Rest.Features.EnableAsync(feature.Id);
                if (!enable && feature.Enabled && CanDisable(feature)) await Api.Crest.Rest.Features.DisableAsync(feature.Id);
            }
            SelectedIds.Clear();
            Notifications.Notify(NotificationSeverity.Success, T.T("Features_Heading", "Features"), string.Format(T.T("Features_BulkAppliedFormat", "Applied {0} to {1} selected features."), BulkActionLabel(action).ToLowerInvariant(), selected.Length));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private sealed record FilterOption(string Value, string Text);
    private sealed record FeatureGroup(string Category, Feature[] Items);
    private sealed record ConfirmationModel(string Title, string Message, string[] Dependents, Func<Task> Action);
    private enum BulkAction { Enable, Disable, Toggle }
}
