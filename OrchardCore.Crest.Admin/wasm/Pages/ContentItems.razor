@page "/Admin/Contents/ContentItems"
@using Crest.Admin.Api
@using Radzen
@using Radzen.Blazor
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications

<RadzenStack Gap="1rem" data-testid="content-items-page">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H4" Text="Content Items" />
            <RadzenText TextStyle="TextStyle.Body2" Text="Browse, filter, publish, unpublish, and remove Orchard content items." />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="New content" Icon="add" Click="StartCreate" Disabled="@(IsBusy || CreatableTypes.Length == 0)" />
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@(() => LoadAsync())" Disabled="@IsBusy" />
        </RadzenStack>
    </RadzenStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</RadzenAlert>
    }

    <RadzenCard>
        <RadzenRow Gap="0.75rem">
            <RadzenColumn Size="12" SizeMD="5"><RadzenTextBox @bind-Value="SearchText" @oninput="OnSearchInput" Placeholder="Search content titles..." Style="width: 100%;" /></RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3"><RadzenDropDown @bind-Value="SelectedContentType" Data="ContentTypeOptions" TextProperty="Text" ValueProperty="Value" Change="@(_ => LoadAsync())" Style="width: 100%;" /></RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2"><RadzenDropDown @bind-Value="SelectedStatus" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Change="@(_ => LoadAsync())" Style="width: 100%;" /></RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2"><RadzenText Text="@($"{Result.Total:n0} items")" TextStyle="TextStyle.Caption" Style="line-height: 2.5rem;" /></RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (IsLoading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (Result.Items.Length == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">No content items match the current filters.</RadzenAlert>
    }
    else
    {
        <RadzenDataGrid Data="@Result.Items" TItem="ContentItem" AllowPaging="false" Responsive="true" data-testid="content-items-grid">
            <Columns>
                <RadzenDataGridColumn TItem="ContentItem" Title="Title">
                    <Template Context="item"><RadzenText TextStyle="TextStyle.Subtitle2" Text="@item.DisplayText" /><RadzenText TextStyle="TextStyle.Caption" Text="@item.ContentItemId" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ContentItem" Title="Type"><Template Context="item">@item.ContentType</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ContentItem" Title="Status"><Template Context="item"><RadzenBadge Text="@(item.Published ? "Published" : "Draft")" BadgeStyle="@(item.Published ? BadgeStyle.Success : BadgeStyle.Warning)" /></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ContentItem" Title="Modified"><Template Context="item">@(item.ModifiedUtc?.ToLocalTime().ToString("g") ?? "—")</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ContentItem" Title="Actions" Sortable="false" Filterable="false" Width="15rem">
                    <Template Context="item">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                            @if (item.Published)
                            {
                                <RadzenButton Icon="unpublished" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="Unpublish" Click="@(() => ChangePublicationAsync(item, false))" Disabled="@IsBusy" />
                            }
                            else
                            {
                                <RadzenButton Icon="publish" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="Publish" Click="@(() => ChangePublicationAsync(item, true))" Disabled="@IsBusy" />
                            }
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="Edit" Click="@(() => Edit(item))" Disabled="@IsBusy" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" title="Delete" Click="@(() => RequestDelete(item))" Disabled="@IsBusy" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenButton Text="Previous" ButtonStyle="ButtonStyle.Light" Click="PreviousPageAsync" Disabled="@(IsBusy || Result.Page <= 1)" />
            <RadzenText Text="@($"Page {Result.Page} of {PageCount}")" />
            <RadzenButton Text="Next" ButtonStyle="ButtonStyle.Light" Click="NextPageAsync" Disabled="@(IsBusy || Result.Page >= PageCount)" />
        </RadzenStack>
    }

    @if (CreateDialogOpen)
    {
        <div class="content-items-dialog-backdrop"><RadzenCard class="content-items-dialog"><RadzenStack Gap="1rem"><RadzenText TextStyle="TextStyle.H5" Text="Create content" /><RadzenDropDown @bind-Value="CreateContentType" Data="CreatableTypes" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /><RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"><RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CloseCreate" /><RadzenButton Text="Continue" Click="Create" Disabled="@string.IsNullOrWhiteSpace(CreateContentType)" /></RadzenStack></RadzenStack></RadzenCard></div>
    }
    @if (DeleteCandidate is not null)
    {
        <div class="content-items-dialog-backdrop"><RadzenCard class="content-items-dialog"><RadzenStack Gap="1rem"><RadzenText TextStyle="TextStyle.H5" Text="Delete content item?" /><RadzenText Text="@($"This permanently removes {DeleteCandidate.DisplayText}.")" /><RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"><RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelDelete" /><RadzenButton Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" Disabled="@IsBusy" /></RadzenStack></RadzenStack></RadzenCard></div>
    }
</RadzenStack>

@code {
    private ContentItemListResult Result { get; set; } = ContentItemListResult.Empty;
    private ContentType[] ContentTypes { get; set; } = [];
    private string? SelectedContentType { get; set; }
    private string SelectedStatus { get; set; } = "latest";
    private string? SearchText { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }
    private bool CreateDialogOpen { get; set; }
    private string? CreateContentType { get; set; }
    private ContentItem? DeleteCandidate { get; set; }
    private CancellationTokenSource? SearchCancellation;

    private static readonly FilterOption[] StatusOptions = [new("latest", "Latest"), new("published", "Published"), new("draft", "Unpublished")];
    private FilterOption[] ContentTypeOptions => [new(string.Empty, "All content types"), .. ContentTypes.Select(type => new FilterOption(type.Name, type.DisplayName))];
    private FilterOption[] CreatableTypes => ContentTypes.Select(type => new FilterOption(type.Name, type.DisplayName)).ToArray();
    private int PageCount => Math.Max(1, (int)Math.Ceiling(Result.Total / (double)Result.PageSize));

    protected override async Task OnInitializedAsync()
    {
        ContentTypes = await Api.Crest.Rest.Content.Types.ListAsync();
        await LoadAsync();
    }

    private async Task LoadAsync(int? page = null)
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Result = await Api.Crest.Rest.Content.Items.ListAsync(SelectedContentType, SelectedStatus, SearchText, page ?? Result.Page, Result.PageSize); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString();
        SearchCancellation?.Cancel();
        SearchCancellation = new CancellationTokenSource();
        try { await Task.Delay(300, SearchCancellation.Token); await LoadAsync(1); }
        catch (OperationCanceledException) { }
    }

    private Task PreviousPageAsync() => LoadAsync(Result.Page - 1);
    private Task NextPageAsync() => LoadAsync(Result.Page + 1);
    private void StartCreate() { CreateContentType = CreatableTypes.FirstOrDefault()?.Value; CreateDialogOpen = true; }
    private void CloseCreate() => CreateDialogOpen = false;
    private void Create() { if (!string.IsNullOrWhiteSpace(CreateContentType)) Navigation.NavigateTo($"/Admin/Contents/ContentTypes/{Uri.EscapeDataString(CreateContentType)}/Create"); }
    private void Edit(ContentItem item) => Navigation.NavigateTo($"/Admin/Contents/ContentItems/{Uri.EscapeDataString(item.ContentItemId)}/Edit");
    private void RequestDelete(ContentItem item) => DeleteCandidate = item;
    private void CancelDelete() => DeleteCandidate = null;

    private async Task ChangePublicationAsync(ContentItem item, bool publish)
    {
        IsSaving = true;
        try { var result = publish ? await Api.Crest.Rest.Content.Items.PublishAsync(item.ContentItemId) : await Api.Crest.Rest.Content.Items.UnpublishAsync(item.ContentItemId); if (!result) throw new InvalidOperationException("Orchard did not accept the content lifecycle change."); Notifications.Notify(NotificationSeverity.Success, "Content items", $"{item.DisplayText} was {(publish ? "published" : "unpublished")}. "); await LoadAsync(); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private async Task DeleteAsync()
    {
        if (DeleteCandidate is null) return;
        IsSaving = true;
        try { if (!await Api.Crest.Rest.Content.Items.DeleteAsync(DeleteCandidate.ContentItemId)) throw new InvalidOperationException("Orchard did not accept the delete request."); Notifications.Notify(NotificationSeverity.Success, "Content items", $"{DeleteCandidate.DisplayText} was deleted."); DeleteCandidate = null; await LoadAsync(); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private sealed record FilterOption(string Value, string Text);
}
