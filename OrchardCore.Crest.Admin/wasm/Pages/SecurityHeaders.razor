@page "/Settings/SecurityHeaders"
@page "/Settings"
@using Crest.Admin.Api
@using Crest.Admin.Components.Shared
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T
@using Microsoft.AspNetCore.Components

<CrestStack Gap="1rem" data-testid="security-headers-page">
    <CrestText TextStyle="TextStyle.H4" Text="@T.T("SecurityHeaders_Heading", "Security Headers")" />

    @if (Model is null)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        @if (Model.FromConfiguration)
        {
            <CrestAlert AlertStyle="AlertStyle.Warning">@T.T("SecurityHeaders_FromConfigurationWarning", "Current values are supplied by configuration. Saving updates the tenant Admin Settings, not that configuration source.")</CrestAlert>
        }

        <CrestMainContentTabs data-testid="security-headers-tabs">
            <CrestTabsItem Text="@T.T("SecurityHeaders_CspTab", "Content Security Policy")">
                <CrestStack Gap="1rem" class="pt-3">
                    <CrestCheckBox @bind-Value="EnableSandbox" Name="enable-sandbox" />
                    <label for="enable-sandbox">@T.T("SecurityHeaders_EnableSandboxLabel", "Enable sandbox")</label>
                    <CrestText TextStyle="TextStyle.Body2" Text="@T.T("SecurityHeaders_SandboxDescription", "Enables a sandbox for the requested resource, similar to the iframe sandbox attribute.")" />
                    <CrestCheckBox @bind-Value="UpgradeInsecureRequests" Name="upgrade-insecure-requests" />
                    <label for="upgrade-insecure-requests">@T.T("SecurityHeaders_UpgradeInsecureRequestsLabel", "Upgrade insecure requests")</label>
                    <CrestDataGrid Data="ContentSecurityPolicies" TItem="SecurityPolicyOption" AllowPaging="false" AllowSorting="false">
                        <Columns>
                            <CrestDataGridColumn TItem="SecurityPolicyOption" Property="Label" Title="@T.T("SecurityHeaders_DirectiveColumn", "Directive")" />
                            <CrestDataGridColumn TItem="SecurityPolicyOption" Title="@T.T("SecurityHeaders_AllowedSourcesColumn", "Allowed sources")">
                                <Template Context="option">
                                    <CrestTextBox Value="@GetContentSecurityPolicy(option.Key)" Change="@(value => SetContentSecurityPolicy(option.Key, value?.ToString()))" Style="width: 100%;" Placeholder="'self' https://cdn.example.com" />
                                </Template>
                            </CrestDataGridColumn>
                        </Columns>
                    </CrestDataGrid>
                    <CrestText TextStyle="TextStyle.Body2" Text="@T.T("SecurityHeaders_CspDescription", "Controls the resources the browser is allowed to load for a page.")" />
                </CrestStack>
            </CrestTabsItem>
            <CrestTabsItem Text="@T.T("SecurityHeaders_PermissionsPolicyTab", "Permissions Policy")">
                <CrestStack Gap="1rem" class="pt-3">
                    <CrestDataGrid Data="PermissionsPolicies" TItem="SecurityPolicyOption" AllowPaging="false" AllowSorting="false">
                        <Columns>
                            <CrestDataGridColumn TItem="SecurityPolicyOption" Property="Label" Title="@T.T("SecurityHeaders_FeatureColumn", "Feature")" />
                            <CrestDataGridColumn TItem="SecurityPolicyOption" Title="@T.T("SecurityHeaders_AllowedByColumn", "Allowed by")">
                                <Template Context="option">
                                    <CrestDropDown TValue="string" Value="@GetPermissionOrigin(option.Key)" Change="@(value => SetPermissionOrigin(option.Key, value?.ToString() ?? "()"))" Data="PermissionOriginOptions" TextProperty="Label" ValueProperty="Value" Style="width: 100%;" />
                                </Template>
                            </CrestDataGridColumn>
                            <CrestDataGridColumn TItem="SecurityPolicyOption" Title="@T.T("SecurityHeaders_AdditionalOriginsColumn", "Additional origins")">
                                <Template Context="option">
                                    @if (GetPermissionOrigin(option.Key) == "self")
                                    {
                                        <CrestTextBox Value="@GetAdditionalOrigins(option.Key)" Change="@(value => SetAdditionalOrigins(option.Key, value?.ToString()))" Style="width: 100%;" Placeholder="https://www.example.com https://app.example.com" />
                                    }
                                </Template>
                            </CrestDataGridColumn>
                        </Columns>
                    </CrestDataGrid>
                    <CrestText TextStyle="TextStyle.Body2" Text="@T.T("SecurityHeaders_PermissionsPolicyDescription", "Controls which browser features and APIs are available to this site.")" />
                </CrestStack>
            </CrestTabsItem>
            <CrestTabsItem Text="@T.T("SecurityHeaders_ReferrerPolicyTab", "Referrer Policy")">
                <CrestStack Gap="1rem" class="pt-3">
                    <CrestFormField Text="@T.T("SecurityHeaders_ReferrerPolicyFieldLabel", "Referrer policy")" Style="width: 100%; max-width: 42rem;">
                        <CrestDropDown TValue="string" @bind-Value="ReferrerPolicy" Data="ReferrerPolicyOptions" TextProperty="Label" ValueProperty="Value" Style="width: 100%;" />
                    </CrestFormField>
                    <CrestText TextStyle="TextStyle.Body2" Text="@T.T("SecurityHeaders_ReferrerPolicyDescription", "Controls how much referrer information the browser includes when navigating away from a page.")" />
                </CrestStack>
            </CrestTabsItem>
        </CrestMainContentTabs>

        <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <CrestButton Text="@T.T("SecurityHeaders_Save", "Save")" Click="SaveAsync" />
        </CrestStack>
    }
</CrestStack>

@code {
    [SupplyParameterFromQuery(Name = "groupId")]
    public string? GroupId { get; set; }

    private CrestSecurityHeaders? Model;
    private Dictionary<string, string> ContentSecurityPolicy = new(StringComparer.Ordinal);
    private Dictionary<string, string> PermissionsPolicy = new(StringComparer.Ordinal);
    private string ReferrerPolicy = "no-referrer";

    private bool EnableSandbox
    {
        get => ContentSecurityPolicy.ContainsKey("sandbox");
        set => SetFlag("sandbox", value);
    }

    private bool UpgradeInsecureRequests
    {
        get => ContentSecurityPolicy.ContainsKey("upgrade-insecure-requests");
        set => SetFlag("upgrade-insecure-requests", value);
    }

    // Properties (not static readonly fields) since they depend on T, which isn't set yet
    // during field initializer execution (constructor runs before [Inject] properties are
    // assigned) - see AdminMenus.razor's CollapseIconPositionOptions for the same rationale.
    private SecurityPolicyOption[] ContentSecurityPolicies =>
    [
        new("base-uri", T.T("SecurityHeaders_BaseUriOption", "Base URI")), new("child-src", T.T("SecurityHeaders_ChildSourceOption", "Child source")), new("connect-src", T.T("SecurityHeaders_ConnectSourceOption", "Connect source")),
        new("default-src", T.T("SecurityHeaders_DefaultSourceOption", "Default source")), new("font-src", T.T("SecurityHeaders_FontSourceOption", "Font source")), new("form-action", T.T("SecurityHeaders_FormActionOption", "Form action")),
        new("frame-ancestors", T.T("SecurityHeaders_FrameAncestorsOption", "Frame ancestors")), new("frame-src", T.T("SecurityHeaders_FrameSourceOption", "Frame source")), new("img-src", T.T("SecurityHeaders_ImageSourceOption", "Image source")),
        new("manifest-src", T.T("SecurityHeaders_ManifestSourceOption", "Manifest source")), new("media-src", T.T("SecurityHeaders_MediaSourceOption", "Media source")), new("object-src", T.T("SecurityHeaders_ObjectSourceOption", "Object source")),
        new("script-src", T.T("SecurityHeaders_ScriptSourceOption", "Script source")), new("style-src", T.T("SecurityHeaders_StyleSourceOption", "Style source")),
    ];

    private SecurityPolicyOption[] PermissionsPolicies =>
    [
        new("accelerometer", T.T("SecurityHeaders_AccelerometerOption", "Accelerometer")), new("ambient-light-sensor", T.T("SecurityHeaders_AmbientLightSensorOption", "Ambient light sensor")), new("autoplay", T.T("SecurityHeaders_AutoplayOption", "Autoplay")),
        new("battery", T.T("SecurityHeaders_BatteryOption", "Battery")), new("camera", T.T("SecurityHeaders_CameraOption", "Camera")), new("display-capture", T.T("SecurityHeaders_DisplayCaptureOption", "Display capture")), new("document-domain", T.T("SecurityHeaders_DocumentDomainOption", "Document domain")),
        new("encrypted-media", T.T("SecurityHeaders_EncryptedMediaOption", "Encrypted media")), new("fullscreen", T.T("SecurityHeaders_FullScreenOption", "Full screen")), new("gamepad", T.T("SecurityHeaders_GamePadOption", "Game pad")),
        new("geolocation", T.T("SecurityHeaders_GeolocationOption", "Geolocation")), new("gyroscope", T.T("SecurityHeaders_GyroscopeOption", "Gyroscope")), new("layout-animations", T.T("SecurityHeaders_LayoutAnimationsOption", "Layout animations")),
        new("legacy-image-format", T.T("SecurityHeaders_LegacyImageFormatOption", "Legacy image format")), new("magnetometer", T.T("SecurityHeaders_MagnetometerOption", "Magnetometer")), new("microphone", T.T("SecurityHeaders_MicrophoneOption", "Microphone")),
        new("midi", T.T("SecurityHeaders_MidiOption", "MIDI")), new("oversized-images", T.T("SecurityHeaders_OversizedImagesOption", "Oversized images")), new("payment", T.T("SecurityHeaders_PaymentOption", "Payment")),
        new("picture-in-picture", T.T("SecurityHeaders_PictureInPictureOption", "Picture in picture")), new("publickey-credentials-get", T.T("SecurityHeaders_PublicKeyRetrievalOption", "Public key retrieval")),
        new("speaker-selection", T.T("SecurityHeaders_SpeakerSelectionOption", "Speaker selection")), new("screen-wake-lock", T.T("SecurityHeaders_ScreenWakeLockOption", "Screen wake lock")),
        new("sync-xhr", T.T("SecurityHeaders_SynchronousXhrOption", "Synchronous XML HTTP request")), new("unoptimized-images", T.T("SecurityHeaders_UnoptimizedImagesOption", "Unoptimized images")),
        new("unsized-media", T.T("SecurityHeaders_UnsizedMediaOption", "Unsized media")), new("usb", T.T("SecurityHeaders_UsbOption", "USB")), new("web-share", T.T("SecurityHeaders_WebShareOption", "Web share")), new("xr-spatial-tracking", T.T("SecurityHeaders_WebXrOption", "Web XR")),
    ];

    private NamedOption[] PermissionOriginOptions => [new("()", T.T("SecurityHeaders_NoneOption", "None")), new("*", T.T("SecurityHeaders_AnyOption", "Any")), new("self", T.T("SecurityHeaders_SelfOption", "Self"))];
    private NamedOption[] ReferrerPolicyOptions =>
    [
        new("no-referrer", T.T("SecurityHeaders_NoReferrerOption", "No referrer")), new("no-referrer-when-downgrade", T.T("SecurityHeaders_NoReferrerWhenDowngradeOption", "No referrer when downgrade")),
        new("origin", T.T("SecurityHeaders_OriginOption", "Origin")), new("origin-when-cross-origin", T.T("SecurityHeaders_OriginWhenCrossOriginOption", "Origin when cross origin")), new("same-origin", T.T("SecurityHeaders_SameOriginOption", "Same origin")),
        new("strict-origin", T.T("SecurityHeaders_StrictOriginOption", "Strict origin")), new("strict-origin-when-cross-origin", T.T("SecurityHeaders_StrictOriginWhenCrossOriginOption", "Strict origin when cross origin")),
        new("unsafe-url", T.T("SecurityHeaders_UnsafeUrlOption", "Unsafe URL")),
    ];

    protected override async Task OnInitializedAsync()
    {
        Model = await Api.Crest.Rest.SecurityHeaders.GetAsync();
        ContentSecurityPolicy = new(Model?.ContentSecurityPolicy ?? [], StringComparer.Ordinal);
        PermissionsPolicy = new(Model?.PermissionsPolicy ?? [], StringComparer.Ordinal);
        ReferrerPolicy = Model?.ReferrerPolicy ?? "no-referrer";
    }

    private string GetContentSecurityPolicy(string key) => ContentSecurityPolicy.TryGetValue(key, out var value) ? value : string.Empty;
    private void SetContentSecurityPolicy(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) ContentSecurityPolicy.Remove(key);
        else ContentSecurityPolicy[key] = value.Trim();
    }
    private void SetFlag(string key, bool value)
    {
        if (value) ContentSecurityPolicy[key] = string.Empty;
        else ContentSecurityPolicy.Remove(key);
    }

    private string GetPermissionOrigin(string key) => PermissionsPolicy.TryGetValue(key, out var value)
        ? value.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries)[0]
        : "()";
    private string GetAdditionalOrigins(string key) => PermissionsPolicy.TryGetValue(key, out var value)
        ? string.Join(' ', value.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries).Skip(1))
        : string.Empty;
    private void SetPermissionOrigin(string key, string value)
    {
        if (value == "()") PermissionsPolicy.Remove(key);
        else if (value == "self") PermissionsPolicy[key] = string.IsNullOrWhiteSpace(GetAdditionalOrigins(key)) ? "self" : $"self {GetAdditionalOrigins(key)}";
        else PermissionsPolicy[key] = value;
    }
    private void SetAdditionalOrigins(string key, string? value)
    {
        if (GetPermissionOrigin(key) == "self") PermissionsPolicy[key] = string.IsNullOrWhiteSpace(value) ? "self" : $"self {value.Trim()}";
    }

    private async Task SaveAsync()
    {
        if (Model is null) return;
        Model = await Api.Crest.Rest.SecurityHeaders.SaveAsync(Model with
        {
            ReferrerPolicy = ReferrerPolicy,
            ContentSecurityPolicy = ContentSecurityPolicy,
            PermissionsPolicy = PermissionsPolicy,
        });
    }

    private sealed record SecurityPolicyOption(string Key, string Label);
    private sealed record NamedOption(string Value, string Label);
}
