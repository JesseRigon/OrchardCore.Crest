@page "/Admin/indexing"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
<CrestStack Gap="1rem" data-testid="indexes-page"><CrestText TextStyle="TextStyle.H4" Text="Indexes"/>@if(Model is null){<CrestProgressBar Mode="ProgressBarMode.Indeterminate"/>}else{<CrestDataGrid Data="Model" TItem="CrestIndex"><Columns><CrestDataGridColumn TItem="CrestIndex" Property="Name" Title="Name"/><CrestDataGridColumn TItem="CrestIndex" Property="Provider" Title="Provider"/><CrestDataGridColumn TItem="CrestIndex" Property="Type" Title="Source"/><CrestDataGridColumn TItem="CrestIndex" Property="CreatedUtc" Title="Created"/><CrestDataGridColumn TItem="CrestIndex" Title="Actions"><Template Context="index"><CrestButton Text="Rebuild" Icon="refresh" Click="@(()=>Rebuild(index))"/></Template></CrestDataGridColumn></Columns></CrestDataGrid>}</CrestStack>
@code { CrestIndex[]? Model; protected override async Task OnInitializedAsync()=>Model=await Api.Crest.Rest.Indexes.ListAsync(); async Task Rebuild(CrestIndex index){await Api.Crest.Rest.Indexes.RebuildAsync(index.Id);Model=await Api.Crest.Rest.Indexes.ListAsync();} }
