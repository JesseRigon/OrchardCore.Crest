@page "/indexing"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T
<CrestStack Gap="1rem" data-testid="indexes-page"><CrestText TextStyle="TextStyle.H4" Text="@T.T("Indexes_Title", "Indexes")"/>@if(Model is null){<CrestProgressBar Mode="ProgressBarMode.Indeterminate"/>}else{<CrestDataGrid Data="Model" TItem="CrestIndex"><Columns><CrestDataGridColumn TItem="CrestIndex" Property="Name" Title="@T.T("Indexes_NameColumn", "Name")"/><CrestDataGridColumn TItem="CrestIndex" Property="Provider" Title="@T.T("Indexes_ProviderColumn", "Provider")"/><CrestDataGridColumn TItem="CrestIndex" Property="Type" Title="@T.T("Indexes_SourceColumn", "Source")"/><CrestDataGridColumn TItem="CrestIndex" Property="CreatedUtc" Title="@T.T("Indexes_CreatedColumn", "Created")"/><CrestDataGridColumn TItem="CrestIndex" Title="@T.T("Indexes_ActionsColumn", "Actions")"><Template Context="index"><CrestButton Text="@T.T("Indexes_Rebuild", "Rebuild")" Icon="refresh" Click="@(()=>Rebuild(index))"/></Template></CrestDataGridColumn></Columns></CrestDataGrid>}</CrestStack>
@code { CrestIndex[]? Model; protected override async Task OnInitializedAsync()=>Model=await Api.Crest.Rest.Indexes.ListAsync(); async Task Rebuild(CrestIndex index){await Api.Crest.Rest.Indexes.RebuildAsync(index.Id);Model=await Api.Crest.Rest.Indexes.ListAsync();} }
