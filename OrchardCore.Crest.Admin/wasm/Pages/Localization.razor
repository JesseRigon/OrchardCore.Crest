@page "/Admin/Settings/localization"
@using Crest.Admin.Api
@using Crest.Admin.DisplayManagement
@using Crest.Components.Inputs
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications

<RadzenStack Gap="1rem" class="localization-page" data-testid="localization-page">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <div>
            <RadzenText TextStyle="TextStyle.H4" Text="Cultures" />
            <RadzenText TextStyle="TextStyle.Body2" Text="Choose the tenant cultures Orchard serves and the default culture used when no request culture is selected." />
        </div>
        @if (HasDynamicTranslations)
        {
            <RadzenButton Text="Edit translations" Icon="translate" ButtonStyle="ButtonStyle.Light" Click="OpenTranslations" />
        }
    </RadzenStack>

    @if (IsLoading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (Model is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">Localization settings are unavailable for this tenant.</RadzenAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</RadzenAlert>
        }

        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" Text="Supported cultures" />
                <RadzenText TextStyle="TextStyle.Body2" Text="These are the valid .NET/BCP 47 cultures Orchard passes to its request-localization pipeline." />

                @if (SupportedCultureOptions.Length == 0)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">At least one culture is required.</RadzenAlert>
                }
                else
                {
                    <div class="localization-page__supported-list">
                        @foreach (var culture in SupportedCultureOptions)
                        {
                            <div class="localization-page__culture-card" @key="culture.Value">
                                <div>
                                    <div class="localization-page__culture-name">@DisplayCultureName(culture)</div>
                                    <div class="localization-page__culture-code">@(string.IsNullOrEmpty(culture.Value) ? "Invariant culture" : culture.Value)</div>
                                </div>
                                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" title="Remove culture" aria-label="@($"Remove {DisplayCultureName(culture)}")" Disabled="@(SupportedCultureOptions.Length == 1 || IsSaving)" Click="@(() => RemoveCulture(culture.Value))" />
                            </div>
                        }
                    </div>
                }

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                    <div class="localization-page__add-picker">
                        <RadzenLabel Text="Add a standard culture" />
                        <CrestDropDown TValue="string"
                                        Data="AvailableCultureOptions"
                                        Value="@SelectedCultureToAdd"
                                        ValueChanged="SelectCultureToAddAsync"
                                        TextProperty="@nameof(CrestCulture.Label)"
                                        ValueProperty="@nameof(CrestCulture.Value)"
                                        Placeholder="Choose a culture"
                                        AllowFiltering="true"
                                        FilterPlaceholder="Filter cultures"
                                        class="localization-page__culture-dropdown" />
                    </div>
                    <RadzenButton Text="Add culture" Icon="add" Disabled="@(IsSaving || string.IsNullOrWhiteSpace(SelectedCultureToAdd))" Click="AddSelectedCultureAsync" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                    <div class="localization-page__add-picker">
                        <RadzenLabel Text="Add a valid custom culture code" />
                        <RadzenTextBox @bind-Value="CustomCultureCode" Placeholder="Example: en-GB" Style="width: 100%;" Disabled="@IsSaving" />
                    </div>
                    <RadzenButton Text="Add custom culture" Icon="add" ButtonStyle="ButtonStyle.Light" Disabled="@(IsSaving || string.IsNullOrWhiteSpace(CustomCultureCode))" Click="AddCustomCultureAsync" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" Text="Custom entries must be culture names recognized by .NET/BCP 47. Orchard stores them in tenant localization settings and validates them again on save." />
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" Text="Default culture" />
                <RadzenText TextStyle="TextStyle.Body2" Text="This is used when a request does not select one of the supported cultures." />
                <CrestDropDown TValue="string"
                                Data="SupportedCultureOptions"
                                Value="@Model.DefaultCulture"
                                ValueChanged="SelectDefaultCultureAsync"
                                TextProperty="@nameof(CrestCulture.Label)"
                                ValueProperty="@nameof(CrestCulture.Value)"
                                Placeholder="Choose the default culture"
                                AllowFiltering="true"
                                FilterPlaceholder="Filter supported cultures"
                                class="localization-page__culture-dropdown" />
                <div>
                    <RadzenCheckBox @bind-Value="Model.FallBackToParentCulture" Name="fallback-to-parent" Disabled="@IsSaving" />
                    <label for="fallback-to-parent"> Fall back to parent cultures</label>
                </div>
            </RadzenStack>
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Save" Icon="save" Disabled="@(IsSaving || SupportedCultureOptions.Length == 0)" Click="SaveAsync" />
        </RadzenStack>
    }
</RadzenStack>

@code {
    [CascadingParameter] public DisplayManager? DisplayManager { get; set; }

    private CrestLocalization? Model { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SelectedCultureToAdd { get; set; }
    private string? CustomCultureCode { get; set; }

    private bool HasDynamicTranslations => DisplayManager?.Manifest?.Features.Any(feature =>
        string.Equals(feature.Id, "OrchardCore.DataLocalization", StringComparison.OrdinalIgnoreCase)) == true;

    private CrestCulture[] SupportedCultureOptions => Model?.SupportedCultures
        .Select(ToCulture)
        .OrderBy(culture => culture.Label, StringComparer.OrdinalIgnoreCase)
        .ToArray() ?? [];

    private CrestCulture[] AvailableCultureOptions => Model?.AvailableCultures
        .Where(culture => !Model.SupportedCultures.Contains(culture.Value, StringComparer.OrdinalIgnoreCase))
        .ToArray() ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model = await Api.Crest.Rest.Localization.GetAsync();
            EnsureDefaultCulture();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SelectCultureToAddAsync(string? value)
    {
        SelectedCultureToAdd = value;
        return Task.CompletedTask;
    }

    private Task SelectDefaultCultureAsync(string? value)
    {
        if (Model is not null && !string.IsNullOrWhiteSpace(value))
        {
            Model.DefaultCulture = value;
        }
        return Task.CompletedTask;
    }

    private Task AddSelectedCultureAsync()
    {
        AddCulture(SelectedCultureToAdd);
        SelectedCultureToAdd = null;
        return Task.CompletedTask;
    }

    private Task AddCustomCultureAsync()
    {
        if (string.IsNullOrWhiteSpace(CustomCultureCode))
        {
            return Task.CompletedTask;
        }

        AddCulture(CustomCultureCode.Trim());
        CustomCultureCode = null;
        return Task.CompletedTask;
    }

    private void AddCulture(string? culture)
    {
        if (Model is null || string.IsNullOrWhiteSpace(culture)) return;
        if (Model.SupportedCultures.Contains(culture, StringComparer.OrdinalIgnoreCase)) return;

        Model.SupportedCultures = [.. Model.SupportedCultures, culture];
        EnsureDefaultCulture();
    }

    private void RemoveCulture(string culture)
    {
        if (Model is null || Model.SupportedCultures.Length <= 1) return;
        Model.SupportedCultures = Model.SupportedCultures
            .Where(value => !string.Equals(value, culture, StringComparison.OrdinalIgnoreCase))
            .ToArray();
        EnsureDefaultCulture();
    }

    private async Task SaveAsync()
    {
        if (Model is null) return;
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var saved = await Api.Crest.Rest.Localization.SaveAsync(Model);
            if (saved is null)
            {
                throw new InvalidOperationException("Orchard did not save the culture settings. Verify custom culture codes and your permission to manage cultures.");
            }

            Model = saved;
            EnsureDefaultCulture();
            Notifications.Notify(NotificationSeverity.Success, "Cultures", "Orchard culture settings were saved. The tenant reloads these settings for new requests.");
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenTranslations() => NavigationManager.NavigateTo("/Admin/DataLocalization/Index");

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private void EnsureDefaultCulture()
    {
        if (Model is null || Model.SupportedCultures.Length == 0) return;
        if (!Model.SupportedCultures.Contains(Model.DefaultCulture, StringComparer.OrdinalIgnoreCase))
        {
            Model.DefaultCulture = Model.SupportedCultures[0];
        }
    }

    private CrestCulture ToCulture(string value) => Model?.AvailableCultures.FirstOrDefault(culture =>
        string.Equals(culture.Value, value, StringComparison.OrdinalIgnoreCase))
        ?? new CrestCulture(value, string.IsNullOrEmpty(value) ? "Invariant culture" : value, value);

    private static string DisplayCultureName(CrestCulture culture) => string.IsNullOrWhiteSpace(culture.NativeLabel)
        ? culture.Label
        : $"{culture.NativeLabel} ({culture.Label})";
}
