@page "/Settings/localization"
@using Crest.Admin.Api
@using Crest.Admin.DisplayManagement
@using Crest.Components.Inputs
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" class="localization-page" data-testid="localization-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <div>
            <CrestText TextStyle="TextStyle.H4" Text="@T.T("Localization_Heading", "Cultures")" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T.T("Localization_HeadingDescription", "Choose the tenant cultures Orchard serves and the default culture used when no request culture is selected.")" />
        </div>
        @if (HasDynamicTranslations)
        {
            <CrestButton Text="@T.T("Localization_EditTranslations", "Edit translations")" Icon="translate" ButtonStyle="ButtonStyle.Light" Click="OpenTranslations" />
        }
    </CrestStack>

    @if (IsLoading)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (Model is null)
    {
        <CrestAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">@T.T("Localization_Unavailable", "Localization settings are unavailable for this tenant.")</CrestAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
        }

        <CrestCard>
            <CrestStack Gap="0.75rem">
                <CrestText TextStyle="TextStyle.Subtitle1" Text="@T.T("Localization_SupportedCulturesHeading", "Supported cultures")" />
                <CrestText TextStyle="TextStyle.Body2" Text="@T.T("Localization_SupportedCulturesDescription", "These are the valid .NET/BCP 47 cultures Orchard passes to its request-localization pipeline.")" />

                @if (SupportedCultureOptions.Length == 0)
                {
                    <CrestAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">@T.T("Localization_AtLeastOneCultureRequired", "At least one culture is required.")</CrestAlert>
                }
                else
                {
                    <div class="localization-page__supported-list">
                        @foreach (var culture in SupportedCultureOptions)
                        {
                            <div class="localization-page__culture-card" @key="culture.Value">
                                <div>
                                    <div class="localization-page__culture-name">@DisplayCultureName(culture)</div>
                                    <div class="localization-page__culture-code">@(string.IsNullOrEmpty(culture.Value) ? T.T("Localization_InvariantCulture", "Invariant culture") : culture.Value)</div>
                                </div>
                                <CrestButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" title="@T.T("Localization_RemoveCultureTitle", "Remove culture")" aria-label="@string.Format(T.T("Localization_RemoveCultureAriaLabelFormat", "Remove {0}"), DisplayCultureName(culture))" Disabled="@(SupportedCultureOptions.Length == 1 || IsSaving)" Click="@(() => RemoveCulture(culture.Value))" />
                            </div>
                        }
                    </div>
                }

                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                    <div class="localization-page__add-picker">
                        <CrestLabel Text="@T.T("Localization_AddStandardCultureLabel", "Add a standard culture")" />
                        <CrestDropDown TValue="string"
                                        Data="AvailableCultureOptions"
                                        Value="@SelectedCultureToAdd"
                                        ValueChanged="SelectCultureToAddAsync"
                                        TextProperty="@nameof(CrestCulture.Label)"
                                        ValueProperty="@nameof(CrestCulture.Value)"
                                        Placeholder="@T.T("Localization_ChooseACulturePlaceholder", "Choose a culture")"
                                        AllowFiltering="true"
                                        FilterPlaceholder="@T.T("Localization_FilterCulturesPlaceholder", "Filter cultures")"
                                        class="localization-page__culture-dropdown" />
                    </div>
                    <CrestButton Text="@T.T("Localization_AddCulture", "Add culture")" Icon="add" Disabled="@(IsSaving || string.IsNullOrWhiteSpace(SelectedCultureToAdd))" Click="AddSelectedCultureAsync" />
                </CrestStack>

                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                    <div class="localization-page__add-picker">
                        <CrestLabel Text="@T.T("Localization_AddCustomCultureCodeLabel", "Add a valid custom culture code")" />
                        <CrestTextBox @bind-Value="CustomCultureCode" Placeholder="@T.T("Localization_CustomCultureExamplePlaceholder", "Example: en-GB")" Style="width: 100%;" Disabled="@IsSaving" />
                    </div>
                    <CrestButton Text="@T.T("Localization_AddCustomCulture", "Add custom culture")" Icon="add" ButtonStyle="ButtonStyle.Light" Disabled="@(IsSaving || string.IsNullOrWhiteSpace(CustomCultureCode))" Click="AddCustomCultureAsync" />
                </CrestStack>
                <CrestText TextStyle="TextStyle.Caption" Text="@T.T("Localization_CustomCultureHint", "Custom entries must be culture names recognized by .NET/BCP 47. Orchard stores them in tenant localization settings and validates them again on save.")" />
            </CrestStack>
        </CrestCard>

        <CrestCard>
            <CrestStack Gap="0.75rem">
                <CrestText TextStyle="TextStyle.Subtitle1" Text="@T.T("Localization_DefaultCultureHeading", "Default culture")" />
                <CrestText TextStyle="TextStyle.Body2" Text="@T.T("Localization_DefaultCultureDescription", "This is used when a request does not select one of the supported cultures.")" />
                <CrestDropDown TValue="string"
                                Data="SupportedCultureOptions"
                                Value="@Model.DefaultCulture"
                                ValueChanged="SelectDefaultCultureAsync"
                                TextProperty="@nameof(CrestCulture.Label)"
                                ValueProperty="@nameof(CrestCulture.Value)"
                                Placeholder="@T.T("Localization_ChooseDefaultCulturePlaceholder", "Choose the default culture")"
                                AllowFiltering="true"
                                FilterPlaceholder="@T.T("Localization_FilterSupportedCulturesPlaceholder", "Filter supported cultures")"
                                class="localization-page__culture-dropdown" />
                <div>
                    <CrestCheckBox @bind-Value="Model.FallBackToParentCulture" Name="fallback-to-parent" Disabled="@IsSaving" />
                    <label for="fallback-to-parent"> @T.T("Localization_FallBackToParentCultures", "Fall back to parent cultures")</label>
                </div>
            </CrestStack>
        </CrestCard>

        <CrestCard>
            <CrestStack Gap="0.75rem">
                <CrestText TextStyle="TextStyle.Subtitle1" Text="@T.T("Localization_AdminDefaultCultureHeading", "Admin default culture")" />
                <CrestText TextStyle="TextStyle.Body2" Text="@T.T("Localization_AdminDefaultCultureDescription", "Optional. Only applies to the admin area — a signed-in user's own language preference or an explicit session choice still takes priority here. Leave unset to use the default culture above everywhere, including the admin area.")" />
                <CrestDropDown TValue="string"
                                Data="AdminDefaultCultureOptions"
                                Value="@Model.AdminDefaultCulture"
                                ValueChanged="SelectAdminDefaultCultureAsync"
                                TextProperty="@nameof(CrestCulture.Label)"
                                ValueProperty="@nameof(CrestCulture.Value)"
                                Placeholder="@T.T("Localization_NoAdminOverridePlaceholder", "No admin-specific override")"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterPlaceholder="@T.T("Localization_FilterSupportedCulturesPlaceholder", "Filter supported cultures")"
                                class="localization-page__culture-dropdown" />
            </CrestStack>
        </CrestCard>

        <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <CrestButton Text="@T.T("Localization_Save", "Save")" Icon="save" Disabled="@(IsSaving || SupportedCultureOptions.Length == 0)" Click="SaveAsync" />
        </CrestStack>
    }
</CrestStack>

@code {
    [CascadingParameter] public DisplayManager? DisplayManager { get; set; }

    private CrestLocalization? Model { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SelectedCultureToAdd { get; set; }
    private string? CustomCultureCode { get; set; }

    private bool HasDynamicTranslations => DisplayManager?.Manifest?.Features.Any(feature =>
        string.Equals(feature.Id, "OrchardCore.DataLocalization", StringComparison.OrdinalIgnoreCase)) == true;

    private CrestCulture[] SupportedCultureOptions => Model?.SupportedCultures
        .Select(ToCulture)
        .OrderBy(culture => culture.Label, StringComparer.OrdinalIgnoreCase)
        .ToArray() ?? [];

    // Same set as SupportedCultureOptions - the admin default, when set, must be one of the
    // tenant's own supported cultures (enforced again server-side on save). "No override"
    // is represented by a null Model.AdminDefaultCulture, via the dropdown's AllowClear.
    private CrestCulture[] AdminDefaultCultureOptions => SupportedCultureOptions;

    private CrestCulture[] AvailableCultureOptions => Model?.AvailableCultures
        .Where(culture => !Model.SupportedCultures.Contains(culture.Value, StringComparer.OrdinalIgnoreCase))
        .ToArray() ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model = await Api.Crest.Rest.Localization.GetAsync();
            EnsureDefaultCulture();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SelectCultureToAddAsync(string? value)
    {
        SelectedCultureToAdd = value;
        return Task.CompletedTask;
    }

    private Task SelectDefaultCultureAsync(string? value)
    {
        if (Model is not null && !string.IsNullOrWhiteSpace(value))
        {
            Model.DefaultCulture = value;
        }
        return Task.CompletedTask;
    }

    private Task SelectAdminDefaultCultureAsync(string? value)
    {
        if (Model is not null)
        {
            Model.AdminDefaultCulture = string.IsNullOrWhiteSpace(value) ? null : value;
        }
        return Task.CompletedTask;
    }

    private Task AddSelectedCultureAsync()
    {
        AddCulture(SelectedCultureToAdd);
        SelectedCultureToAdd = null;
        return Task.CompletedTask;
    }

    private Task AddCustomCultureAsync()
    {
        if (string.IsNullOrWhiteSpace(CustomCultureCode))
        {
            return Task.CompletedTask;
        }

        AddCulture(CustomCultureCode.Trim());
        CustomCultureCode = null;
        return Task.CompletedTask;
    }

    private void AddCulture(string? culture)
    {
        if (Model is null || string.IsNullOrWhiteSpace(culture)) return;
        if (Model.SupportedCultures.Contains(culture, StringComparer.OrdinalIgnoreCase)) return;

        Model.SupportedCultures = [.. Model.SupportedCultures, culture];
        EnsureDefaultCulture();
    }

    private void RemoveCulture(string culture)
    {
        if (Model is null || Model.SupportedCultures.Length <= 1) return;
        Model.SupportedCultures = Model.SupportedCultures
            .Where(value => !string.Equals(value, culture, StringComparison.OrdinalIgnoreCase))
            .ToArray();
        EnsureDefaultCulture();
    }

    private async Task SaveAsync()
    {
        if (Model is null) return;
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var saved = await Api.Crest.Rest.Localization.SaveAsync(Model);
            if (saved is null)
            {
                throw new InvalidOperationException(T.T("Localization_SaveFailedMessage", "Orchard did not save the culture settings. Verify custom culture codes and your permission to manage cultures."));
            }

            Model = saved;
            EnsureDefaultCulture();
            Notifications.Notify(NotificationSeverity.Success, T.T("Localization_Heading", "Cultures"), T.T("Localization_SavedMessage", "Orchard culture settings were saved. The tenant reloads these settings for new requests."));
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenTranslations() => NavigationManager.NavigateTo("DataLocalization/Index");

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private void EnsureDefaultCulture()
    {
        if (Model is null || Model.SupportedCultures.Length == 0) return;
        if (!Model.SupportedCultures.Contains(Model.DefaultCulture, StringComparer.OrdinalIgnoreCase))
        {
            Model.DefaultCulture = Model.SupportedCultures[0];
        }

        // Unlike DefaultCulture, AdminDefaultCulture is optional - if the culture it pointed
        // at was just removed from the supported list, clear it back to "no override" rather
        // than reassigning it to some other culture the admin didn't choose.
        if (!string.IsNullOrWhiteSpace(Model.AdminDefaultCulture) &&
            !Model.SupportedCultures.Contains(Model.AdminDefaultCulture, StringComparer.OrdinalIgnoreCase))
        {
            Model.AdminDefaultCulture = null;
        }
    }

    private CrestCulture ToCulture(string value) => Model?.AvailableCultures.FirstOrDefault(culture =>
        string.Equals(culture.Value, value, StringComparison.OrdinalIgnoreCase))
        ?? new CrestCulture(value, string.IsNullOrEmpty(value) ? T.T("Localization_InvariantCulture", "Invariant culture") : value, value);

    private static string DisplayCultureName(CrestCulture culture) => string.IsNullOrWhiteSpace(culture.NativeLabel)
        ? culture.Label
        : $"{culture.NativeLabel} ({culture.Label})";
}
