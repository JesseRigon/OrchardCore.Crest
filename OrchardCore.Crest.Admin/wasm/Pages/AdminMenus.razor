@page "/AdminMenus"
@page "/AdminMenu"
@page "/AdminMenu/List"
@using Crest.Admin.Api
@using Crest.Admin.Components.Admin
@using Crest.Admin.Components.Shared
@using Crest.Admin.DisplayManagement
@using Crest.Components.Inputs
@using Crest.Icons
@using Crest.Icons.Components
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@implements IAsyncDisposable
@inject IApi Api
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject DisplayManager DisplayManager
@inject ClientIconRegistry ClientIcons
@inject Crest.Components.Theme.CrestApiLocalizer T

    <CascadingValue Value="DragDrop">
        <CrestStack Gap="1rem">
                    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                        <CrestStack Gap="0.25rem">
                            <CrestText TextStyle="TextStyle.H4" Text="@T.T("AdminMenus_Title", "Admin Menus")" />
                            <CrestText TextStyle="TextStyle.Body2" Text="@T.T("AdminMenus_Description", "Manage Orchard admin menu nodes with drag-and-drop ordering and a parent-node fallback selector.")" />
                        </CrestStack>
                        <CrestButton Text="@T.T("AdminMenus_Refresh", "Refresh")" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="@(() => LoadAsync())" Disabled="@IsBusy" />
                    </CrestStack>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
                            @ErrorMessage
                        </CrestAlert>
                    }

                    @if (IsLoading)
                    {
                        <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <CrestProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                            <CrestText Text="@T.T("AdminMenus_Loading", "Loading admin menus...")" />
                        </CrestStack>
                    }
                    else
                    {
                        <CrestRow Gap="1rem">
                            <CrestColumn Size="12" SizeLG="4">
                                <CrestCard>
                                    <CrestStack Gap="0.75rem">
                                        <CrestText TextStyle="TextStyle.H6" Text="@T.T("AdminMenus_MenusHeading", "Menus")" />
                                        <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <CrestTextBox @bind-Value="MenuSearch" Placeholder="@T.T("AdminMenus_SearchPlaceholder", "Search menus...")" Style="width: 100%;" />
                                            <div class="admin-menu-actions">
                                                <CrestButton Icon="add" ButtonStyle="ButtonStyle.Primary" Click="ToggleCreateMenuPopover" Disabled="@IsBusy" title="@T.T("AdminMenus_AddMenuTitle", "Add menu")" />
                                                @if (IsCreateMenuOpen)
                                                {
                                                    <div class="admin-menu-actions__popover" role="menu">
                                                        <CrestButton Text="@T.T("AdminMenus_AdminMenuOption", "Admin Menu")" Icon="add" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => CreateMenuAsync(CrestMenuPlacement.Admin))" />
                                                        <CrestButton Text="@T.T("AdminMenus_LocalMenuOption", "Local Menu")" Icon="add" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => CreateMenuAsync(CrestMenuPlacement.Local))" />
                                                        <CrestButton Text="@T.T("AdminMenus_UserProfileMenuOption", "User Profile Menu")" Icon="add" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => CreateMenuAsync(CrestMenuPlacement.User))" />
                                                    </div>
                                                }
                                            </div>
                                        </CrestStack>
                                        @if (FilteredMenus.Length == 0)
                                        {
                                            <CrestText Text="@T.T("AdminMenus_NoneFound", "No admin menus found.")" />
                                        }
                                        else
                                        {
                                            <CrestStack Gap="0.35rem">
                                                @foreach (var menu in FilteredMenus)
                                                {
                                                    <div class="admin-menu-list-item @(menu.Id == SelectedMenuId ? "admin-menu-list-item--selected" : null) @(!menu.Enabled ? "admin-menu-list-item--disabled" : null)">
                                                        @if (RenamingMenuId == menu.Id)
                                                        {
                                                            <CrestTextBox @bind-Value="MenuRenameText" class="admin-menu-list-item__rename-input" @oninput="UpdateMenuRenameText" @onkeydown="HandleMenuRenameKeyDownAsync" />
                                                            <CrestButton Size="ButtonSize.Small" Icon="check" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="SaveMenuRenameAsync" Disabled="@IsBusy" title="@T.T("AdminMenus_SaveMenuNameTitle", "Save menu name")" />
                                                            <CrestButton Size="ButtonSize.Small" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="CancelMenuRename" Disabled="@IsBusy" title="@T.T("AdminMenus_CancelRenameTitle", "Cancel rename")" />
                                                        }
                                                        else
                                                        {
                                                            <CrestButton Text="@(menu.IsDefault ? string.Format(T.T("AdminMenus_BuiltInFormat", "{0} (Built In)"), menu.Name) : $"{menu.Name}{PlacementSuffix(menu)}")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => SelectMenu(menu.Id))" Style="justify-content: flex-start; flex: 1; min-width: 0;" />
                                                            <CrestButton Size="ButtonSize.Small" Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => StartMenuRename(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="@T.T("AdminMenus_RenameMenuTitle", "Rename menu")" />
                                                            @if (CanConvert(menu))
                                                            {
                                                                <CrestButton Size="ButtonSize.Small" Icon="swap_horiz" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => ConvertMenuAsync(menu))" Disabled="@IsBusy" title="@(menu.Placement == CrestMenuPlacement.Admin ? T.T("AdminMenus_ConvertToLocalTitle", "Convert to Local Menu") : T.T("AdminMenus_ConvertToAdminTitle", "Convert to Admin Menu"))" />
                                                            }
                                                            <CrestButton Size="ButtonSize.Small" Icon="@(menu.Enabled ? "visibility_off" : "visibility")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => ToggleMenuAsync(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="@(menu.Enabled ? T.T("AdminMenus_HideMenuTitle", "Hide menu") : T.T("AdminMenus_ShowMenuTitle", "Show menu"))" />
                                                            <CrestButton Size="ButtonSize.Small" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => DuplicateMenuAsync(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="@T.T("AdminMenus_DuplicateMenuTitle", "Duplicate menu")" />
                                                            <CrestButton Size="ButtonSize.Small" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(() => DeleteMenuAsync(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="@T.T("AdminMenus_DeleteMenuTitle", "Delete menu")" />
                                                        }
                                                    </div>
                                                }
                                            </CrestStack>
                                        }
                                    </CrestStack>
                                </CrestCard>
                            </CrestColumn>

                            <CrestColumn Size="12" SizeLG="8">
                                @if (SelectedMenu is null)
                                {
                                    <CrestCard>
                                        <CrestText Text="@T.T("AdminMenus_SelectPrompt", "Select an admin menu to edit its nodes.")" />
                                    </CrestCard>
                                }
                                else
                                {
                                    <CrestStack Gap="1rem">
                                        <CrestCard>
                                            <CrestStack Gap="0.85rem">
                                                <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                                                    <CrestStack Gap="0.2rem">
                                                        <CrestText TextStyle="TextStyle.H5" Text="@SelectedMenu.Name" />
                                                        <CrestText TextStyle="TextStyle.Caption" Text="@T.T("AdminMenus_DragHint", "Drag by the handle. Drop on the top/bottom edge to reorder, or center to make the item a child. Admin menus support up to 4 tiers.")" />
                                                    </CrestStack>
                                                    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="admin-menu-toolbar-actions">
                                                        @if (SelectedMenu.IsDefault)
                                                        {
                                                            <CrestButton Text="@T.T("AdminMenus_ExportJson", "Export JSON")" Icon="download" ButtonStyle="ButtonStyle.Light" Click="ExportLayoutAsync" Disabled="@(IsBusy || IsExportingLayout)" />
                                                            <CrestButton Text="@T.T("AdminMenus_PruneJson", "Prune JSON")" Icon="cleaning_services" ButtonStyle="ButtonStyle.Light" Click="PruneOverridesAsync" Disabled="@(IsBusy || IsPruningOverrides)" />
                                                        }
                                                        <CrestButton Text="@(AllNodesCollapsed ? T.T("AdminMenus_ExpandAll", "Expand All") : T.T("AdminMenus_CollapseAll", "Collapse All"))" Icon="@(AllNodesCollapsed ? "unfold_more" : "unfold_less")" ButtonStyle="ButtonStyle.Light" Click="ToggleCollapseAll" Disabled="@(IsBusy || SelectedMenu.Nodes.Length == 0)" />
                                                        <div class="admin-menu-actions">
                                                            <CrestButton Text="@T.T("AdminMenus_Add", "Add")" Icon="add" Click="ToggleAddMenu" Disabled="@IsBusy" />
                                                            @if (IsAddMenuOpen)
                                                            {
                                                                <div class="admin-menu-actions__popover" role="menu">
                                                                    <CrestButton Text="@T.T("AdminMenus_NodeOption", "Node")" Icon="add" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="AddNodeFromMenu" />
                                                                    @if (SelectedMenu.IsDefault)
                                                                    {
                                                                        <CrestButton Text="@T.T("AdminMenus_SeparatorOption", "Separator")" Icon="horizontal_rule" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="AddRootSeparatorFromMenuAsync" />
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                        @if (SelectedMenu.IsDefault)
                                                        {
                                                            <div class="admin-menu-actions">
                                                                <CrestButton Icon="settings" ButtonStyle="ButtonStyle.Light" Click="TogglePrimaryNavMenuSettings" title="@T.T("AdminMenus_PrimaryNavSettingsTitle", "Primary navigation settings")" />
                                                                @if (IsPrimaryNavMenuSettingsOpen)
                                                                {
                                                                    @PrimaryNavMenuSettingsFlyout()
                                                                }
                                                            </div>
                                                        }
                                                    </CrestStack>
                                                </CrestStack>

                                                <div @ref="TreeRoot" class="admin-menu-tree" data-menu-id="@SelectedMenu.Id">
                                                    @if (SelectedMenu.IsDefault)
                                                    {
                                                        <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                                            @T.T("AdminMenus_BuiltInSidebarHint", "Sidebar (Built In) is the generated Orchard admin menu plus Crest layout overrides. Drag items anywhere; hide/show only affects this tenant's sidebar. Add node creates lightweight placeholder groups only.")
                                                        </CrestAlert>
                                                    }
                                                    @if (EditingModel is not null && EditingNodeId is null)
                                                    {
                                                        @NodeEditor(T.T("AdminMenus_AddNodeTitle", "Add admin menu node"), EditingModel)
                                                    }
                                                    @if (SelectedMenu.Nodes.Length == 0)
                                                    {
                                                        <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                                            @T.T("AdminMenus_NoNodesYet", "This admin menu does not have any nodes yet.")
                                                        </CrestAlert>
                                                    }
                                                    else
                                                    {
                                                        <ol class="admin-menu-tree__list admin-menu-tree__list--root">
                                                            @foreach (var entry in MenuEntries(null, SelectedMenu.Nodes))
                                                            {
                                                                @(entry.Node is not null ? NodeItem(entry.Node) : SeparatorItem(entry.Separator!))
                                                            }
                                                        </ol>
                                                    }
                                                </div>
                                            </CrestStack>
                                        </CrestCard>
                                    </CrestStack>
                                }
                            </CrestColumn>
                        </CrestRow>
                    }
        </CrestStack>
    </CascadingValue>


@code {
    private const string LinkNodeType = "LinkAdminNode";
    private const string PlaceholderNodeType = "PlaceholderAdminNode";
    private const string LockedNewNodeId = "new";
    private const int MaxMenuTiers = 4;
    private const int MaxNodeDepth = MaxMenuTiers - 1;
    private static readonly CrestMeasurementUnitOption[] CssSizeUnits =
    [
        new("rem", "rem"),
        new("em", "em"),
        new("px", "px"),
        new("%", "%"),
        new("vh", "vh"),
        new("vw", "vw"),
    ];
    // More positions are expected later (other anchor corners, responsive-size-specific
    // choices) — this list is intentionally not exhaustive. A property (not a static
    // readonly field) since it depends on T, which isn't set yet during field
    // initializer execution (constructor runs before [Inject] properties are assigned).
    private CollapseIconPositionOption[] CollapseIconPositionOptions =>
    [
        new(Crest.Admin.Api.PrimaryNavMenuCollapseIconPosition.OutsideBottomRight, T.T("AdminMenus_OutsideBottomRightOption", "Outside, bottom-right")),
        new(Crest.Admin.Api.PrimaryNavMenuCollapseIconPosition.InsideBottomLeft, T.T("AdminMenus_InsideBottomLeftOption", "Inside, bottom-left")),
    ];

    private readonly DragDropManager DragDrop = new();
    private readonly HashSet<string> CollapsedNodeIds = [];
    private NodeTypeOption[] NodeTypes =>
    [
        new(LinkNodeType, T.T("AdminMenus_LinkTypeLabel", "Link")),
        new(PlaceholderNodeType, T.T("AdminMenus_PlaceholderTypeLabel", "Placeholder")),
    ];

    private AdminMenusState State { get; set; } = AdminMenusState.Empty;
    private string? SelectedMenuId { get; set; }
    private string? MenuSearch { get; set; }
    private AdminMenuSummary[] FilteredMenus => string.IsNullOrWhiteSpace(MenuSearch)
        ? State.Menus
        : State.Menus.Where(menu => menu.Name.Contains(MenuSearch, StringComparison.OrdinalIgnoreCase)).ToArray();
    private AdminMenuSummary? SelectedMenu => State.Menus.FirstOrDefault(menu => menu.Id == SelectedMenuId) ?? State.Menus.FirstOrDefault();
    private NodeTypeOption[] AvailableNodeTypes => SelectedMenu?.IsDefault == true ? [new(PlaceholderNodeType, T.T("AdminMenus_PlaceholderTypeLabel", "Placeholder"))] : NodeTypes;
    private bool AllNodesCollapsed => SelectedMenu is not null && Flatten(SelectedMenu.Nodes).Where(node => node.Items.Length > 0).All(node => CollapsedNodeIds.Contains(node.Id));
    private bool IsEditingNewBranch => IsNewBranchNode(EditingNodeId);
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }
    private bool IsExportingLayout { get; set; }
    private bool IsPruningOverrides { get; set; }
    private string? ErrorMessage { get; set; }
    private ElementReference TreeRoot;
    private DotNetObjectReference<AdminMenus>? DotNetRef;
    private HubConnection? AdminMenuLayoutHub;
    private bool ShouldInitializeTree { get; set; }
    private string? EditingNodeId { get; set; }
    private AdminMenuNodeFormModel? EditingModel { get; set; }
    private string? RenamingMenuId { get; set; }
    private string? MenuRenameText { get; set; }
    private string? RenamingNodeId { get; set; }
    private string? RenameText { get; set; }
    private bool IsAddMenuOpen { get; set; }
    private bool IsCreateMenuOpen { get; set; }
    private bool IsPrimaryNavMenuSettingsOpen { get; set; }
    private AdminPrimaryNavMenuSettings PrimaryNavMenuSettingsModel { get; set; } = CreateDefaultPrimaryNavMenuSettings();
    private decimal PrimaryNavMenuExpansionMilliseconds
    {
        get => PrimaryNavMenuSettingsModel.ExpansionDurationMilliseconds;
        set => PrimaryNavMenuSettingsModel.ExpansionDurationMilliseconds = (int)Math.Clamp(value, 100, 2000);
    }

    private IReadOnlyList<ParentOption> ParentOptions
    {
        get
        {
            if (SelectedMenu is null)
            {
                return [];
            }

            var options = new List<ParentOption>();
            if (CanPlaceNodeUnder(EditingNodeId, null))
            {
                options.Add(new ParentOption(string.Empty, T.T("AdminMenus_RootLevelPlaceholder", "Root level")));
            }

            options.AddRange(Flatten(SelectedMenu.Nodes)
                .Where(node => node.Id != EditingNodeId && !IsNewBranchNode(node) && !IsDescendantOf(node, EditingNodeId) && CanPlaceNodeUnder(EditingNodeId, node.Id))
                .Select(node => new ParentOption(node.Id, $"{new string('—', node.Depth)} {node.Text} ({NodeTypeLabel(node.Type)})")));

            return options;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await StartAdminMenuLayoutHubAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedMenu is not null && (firstRender || ShouldInitializeTree))
        {
            DotNetRef ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("crestAdminMenus.init", ".admin-menu-tree", DotNetRef);
            ShouldInitializeTree = false;
        }
    }

    private async Task LoadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            IsLoading = true;
            IsBusy = true;
        }

        ErrorMessage = null;

        try
        {
            State = await Api.Crest.Rest.AdminMenus.ListAsync();
            RegisterMenuIcons(State.Menus);
            SelectedMenuId ??= State.Menus.FirstOrDefault()?.Id;
            if (SelectedMenuId is not null && State.Menus.All(menu => menu.Id != SelectedMenuId))
            {
                SelectedMenuId = State.Menus.FirstOrDefault()?.Id;
            }

            if (showLoading)
            {
                CollapseSelectedMenuNodes();
            }

            SyncPrimaryNavMenuSettingsModel();
            ShouldInitializeTree = true;
            await DisplayManager.RefreshAdminMenuAsync();
        }
        catch (Exception ex)
        {
            if (showLoading)
            {
                ErrorMessage = ex.Message;
            }
        }
        finally
        {
            if (showLoading)
            {
                IsLoading = false;
                IsBusy = false;
            }
        }
    }

    private async Task StartAdminMenuLayoutHubAsync()
    {
        // Browser-only: this runs from OnInitializedAsync, which also executes during
        // static SSR prerender and the InteractiveServer circuit phase - both on the
        // server, where this HubConnection would be an outbound server-to-self connection
        // carrying none of the user's auth cookies (and during prerender it would just
        // burn a failed negotiate while blocking the request). The WASM phase re-runs
        // this init in the browser, where the connection authenticates via the ambient
        // cookies; until then the manual Refresh button covers layout invalidation.
        if (!OperatingSystem.IsBrowser())
        {
            return;
        }

        if (AdminMenuLayoutHub is not null)
        {
            return;
        }

        // Base-relative: the server middleware strips the shell base off
        // "{shellBase}/api/..." - see DisplayManager.StartPermissionRefreshAsync for
        // the same pattern and rationale.
        AdminMenuLayoutHub = new HubConnectionBuilder()
            .WithUrl(new Uri(new Uri(Navigation.BaseUri), "api/crest/admin-menu-layout"))
            .WithAutomaticReconnect()
            .Build();

        AdminMenuLayoutHub.On("adminMenuLayoutInvalidated", async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync(showLoading: false);
                StateHasChanged();
            });
        });

        try
        {
            await AdminMenuLayoutHub.StartAsync();
        }
        catch
        {
            // Manual refresh remains available if SignalR is unavailable.
        }
    }

    private async Task ExportLayoutAsync()
    {
        IsExportingLayout = true;

        try
        {
            var result = await Api.Crest.Rest.AdminMenus.ExportLayoutAsync();
            if (result is null)
            {
                Notifications.Notify(NotificationSeverity.Error, T.T("AdminMenus_ExportFailedTitle", "Primary navigation export failed"), T.T("AdminMenus_ExportUnavailable", "The development export endpoint was not available or rejected the request."));
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T.T("AdminMenus_ExportedTitle", "Primary navigation exported"), string.Format(T.T("AdminMenus_ExportedMessageFormat", "{0} saved with {1} layout items, {2} custom items, and {3} separators."), result.File, result.ItemCount, result.CustomItemCount, result.SeparatorCount));
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, T.T("AdminMenus_ExportFailedTitle", "Primary navigation export failed"), ex.Message);
        }
        finally
        {
            IsExportingLayout = false;
        }
    }

    private async Task PruneOverridesAsync()
    {
        if (SelectedMenu is null || !SelectedMenu.IsDefault)
        {
            return;
        }

        IsPruningOverrides = true;

        try
        {
            await ApplyMenuResultAsync(await Api.Crest.Rest.AdminMenus.PruneOverridesAsync(SelectedMenu.Id));
            Notifications.Notify(NotificationSeverity.Success, T.T("AdminMenus_PrunedTitle", "Layout overrides cleaned up"), T.T("AdminMenus_PrunedMessage", "Removed any saved overrides that no longer match a current menu item."));
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, T.T("AdminMenus_PruneFailedTitle", "Cleanup failed"), ex.Message);
        }
        finally
        {
            IsPruningOverrides = false;
        }
    }

    private void SelectMenu(string? menuId = null)
    {
        if (!string.IsNullOrWhiteSpace(menuId))
        {
            SelectedMenuId = menuId;
        }

        EditingNodeId = null;
        EditingModel = null;
        RenamingNodeId = null;
        RenameText = null;
        RenamingMenuId = null;
        MenuRenameText = null;
        IsAddMenuOpen = false;
        IsPrimaryNavMenuSettingsOpen = false;
        SyncPrimaryNavMenuSettingsModel();
        CollapseSelectedMenuNodes();
        ShouldInitializeTree = true;
    }

    private void ToggleCreateMenuPopover()
    {
        IsCreateMenuOpen = !IsCreateMenuOpen;
    }

    private static string PlacementBaseName(CrestMenuPlacement placement) => placement switch
    {
        CrestMenuPlacement.Local => "New Local Menu",
        CrestMenuPlacement.User => "New User Profile Menu",
        _ => "New Admin Menu",
    };

    private string PlacementSuffix(AdminMenuSummary menu) => menu.Placement switch
    {
        CrestMenuPlacement.Local => " " + T.T("AdminMenus_LocalSuffix", "(Local)"),
        CrestMenuPlacement.User => " " + T.T("AdminMenus_UserProfileSuffix", "(User Profile)"),
        _ => string.Empty,
    };

    // Admin and Local menus share the same underlying storage/rendering and can be
    // converted into each other. A User Profile Menu is stable once created.
    private static bool CanConvert(AdminMenuSummary menu) => !menu.IsDefault && menu.Placement != CrestMenuPlacement.User;

    private async Task CreateMenuAsync(CrestMenuPlacement placement)
    {
        IsCreateMenuOpen = false;
        var baseName = PlacementBaseName(placement);
        var name = baseName;
        var index = 2;
        while (State.Menus.Any(menu => menu.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            name = $"{baseName} {index++}";
        }

        var menu = await Api.Crest.Rest.AdminMenus.CreateMenuAsync(new(name, true, placement));
        if (menu is not null)
        {
            State = new([.. State.Menus, menu]);
            SelectedMenuId = menu.Id;
            Notifications.Notify(NotificationSeverity.Success, T.T("AdminMenus_CreatedTitle", "Admin menu created"), name);
        }
    }

    private async Task ConvertMenuAsync(AdminMenuSummary menu)
    {
        var targetPlacement = menu.Placement == CrestMenuPlacement.Admin ? CrestMenuPlacement.Local : CrestMenuPlacement.Admin;
        var converted = await Api.Crest.Rest.AdminMenus.ConvertMenuAsync(menu.Id, new(targetPlacement));
        if (converted is not null)
        {
            State = new([.. State.Menus.Select(m => m.Id == converted.Id ? converted : m)]);
            Notifications.Notify(NotificationSeverity.Success, T.T("AdminMenus_ConvertedTitle", "Menu converted"), converted.Name);
        }
    }

    private void StartMenuRename(AdminMenuSummary menu)
    {
        if (menu.IsDefault)
        {
            return;
        }

        SelectedMenuId = menu.Id;
        RenamingMenuId = menu.Id;
        MenuRenameText = menu.Name;
        EditingNodeId = null;
        EditingModel = null;
        RenamingNodeId = null;
        RenameText = null;
    }

    private void CancelMenuRename()
    {
        RenamingMenuId = null;
        MenuRenameText = null;
    }

    private void UpdateMenuRenameText(ChangeEventArgs args)
    {
        MenuRenameText = args.Value?.ToString();
    }

    private async Task HandleMenuRenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveMenuRenameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelMenuRename();
        }
    }

    private async Task SaveMenuRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(RenamingMenuId))
        {
            return;
        }

        var current = State.Menus.FirstOrDefault(menu => menu.Id == RenamingMenuId);
        if (current is null)
        {
            CancelMenuRename();
            return;
        }

        IsBusy = true;
        var updated = await Api.Crest.Rest.AdminMenus.RenameMenuAsync(RenamingMenuId, new(MenuRenameText, current.Enabled));
        if (updated is not null)
        {
            State = new(State.Menus.Select(existing => existing.Id == updated.Id ? updated : existing).ToArray());
            SelectedMenuId = updated.Id;
            CancelMenuRename();
            Notifications.Notify(NotificationSeverity.Success, T.T("AdminMenus_RenamedTitle", "Admin menu renamed"), updated.Name);
            await DisplayManager.RefreshAdminMenuAsync();
        }
        else
        {
            Notifications.Notify(NotificationSeverity.Error, T.T("AdminMenus_RenameFailedTitle", "Admin menu rename failed"), T.T("AdminMenus_RenameFailedMessage", "The server could not update the menu name."));
        }

        IsBusy = false;
    }

    private async Task ToggleMenuAsync(AdminMenuSummary menu)
    {
        var updated = await Api.Crest.Rest.AdminMenus.ToggleMenuAsync(menu.Id);
        if (updated is not null)
        {
            State = new(State.Menus.Select(existing => existing.Id == updated.Id ? updated : existing).ToArray());
            Notifications.Notify(NotificationSeverity.Success, updated.Enabled ? T.T("AdminMenus_ShownTitle", "Admin menu shown") : T.T("AdminMenus_HiddenTitle", "Admin menu hidden"), updated.Name);
            await DisplayManager.RefreshAdminMenuAsync();
        }
    }

    private async Task DuplicateMenuAsync(AdminMenuSummary menu)
    {
        var copy = await Api.Crest.Rest.AdminMenus.DuplicateMenuAsync(menu.Id);
        if (copy is not null)
        {
            State = new([.. State.Menus, copy]);
            SelectedMenuId = copy.Id;
            Notifications.Notify(NotificationSeverity.Success, T.T("AdminMenus_DuplicatedTitle", "Admin menu duplicated"), copy.Name);
        }
    }

    private async Task DeleteMenuAsync(AdminMenuSummary menu)
    {
        if (await Api.Crest.Rest.AdminMenus.DeleteMenuAsync(menu.Id))
        {
            State = new(State.Menus.Where(existing => existing.Id != menu.Id).ToArray());
            SelectedMenuId = State.Menus.FirstOrDefault()?.Id;
            Notifications.Notify(NotificationSeverity.Success, T.T("AdminMenus_DeletedTitle", "Admin menu deleted"), menu.Name);
            await DisplayManager.RefreshAdminMenuAsync();
        }
    }

