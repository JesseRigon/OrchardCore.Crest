@page "/Admin/AdminMenus"
@page "/Admin/AdminMenu"
@page "/Admin/AdminMenu/List"
@using Crest.Admin.Api
@using Crest.Admin.Components.Admin
@using Crest.Admin.Components.Shared
@using Crest.Admin.DisplayManagement
@using Crest.Icons.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Radzen
@using Radzen.Blazor
@implements IAsyncDisposable
@inject IApi Api
@inject IJSRuntime Js
@inject NotificationService Notifications
@inject DisplayManager DisplayManager

    <CascadingValue Value="DragDrop">
        <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.H4" Text="Admin Menus" />
                            <RadzenText TextStyle="TextStyle.Body2" Text="Manage Orchard admin menu nodes with drag-and-drop ordering and a parent-node fallback selector." />
                        </RadzenStack>
                        <RadzenButton Text="Refresh" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="@(() => LoadAsync())" Disabled="@IsBusy" />
                    </RadzenStack>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
                            @ErrorMessage
                        </RadzenAlert>
                    }

                    @if (IsLoading)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                            <RadzenText Text="Loading admin menus..." />
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeLG="4">
                                <RadzenCard>
                                    <RadzenStack Gap="0.75rem">
                                        <RadzenText TextStyle="TextStyle.H6" Text="Menus" />
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenTextBox @bind-Value="MenuSearch" Placeholder="Search menus..." Style="width: 100%;" />
                                            <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Primary" Click="CreateMenuAsync" Disabled="@IsBusy" title="Add menu" />
                                        </RadzenStack>
                                        @if (FilteredMenus.Length == 0)
                                        {
                                            <RadzenText Text="No admin menus found." />
                                        }
                                        else
                                        {
                                            <RadzenStack Gap="0.35rem">
                                                @foreach (var menu in FilteredMenus)
                                                {
                                                    <div class="admin-menu-list-item @(menu.Id == SelectedMenuId ? "admin-menu-list-item--selected" : null) @(!menu.Enabled ? "admin-menu-list-item--disabled" : null)">
                                                        @if (RenamingMenuId == menu.Id)
                                                        {
                                                            <RadzenTextBox @bind-Value="MenuRenameText" class="admin-menu-list-item__rename-input" @oninput="UpdateMenuRenameText" @onkeydown="HandleMenuRenameKeyDownAsync" />
                                                            <RadzenButton Size="ButtonSize.Small" Icon="check" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="SaveMenuRenameAsync" Disabled="@IsBusy" title="Save menu name" />
                                                            <RadzenButton Size="ButtonSize.Small" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="CancelMenuRename" Disabled="@IsBusy" title="Cancel rename" />
                                                        }
                                                        else
                                                        {
                                                            <RadzenButton Text="@(menu.IsDefault ? $"{menu.Name} (built-in)" : menu.Name)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => SelectMenu(menu.Id))" Style="justify-content: flex-start; flex: 1; min-width: 0;" />
                                                            <RadzenButton Size="ButtonSize.Small" Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => StartMenuRename(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="Rename menu" />
                                                            <RadzenButton Size="ButtonSize.Small" Icon="@(menu.Enabled ? "visibility_off" : "visibility")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => ToggleMenuAsync(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="@(menu.Enabled ? "Hide menu" : "Show menu")" />
                                                            <RadzenButton Size="ButtonSize.Small" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => DuplicateMenuAsync(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="Duplicate menu" />
                                                            <RadzenButton Size="ButtonSize.Small" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(() => DeleteMenuAsync(menu))" Disabled="@(IsBusy || menu.IsDefault)" title="Delete menu" />
                                                        }
                                                    </div>
                                                }
                                            </RadzenStack>
                                        }
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeLG="8">
                                @if (SelectedMenu is null)
                                {
                                    <RadzenCard>
                                        <RadzenText Text="Select an admin menu to edit its nodes." />
                                    </RadzenCard>
                                }
                                else
                                {
                                    <RadzenStack Gap="1rem">
                                        <RadzenCard>
                                            <RadzenStack Gap="0.85rem">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                                                    <RadzenStack Gap="0.2rem">
                                                        <RadzenText TextStyle="TextStyle.H5" Text="@SelectedMenu.Name" />
                                                        <RadzenText TextStyle="TextStyle.Caption" Text="Drag by the handle. Drop on the top/bottom edge to reorder, or center to make the item a child. Admin menus support up to 4 tiers." />
                                                    </RadzenStack>
                                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                        @if (SelectedMenu.IsDefault)
                                                        {
                                                            <RadzenButton Text="Export layout JSON" Icon="download" ButtonStyle="ButtonStyle.Light" Click="ExportLayoutAsync" Disabled="@(IsBusy || IsExportingLayout)" />
                                                        }
                                                        <RadzenButton Text="@(AllNodesCollapsed ? "Expand All" : "Collapse All")" Icon="@(AllNodesCollapsed ? "unfold_more" : "unfold_less")" ButtonStyle="ButtonStyle.Light" Click="ToggleCollapseAll" Disabled="@(IsBusy || SelectedMenu.Nodes.Length == 0)" />
                                                        <RadzenButton Text="Add node" Icon="add" Click="AddNode" Disabled="@IsBusy" />
                                                    </RadzenStack>
                                                </RadzenStack>

                                                <div @ref="TreeRoot" class="admin-menu-tree" data-menu-id="@SelectedMenu.Id">
                                                    @if (SelectedMenu.IsDefault)
                                                    {
                                                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                                            Sidebar Layout is the generated Orchard admin sidebar plus Crest layout overrides. Drag items anywhere; hide/show only affects this tenant's sidebar layout. Add node creates lightweight placeholder groups only.
                                                        </RadzenAlert>
                                                    }
                                                    @if (EditingModel is not null && EditingNodeId is null)
                                                    {
                                                        @NodeEditor("Add admin menu node", EditingModel)
                                                    }
                                                    @if (SelectedMenu.Nodes.Length == 0)
                                                    {
                                                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                                            This admin menu does not have any nodes yet.
                                                        </RadzenAlert>
                                                    }
                                                    else
                                                    {
                                                        <ol class="admin-menu-tree__list admin-menu-tree__list--root">
                                                            @foreach (var node in SelectedMenu.Nodes)
                                                            {
                                                                @NodeItem(node)
                                                            }
                                                        </ol>
                                                    }
                                                </div>
                                            </RadzenStack>
                                        </RadzenCard>
                                    </RadzenStack>
                                }
                            </RadzenColumn>
                        </RadzenRow>
                    }
        </RadzenStack>
    </CascadingValue>


<style>
    .admin-menu-list-item {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        border: 1px solid var(--rz-border-color);
        border-radius: var(--rz-border-radius);
        padding: 0.15rem;
    }

    .admin-menu-list-item--selected {
        border-color: var(--rz-primary);
        background: color-mix(in srgb, var(--rz-primary) 8%, transparent);
    }

    .admin-menu-list-item--disabled {
        opacity: 0.55;
    }

    .admin-menu-list-item__rename-input {
        flex: 1;
        min-width: 0;
    }

    .admin-menu-list-item .rz-button,
    .admin-menu-list-item .rz-button-text {
        color: var(--rz-text-color) !important;
    }

    .admin-menu-list-item--selected .rz-button,
    .admin-menu-list-item--selected .rz-button-text {
        color: var(--rz-primary) !important;
        font-weight: 600;
    }

    .admin-menu-tree__list {
        list-style: none;
        margin: 0;
        padding-left: 1.25rem;
    }

    .admin-menu-tree__list--root {
        padding-left: 0;
    }

    .admin-menu-tree__item {
        margin: 0.45rem 0;
    }

    .admin-menu-node {
        position: relative;
        border: 1px solid var(--rz-border-color);
        border-radius: var(--rz-border-radius);
        background: var(--rz-base-background-color);
        padding: 0.65rem;
        transition: border-color .12s ease, box-shadow .12s ease, background .12s ease;
    }

    .admin-menu-node--locked {
        opacity: 0.55;
        background: color-mix(in srgb, var(--rz-text-secondary-color, #6b7280) 8%, var(--rz-base-background-color));
    }

    .admin-menu-node--locked .admin-menu-node__handle {
        cursor: not-allowed;
    }

    .admin-menu-node__handle {
        cursor: grab;
        color: var(--rz-text-secondary-color);
        border: 1px dashed var(--rz-border-color);
        border-radius: 999px;
        padding: 0.15rem 0.35rem;
        user-select: none;
    }

    .admin-menu-node__handle:active {
        cursor: grabbing;
    }

    .admin-menu-node__spacer {
        display: inline-block;
        width: 2rem;
    }

    .admin-menu-node__collapse,
    .admin-menu-node__collapse .rz-button-icon {
        color: var(--rz-text-color) !important;
    }

    .admin-menu-node--drop-before > .admin-menu-node::before,
    .admin-menu-node--drop-after > .admin-menu-node::after {
        content: '';
        position: absolute;
        left: 0.65rem;
        right: 0.65rem;
        height: 3px;
        background: var(--rz-primary);
        border-radius: 999px;
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--rz-primary) 20%, transparent);
    }

    .admin-menu-node--drop-before > .admin-menu-node::before {
        top: -3px;
    }

    .admin-menu-node--drop-after > .admin-menu-node::after {
        bottom: -3px;
    }

    .admin-menu-node--drop-inside > .admin-menu-node {
        border-color: var(--rz-primary);
        background: color-mix(in srgb, var(--rz-primary) 8%, var(--rz-base-background-color));
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--rz-primary) 18%, transparent);
    }

    .admin-menu-node__rename {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
    }

    .admin-menu-node__rename-input {
        width: min(24rem, 55vw);
    }

    .admin-menu-node__original-text {
        color: var(--rz-text-secondary-color);
        text-decoration: line-through;
        opacity: 0.75;
    }

    .admin-menu-node-editor {
        position: relative;
        z-index: 5;
        margin: 0.5rem 0 0.75rem 2.25rem;
        padding: 1rem;
        border: 1px solid var(--rz-primary);
        border-radius: var(--rz-border-radius);
        background: var(--rz-base-background-color, #fff);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
    }
</style>

@code {
    private const string LinkNodeType = "LinkAdminNode";
    private const string PlaceholderNodeType = "PlaceholderAdminNode";
    private const string LockedNewNodeId = "new";
    private const int MaxMenuTiers = 4;
    private const int MaxNodeDepth = MaxMenuTiers - 1;

    private readonly DragDropManager DragDrop = new();
    private readonly HashSet<string> CollapsedNodeIds = [];
    private readonly NodeTypeOption[] NodeTypes =
    [
        new(LinkNodeType, "Link"),
        new(PlaceholderNodeType, "Placeholder"),
    ];

    private AdminMenusState State { get; set; } = AdminMenusState.Empty;
    private string? SelectedMenuId { get; set; }
    private string? MenuSearch { get; set; }
    private AdminMenuSummary[] FilteredMenus => string.IsNullOrWhiteSpace(MenuSearch)
        ? State.Menus
        : State.Menus.Where(menu => menu.Name.Contains(MenuSearch, StringComparison.OrdinalIgnoreCase)).ToArray();
    private AdminMenuSummary? SelectedMenu => State.Menus.FirstOrDefault(menu => menu.Id == SelectedMenuId) ?? State.Menus.FirstOrDefault();
    private NodeTypeOption[] AvailableNodeTypes => SelectedMenu?.IsDefault == true ? [new(PlaceholderNodeType, "Placeholder")] : NodeTypes;
    private bool AllNodesCollapsed => SelectedMenu is not null && Flatten(SelectedMenu.Nodes).Where(node => node.Items.Length > 0).All(node => CollapsedNodeIds.Contains(node.Id));
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }
    private bool IsExportingLayout { get; set; }
    private string? ErrorMessage { get; set; }
    private ElementReference TreeRoot;
    private DotNetObjectReference<AdminMenus>? DotNetRef;
    private CancellationTokenSource? PollingCts;
    private bool ShouldInitializeTree { get; set; }
    private string? EditingNodeId { get; set; }
    private AdminMenuNodeFormModel? EditingModel { get; set; }
    private string? RenamingMenuId { get; set; }
    private string? MenuRenameText { get; set; }
    private string? RenamingNodeId { get; set; }
    private string? RenameText { get; set; }

    private IReadOnlyList<ParentOption> ParentOptions
    {
        get
        {
            if (SelectedMenu is null)
            {
                return [];
            }

            var options = new List<ParentOption>();
            if (CanPlaceNodeUnder(EditingNodeId, null))
            {
                options.Add(new ParentOption(string.Empty, "Root level"));
            }

            options.AddRange(Flatten(SelectedMenu.Nodes)
                .Where(node => node.Id != EditingNodeId && !IsLockedNode(node) && !IsDescendantOf(node, EditingNodeId) && CanPlaceNodeUnder(EditingNodeId, node.Id))
                .Select(node => new ParentOption(node.Id, $"{new string('—', node.Depth)} {node.Text} ({NodeTypeLabel(node.Type)})")));

            return options;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        PollingCts = new CancellationTokenSource();
        _ = PollForExternalChangesAsync(PollingCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedMenu is not null && (firstRender || ShouldInitializeTree))
        {
            DotNetRef ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("crestAdminMenus.init", ".admin-menu-tree", DotNetRef);
            ShouldInitializeTree = false;
        }
    }

    private async Task LoadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            IsLoading = true;
            IsBusy = true;
        }

        ErrorMessage = null;

        try
        {
            State = await Api.Crest.Rest.AdminMenus.ListAsync();
            SelectedMenuId ??= State.Menus.FirstOrDefault()?.Id;
            if (SelectedMenuId is not null && State.Menus.All(menu => menu.Id != SelectedMenuId))
            {
                SelectedMenuId = State.Menus.FirstOrDefault()?.Id;
            }

            if (showLoading)
            {
                CollapseSelectedMenuNodes();
            }

            ShouldInitializeTree = true;
            await DisplayManager.RefreshAdminMenuAsync();
        }
        catch (Exception ex)
        {
            if (showLoading)
            {
                ErrorMessage = ex.Message;
            }
        }
        finally
        {
            if (showLoading)
            {
                IsLoading = false;
                IsBusy = false;
            }
        }
    }

    private async Task PollForExternalChangesAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (IsBusy || EditingModel is not null || RenamingNodeId is not null || RenamingMenuId is not null)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    await LoadAsync(showLoading: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normal during component disposal.
        }
    }

    private async Task ExportLayoutAsync()
    {
        IsExportingLayout = true;

        try
        {
            var result = await Api.Crest.Rest.AdminMenus.ExportLayoutAsync();
            if (result is null)
            {
                Notifications.Notify(NotificationSeverity.Error, "Sidebar layout export failed", "The development export endpoint was not available or rejected the request.");
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, "Sidebar layout exported", $"{result.File} saved with {result.ItemCount} layout items and {result.CustomItemCount} custom items.");
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Sidebar layout export failed", ex.Message);
        }
        finally
        {
            IsExportingLayout = false;
        }
    }

    private void SelectMenu(string? menuId = null)
    {
        if (!string.IsNullOrWhiteSpace(menuId))
        {
            SelectedMenuId = menuId;
        }

        EditingNodeId = null;
        EditingModel = null;
        RenamingNodeId = null;
        RenameText = null;
        RenamingMenuId = null;
        MenuRenameText = null;
        CollapseSelectedMenuNodes();
        ShouldInitializeTree = true;
    }

    private async Task CreateMenuAsync()
    {
        var baseName = "New Admin Menu";
        var name = baseName;
        var index = 2;
        while (State.Menus.Any(menu => menu.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            name = $"{baseName} {index++}";
        }

        var menu = await Api.Crest.Rest.AdminMenus.CreateMenuAsync(new(name, true));
        if (menu is not null)
        {
            State = new([.. State.Menus, menu]);
            SelectedMenuId = menu.Id;
            Notifications.Notify(NotificationSeverity.Success, "Admin menu created", name);
        }
    }

    private void StartMenuRename(AdminMenuSummary menu)
    {
        if (menu.IsDefault)
        {
            return;
        }

        SelectedMenuId = menu.Id;
        RenamingMenuId = menu.Id;
        MenuRenameText = menu.Name;
        EditingNodeId = null;
        EditingModel = null;
        RenamingNodeId = null;
        RenameText = null;
    }

    private void CancelMenuRename()
    {
        RenamingMenuId = null;
        MenuRenameText = null;
    }

    private void UpdateMenuRenameText(ChangeEventArgs args)
    {
        MenuRenameText = args.Value?.ToString();
    }

    private async Task HandleMenuRenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveMenuRenameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelMenuRename();
        }
    }

    private async Task SaveMenuRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(RenamingMenuId))
        {
            return;
        }

        var current = State.Menus.FirstOrDefault(menu => menu.Id == RenamingMenuId);
        if (current is null)
        {
            CancelMenuRename();
            return;
        }

        IsBusy = true;
        var updated = await Api.Crest.Rest.AdminMenus.RenameMenuAsync(RenamingMenuId, new(MenuRenameText, current.Enabled));
        if (updated is not null)
        {
            State = new(State.Menus.Select(existing => existing.Id == updated.Id ? updated : existing).ToArray());
            SelectedMenuId = updated.Id;
            CancelMenuRename();
            Notifications.Notify(NotificationSeverity.Success, "Admin menu renamed", updated.Name);
            await DisplayManager.RefreshAdminMenuAsync();
        }
        else
        {
            Notifications.Notify(NotificationSeverity.Error, "Admin menu rename failed", "The server could not update the menu name.");
        }

        IsBusy = false;
    }

    private async Task ToggleMenuAsync(AdminMenuSummary menu)
    {
        var updated = await Api.Crest.Rest.AdminMenus.ToggleMenuAsync(menu.Id);
        if (updated is not null)
        {
            State = new(State.Menus.Select(existing => existing.Id == updated.Id ? updated : existing).ToArray());
            Notifications.Notify(NotificationSeverity.Success, updated.Enabled ? "Admin menu shown" : "Admin menu hidden", updated.Name);
            await DisplayManager.RefreshAdminMenuAsync();
        }
    }

    private async Task DuplicateMenuAsync(AdminMenuSummary menu)
    {
        var copy = await Api.Crest.Rest.AdminMenus.DuplicateMenuAsync(menu.Id);
        if (copy is not null)
        {
            State = new([.. State.Menus, copy]);
            SelectedMenuId = copy.Id;
            Notifications.Notify(NotificationSeverity.Success, "Admin menu duplicated", copy.Name);
        }
    }

    private async Task DeleteMenuAsync(AdminMenuSummary menu)
    {
        if (await Api.Crest.Rest.AdminMenus.DeleteMenuAsync(menu.Id))
        {
            State = new(State.Menus.Where(existing => existing.Id != menu.Id).ToArray());
            SelectedMenuId = State.Menus.FirstOrDefault()?.Id;
            Notifications.Notify(NotificationSeverity.Success, "Admin menu deleted", menu.Name);
            await DisplayManager.RefreshAdminMenuAsync();
        }
    }

    private RenderFragment NodeItem(AdminMenuNodeSummary node) => @<li class="admin-menu-tree__item" data-node-id="@node.Id" data-locked="@IsLockedNode(node).ToString().ToLowerInvariant()">
        <div class="admin-menu-node @(IsLockedNode(node) ? "admin-menu-node--locked" : null)">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.65rem">
                    <span class="admin-menu-node__handle" draggable="@(!IsLockedNode(node) ? "true" : "false")" title="@(IsLockedNode(node) ? "The New menu branch is locked" : "Drag to move")">
                        <RadzenIcon Icon="drag_indicator" />
                    </span>
                    @if (node.Items.Length > 0)
                    {
                        <RadzenButton Size="ButtonSize.Small"
                                      Icon="@(IsCollapsed(node.Id) ? "chevron_right" : "expand_more")"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      class="admin-menu-node__collapse"
                                      Click="@(() => ToggleCollapsed(node.Id))"
                                      title="Expand/collapse" />
                    }
                    else
                    {
                        <span class="admin-menu-node__spacer"></span>
                    }
                    <RadzenStack Gap="0.15rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.45rem">
                            <Crest.Icons.Components.OrchardIcon IconClass="@node.IconClass" Size="1rem" BoxSize="1.25rem" Color="var(--rz-text-secondary-color, #6b7280)" Class="admin-menu-node__icon" />
                            @if (SelectedMenu?.IsDefault == true && RenamingNodeId == node.Id)
                            {
                                <span class="admin-menu-node__rename">
                                    <RadzenTextBox @bind-Value="RenameText" class="admin-menu-node__rename-input" @oninput="UpdateRenameText" @onkeydown="HandleRenameKeyDownAsync" />
                                    <span class="admin-menu-node__original-text">@OriginalNodeText(node)</span>
                                    <RadzenButton Size="ButtonSize.Small" Icon="check" ButtonStyle="ButtonStyle.Primary" Click="SaveRenameAsync" Disabled="@IsBusy" />
                                    <RadzenButton Size="ButtonSize.Small" Icon="close" ButtonStyle="ButtonStyle.Light" Click="CancelRename" Disabled="@IsBusy" />
                                </span>
                            }
                            else
                            {
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@node.Text" />
                                @if (!string.IsNullOrWhiteSpace(node.OriginalText))
                                {
                                    <span class="admin-menu-node__original-text">@node.OriginalText</span>
                                }
                            }
                            <RadzenBadge Text="@NodeTypeLabel(node.Type)" BadgeStyle="BadgeStyle.Info" />
                            @if (!node.Enabled)
                            {
                                <RadzenBadge Text="Disabled" BadgeStyle="BadgeStyle.Warning" />
                            }
                            @if (IsLockedNode(node))
                            {
                                <RadzenBadge Text="Locked" BadgeStyle="BadgeStyle.Secondary" />
                            }
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Caption" Text="@NodeMeta(node)" />
                    </RadzenStack>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem">
                    <RadzenButton Size="ButtonSize.Small" Icon="edit" ButtonStyle="ButtonStyle.Light" Click="@(() => EditOrRenameNode(node))" Disabled="@(IsBusy || IsLockedNode(node))" />
                    <RadzenButton Size="ButtonSize.Small" Icon="@(node.Enabled ? "visibility_off" : "visibility")" ButtonStyle="ButtonStyle.Light" Click="@(() => ToggleNodeAsync(node))" Disabled="@(IsBusy || IsLockedNode(node))" />
                    <RadzenButton Size="ButtonSize.Small" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteNodeAsync(node))" Disabled="@(IsBusy || SelectedMenu?.IsDefault == true || IsLockedNode(node))" />
                </RadzenStack>
            </RadzenStack>
        </div>

        @if (EditingModel is not null && EditingNodeId == node.Id)
        {
            @NodeEditor($"Edit admin menu node: {node.Text}", EditingModel)
        }

        @if (node.Items.Length > 0 && !IsCollapsed(node.Id))
        {
            <ol class="admin-menu-tree__list">
                @foreach (var child in node.Items)
                {
                    @NodeItem(child)
                }
            </ol>
        }
    </li>;

    private bool IsCollapsed(string nodeId) => CollapsedNodeIds.Contains(nodeId);

    private void ToggleCollapsed(string nodeId)
    {
        if (!CollapsedNodeIds.Add(nodeId))
        {
            CollapsedNodeIds.Remove(nodeId);
        }
    }

    private void CollapseSelectedMenuNodes()
    {
        if (SelectedMenu is null)
        {
            return;
        }

        CollapsedNodeIds.Clear();
        foreach (var nodeId in Flatten(SelectedMenu.Nodes).Where(node => node.Items.Length > 0).Select(node => node.Id))
        {
            CollapsedNodeIds.Add(nodeId);
        }
    }

    private void ToggleCollapseAll()
    {
        if (SelectedMenu is null)
        {
            return;
        }

        var parentNodeIds = Flatten(SelectedMenu.Nodes)
            .Where(node => node.Items.Length > 0)
            .Select(node => node.Id)
            .ToArray();

        if (AllNodesCollapsed)
        {
            foreach (var nodeId in parentNodeIds)
            {
                CollapsedNodeIds.Remove(nodeId);
            }
        }
        else
        {
            foreach (var nodeId in parentNodeIds)
            {
                CollapsedNodeIds.Add(nodeId);
            }
        }
    }

    [JSInvokable]
    public async Task OnMenuNodeDropped(string nodeId, string? parentNodeId, int position)
    {
        if (SelectedMenu is null || string.IsNullOrWhiteSpace(nodeId) || nodeId == parentNodeId)
        {
            return;
        }

        var node = FindNode(SelectedMenu.Nodes, nodeId);
        if (node is null || IsLockedNode(node) || IsLockedNode(parentNodeId) || IsDescendantOf(node, parentNodeId))
        {
            return;
        }

        if (!CanPlaceNodeUnder(nodeId, parentNodeId))
        {
            ShowTierLimitError();
            return;
        }

        await ApplyMenuResultAsync(await Api.Crest.Rest.AdminMenus.MoveNodeAsync(SelectedMenu.Id, nodeId, new(parentNodeId, position)));
    }

    private void AddNode()
    {
        EditingNodeId = null;
        EditingModel = new AdminMenuNodeFormModel
        {
            Type = SelectedMenu?.IsDefault == true ? PlaceholderNodeType : LinkNodeType,
            Text = string.Empty,
            Url = SelectedMenu?.IsDefault == true ? null : "/Admin/",
            Enabled = true,
        };
    }

    private void EditOrRenameNode(AdminMenuNodeSummary node)
    {
        if (IsLockedNode(node))
        {
            return;
        }

        EditNode(node);
    }

    private void StartRename(AdminMenuNodeSummary node)
    {
        RenamingNodeId = node.Id;
        RenameText = node.Text;
        EditingNodeId = null;
        EditingModel = null;
    }

    private void EditNode(AdminMenuNodeSummary node)
    {
        RenamingNodeId = null;
        RenameText = null;
        EditingNodeId = node.Id;
        EditingModel = new AdminMenuNodeFormModel
        {
            Type = node.Type,
            Text = node.Text,
            Url = node.Url,
            IconClass = node.IconClass,
            Enabled = node.Enabled,
            Priority = node.Priority,
            DisplayPosition = node.DisplayPosition,
            PermissionNamesText = string.Join(", ", node.PermissionNames),
            ParentNodeId = node.ParentId ?? string.Empty,
            Position = node.Order,
        };
    }

    private RenderFragment NodeEditor(string title, AdminMenuNodeFormModel model) => @<div class="admin-menu-node-editor">
        <RadzenTemplateForm TItem="AdminMenuNodeFormModel" Data="@model" Submit="SaveNodeAsync">
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H6" Text="@title" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelEdit" ButtonType="ButtonType.Button" />
                </RadzenStack>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Node type" />
                        <RadzenDropDown TValue="string" Data="@AvailableNodeTypes" TextProperty="Text" ValueProperty="Value" @bind-Value="model.Type" Disabled="@(EditingNodeId is not null || SelectedMenu?.IsDefault == true)" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Parent Node" />
                        <RadzenDropDown TValue="string" Data="@ParentOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="model.ParentNodeId" Placeholder="Root level" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Text" />
                        <RadzenTextBox @bind-Value="model.Text" Name="Text" Style="width: 100%;" />
                        <RadzenRequiredValidator Component="Text" Text="Text is required" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Url" />
                        <RadzenTextBox @bind-Value="model.Url" Disabled="@(SelectedMenu?.IsDefault == true || model.Type != LinkNodeType)" Placeholder="@(SelectedMenu?.IsDefault == true ? "Sidebar Layout placeholders do not link" : "/Admin/MyPage")" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenLabel Text="Icon" />
                        <IconSelector @bind-Value="model.IconClass" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenLabel Text="Priority" />
                        <RadzenNumeric TValue="int" @bind-Value="model.Priority" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenLabel Text="Position" />
                        <RadzenNumeric TValue="int?" @bind-Value="model.Position" Placeholder="Append" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenLabel Text="Permissions" />
                        <RadzenTextBox @bind-Value="model.PermissionNamesText" Placeholder="Permission names, comma-separated" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCheckBox @bind-Value="model.Enabled" TValue="bool" />
                        <RadzenLabel Text="Enabled" Style="margin-left: .5rem;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Save" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsBusy" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelEdit" ButtonType="ButtonType.Button" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </div>;

    private void CancelEdit()
    {
        EditingNodeId = null;
        EditingModel = null;
    }

    private void CancelRename()
    {
        RenamingNodeId = null;
        RenameText = null;
    }

    private void UpdateRenameText(ChangeEventArgs args)
    {
        RenameText = args.Value?.ToString();
    }

    private async Task HandleRenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveRenameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task SaveRenameAsync()
    {
        if (SelectedMenu is null || string.IsNullOrWhiteSpace(RenamingNodeId))
        {
            return;
        }

        if (IsLockedNode(RenamingNodeId))
        {
            CancelRename();
            return;
        }

        IsBusy = true;
        var result = await Api.Crest.Rest.AdminMenus.RenameNodeAsync(SelectedMenu.Id, RenamingNodeId, new(RenameText));
        await ApplyMenuResultAsync(result);
        if (result is not null)
        {
            CancelRename();
            Notifications.Notify(NotificationSeverity.Success, "Sidebar item renamed", "The sidebar display text was updated.");
        }

        IsBusy = false;
    }

    private static string OriginalNodeText(AdminMenuNodeSummary node) => string.IsNullOrWhiteSpace(node.OriginalText) ? node.Text : node.OriginalText;

    private async Task SaveNodeAsync(AdminMenuNodeFormModel model)
    {
        if (SelectedMenu is null)
        {
            return;
        }

        if (IsLockedNode(EditingNodeId) || IsLockedNode(model.ParentNodeId))
        {
            CancelEdit();
            Notifications.Notify(NotificationSeverity.Warning, "Admin menu item locked", "The New menu branch is a built-in Orchard shortcut and cannot be edited.");
            return;
        }

        if (!CanPlaceNodeUnder(EditingNodeId, model.ParentNodeId))
        {
            ShowTierLimitError();
            return;
        }

        IsBusy = true;
        var editModel = model.ToEditModel();
        var result = EditingNodeId is null
            ? await Api.Crest.Rest.AdminMenus.CreateNodeAsync(SelectedMenu.Id, editModel)
            : await Api.Crest.Rest.AdminMenus.UpdateNodeAsync(SelectedMenu.Id, EditingNodeId, editModel);

        await ApplyMenuResultAsync(result);
        if (result is not null)
        {
            CancelEdit();
            Notifications.Notify(NotificationSeverity.Success, "Admin menu saved", "The admin menu node was saved.");
        }

        IsBusy = false;
    }

    private async Task ToggleNodeAsync(AdminMenuNodeSummary node)
    {
        if (SelectedMenu is null || IsLockedNode(node))
        {
            return;
        }

        await ApplyMenuResultAsync(await Api.Crest.Rest.AdminMenus.ToggleNodeAsync(SelectedMenu.Id, node.Id));
    }

    private async Task DeleteNodeAsync(AdminMenuNodeSummary node)
    {
        if (SelectedMenu is null || IsLockedNode(node))
        {
            return;
        }

        await ApplyMenuResultAsync(await Api.Crest.Rest.AdminMenus.DeleteNodeAsync(SelectedMenu.Id, node.Id));
    }

    private async Task ApplyMenuResultAsync(AdminMenuSummary? menu)
    {
        if (menu is null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Admin menu update failed", "The server could not update the admin menu.");
            return;
        }

        State = new(State.Menus.Select(existing => existing.Id == menu.Id ? menu : existing).ToArray());
        SelectedMenuId = menu.Id;
        ShouldInitializeTree = true;
        await DisplayManager.RefreshAdminMenuAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static IEnumerable<AdminMenuNodeSummary> Flatten(IEnumerable<AdminMenuNodeSummary> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in Flatten(node.Items))
            {
                yield return child;
            }
        }
    }

    private static AdminMenuNodeSummary? FindNode(IEnumerable<AdminMenuNodeSummary> nodes, string id) =>
        Flatten(nodes).FirstOrDefault(node => node.Id == id);

    private static bool IsDescendantOf(AdminMenuNodeSummary node, string? candidateId) =>
        !string.IsNullOrWhiteSpace(candidateId) && Flatten(node.Items).Any(child => child.Id == candidateId);

    private bool IsLockedNode(AdminMenuNodeSummary node) => SelectedMenu?.IsDefault == true && (node.Id == LockedNewNodeId || IsDescendantOfNewNode(node.Id));

    private bool IsLockedNode(string? nodeId) =>
        SelectedMenu?.IsDefault == true && !string.IsNullOrWhiteSpace(nodeId) && (nodeId == LockedNewNodeId || IsDescendantOfNewNode(nodeId));

    private bool IsDescendantOfNewNode(string nodeId)
    {
        if (SelectedMenu is null)
        {
            return false;
        }

        var newNode = FindNode(SelectedMenu.Nodes, LockedNewNodeId);
        return newNode is not null && IsDescendantOf(newNode, nodeId);
    }

    private bool CanPlaceNodeUnder(string? movingNodeId, string? parentNodeId)
    {
        if (SelectedMenu is null)
        {
            return false;
        }

        var normalizedParentNodeId = string.IsNullOrWhiteSpace(parentNodeId) ? null : parentNodeId;
        var parentDepth = normalizedParentNodeId is null ? -1 : FindNode(SelectedMenu.Nodes, normalizedParentNodeId)?.Depth;
        if (parentDepth is null)
        {
            return false;
        }

        var movingNode = string.IsNullOrWhiteSpace(movingNodeId) ? null : FindNode(SelectedMenu.Nodes, movingNodeId);
        var subtreeHeight = movingNode is null ? 0 : GetSubtreeHeight(movingNode);
        var targetDepth = parentDepth.Value + 1;

        return targetDepth + subtreeHeight <= MaxNodeDepth;
    }

    private static int GetSubtreeHeight(AdminMenuNodeSummary node) =>
        node.Items.Length == 0 ? 0 : 1 + node.Items.Max(GetSubtreeHeight);

    private void ShowTierLimitError()
    {
        ErrorMessage = $"Admin menus support a maximum of {MaxMenuTiers} tiers. Move the item to a higher level before saving.";
        Notifications.Notify(NotificationSeverity.Error, "Admin menu depth limit", ErrorMessage);
    }

    private static string NodeTypeLabel(string type) => type switch
    {
        LinkNodeType => "Link",
        PlaceholderNodeType => "Placeholder",
        _ => type,
    };

    private static string NodeMeta(AdminMenuNodeSummary node)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(node.Url))
        {
            parts.Add(node.Url);
        }

        if (!string.IsNullOrWhiteSpace(node.IconClass))
        {
            parts.Add($"Icon: {node.IconClass}");
        }

        if (node.PermissionNames.Length > 0)
        {
            parts.Add($"Permissions: {string.Join(", ", node.PermissionNames)}");
        }

        return parts.Count == 0 ? "No link metadata" : string.Join(" · ", parts);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("crestAdminMenus.dispose", ".admin-menu-tree");
        }
        catch
        {
            // Ignore JS runtime disposal races during navigation.
        }

        PollingCts?.Cancel();
        PollingCts?.Dispose();
        DotNetRef?.Dispose();
    }

    private sealed record NodeTypeOption(string Value, string Text);
    private sealed record ParentOption(string Value, string Text);

    private sealed class AdminMenuNodeFormModel
    {
        public string Type { get; set; } = LinkNodeType;
        public string Text { get; set; } = string.Empty;
        public string? Url { get; set; }
        public string? IconClass { get; set; }
        public bool Enabled { get; set; } = true;
        public int Priority { get; set; }
        public string? DisplayPosition { get; set; }
        public string? PermissionNamesText { get; set; }
        public string ParentNodeId { get; set; } = string.Empty;
        public int? Position { get; set; }

        public AdminMenuNodeEditModel ToEditModel() => new(
            Type,
            Text,
            Url,
            IconClass,
            Enabled,
            Priority,
            DisplayPosition,
            PermissionNamesText?.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [],
            string.IsNullOrWhiteSpace(ParentNodeId) ? null : ParentNodeId,
            Position);
    }
}
