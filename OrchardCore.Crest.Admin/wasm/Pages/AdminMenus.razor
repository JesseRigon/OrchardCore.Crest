    private async Task ApplyMenuResultAsync(AdminMenuSummary? menu)
    {
        if (menu is null)
        {
            Notifications.Notify(NotificationSeverity.Error, "Admin menu update failed", "The server could not update the admin menu.");
            return;
        }

        State = new(State.Menus.Select(existing => existing.Id == menu.Id ? menu : existing).ToArray());
        RegisterMenuIcons(menu);
        SelectedMenuId = menu.Id;
        SyncPrimaryNavMenuSettingsModel();
        ShouldInitializeTree = true;
        await DisplayManager.RefreshAdminMenuAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void RegisterMenuIcons(params AdminMenuSummary[] menus)
    {
        foreach (var menu in menus)
        {
            ClientIcons.Register(menu.Icons);
        }
    }

    private async Task SavePrimaryNavMenuSettingsAsync()
    {
        if (SelectedMenu is null || !SelectedMenu.IsDefault)
        {
            return;
        }

        IsBusy = true;
        var result = await Api.Crest.Rest.AdminMenus.UpdatePrimaryNavMenuSettingsAsync(SelectedMenu.Id, NormalizePrimaryNavMenuSettings(PrimaryNavMenuSettingsModel));
        await ApplyMenuResultAsync(result);
        if (result is not null)
        {
            IsPrimaryNavMenuSettingsOpen = false;
            Notifications.Notify(NotificationSeverity.Success, "Primary navigation settings saved", "The primary navigation settings were updated.");
        }

        IsBusy = false;
    }

    private void SyncPrimaryNavMenuSettingsModel()
    {
        PrimaryNavMenuSettingsModel = ClonePrimaryNavMenuSettings(SelectedMenu?.PrimaryNavMenuSettings ?? CreateDefaultPrimaryNavMenuSettings());
    }

    private static AdminPrimaryNavMenuSettings ClonePrimaryNavMenuSettings(AdminPrimaryNavMenuSettings settings) => new()
    {
        Collapsible = settings.Collapsible,
        ExpansionDurationMilliseconds = settings.ExpansionDurationMilliseconds,
        TierSeparators = settings.TierSeparators?.ToList() ?? [true, false, false],
        TierIndents = settings.TierIndents?.ToList() ?? ["0rem", "0.75rem", "1.25rem", "1.75rem"],
        TierBackgrounds = settings.TierBackgrounds?.ToList() ?? ["transparent", "transparent", "#f3f4f6", "transparent"],
        TierBaseSizes = settings.TierBaseSizes is { Count: > 0 }
            ? settings.TierBaseSizes.ToList()
            : settings.TierBaseRems?.Select(value => $"{value:0.###}rem").ToList() ?? ["1rem", "0.95rem", "0.9rem"],
        TierBaseRems = settings.TierBaseRems?.ToList() ?? [1.0, 0.95, 0.9],
    };

    private static AdminPrimaryNavMenuSettings CreateDefaultPrimaryNavMenuSettings() => new();

    private static AdminPrimaryNavMenuSettings NormalizePrimaryNavMenuSettings(AdminPrimaryNavMenuSettings settings)
    {
        var normalized = ClonePrimaryNavMenuSettings(settings);
        normalized.ExpansionDurationMilliseconds = Math.Clamp(normalized.ExpansionDurationMilliseconds, 100, 2000);
        EnsureLength(normalized.TierSeparators, 3, false);
        EnsureLength(normalized.TierIndents, 4, "0rem");
        EnsureLength(normalized.TierBackgrounds, 4, "transparent");
        EnsureLength(normalized.TierBaseSizes, 3, "1rem");
        EnsureLength(normalized.TierBaseRems, 3, 1.0);
        normalized.TierIndents = normalized.TierIndents.Take(4).Select(NormalizeCssMeasurement).ToList();
        normalized.TierBaseSizes = normalized.TierBaseSizes.Take(3).Select(NormalizeCssMeasurement).ToList();
        normalized.TierBaseRems = normalized.TierBaseRems.Take(3).Select(value => Math.Clamp(value, 0.5, 2.0)).ToList();
        return normalized;
    }

    private Task SetPrimaryNavMenuExpansionMilliseconds(decimal value)
    {
        PrimaryNavMenuExpansionMilliseconds = value;
        return Task.CompletedTask;
    }

    private decimal GetTierIndentValue(int index) => ParseCssMeasurement(GetValue(PrimaryNavMenuSettingsModel.TierIndents, index, index == 0 ? "0rem" : $"{index * 0.75:0.##}rem")).Value;
    private string GetTierIndentUnit(int index) => ParseCssMeasurement(GetValue(PrimaryNavMenuSettingsModel.TierIndents, index, index == 0 ? "0rem" : $"{index * 0.75:0.##}rem")).Unit;
    private void SetTierIndentValue(int index, decimal value) => SetMeasurement(PrimaryNavMenuSettingsModel.TierIndents, index, value, GetTierIndentUnit(index));
    private void SetTierIndentUnit(int index, string unit) => SetMeasurement(PrimaryNavMenuSettingsModel.TierIndents, index, GetTierIndentValue(index), unit);
    private bool GetTierSeparator(int index) => GetValue(PrimaryNavMenuSettingsModel.TierSeparators, index, false);
    private void SetTierSeparator(int index, bool value) => SetValue(PrimaryNavMenuSettingsModel.TierSeparators, index, value);
    private decimal GetTierBaseSizeValue(int index) => ParseCssMeasurement(GetValue(PrimaryNavMenuSettingsModel.TierBaseSizes, index, index == 0 ? "1rem" : $"{1 - (index * 0.05m):0.###}rem")).Value;
    private string GetTierBaseSizeUnit(int index) => ParseCssMeasurement(GetValue(PrimaryNavMenuSettingsModel.TierBaseSizes, index, index == 0 ? "1rem" : $"{1 - (index * 0.05m):0.###}rem")).Unit;
    private void SetTierBaseSizeValue(int index, decimal value) => SetMeasurement(PrimaryNavMenuSettingsModel.TierBaseSizes, index, value, GetTierBaseSizeUnit(index));
    private void SetTierBaseSizeUnit(int index, string unit) => SetMeasurement(PrimaryNavMenuSettingsModel.TierBaseSizes, index, GetTierBaseSizeValue(index), unit);
    private string GetTierColor(int index) => ToColorInputValue(GetValue(PrimaryNavMenuSettingsModel.TierBackgrounds, index, "transparent"));
    private void SetTierBackground(int index, string? value) => SetValue(PrimaryNavMenuSettingsModel.TierBackgrounds, index, string.IsNullOrWhiteSpace(value) ? "transparent" : value.Trim());

    private static void SetMeasurement(IList<string> values, int index, decimal value, string unit)
    {
        unit = CssSizeUnits.Any(candidate => string.Equals(candidate.Value, unit, StringComparison.OrdinalIgnoreCase)) ? unit : "rem";
        SetValue(values, index, $"{value:0.###}{unit}");
    }

    private static string NormalizeCssMeasurement(string value)
    {
        var parsed = ParseCssMeasurement(value);
        return $"{parsed.Value:0.###}{parsed.Unit}";
    }

    private static (decimal Value, string Unit) ParseCssMeasurement(string? value)
    {
        value = string.IsNullOrWhiteSpace(value) ? "0rem" : value.Trim();
        var unit = CssSizeUnits.FirstOrDefault(option => value.EndsWith(option.Value, StringComparison.OrdinalIgnoreCase))?.Value ?? "rem";
        var number = unit.Length <= value.Length ? value[..^unit.Length] : value;
        return decimal.TryParse(number, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? (parsed, unit)
            : (0, unit);
    }

    private static string ToColorInputValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Equals("transparent", StringComparison.OrdinalIgnoreCase) || !value.StartsWith('#'))
        {
            return "#ffffff";
        }

        return value.Length == 4 || value.Length == 7 ? value : "#ffffff";
    }

    private static T GetValue<T>(IList<T> values, int index, T fallback)
    {
        EnsureLength(values, index + 1, fallback);
        return values[index];
    }

    private static void SetValue<T>(IList<T> values, int index, T value)
    {
        EnsureLength(values, index + 1, value);
        values[index] = value;
    }

    private static void EnsureLength<T>(IList<T> values, int length, T fallback)
    {
        while (values.Count < length)
        {
            values.Add(fallback);
        }
    }

    private static IEnumerable<AdminMenuNodeSummary> Flatten(IEnumerable<AdminMenuNodeSummary> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in Flatten(node.Items))
            {
                yield return child;
            }
        }
    }

    private static AdminMenuNodeSummary? FindNode(IEnumerable<AdminMenuNodeSummary> nodes, string id) =>
        Flatten(nodes).FirstOrDefault(node => node.Id == id);

    private static bool IsDescendantOf(AdminMenuNodeSummary node, string? candidateId) =>
        !string.IsNullOrWhiteSpace(candidateId) && Flatten(node.Items).Any(child => child.Id == candidateId);

    private bool CanEditNode(AdminMenuNodeSummary node) => SelectedMenu?.IsDefault != true || IsNewBranchNode(node) || !IsMoveLockedNode(node);

    private bool IsMoveLockedNode(AdminMenuNodeSummary node) => IsNewBranchNode(node);

    private bool IsNewBranchNode(AdminMenuNodeSummary node) => IsNewBranchNode(node.Id);

    private static bool IsNewRootNode(AdminMenuNodeSummary node) => node.Id == LockedNewNodeId;

    private bool IsNewBranchNode(string? nodeId) =>
        SelectedMenu?.IsDefault == true && !string.IsNullOrWhiteSpace(nodeId) && (nodeId == LockedNewNodeId || IsDescendantOfNewNode(nodeId));

    private bool IsDescendantOfNewNode(string nodeId)
    {
        if (SelectedMenu is null)
        {
            return false;
        }

        var newNode = FindNode(SelectedMenu.Nodes, LockedNewNodeId);
        return newNode is not null && IsDescendantOf(newNode, nodeId);
    }

    private bool CanPlaceNodeUnder(string? movingNodeId, string? parentNodeId)
    {
        if (SelectedMenu is null)
        {
            return false;
        }

        var normalizedParentNodeId = string.IsNullOrWhiteSpace(parentNodeId) ? null : parentNodeId;
        var parentDepth = normalizedParentNodeId is null ? -1 : FindNode(SelectedMenu.Nodes, normalizedParentNodeId)?.Depth;
        if (parentDepth is null)
        {
            return false;
        }

        var movingNode = string.IsNullOrWhiteSpace(movingNodeId) ? null : FindNode(SelectedMenu.Nodes, movingNodeId);
        var subtreeHeight = movingNode is null ? 0 : GetSubtreeHeight(movingNode);
        var targetDepth = parentDepth.Value + 1;

        return targetDepth + subtreeHeight <= MaxNodeDepth;
    }

    private static int GetSubtreeHeight(AdminMenuNodeSummary node) =>
        node.Items.Length == 0 ? 0 : 1 + node.Items.Max(GetSubtreeHeight);

    private void ShowTierLimitError()
    {
        ErrorMessage = $"Admin menus support a maximum of {MaxMenuTiers} tiers. Move the item to a higher level before saving.";
        Notifications.Notify(NotificationSeverity.Error, "Admin menu depth limit", ErrorMessage);
    }

    private static string NodeTypeLabel(string type) => type switch
    {
        LinkNodeType => "Link",
        PlaceholderNodeType => "Placeholder",
        _ => type,
    };

    private static string NodeMeta(AdminMenuNodeSummary node)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(node.Url))
        {
            parts.Add(node.Url);
        }

        if (!string.IsNullOrWhiteSpace(node.IconClass))
        {
            parts.Add($"Icon: {node.IconClass}");
        }

        if (node.PermissionNames.Length > 0)
        {
            parts.Add($"Permissions: {string.Join(", ", node.PermissionNames)}");
        }

        return parts.Count == 0 ? "No link metadata" : string.Join(" · ", parts);
    }

    private static string NodeIconTitle(AdminMenuNodeSummary node)
    {
        var iconKey = node.Icon?.Key;
        return string.IsNullOrWhiteSpace(iconKey)
            ? "No icon assigned"
            : $"Icon: {iconKey}";
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("crestAdminMenus.dispose", ".admin-menu-tree");
        }
        catch
        {
            // Ignore JS runtime disposal races during navigation.
        }

        if (AdminMenuLayoutHub is not null)
        {
            await AdminMenuLayoutHub.DisposeAsync();
        }

        DotNetRef?.Dispose();
    }

    private sealed record NodeTypeOption(string Value, string Text);
    private sealed record ParentOption(string Value, string Text);
    private sealed record MenuEntry(int Order, int Kind, AdminMenuNodeSummary? Node, AdminMenuSeparatorSummary? Separator);

    private sealed class AdminMenuNodeFormModel
    {
        public string Type { get; set; } = LinkNodeType;
        public string Text { get; set; } = string.Empty;
        public string? Url { get; set; }
        public string? IconClass { get; set; }
        public bool Enabled { get; set; } = true;
        public int Priority { get; set; }
        public string? DisplayPosition { get; set; }
        public string? PermissionNamesText { get; set; }
        public string ParentNodeId { get; set; } = string.Empty;
        public int? Position { get; set; }

        public AdminMenuNodeEditModel ToEditModel() => new(
            Type,
            Text,
            Url,
            IconClass,
            Enabled,
            Priority,
            DisplayPosition,
            PermissionNamesText?.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [],
            string.IsNullOrWhiteSpace(ParentNodeId) ? null : ParentNodeId,
            Position);
    }
}
