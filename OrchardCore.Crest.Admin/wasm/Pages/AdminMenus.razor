    private IEnumerable<MenuEntry> MenuEntries(string? parentId, AdminMenuNodeSummary[] nodes)
    {
        var entries = nodes
            .Select(node => new MenuEntry(GetEditorOrder(parentId, node), 1, node, null))
            .ToList();
        if (SelectedMenu is not null)
        {
            entries.AddRange(SelectedMenu.Separators
                .Where(separator => string.Equals(separator.ParentId, parentId, StringComparison.Ordinal))
                .Select(separator => new MenuEntry(separator.Order, 0, null, separator)));
        }

        return entries
            .OrderBy(entry => entry.Order)
            .ThenBy(entry => entry.Kind);
    }

    private static int GetEditorOrder(string? parentId, AdminMenuNodeSummary node) =>
        parentId is null && IsNewRootNode(node) ? int.MinValue : node.Order;

    private bool IsCollapsed(string nodeId) => CollapsedNodeIds.Contains(nodeId);

    private void ToggleCollapsed(string nodeId)
    {
        if (!CollapsedNodeIds.Add(nodeId))
        {
            CollapsedNodeIds.Remove(nodeId);
        }
    }

    private void CollapseSelectedMenuNodes()
    {
        if (SelectedMenu is null)
        {
            return;
        }

        CollapsedNodeIds.Clear();
        foreach (var nodeId in Flatten(SelectedMenu.Nodes).Where(node => node.Items.Length > 0).Select(node => node.Id))
        {
            CollapsedNodeIds.Add(nodeId);
        }
    }

    private void ToggleCollapseAll()
    {
        if (SelectedMenu is null)
        {
            return;
        }

        var parentNodeIds = Flatten(SelectedMenu.Nodes)
            .Where(node => node.Items.Length > 0)
            .Select(node => node.Id)
            .ToArray();

        if (AllNodesCollapsed)
        {
            foreach (var nodeId in parentNodeIds)
            {
                CollapsedNodeIds.Remove(nodeId);
            }
        }
        else
        {
            foreach (var nodeId in parentNodeIds)
            {
                CollapsedNodeIds.Add(nodeId);
            }
        }
    }

    [JSInvokable]
    public async Task OnMenuNodeDropped(string nodeId, string? parentNodeId, int position)
        => await OnMenuEntryDropped(nodeId, "node", parentNodeId, position);

    [JSInvokable]
    public async Task OnMenuEntryDropped(string entryId, string? entryType, string? parentNodeId, int position)
    {
        if (SelectedMenu is null || string.IsNullOrWhiteSpace(entryId) || entryId == parentNodeId)
        {
            return;
        }

        if (string.Equals(entryType, "separator", StringComparison.OrdinalIgnoreCase))
        {
            if (!SelectedMenu.IsDefault || IsNewBranchNode(parentNodeId))
            {
                return;
            }

            await ApplyMenuResultAsync(await Api.Crest.Rest.AdminMenus.MoveSeparatorAsync(SelectedMenu.Id, entryId, new(parentNodeId, position)));
            return;
        }

        var nodeId = entryId;
        var node = FindNode(SelectedMenu.Nodes, nodeId);
        if (node is null || IsMoveLockedNode(node) || IsNewBranchNode(parentNodeId) || IsDescendantOf(node, parentNodeId))
        {
            return;
        }

        if (!CanPlaceNodeUnder(nodeId, parentNodeId))
        {
            ShowTierLimitError();
            return;
        }

        await ApplyMenuResultAsync(await Api.Crest.Rest.AdminMenus.MoveNodeAsync(SelectedMenu.Id, nodeId, new(parentNodeId, position)));
    }

