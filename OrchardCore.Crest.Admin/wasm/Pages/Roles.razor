@page "/Roles/Index"
@using Crest.Admin.Api
@using Crest.Components.Model
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="roles-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["Roles"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["Browse Orchard roles and their system and administrator status."]" />
        </CrestStack>
        <CrestButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsLoading" />
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    <CrestRow Gap="1rem">
        <CrestColumn Size="12" SizeLG="4">
            <CrestModelList TItem="Role"
                            Title="@T["Roles"]"
                            Items="@AllRoles"
                            SelectedKey="@SelectedRoleName"
                            KeySelector="@(role => role.Name)"
                            TextSelector="@(role => role.Name)"
                            DescriptionSelector="@(role => role.Description)"
                            SearchPredicate="MatchesSearch"
                            Select="SelectRoleAsync"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            EmptyText="@T["No roles are available."]" />
        </CrestColumn>
        <CrestColumn Size="12" SizeLG="8">
            @if (IsLoading)
            {
                <CrestCard><CrestProgressBar Mode="ProgressBarMode.Indeterminate" /></CrestCard>
            }
            else if (SelectedRole is null)
            {
                <CrestCard><CrestText Text="@T["Select a role to inspect its Orchard status."]" /></CrestCard>
            }
            else
            {
                <CrestCard data-testid="role-detail">
                    <CrestStack Gap="1rem">
                        <CrestStack Gap="0.25rem">
                            <CrestText TextStyle="TextStyle.H5" Text="@SelectedRole.Name" />
                            <CrestText TextStyle="TextStyle.Body2" Text="@(string.IsNullOrWhiteSpace(SelectedRole.Description) ? T["No role description has been set."] : SelectedRole.Description)" />
                        </CrestStack>
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <CrestBadge Text="@(SelectedRole.IsSystem ? T["System role"] : T["Custom role"])" BadgeStyle="@(SelectedRole.IsSystem ? BadgeStyle.Info : BadgeStyle.Secondary)" />
                            @if (SelectedRole.IsAdmin)
                            {
                                <CrestBadge Text="@T["Administrator"]" BadgeStyle="BadgeStyle.Success" />
                            }
                        </CrestStack>
                        @if (SelectedRole.IsSystem)
                        {
                            <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["System roles are managed by Orchard and cannot be deleted."]</CrestAlert>
                        }
                        <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["Role permissions will be added with the dedicated permission editor so they retain Orchard’s effective-permission behavior."]</CrestAlert>
                    </CrestStack>
                </CrestCard>
            }
        </CrestColumn>
    </CrestRow>
</CrestStack>

@code {
    private Role[] AllRoles { get; set; } = [];
    private string? SelectedRoleName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private Role? SelectedRole => AllRoles.FirstOrDefault(role => string.Equals(role.Name, SelectedRoleName, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            AllRoles = await Api.Crest.Rest.Roles.ListAsync();
            SelectedRoleName = AllRoles.Any(role => string.Equals(role.Name, SelectedRoleName, StringComparison.OrdinalIgnoreCase))
                ? SelectedRoleName
                : AllRoles.FirstOrDefault()?.Name;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SelectRoleAsync(Role role)
    {
        SelectedRoleName = role.Name;
        return Task.CompletedTask;
    }

    private static bool MatchesSearch(Role role, string term) =>
        role.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || role.Description.Contains(term, StringComparison.OrdinalIgnoreCase);
}
