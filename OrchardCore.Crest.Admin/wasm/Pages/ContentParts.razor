@page "/ContentTypes/ListParts"
@using Crest.Admin.Api
@using Crest.Components.Model
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="content-parts-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T.T("ContentParts_Heading", "Content Parts")" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T.T("ContentParts_Description", "Browse reusable Orchard parts, their fields, and the content types that attach them.")" />
        </CrestStack>
        <CrestButton Text="@T.T("ContentParts_Refresh", "Refresh")" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsLoading" />
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    <CrestRow Gap="1rem">
        <CrestColumn Size="12" SizeLG="4">
            <CrestModelList TItem="ContentPartUsage"
                            Title="@T.T("ContentParts_ListTitle", "Content parts")"
                            Items="@PartUsages"
                            SelectedKey="@SelectedPartName"
                            KeySelector="@(part => part.Name)"
                            TextSelector="@(part => part.Name)"
                            DescriptionSelector="@(part => string.Format(T.T("ContentParts_FieldsTypesFormat", "{0} fields · {1} types"), part.Fields.Length, part.ContentTypes.Length))"
                            SearchPredicate="MatchesSearch"
                            Select="SelectPartAsync"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            EmptyText="@T.T("ContentParts_EmptyList", "No content parts are attached to the available types.")" />
        </CrestColumn>
        <CrestColumn Size="12" SizeLG="8">
            @if (IsLoading)
            {
                <CrestCard><CrestProgressBar Mode="ProgressBarMode.Indeterminate" /></CrestCard>
            }
            else if (SelectedPart is null)
            {
                <CrestCard><CrestText Text="@T.T("ContentParts_SelectPrompt", "Select a content part to inspect its field and type usage.")" /></CrestCard>
            }
            else
            {
                <CrestCard data-testid="content-part-detail">
                    <CrestStack Gap="1rem">
                        <CrestStack Gap="0.25rem">
                            <CrestText TextStyle="TextStyle.H5" Text="@SelectedPart.Name" />
                            <CrestText TextStyle="TextStyle.Body2" Text="@TypeUsageText(SelectedPart)" />
                        </CrestStack>

                        <CrestFieldset Text="@T.T("ContentParts_FieldsFieldset", "Fields")" AllowCollapse="true" Collapsed="false">
                            @if (SelectedPart.Fields.Length == 0)
                            {
                                <CrestText Text="@T.T("ContentParts_NoFields", "No fields are defined on this part.")" />
                            }
                            else
                            {
                                <div class="content-part-fields">
                                    @foreach (var field in SelectedPart.Fields.OrderBy(field => field.Name, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <div class="content-part-field">
                                            <CrestText TextStyle="TextStyle.Subtitle2" Text="@field.Name" />
                                            <CrestText TextStyle="TextStyle.Caption" Text="@field.Field.Name" />
                                        </div>
                                    }
                                </div>
                            }
                        </CrestFieldset>

                        <CrestFieldset Text="@T.T("ContentParts_UsedByFieldset", "Used by content types")" AllowCollapse="true" Collapsed="false">
                            <CrestStack Orientation="Orientation.Horizontal" Gap="0.45rem" Wrap="FlexWrap.Wrap">
                                @foreach (var contentType in SelectedPart.ContentTypes.Order(StringComparer.OrdinalIgnoreCase))
                                {
                                    <CrestBadge Text="@contentType" BadgeStyle="BadgeStyle.Info" />
                                }
                            </CrestStack>
                        </CrestFieldset>
                    </CrestStack>
                </CrestCard>
            }
        </CrestColumn>
    </CrestRow>
</CrestStack>

@code {
    private ContentPartUsage[] PartUsages { get; set; } = [];
    private string? SelectedPartName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private ContentPartUsage? SelectedPart => PartUsages.FirstOrDefault(part => string.Equals(part.Name, SelectedPartName, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var types = await Api.Crest.Rest.Content.Types.ListAsync();
            PartUsages = types
                .SelectMany(type => type.Parts.Select(part => new { TypeName = type.DisplayName, Part = part }))
                .GroupBy(entry => entry.Part.Name, StringComparer.OrdinalIgnoreCase)
                .Select(group => new ContentPartUsage(
                    group.Key,
                    group.First().Part.Part.Fields,
                    group.Select(entry => entry.TypeName).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray()))
                .OrderBy(part => part.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            SelectedPartName = PartUsages.Any(part => string.Equals(part.Name, SelectedPartName, StringComparison.OrdinalIgnoreCase))
                ? SelectedPartName
                : PartUsages.FirstOrDefault()?.Name;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SelectPartAsync(ContentPartUsage part)
    {
        SelectedPartName = part.Name;
        return Task.CompletedTask;
    }

    private static bool MatchesSearch(ContentPartUsage part, string term) =>
        part.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || part.Fields.Any(field => field.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
        || part.ContentTypes.Any(contentType => contentType.Contains(term, StringComparison.OrdinalIgnoreCase));

    private string TypeUsageText(ContentPartUsage part) =>
        part.ContentTypes.Length == 1
            ? string.Format(T.T("ContentParts_AttachedToSingularFormat", "Attached to {0} content type."), part.ContentTypes.Length)
            : string.Format(T.T("ContentParts_AttachedToPluralFormat", "Attached to {0} content types."), part.ContentTypes.Length);

    private sealed record ContentPartUsage(string Name, ContentPartField[] Fields, string[] ContentTypes);
}
