@page "/ContentTypes/ListParts"
@using System.Net.Http.Json
@using Crest.Admin.Api
@using Crest.Components.Model
@using Crest.Components.Primitives
@inject HttpClient Http
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

@* Field DEFINITIONS are edited here, on the part, because a part is shared: a field
   added or converted on AddressPart lands on every content type carrying it. The
   Content Types screen manages which types carry which parts (and the attachment's
   instance settings); it never edits fields. *@
<CrestStack Gap="1rem" data-testid="content-parts-page" Style="height: 100%;">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["Content Parts"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["Reusable content parts and their fields. Fields are defined here and appear on every content type the part is attached to."]" />
        </CrestStack>
        <CrestButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsLoading" />
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    @* Standard master-detail structure: this region takes the page's remaining
       height; the list's items and the detail pane's body do the scrolling. *@
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; flex: 1 1 auto; min-height: 0; align-items: stretch;">
        <div style="flex: 0 1 350px; min-width: 16rem; min-height: 0; display: flex;">
            <CrestModelList TItem="PartDefinition"
                            Title="@T["Content Parts"]"
                            Items="@Parts"
                            SelectedKey="@SelectedPartName"
                            KeySelector="@(part => part.Name)"
                            TextSelector="@(part => part.Name)"
                            DescriptionSelector="@(part => T["{0} fields · {1} types", part.Part.Fields.Length, part.UsedByTypes.Length])"
                            SearchPredicate="MatchesSearch"
                            Select="SelectPartAsync"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            MinWidth="16rem"
                            MaxWidth="350px"
                            EmptyText="@T["No content parts are defined."]" />
        </div>
        <div style="flex: 1 1 480px; min-width: 0; min-height: 0; display: flex;">
            @if (IsLoading)
            {
                <CrestCard><CrestProgressBar Mode="ProgressBarMode.Indeterminate" /></CrestCard>
            }
            else if (SelectedPart is null)
            {
                <CrestCard><CrestText Text="@T["Select a content part to manage its fields."]" /></CrestCard>
            }
            else
            {
                <CrestDetailPane TestId="content-part-detail" Style="flex: 1 1 auto;">
                    <Header>
                        <CrestStack Gap="0.25rem">
                            <CrestText TextStyle="TextStyle.H5" Text="@SelectedPart.Name" />
                            <CrestText TextStyle="TextStyle.Body2" Text="@TypeUsageText(SelectedPart)" />
                        </CrestStack>
                    </Header>
                    <ChildContent>
                        <CrestFieldset Text="@T["Fields"]" AllowCollapse="true" Collapsed="false">
                            <CrestStack Gap="0.7rem">
                                @if (SelectedPart.Part.Fields.Length == 0)
                                {
                                    <CrestText Text="@T["No fields are defined on this part."]" />
                                }
                                else
                                {
                                    <div class="content-part-fields">
                                        @foreach (var field in SelectedPart.Part.Fields.OrderBy(field => field.Name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            var fieldName = field.Name;
                                            var fieldType = field.Field.Name;
                                            <div class="content-part-field">
                                                <CrestText TextStyle="TextStyle.Subtitle2" Text="@field.Name" />
                                                @* The field's TYPE is the dropdown. Picking most types
                                                   converts immediately; picking Option picker opens the
                                                   settings editor first, so the conversion and the source
                                                   binding are one Save. *@
                                                <CrestDropDown TValue="string"
                                                               Value="@fieldType"
                                                               Data="@FieldTypeChoicesFor(fieldType)"
                                                               TextProperty="Label" ValueProperty="Value"
                                                               Change="@(value => OnFieldTypeChangedAsync(fieldName, fieldType, value as string))"
                                                               Disabled="@IsLoading"
                                                               Style="width: 100%;"
                                                               data-testid="field-type-dropdown" />
                                                @if (fieldType == "OptionPickerField")
                                                {
                                                    <CrestButton Text="@T["Picker settings"]" Icon="tune" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                 Click="@(() => OpenPickerEditor(fieldName))"
                                                                 data-testid="configure-picker" />
                                                }
                                                @* Every field type can carry a visibility condition. *@
                                                <CrestButton Text="@T["Visibility"]" Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                             Click="@(() => OpenVisibilityEditor(fieldName))"
                                                             data-testid="configure-visibility" />
                                            </div>
                                        }
                                    </div>
                                }

                                @if (EditingField is not null)
                                {
                                    <OptionPickerAttachmentEditor PartName="@SelectedPart.Name"
                                                                  FieldName="@EditingField"
                                                                  SiblingFields="@SelectedPart.Part.Fields.Select(field => field.Name).ToArray()"
                                                                  OnSaved="OnPickerSavedAsync"
                                                                  OnClose="@(() => EditingField = null)" />
                                }

                                @if (EditingVisibilityField is not null)
                                {
                                    <FieldVisibilityEditor PartName="@SelectedPart.Name"
                                                           FieldName="@EditingVisibilityField"
                                                           SiblingFields="@SelectedPart.Part.Fields.Select(field => field.Name).ToArray()"
                                                           OnSaved="OnVisibilitySavedAsync"
                                                           OnClose="@(() => EditingVisibilityField = null)" />
                                }

                                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                                    <CrestFormField Text="@T["New field"]">
                                        <CrestTextBox @bind-Value="NewFieldName" Placeholder="@T["e.g. Country"]" Disabled="@IsLoading" />
                                    </CrestFormField>
                                    <CrestFormField Text="@T["Field type"]">
                                        <CrestDropDown @bind-Value="NewFieldType" TValue="string" Data="@FieldTypeChoices"
                                                       TextProperty="Label" ValueProperty="Value" Disabled="@IsLoading" Style="min-width: 11rem;" />
                                    </CrestFormField>
                                    <CrestButton Text="@T["Add field"]" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                 Click="AddFieldAsync"
                                                 Disabled="@(IsLoading || string.IsNullOrWhiteSpace(NewFieldName) || string.IsNullOrWhiteSpace(NewFieldType))"
                                                 data-testid="add-picker-field" />
                                </CrestStack>
                            </CrestStack>
                        </CrestFieldset>

                        <CrestFieldset Text="@T["Used by content types"]" AllowCollapse="true" Collapsed="false">
                            @if (SelectedPart.UsedByTypes.Length == 0)
                            {
                                <CrestText Text="@T["Not attached to any content type yet. Attach it from the Content Types screen."]" />
                            }
                            else
                            {
                                <CrestStack Orientation="Orientation.Horizontal" Gap="0.45rem" Wrap="FlexWrap.Wrap">
                                    @foreach (var contentType in SelectedPart.UsedByTypes)
                                    {
                                        <CrestBadge Text="@contentType" BadgeStyle="BadgeStyle.Info" />
                                    }
                                </CrestStack>
                            }
                        </CrestFieldset>
                    </ChildContent>
                </CrestDetailPane>
            }
        </div>
    </div>
</CrestStack>

@code {
    private PartDefinition[] Parts { get; set; } = [];
    private string? SelectedPartName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private string? EditingField { get; set; }
    private string? EditingVisibilityField { get; set; }
    private string NewFieldName { get; set; } = string.Empty;
    private string NewFieldType { get; set; } = "TextField";
    private string[] FieldTypes { get; set; } = [];

    private PartDefinition? SelectedPart => Parts.FirstOrDefault(part => string.Equals(part.Name, SelectedPartName, StringComparison.OrdinalIgnoreCase));

    private sealed record PartDefinition(string Name, ContentPart Part, string[] UsedByTypes);
    private sealed record Choice(string Label, string Value);

    private Choice[] FieldTypeChoices => [.. FieldTypes.Select(type => new Choice(FieldTypeLabel(type), type))];

    // The current type stays pickable even when no longer registered (a disabled
    // feature's field), so the dropdown never shows an empty value.
    private Choice[] FieldTypeChoicesFor(string currentType) => FieldTypes.Contains(currentType, StringComparer.Ordinal)
        ? FieldTypeChoices
        : [new(FieldTypeLabel(currentType), currentType), .. FieldTypeChoices];

    private string FieldTypeLabel(string type) =>
        type == "OptionPickerField" ? T["Option picker"]
        : type.EndsWith("Field", StringComparison.Ordinal) ? type[..^"Field".Length] : type;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            FieldTypes = await Http.GetFromJsonAsync<string[]>("api/crest/content-types/field-types") ?? [];
        }
        catch
        {
            FieldTypes = [];
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Parts = await Http.GetFromJsonAsync<PartDefinition[]>("api/crest/content-types/parts") ?? [];
            SelectedPartName = Parts.Any(part => string.Equals(part.Name, SelectedPartName, StringComparison.OrdinalIgnoreCase))
                ? SelectedPartName
                : Parts.FirstOrDefault()?.Name;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SelectPartAsync(PartDefinition part)
    {
        SelectedPartName = part.Name;
        EditingField = null;
        EditingVisibilityField = null;
        return Task.CompletedTask;
    }

    private static bool MatchesSearch(PartDefinition part, string term) =>
        part.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || part.Part.Fields.Any(field => field.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
        || part.UsedByTypes.Any(contentType => contentType.Contains(term, StringComparison.OrdinalIgnoreCase));

    private string TypeUsageText(PartDefinition part) => part.UsedByTypes.Length switch
    {
        0 => T["Not attached to any content type."],
        1 => T["Attached to 1 content type - field changes land there."],
        _ => T["Attached to {0} content types - field changes land on all of them.", part.UsedByTypes.Length],
    };

    private async Task OnFieldTypeChangedAsync(string fieldName, string currentType, string? newType)
    {
        if (SelectedPart is null || string.IsNullOrWhiteSpace(newType) || newType == currentType)
        {
            return;
        }

        // Option picker conversion goes through the settings editor: the type change
        // and the source binding are one Save, never a half-configured picker.
        if (newType == "OptionPickerField")
        {
            OpenPickerEditor(fieldName);
            return;
        }

        await SetFieldTypeAsync(fieldName, newType);
    }

    private async Task AddFieldAsync()
    {
        if (SelectedPart is null || string.IsNullOrWhiteSpace(NewFieldName) || string.IsNullOrWhiteSpace(NewFieldType))
        {
            return;
        }

        var fieldName = NewFieldName.Trim();
        if (NewFieldType == "OptionPickerField")
        {
            EditingField = fieldName;
            return;
        }

        await SetFieldTypeAsync(fieldName, NewFieldType);
        NewFieldName = string.Empty;
    }

    private async Task SetFieldTypeAsync(string fieldName, string fieldType)
    {
        if (SelectedPart is null)
        {
            return;
        }

        ErrorMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync("api/crest/content-types/fields",
                new { Part = SelectedPart.Name, Field = fieldName, FieldType = fieldType });
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T["Content Parts"], T["{0} is now a {1}.", fieldName, FieldTypeLabel(fieldType)]);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private void OpenPickerEditor(string fieldName)
    {
        EditingField = fieldName;
        EditingVisibilityField = null;
    }

    private async Task OnPickerSavedAsync()
    {
        EditingField = null;
        NewFieldName = string.Empty;
        await LoadAsync();
    }

    private void OpenVisibilityEditor(string fieldName)
    {
        EditingVisibilityField = fieldName;
        EditingField = null;
    }

    private async Task OnVisibilitySavedAsync()
    {
        EditingVisibilityField = null;
        await LoadAsync();
    }
}
