@page "/Queries/Index"
@using System.Text.Json
@using System.Text.Json.Nodes
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="queries-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["Queries"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["Manage queries through the query sources enabled for this tenant."]" />
        </CrestStack>
        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <CrestButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" />
            <CrestButton Text="@T["Delete selected ({0})", SelectedQueryNames.Count]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="ConfirmDeleteSelected" Disabled="@(SelectedQueryNames.Count == 0 || IsBusy)" />
            <CrestButton Text="@T["New query"]" Icon="add" Click="NewQuery" Disabled="@(Catalog.Sources.Length == 0 || IsBusy)" />
        </CrestStack>
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    <CrestCard>
        <CrestRow AlignItems="AlignItems.End" Gap="0.75rem">
            <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T["Search"]" Style="width: 100%;"><CrestTextBox @bind-Value="Search" Placeholder="@T["Search query names"]" Style="width: 100%;" /></CrestFormField></CrestColumn>
            <CrestColumn Size="12" SizeMD="3"><CrestButton Text="@T["Search"]" Icon="search" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" /></CrestColumn>
        </CrestRow>
    </CrestCard>

    @if (Editing)
    {
        <CrestCard data-testid="query-editor">
            <CrestStack Gap="1rem">
                <CrestText TextStyle="TextStyle.H5" Text="@(EditingName is null ? T["New query"] : T["Edit {0}", EditingName])" />
                <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                    @T["The source and metadata are provider-neutral. Provider modules may store any metadata shape in the JSON object below."]
                </CrestAlert>
                @if (!string.IsNullOrWhiteSpace(EditorError))
                {
                    <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@EditorError</CrestAlert>
                }
                <CrestRow Gap="1rem">
                    <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T["Name"]" Style="width: 100%;"><CrestTextBox @bind-Value="DraftName" Style="width: 100%;" /></CrestFormField></CrestColumn>
                    <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T["Source"]" Style="width: 100%;"><CrestDropDown @bind-Value="DraftSource" Data="@Catalog.Sources" Style="width: 100%;" /></CrestFormField></CrestColumn>
                    <CrestColumn Size="12"><CrestFormField Text="@T["Result schema (optional)"]" Style="width: 100%;"><CrestTextBox @bind-Value="DraftSchema" Style="width: 100%;" /></CrestFormField></CrestColumn>
                </CrestRow>
                <CrestCheckBox @bind-Value="DraftReturnContentItems" Name="return-content-items" /> <span>@T["Return Content Items"]</span>
                <CrestFormField Text="@T["Provider metadata (JSON object)"]" Style="width: 100%;"><CrestTextArea @bind-Value="DraftProperties" Rows="14" Style="width: 100%; font-family: var(--rz-code-font-family, monospace);" /></CrestFormField>
                <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelEdit" Disabled="@IsBusy" />
                    <CrestButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="@IsBusy" />
                </CrestStack>
            </CrestStack>
        </CrestCard>
    }

    @if (DeletingNames.Length > 0)
    {
        <CrestAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                <span>@(DeletingNames.Length == 1 ? T["Delete query {0}? This cannot be undone.", DeletingNames[0]] : T["Delete {0} selected queries? This cannot be undone.", DeletingNames.Length])</span>
                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem"><CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelDelete" /><CrestButton Text="@T["Delete"]" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" Disabled="@IsBusy" /></CrestStack>
            </CrestStack>
        </CrestAlert>
    }

    <CrestCard>
        @if (IsLoading)
        {
            <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Catalog.Queries.Length == 0)
        {
            <CrestText TextStyle="TextStyle.Body2" Text="@T["No queries match this filter."]" />
        }
        else
        {
            <CrestDataGrid Data="@Catalog.Queries" TItem="CrestQuery" AllowPaging="true" PageSize="20">
                <Columns>
                    <CrestDataGridColumn TItem="CrestQuery" Width="3.5rem" Sortable="false" Filterable="false"><HeaderTemplate><CrestCheckBox Value="@(Catalog.Queries.Length > 0 && Catalog.Queries.All(query => SelectedQueryNames.Contains(query.Name)))" Change="@((bool value) => ToggleAll(value))" Name="select-all-queries" /></HeaderTemplate><Template Context="query"><CrestCheckBox Value="@SelectedQueryNames.Contains(query.Name)" Change="@((bool value) => ToggleSelection(query.Name, value))" Name="@($"query-{query.Name}")" /></Template></CrestDataGridColumn>
                    <CrestDataGridColumn TItem="CrestQuery" Property="Name" Title="@T["Name"]" />
                    <CrestDataGridColumn TItem="CrestQuery" Property="Source" Title="@T["Source"]" />
                    <CrestDataGridColumn TItem="CrestQuery" Property="Schema" Title="@T["Schema"]"><Template Context="query">@(string.IsNullOrWhiteSpace(query.Schema) ? "—" : query.Schema)</Template></CrestDataGridColumn>
                    <CrestDataGridColumn TItem="CrestQuery" Title="@T["Result"]"><Template Context="query">@(query.ReturnContentItems ? T["Content Items"] : T["Documents"])</Template></CrestDataGridColumn>
                    <CrestDataGridColumn TItem="CrestQuery" Title="@T["Actions"]" Width="10rem"><Template Context="query"><CrestStack Orientation="Orientation.Horizontal" Gap="0.25rem"><CrestButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(query))" title="@T["Edit"]" /><CrestButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => ConfirmDelete(query.Name))" title="@T["Delete"]" /></CrestStack></Template></CrestDataGridColumn>
                </Columns>
            </CrestDataGrid>
        }
    </CrestCard>
</CrestStack>

@code {
    private CrestQueryCatalog Catalog { get; set; } = CrestQueryCatalog.Empty;
    private string? Search { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }
    private bool Editing { get; set; }
    private string? EditingName { get; set; }
    private string DraftName { get; set; } = string.Empty;
    private string DraftSource { get; set; } = string.Empty;
    private string? DraftSchema { get; set; }
    private bool DraftReturnContentItems { get; set; }
    private string DraftProperties { get; set; } = "{}";
    private string? EditorError { get; set; }
    private HashSet<string> SelectedQueryNames { get; } = new(StringComparer.OrdinalIgnoreCase);
    private string[] DeletingNames { get; set; } = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Catalog = await Api.Crest.Rest.Queries.ListAsync(Search); }
        catch (Exception exception) { ErrorMessage = exception.Message; }
        finally { IsLoading = false; }
    }

    private void NewQuery()
    {
        Editing = true;
        EditingName = null;
        DraftName = string.Empty;
        DraftSource = Catalog.Sources.FirstOrDefault() ?? string.Empty;
        DraftSchema = null;
        DraftReturnContentItems = false;
        DraftProperties = "{}";
        EditorError = null;
    }

    private void Edit(CrestQuery query)
    {
        Editing = true;
        EditingName = query.Name;
        DraftName = query.Name;
        DraftSource = query.Source;
        DraftSchema = query.Schema;
        DraftReturnContentItems = query.ReturnContentItems;
        DraftProperties = query.Properties.ToJsonString(new() { WriteIndented = true });
        EditorError = null;
    }

    private void CancelEdit() { Editing = false; EditorError = null; }
    private void ConfirmDelete(string name) => DeletingNames = [name];
    private void ConfirmDeleteSelected() => DeletingNames = SelectedQueryNames.ToArray();
    private void CancelDelete() => DeletingNames = [];
    private void ToggleSelection(string name, bool value)
    {
        if (value is true) SelectedQueryNames.Add(name);
        else SelectedQueryNames.Remove(name);
    }
    private void ToggleAll(bool value)
    {
        if (value is true) foreach (var query in Catalog.Queries) SelectedQueryNames.Add(query.Name);
        else SelectedQueryNames.Clear();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(DraftName) || string.IsNullOrWhiteSpace(DraftSource)) { EditorError = T["A query name and source are required."]; return; }
        if (JsonNode.Parse(DraftProperties) is not JsonObject properties) { EditorError = T["Provider metadata must be a JSON object."]; return; }

        IsSaving = true;
        EditorError = null;
        try
        {
            var write = new CrestQueryWrite(DraftName, DraftSource, DraftSchema, DraftReturnContentItems, properties);
            var saved = EditingName is null ? await Api.Crest.Rest.Queries.CreateAsync(write) : await Api.Crest.Rest.Queries.SaveAsync(EditingName, write);
            if (saved is null) { EditorError = T["The query could not be saved. Check the provider metadata and try again."]; return; }
            Notifications.Notify(NotificationSeverity.Success, T["Query saved"], T["{0} was saved.", saved.Name]);
            Editing = false;
            await LoadAsync();
        }
        catch (JsonException) { EditorError = T["Provider metadata must contain valid JSON."]; }
        catch (Exception exception) { EditorError = exception.Message; }
        finally { IsSaving = false; }
    }

    private async Task DeleteAsync()
    {
        if (DeletingNames.Length == 0) return;
        IsSaving = true;
        try
        {
            var deleted = DeletingNames.Length == 1
                ? await Api.Crest.Rest.Queries.DeleteAsync(DeletingNames[0])
                : await Api.Crest.Rest.Queries.DeleteManyAsync(DeletingNames);
            if (deleted)
            {
                Notifications.Notify(NotificationSeverity.Success, T["Queries deleted"], DeletingNames.Length == 1 ? T["1 query deleted."] : T["{0} queries deleted.", DeletingNames.Length]);
                foreach (var name in DeletingNames) SelectedQueryNames.Remove(name);
                DeletingNames = [];
                await LoadAsync();
            }
        }
        finally { IsSaving = false; }
    }
}
