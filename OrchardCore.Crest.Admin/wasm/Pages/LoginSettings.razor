@page "/Settings/userLogin"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="login-settings-page">
    <CrestText TextStyle="TextStyle.H4" Text="@T["User Login Settings"]" />
    @if (Model is null)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <CrestFieldset Text="@T["General"]">
            <CrestCheckBox @bind-Value="Model.AllowRememberMe" Name="allow-remember-me" /><label for="allow-remember-me"> @T["Allow user to be remembered during login"]</label><br />
            <CrestCheckBox @bind-Value="Model.AllowChangingUsername" Name="allow-changing-username" /><label for="allow-changing-username"> @T["Allow user to change their username"]</label><br />
            <CrestCheckBox @bind-Value="Model.AllowChangingEmail" Name="allow-changing-email" /><label for="allow-changing-email"> @T["Allow user to change their email address"]</label><br />
            <CrestCheckBox @bind-Value="Model.AllowChangingPhoneNumber" Name="allow-changing-phone" /><label for="allow-changing-phone"> @T["Allow user to change their phone number"]</label><br />
            <CrestCheckBox @bind-Value="Model.UseSiteTheme" Name="use-site-theme" /><label for="use-site-theme"> @T["Use site theme for login page"]</label><br />
            <CrestCheckBox @bind-Value="Model.DisableLocalLogin" Name="disable-local-login" /><label for="disable-local-login"> @T["Disable local password login."]</label>
        </CrestFieldset>
        <CrestFieldset Text="@T["Two-Factor Authentication"]">
            <CrestCheckBox @bind-Value="Model.AllowRememberClientTwoFactorAuthentication" Name="remember-two-factor" /><label for="remember-two-factor"> @T["Allow users to remember client"]</label><br />
            <CrestCheckBox @bind-Value="Model.RequireTwoFactorAuthentication" Name="require-two-factor" /><label for="require-two-factor"> @T["Require two-factor authentication"]</label><br />
            <CrestLabel Text="@T["Number of recovery codes to generate"]" Component="recovery-codes" />
            <CrestNumeric @bind-Value="Model.NumberOfRecoveryCodesToGenerate" Name="recovery-codes" Min="1" /><br />
            <CrestCheckBox @bind-Value="Model.UseSiteThemeForTwoFactorAuthentication" Name="two-factor-site-theme" /><label for="two-factor-site-theme"> @T["Use site theme for two-factor authentication pages"]</label>
        </CrestFieldset>
        <CrestFieldset Text="@T["External Login"]">
            <CrestCheckBox @bind-Value="Model.UseExternalProviderIfOnlyOneDefined" Name="use-external-provider" /><label for="use-external-provider"> @T["Use external provider for login."]</label><br />
            <CrestCheckBox @bind-Value="Model.UseScriptToSyncProperties" Name="sync-external-properties" /><label for="sync-external-properties"> @T["Use a script to sync user properties from external provider claims"]</label>
            @if (Model.UseScriptToSyncProperties)
            {
                <CrestTextArea @bind-Value="Model.SyncPropertiesScript" Rows="16" Style="width:100%; margin-top: .75rem" Placeholder="@T["External login synchronization script"]" />
            }
        </CrestFieldset>
        <CrestButton Text="@T["Save"]" Icon="save" Click="SaveAsync" />
        @if (!string.IsNullOrWhiteSpace(Error)) { <CrestText TextStyle="TextStyle.Body2" Style="color: var(--rz-danger)">@Error</CrestText> }
    }
</CrestStack>

@code {
    private CrestLoginSettings? Model;
    private string? Error;

    protected override async Task OnInitializedAsync() => Model = await Api.Crest.Rest.LoginSettings.GetAsync();

    private async Task SaveAsync()
    {
        if (Model is null) return;
        Error = null;
        var saved = await Api.Crest.Rest.LoginSettings.SaveAsync(Model);
        if (saved is null) Error = T["The login settings could not be saved."];
        else Model = saved;
    }
}
