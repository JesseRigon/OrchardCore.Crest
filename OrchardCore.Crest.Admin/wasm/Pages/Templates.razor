@page "/Templates"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T
<CrestStack Gap="1rem" data-testid="templates-page"><CrestText TextStyle="TextStyle.H4" Text="@T["Templates"]"/><CrestButton Text="@T["New template"]" Click="New"/>@if(Edit){<CrestCard><CrestTextBox @bind-Value="Name" Placeholder="@T["Name"]"/><CrestTextBox @bind-Value="Description" Placeholder="@T["Description"]"/><CrestTextArea @bind-Value="Content" Rows="14"/><CrestButton Text="@T["Save"]" Click="Save"/></CrestCard>}<CrestDataGrid Data="@Items" TItem="CrestTemplate"><Columns><CrestDataGridColumn TItem="CrestTemplate" Property="Name" Title="@T["Name"]"/><CrestDataGridColumn TItem="CrestTemplate" Property="Description" Title="@T["Description"]"/><CrestDataGridColumn TItem="CrestTemplate" Title="@T["Actions"]"><Template Context="x"><CrestButton Icon="edit" Click="@(()=>Load(x))"/><CrestButton Icon="delete" Click="@(()=>Delete(x))"/></Template></CrestDataGridColumn></Columns></CrestDataGrid></CrestStack>
@code { CrestTemplate[] Items=[]; bool Edit; string Name="",Description="",Content=""; protected override async Task OnInitializedAsync()=>Items=await Api.Crest.Rest.Templates.ListAsync(); void New(){Edit=true;Name=Description=Content="";} void Load(CrestTemplate x){Edit=true;Name=x.Name;Description=x.Description??"";Content=x.Content;} async Task Save(){await Api.Crest.Rest.Templates.SaveAsync(Name,new(Description,Content));Edit=false;Items=await Api.Crest.Rest.Templates.ListAsync();} async Task Delete(CrestTemplate x){await Api.Crest.Rest.Templates.DeleteAsync(x.Name);Items=await Api.Crest.Rest.Templates.ListAsync();}}
