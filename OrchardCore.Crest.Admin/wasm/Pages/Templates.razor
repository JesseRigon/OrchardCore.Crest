@page "/Admin/Templates"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
<CrestStack Gap="1rem" data-testid="templates-page"><CrestText TextStyle="TextStyle.H4" Text="Templates"/><CrestButton Text="New template" Click="New"/>@if(Edit){<CrestCard><CrestTextBox @bind-Value="Name" Placeholder="Name"/><CrestTextBox @bind-Value="Description" Placeholder="Description"/><CrestTextArea @bind-Value="Content" Rows="14"/><CrestButton Text="Save" Click="Save"/></CrestCard>}<CrestDataGrid Data="@Items" TItem="CrestTemplate"><Columns><CrestDataGridColumn TItem="CrestTemplate" Property="Name" Title="Name"/><CrestDataGridColumn TItem="CrestTemplate" Property="Description" Title="Description"/><CrestDataGridColumn TItem="CrestTemplate" Title="Actions"><Template Context="x"><CrestButton Icon="edit" Click="@(()=>Load(x))"/><CrestButton Icon="delete" Click="@(()=>Delete(x))"/></Template></CrestDataGridColumn></Columns></CrestDataGrid></CrestStack>
@code { CrestTemplate[] Items=[]; bool Edit; string Name="",Description="",Content=""; protected override async Task OnInitializedAsync()=>Items=await Api.Crest.Rest.Templates.ListAsync(); void New(){Edit=true;Name=Description=Content="";} void Load(CrestTemplate x){Edit=true;Name=x.Name;Description=x.Description??"";Content=x.Content;} async Task Save(){await Api.Crest.Rest.Templates.SaveAsync(Name,new(Description,Content));Edit=false;Items=await Api.Crest.Rest.Templates.ListAsync();} async Task Delete(CrestTemplate x){await Api.Crest.Rest.Templates.DeleteAsync(x.Name);Items=await Api.Crest.Rest.Templates.ListAsync();}}
