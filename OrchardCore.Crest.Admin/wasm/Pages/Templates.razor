@page "/Admin/Templates"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
<RadzenStack Gap="1rem" data-testid="templates-page"><RadzenText TextStyle="TextStyle.H4" Text="Templates"/><RadzenButton Text="New template" Click="New"/>@if(Edit){<RadzenCard><RadzenTextBox @bind-Value="Name" Placeholder="Name"/><RadzenTextBox @bind-Value="Description" Placeholder="Description"/><RadzenTextArea @bind-Value="Content" Rows="14"/><RadzenButton Text="Save" Click="Save"/></RadzenCard>}<RadzenDataGrid Data="@Items" TItem="CrestTemplate"><Columns><RadzenDataGridColumn TItem="CrestTemplate" Property="Name" Title="Name"/><RadzenDataGridColumn TItem="CrestTemplate" Property="Description" Title="Description"/><RadzenDataGridColumn TItem="CrestTemplate" Title="Actions"><Template Context="x"><RadzenButton Icon="edit" Click="@(()=>Load(x))"/><RadzenButton Icon="delete" Click="@(()=>Delete(x))"/></Template></RadzenDataGridColumn></Columns></RadzenDataGrid></RadzenStack>
@code { CrestTemplate[] Items=[]; bool Edit; string Name="",Description="",Content=""; protected override async Task OnInitializedAsync()=>Items=await Api.Crest.Rest.Templates.ListAsync(); void New(){Edit=true;Name=Description=Content="";} void Load(CrestTemplate x){Edit=true;Name=x.Name;Description=x.Description??"";Content=x.Content;} async Task Save(){await Api.Crest.Rest.Templates.SaveAsync(Name,new(Description,Content));Edit=false;Items=await Api.Crest.Rest.Templates.ListAsync();} async Task Delete(CrestTemplate x){await Api.Crest.Rest.Templates.DeleteAsync(x.Name);Items=await Api.Crest.Rest.Templates.ListAsync();}}
