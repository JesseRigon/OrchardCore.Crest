@page "/MediaProfiles"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="media-profiles-page">
 <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"><CrestStack Gap=".25rem"><CrestText TextStyle="TextStyle.H4" Text="@T["Media Profiles"]"/><CrestText TextStyle="TextStyle.Body2" Text="@T["Define reusable Orchard image transformations."]"/></CrestStack><CrestButton Text="@T["New profile"]" Icon="add" Click="NewProfile"/></CrestStack>
 @if (!string.IsNullOrWhiteSpace(Error)) { <CrestAlert AlertStyle="AlertStyle.Danger">@Error</CrestAlert> }
 @if (Editing) { <CrestCard><CrestStack Gap=".75rem"><CrestText TextStyle="TextStyle.H5" Text="@((SelectedName is null) ? T["New media profile"] : T["Edit {0}", SelectedName])"/><CrestTextBox @bind-Value="Name" Placeholder="@T["Profile name"]" Disabled="@(SelectedName is not null)"/><CrestTextBox @bind-Value="Hint" Placeholder="@T["Hint"]"/><CrestRow><CrestColumn><CrestNumeric @bind-Value="Width" Placeholder="@T["Width"]" Style="width:100%"/></CrestColumn><CrestColumn><CrestNumeric @bind-Value="Height" Placeholder="@T["Height"]" Style="width:100%"/></CrestColumn><CrestColumn><CrestNumeric @bind-Value="Quality" Placeholder="@T["Quality"]" Style="width:100%"/></CrestColumn></CrestRow><CrestTextBox @bind-Value="Background" Placeholder="@T["Background Color"]"/><CrestCheckBox @bind-Value="AutoOrient"/> <span>@T["Auto Orient"]</span><CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"><CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="Cancel"/><CrestButton Text="@T["Save"]" Click="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(Name)"/></CrestStack></CrestStack></CrestCard> }
 @if (Loading) { <CrestProgressBar Mode="ProgressBarMode.Indeterminate"/> } else { <CrestDataGrid Data="@Profiles" TItem="MediaProfile" data-testid="media-profiles-grid"><Columns><CrestDataGridColumn TItem="MediaProfile" Property="Name" Title="@T["Name"]"/><CrestDataGridColumn TItem="MediaProfile" Property="Hint" Title="@T["Hint"]"/><CrestDataGridColumn TItem="MediaProfile" Title="@T["Size"]"><Template Context="p">@p.Width × @p.Height</Template></CrestDataGridColumn><CrestDataGridColumn TItem="MediaProfile" Property="Quality" Title="@T["Quality"]"/><CrestDataGridColumn TItem="MediaProfile" Title="@T["Actions"]"><Template Context="p"><CrestButton Icon="edit" Variant="Variant.Text" Click="@(()=>Edit(p))"/><CrestButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(()=>DeleteAsync(p))"/></Template></CrestDataGridColumn></Columns></CrestDataGrid> }
</CrestStack>
@code { MediaProfile[] Profiles=[]; bool Loading=true, Editing; string? Error,SelectedName,Name,Hint,Background; int Width,Height,Quality=80; bool AutoOrient=true; protected override Task OnInitializedAsync()=>LoadAsync(); async Task LoadAsync(){Loading=true;try{Profiles=await Api.Crest.Rest.MediaProfiles.ListAsync();}catch(Exception e){Error=e.Message;}finally{Loading=false;}} void NewProfile(){SelectedName=null;Name=Hint=Background=null;Width=Height=0;Quality=80;AutoOrient=true;Editing=true;} void Edit(MediaProfile p){SelectedName=Name=p.Name;Hint=p.Hint;Width=p.Width;Height=p.Height;Quality=p.Quality;Background=p.BackgroundColor;AutoOrient=p.AutoOrient;Editing=true;} void Cancel()=>Editing=false; async Task SaveAsync(){var saved=await Api.Crest.Rest.MediaProfiles.SaveAsync(Name!,new(Hint,Width,Height,0,0,Quality,Background,AutoOrient));if(saved is null){Error=T["Orchard did not save the profile."];return;}Editing=false;Notifications.Notify(NotificationSeverity.Success,T["Media Profiles"],T["Profile saved."]);await LoadAsync();} async Task DeleteAsync(MediaProfile p){if(await Api.Crest.Rest.MediaProfiles.DeleteAsync(p.Name)){Notifications.Notify(NotificationSeverity.Success,T["Media Profiles"],T["Profile deleted."]);await LoadAsync();}} }
