@page "/Admin/MediaProfiles"
@using Crest.Admin.Api
@using Radzen
@using Radzen.Blazor
@inject IApi Api
@inject NotificationService Notifications

<RadzenStack Gap="1rem" data-testid="media-profiles-page">
 <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"><RadzenStack Gap=".25rem"><RadzenText TextStyle="TextStyle.H4" Text="Media Profiles"/><RadzenText TextStyle="TextStyle.Body2" Text="Define reusable Orchard image transformations."/></RadzenStack><RadzenButton Text="New profile" Icon="add" Click="NewProfile"/></RadzenStack>
 @if (!string.IsNullOrWhiteSpace(Error)) { <RadzenAlert AlertStyle="AlertStyle.Danger">@Error</RadzenAlert> }
 @if (Editing) { <RadzenCard><RadzenStack Gap=".75rem"><RadzenText TextStyle="TextStyle.H5" Text="@((SelectedName is null) ? "New media profile" : $"Edit {SelectedName}")"/><RadzenTextBox @bind-Value="Name" Placeholder="Profile name" Disabled="@(SelectedName is not null)"/><RadzenTextBox @bind-Value="Hint" Placeholder="Hint"/><RadzenRow><RadzenColumn><RadzenNumeric @bind-Value="Width" Placeholder="Width" Style="width:100%"/></RadzenColumn><RadzenColumn><RadzenNumeric @bind-Value="Height" Placeholder="Height" Style="width:100%"/></RadzenColumn><RadzenColumn><RadzenNumeric @bind-Value="Quality" Placeholder="Quality" Style="width:100%"/></RadzenColumn></RadzenRow><RadzenTextBox @bind-Value="Background" Placeholder="Background color"/><RadzenCheckBox @bind-Value="AutoOrient"/> <span>Auto orient</span><RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"><RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel"/><RadzenButton Text="Save" Click="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(Name)"/></RadzenStack></RadzenStack></RadzenCard> }
 @if (Loading) { <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"/> } else { <RadzenDataGrid Data="@Profiles" TItem="MediaProfile" data-testid="media-profiles-grid"><Columns><RadzenDataGridColumn TItem="MediaProfile" Property="Name" Title="Name"/><RadzenDataGridColumn TItem="MediaProfile" Property="Hint" Title="Hint"/><RadzenDataGridColumn TItem="MediaProfile" Title="Size"><Template Context="p">@p.Width × @p.Height</Template></RadzenDataGridColumn><RadzenDataGridColumn TItem="MediaProfile" Property="Quality" Title="Quality"/><RadzenDataGridColumn TItem="MediaProfile" Title="Actions"><Template Context="p"><RadzenButton Icon="edit" Variant="Variant.Text" Click="@(()=>Edit(p))"/><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(()=>DeleteAsync(p))"/></Template></RadzenDataGridColumn></Columns></RadzenDataGrid> }
</RadzenStack>
@code { MediaProfile[] Profiles=[]; bool Loading=true, Editing; string? Error,SelectedName,Name,Hint,Background; int Width,Height,Quality=80; bool AutoOrient=true; protected override Task OnInitializedAsync()=>LoadAsync(); async Task LoadAsync(){Loading=true;try{Profiles=await Api.Crest.Rest.MediaProfiles.ListAsync();}catch(Exception e){Error=e.Message;}finally{Loading=false;}} void NewProfile(){SelectedName=null;Name=Hint=Background=null;Width=Height=0;Quality=80;AutoOrient=true;Editing=true;} void Edit(MediaProfile p){SelectedName=Name=p.Name;Hint=p.Hint;Width=p.Width;Height=p.Height;Quality=p.Quality;Background=p.BackgroundColor;AutoOrient=p.AutoOrient;Editing=true;} void Cancel()=>Editing=false; async Task SaveAsync(){var saved=await Api.Crest.Rest.MediaProfiles.SaveAsync(Name!,new(Hint,Width,Height,0,0,Quality,Background,AutoOrient));if(saved is null){Error="Orchard did not save the profile.";return;}Editing=false;Notifications.Notify(NotificationSeverity.Success,"Media profiles","Profile saved.");await LoadAsync();} async Task DeleteAsync(MediaProfile p){if(await Api.Crest.Rest.MediaProfiles.DeleteAsync(p.Name)){Notifications.Notify(NotificationSeverity.Success,"Media profiles","Profile deleted.");await LoadAsync();}} }
