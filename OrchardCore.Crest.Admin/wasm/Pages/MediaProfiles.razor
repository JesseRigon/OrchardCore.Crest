@page "/MediaProfiles"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="media-profiles-page">
 <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"><CrestStack Gap=".25rem"><CrestText TextStyle="TextStyle.H4" Text="@T.T("MediaProfiles_Title", "Media Profiles")"/><CrestText TextStyle="TextStyle.Body2" Text="@T.T("MediaProfiles_Description", "Define reusable Orchard image transformations.")"/></CrestStack><CrestButton Text="@T.T("MediaProfiles_NewProfile", "New profile")" Icon="add" Click="NewProfile"/></CrestStack>
 @if (!string.IsNullOrWhiteSpace(Error)) { <CrestAlert AlertStyle="AlertStyle.Danger">@Error</CrestAlert> }
 @if (Editing) { <CrestCard><CrestStack Gap=".75rem"><CrestText TextStyle="TextStyle.H5" Text="@((SelectedName is null) ? T.T("MediaProfiles_NewProfileHeading", "New media profile") : string.Format(T.T("MediaProfiles_EditFormat", "Edit {0}"), SelectedName))"/><CrestTextBox @bind-Value="Name" Placeholder="@T.T("MediaProfiles_NamePlaceholder", "Profile name")" Disabled="@(SelectedName is not null)"/><CrestTextBox @bind-Value="Hint" Placeholder="@T.T("MediaProfiles_HintPlaceholder", "Hint")"/><CrestRow><CrestColumn><CrestNumeric @bind-Value="Width" Placeholder="@T.T("MediaProfiles_WidthPlaceholder", "Width")" Style="width:100%"/></CrestColumn><CrestColumn><CrestNumeric @bind-Value="Height" Placeholder="@T.T("MediaProfiles_HeightPlaceholder", "Height")" Style="width:100%"/></CrestColumn><CrestColumn><CrestNumeric @bind-Value="Quality" Placeholder="@T.T("MediaProfiles_QualityPlaceholder", "Quality")" Style="width:100%"/></CrestColumn></CrestRow><CrestTextBox @bind-Value="Background" Placeholder="@T.T("MediaProfiles_BackgroundPlaceholder", "Background color")"/><CrestCheckBox @bind-Value="AutoOrient"/> <span>@T.T("MediaProfiles_AutoOrient", "Auto orient")</span><CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"><CrestButton Text="@T.T("MediaProfiles_Cancel", "Cancel")" ButtonStyle="ButtonStyle.Light" Click="Cancel"/><CrestButton Text="@T.T("MediaProfiles_Save", "Save")" Click="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(Name)"/></CrestStack></CrestStack></CrestCard> }
 @if (Loading) { <CrestProgressBar Mode="ProgressBarMode.Indeterminate"/> } else { <CrestDataGrid Data="@Profiles" TItem="MediaProfile" data-testid="media-profiles-grid"><Columns><CrestDataGridColumn TItem="MediaProfile" Property="Name" Title="@T.T("MediaProfiles_NameColumn", "Name")"/><CrestDataGridColumn TItem="MediaProfile" Property="Hint" Title="@T.T("MediaProfiles_HintColumn", "Hint")"/><CrestDataGridColumn TItem="MediaProfile" Title="@T.T("MediaProfiles_SizeColumn", "Size")"><Template Context="p">@p.Width × @p.Height</Template></CrestDataGridColumn><CrestDataGridColumn TItem="MediaProfile" Property="Quality" Title="@T.T("MediaProfiles_QualityColumn", "Quality")"/><CrestDataGridColumn TItem="MediaProfile" Title="@T.T("MediaProfiles_ActionsColumn", "Actions")"><Template Context="p"><CrestButton Icon="edit" Variant="Variant.Text" Click="@(()=>Edit(p))"/><CrestButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(()=>DeleteAsync(p))"/></Template></CrestDataGridColumn></Columns></CrestDataGrid> }
</CrestStack>
@code { MediaProfile[] Profiles=[]; bool Loading=true, Editing; string? Error,SelectedName,Name,Hint,Background; int Width,Height,Quality=80; bool AutoOrient=true; protected override Task OnInitializedAsync()=>LoadAsync(); async Task LoadAsync(){Loading=true;try{Profiles=await Api.Crest.Rest.MediaProfiles.ListAsync();}catch(Exception e){Error=e.Message;}finally{Loading=false;}} void NewProfile(){SelectedName=null;Name=Hint=Background=null;Width=Height=0;Quality=80;AutoOrient=true;Editing=true;} void Edit(MediaProfile p){SelectedName=Name=p.Name;Hint=p.Hint;Width=p.Width;Height=p.Height;Quality=p.Quality;Background=p.BackgroundColor;AutoOrient=p.AutoOrient;Editing=true;} void Cancel()=>Editing=false; async Task SaveAsync(){var saved=await Api.Crest.Rest.MediaProfiles.SaveAsync(Name!,new(Hint,Width,Height,0,0,Quality,Background,AutoOrient));if(saved is null){Error=T.T("MediaProfiles_SaveFailed", "Orchard did not save the profile.");return;}Editing=false;Notifications.Notify(NotificationSeverity.Success,T.T("MediaProfiles_NotifyTitle", "Media profiles"),T.T("MediaProfiles_SavedMessage", "Profile saved."));await LoadAsync();} async Task DeleteAsync(MediaProfile p){if(await Api.Crest.Rest.MediaProfiles.DeleteAsync(p.Name)){Notifications.Notify(NotificationSeverity.Success,T.T("MediaProfiles_NotifyTitle", "Media profiles"),T.T("MediaProfiles_DeletedMessage", "Profile deleted."));await LoadAsync();}} }
