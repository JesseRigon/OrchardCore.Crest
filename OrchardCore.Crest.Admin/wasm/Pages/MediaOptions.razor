@page "/Media/Options"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T
<CrestStack Gap="1rem" data-testid="media-options-page"><CrestStack Gap=".25rem"><CrestText TextStyle="TextStyle.H4" Text="@T["Media Options"]"/><CrestText TextStyle="TextStyle.Body2" Text="@T["Read-only Orchard media configuration from appsettings.json."]"/></CrestStack>@if(Model is null){<CrestProgressBar Mode="ProgressBarMode.Indeterminate"/>}else{<CrestCard><dl class="media-options"><dt>@T["Supported sizes"]</dt><dd>@string.Join(", ",Model.SupportedSizes)</dd><dt>@T["Allowed extensions"]</dt><dd>@string.Join(", ",Model.AllowedFileExtensions)</dd><dt>@T["Max file size"]</dt><dd>@T["{0} bytes", Model.MaxFileSize.ToString("n0")]</dd><dt>@T["Browser cache"]</dt><dd>@T["{0} days", Model.MaxBrowserCacheDays]</dd><dt>@T["Media URL path"]</dt><dd>@Model.AssetsRequestPath</dd><dt>@T["Assets path"]</dt><dd>@Model.AssetsPath</dd><dt>@T["Tokenized query strings"]</dt><dd>@(Model.UseTokenizedQueryString?T["Enabled"]:T["Disabled"])</dd></dl></CrestCard>}</CrestStack>
@code { CrestMediaOptions? Model; protected override async Task OnInitializedAsync()=>Model=await Api.Crest.Rest.MediaOptions.GetAsync(); }
