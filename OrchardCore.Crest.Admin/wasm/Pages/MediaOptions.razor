@page "/Media/Options"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T
<CrestStack Gap="1rem" data-testid="media-options-page"><CrestStack Gap=".25rem"><CrestText TextStyle="TextStyle.H4" Text="@T.T("MediaOptions_Title", "Media Options")"/><CrestText TextStyle="TextStyle.Body2" Text="@T.T("MediaOptions_Description", "Read-only Orchard media configuration from appsettings.json.")"/></CrestStack>@if(Model is null){<CrestProgressBar Mode="ProgressBarMode.Indeterminate"/>}else{<CrestCard><dl class="media-options"><dt>@T.T("MediaOptions_SupportedSizes", "Supported sizes")</dt><dd>@string.Join(", ",Model.SupportedSizes)</dd><dt>@T.T("MediaOptions_AllowedExtensions", "Allowed extensions")</dt><dd>@string.Join(", ",Model.AllowedFileExtensions)</dd><dt>@T.T("MediaOptions_MaxFileSize", "Max file size")</dt><dd>@string.Format(T.T("MediaOptions_BytesFormat", "{0} bytes"), Model.MaxFileSize.ToString("n0"))</dd><dt>@T.T("MediaOptions_BrowserCache", "Browser cache")</dt><dd>@string.Format(T.T("MediaOptions_DaysFormat", "{0} days"), Model.MaxBrowserCacheDays)</dd><dt>@T.T("MediaOptions_MediaUrlPath", "Media URL path")</dt><dd>@Model.AssetsRequestPath</dd><dt>@T.T("MediaOptions_AssetsPath", "Assets path")</dt><dd>@Model.AssetsPath</dd><dt>@T.T("MediaOptions_TokenizedQueryStrings", "Tokenized query strings")</dt><dd>@(Model.UseTokenizedQueryString?T.T("MediaOptions_Enabled", "Enabled"):T.T("MediaOptions_Disabled", "Disabled"))</dd></dl></CrestCard>}</CrestStack>
@code { CrestMediaOptions? Model; protected override async Task OnInitializedAsync()=>Model=await Api.Crest.Rest.MediaOptions.GetAsync(); }
