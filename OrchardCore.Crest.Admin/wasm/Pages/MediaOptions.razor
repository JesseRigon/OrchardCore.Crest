@page "/Admin/Media/Options"
@using Crest.Admin.Api
@using Radzen
@using Radzen.Blazor
@inject IApi Api
<RadzenStack Gap="1rem" data-testid="media-options-page"><RadzenStack Gap=".25rem"><RadzenText TextStyle="TextStyle.H4" Text="Media Options"/><RadzenText TextStyle="TextStyle.Body2" Text="Read-only Orchard media configuration from appsettings.json."/></RadzenStack>@if(Model is null){<RadzenProgressBar Mode="ProgressBarMode.Indeterminate"/>}else{<RadzenCard><dl class="media-options"><dt>Supported sizes</dt><dd>@string.Join(", ",Model.SupportedSizes)</dd><dt>Allowed extensions</dt><dd>@string.Join(", ",Model.AllowedFileExtensions)</dd><dt>Max file size</dt><dd>@Model.MaxFileSize.ToString("n0") bytes</dd><dt>Browser cache</dt><dd>@Model.MaxBrowserCacheDays days</dd><dt>Media URL path</dt><dd>@Model.AssetsRequestPath</dd><dt>Assets path</dt><dd>@Model.AssetsPath</dd><dt>Tokenized query strings</dt><dd>@(Model.UseTokenizedQueryString?"Enabled":"Disabled")</dd></dl></RadzenCard>}</RadzenStack>
@code { CrestMediaOptions? Model; protected override async Task OnInitializedAsync()=>Model=await Api.Crest.Rest.MediaOptions.GetAsync(); }
