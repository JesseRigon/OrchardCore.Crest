@page "/Admin/Media/Options"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
<CrestStack Gap="1rem" data-testid="media-options-page"><CrestStack Gap=".25rem"><CrestText TextStyle="TextStyle.H4" Text="Media Options"/><CrestText TextStyle="TextStyle.Body2" Text="Read-only Orchard media configuration from appsettings.json."/></CrestStack>@if(Model is null){<CrestProgressBar Mode="ProgressBarMode.Indeterminate"/>}else{<CrestCard><dl class="media-options"><dt>Supported sizes</dt><dd>@string.Join(", ",Model.SupportedSizes)</dd><dt>Allowed extensions</dt><dd>@string.Join(", ",Model.AllowedFileExtensions)</dd><dt>Max file size</dt><dd>@Model.MaxFileSize.ToString("n0") bytes</dd><dt>Browser cache</dt><dd>@Model.MaxBrowserCacheDays days</dd><dt>Media URL path</dt><dd>@Model.AssetsRequestPath</dd><dt>Assets path</dt><dd>@Model.AssetsPath</dd><dt>Tokenized query strings</dt><dd>@(Model.UseTokenizedQueryString?"Enabled":"Disabled")</dd></dl></CrestCard>}</CrestStack>
@code { CrestMediaOptions? Model; protected override async Task OnInitializedAsync()=>Model=await Api.Crest.Rest.MediaOptions.GetAsync(); }
