@page "/Admin/Settings/admin"
@using Crest.Admin.Api
@using Crest.Admin.Components.Shared
@using Crest.Admin.DisplayManagement
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject DisplayManager DisplayManager

<CrestStack Gap="1rem">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="Admin Settings" />
            <CrestText TextStyle="TextStyle.Body2" Text="Manage Orchard admin UI options and route access planning." />
        </CrestStack>
        <CrestButton Text="Refresh" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="@LoadAsync" Disabled="@IsBusy" />
    </CrestStack>

    <CrestCard>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
        }
        else if (IsLoading)
        {
            <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <CrestProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <CrestText Text="Loading settings..." />
            </CrestStack>
        }
        else
        {
            <CrestMainContentTabs @bind-SelectedIndex="SelectedTabIndex" aria-label="Admin settings sections">
                <CrestTabsItem Text="Admin" Icon="admin_panel_settings">
                    <CrestTemplateForm TItem="AdminSettingsModel" Data="@Model" Submit="@(_ => SaveAsync())">
                        <CrestStack Gap="1rem">
                            <CrestText TextStyle="TextStyle.H5" Text="Admin" />
                            <SettingsSwitch Label="Enable theme toggler" Hint="Whether or not to display a theme toggler." @bind-Value="Model.DisplayThemeToggler" />
                            <SettingsSwitch Label="Enable Admin Menu filter" Hint="Whether a quick search to filter the admin menu is displayed." @bind-Value="Model.DisplayMenuFilter" />
                            <SettingsSwitch Label="Display titles in top bar" Hint="Whether the titles are displayed in the top bar." @bind-Value="Model.DisplayTitlesInTopbar" />
                            <CrestFieldset Text="Title bar">
                                <CrestStack Gap="0.75rem">
                                    <SettingsSwitch Label="Display culture label" Hint="Show the culture name beside its flag. The default is the flag icon only." @bind-Value="TitleBarModel.DisplayCultureLabel" />
                                    <CrestDropDown Data="@AvatarShapes" @bind-Value="TitleBarModel.TenantAvatarShape" TextProperty="Label" ValueProperty="Value" Placeholder="Tenant avatar shape" Style="width: 100%;" />
                                    <CrestTextBox @bind-Value="TitleBarModel.TenantAvatarImageUrl" Placeholder="Tenant avatar image URL (optional)" Style="width: 100%;" />
                                    @if (string.Equals(TitleBarModel.TenantAvatarShape, "Custom", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <CrestTextBox @bind-Value="TitleBarModel.TenantAvatarClipPath" Placeholder="CSS/SVG clip-path, for example polygon(...) or url(#clip)" Style="width: 100%;" />
                                        <CrestTextBox @bind-Value="TitleBarModel.TenantAvatarBorderRadius" Placeholder="Optional border radius" Style="width: 100%;" />
                                    }
                                </CrestStack>
                            </CrestFieldset>
                            <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                <CrestButton Text="Save settings" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                            </CrestStack>
                        </CrestStack>
                    </CrestTemplateForm>
                </CrestTabsItem>
                <CrestTabsItem Text="Site Map" Icon="account_tree">
                    <CrestStack Gap="1rem">
                        <CrestStack Gap="0.25rem">
                            <CrestText TextStyle="TextStyle.H5" Text="Site Map" />
                            <CrestText TextStyle="TextStyle.Body2" Text="Route access management placeholder. This uses the admin menu tree editor presentation for now; route permissions and access-control editors will be added here as requirements firm up." />
                        </CrestStack>
                        @if (RouteNodes.Length == 0)
                        {
                            <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">No routes were discovered for the admin site map.</CrestAlert>
                        }
                        else
                        {
                            <ol class="admin-menu-tree__list admin-menu-tree__list--root">
                                @foreach (var node in RouteNodes)
                                {
                                    @RenderRouteNode(node)
                                }
                            </ol>
                        }
                    </CrestStack>
                </CrestTabsItem>
            </CrestMainContentTabs>
        }
    </CrestCard>
</CrestStack>

<style>
    .admin-menu-tree__list { list-style: none; margin: 0; padding-left: 1.25rem; }
    .admin-menu-tree__list--root { padding-left: 0; }
    .admin-menu-tree__item { margin: 0.45rem 0; }
    .admin-menu-node { border: 1px solid var(--rz-border-color); border-radius: var(--rz-border-radius); background: var(--rz-base-background-color); padding: 0.65rem; }
    .admin-menu-node__handle { color: var(--rz-text-secondary-color); border: 1px dashed var(--rz-border-color); border-radius: 999px; padding: 0.15rem 0.35rem; user-select: none; display: inline-flex; align-items: center; }
    .admin-menu-node__spacer { display: inline-block; width: 2rem; }
</style>

@code {
    private int SelectedTabIndex { get; set; }
    private AdminSettingsModel Model { get; set; } = new();
    private TitleBarSettingsModel TitleBarModel { get; set; } = new();
    private static TitleBarShapeOption[] AvatarShapes { get; } =
    [new("Circle", "Circle"), new("RoundedSquare", "Rounded square"), new("Square", "Square"), new("Custom", "Custom clip path")];
    private RouteNode[] RouteNodes { get; set; } = [];
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Model = AdminSettingsModel.From(await Api.Crest.Rest.AdminSettings.GetAsync());
            TitleBarModel = TitleBarSettingsModel.From(await Api.Crest.Rest.TitleBarSettings.GetAsync());
            var manifest = await Api.Crest.Rest.App.GetManifestAsync();
            RouteNodes = manifest?.AdminMenu.Items.Select((item, index) => RouteNode.From(item, null, 0, index)).ToArray() ?? [];
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        try
        {
            var saved = await Api.Crest.Rest.AdminSettings.UpdateAsync(Model.ToUpdate());
            var titleBarSaved = await Api.Crest.Rest.TitleBarSettings.UpdateAsync(TitleBarModel.ToUpdate());
            if (saved is not null && titleBarSaved is not null)
            {
                Model = AdminSettingsModel.From(saved);
                TitleBarModel = TitleBarSettingsModel.From(titleBarSaved);
                await DisplayManager.RefreshAdminStateAsync();
                Notifications.Notify(NotificationSeverity.Success, "Settings saved", "Admin settings were updated.");
            }
        }
        finally { IsSaving = false; }
    }

    private RenderFragment RenderRouteNode(RouteNode node) => @<li class="admin-menu-tree__item">
        <div class="admin-menu-node">
            <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem">
                <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.65rem">
                    <span class="admin-menu-node__handle" title="Drag to move"><CrestIcon IconKey="iconify.mdi/current/default/drag" /></span>
                    @if (node.Items.Length > 0)
                    {
                        <CrestButton Size="ButtonSize.Small" Icon="expand_more" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Disabled="true" title="Expand/collapse coming soon" />
                    }
                    else
                    {
                        <span class="admin-menu-node__spacer"></span>
                    }
                    <CrestStack Gap="0.1rem" Style="flex: 1; min-width: 0;">
                        <CrestText TextStyle="TextStyle.Subtitle2" Text="@node.Text" />
                        <CrestText TextStyle="TextStyle.Caption" Text="@node.Meta" />
                    </CrestStack>
                </CrestStack>
                <CrestStack Orientation="Orientation.Horizontal" Gap="0.35rem">
                    <CrestButton Size="ButtonSize.Small" Icon="edit" ButtonStyle="ButtonStyle.Light" Disabled="true" title="Edit route permissions coming soon" />
                    <CrestButton Size="ButtonSize.Small" Icon="visibility_off" ButtonStyle="ButtonStyle.Light" Disabled="true" title="Toggle route access coming soon" />
                    <CrestButton Size="ButtonSize.Small" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Disabled="true" title="Delete route override coming soon" />
                </CrestStack>
            </CrestStack>
        </div>
        @if (node.Items.Length > 0)
        {
            <ol class="admin-menu-tree__list">
                @foreach (var child in node.Items)
                {
                    @RenderRouteNode(child)
                }
            </ol>
        }
    </li>;

    private sealed class AdminSettingsModel
    {
        public bool DisplayThemeToggler { get; set; }
        public bool DisplayMenuFilter { get; set; }
        public bool DisplayTitlesInTopbar { get; set; }

        public static AdminSettingsModel From(AdminSettingsDto settings) => new()
        {
            DisplayThemeToggler = settings.DisplayThemeToggler,
            DisplayMenuFilter = settings.DisplayMenuFilter,
            DisplayTitlesInTopbar = settings.DisplayTitlesInTopbar,
        };

        public AdminSettingsUpdate ToUpdate() => new(DisplayThemeToggler, DisplayMenuFilter, true, DisplayTitlesInTopbar);
    }

    private sealed class TitleBarSettingsModel
    {
        public bool DisplayCultureLabel { get; set; }
        public string? TenantAvatarImageUrl { get; set; }
        public string TenantAvatarShape { get; set; } = "Circle";
        public string? TenantAvatarClipPath { get; set; }
        public string? TenantAvatarBorderRadius { get; set; }

        public static TitleBarSettingsModel From(CrestTitleBarSettingsDto settings) => new()
        {
            DisplayCultureLabel = settings.DisplayCultureLabel,
            TenantAvatarImageUrl = settings.TenantAvatarImageUrl,
            TenantAvatarShape = settings.TenantAvatarShape,
            TenantAvatarClipPath = settings.TenantAvatarClipPath,
            TenantAvatarBorderRadius = settings.TenantAvatarBorderRadius,
        };

        public CrestTitleBarSettingsUpdate ToUpdate() => new(DisplayCultureLabel, TenantAvatarImageUrl, TenantAvatarShape, TenantAvatarClipPath, TenantAvatarBorderRadius);
    }

    private sealed record TitleBarShapeOption(string Value, string Label);

    private sealed record RouteNode(string Id, string Text, string Meta, RouteNode[] Items)
    {
        public static RouteNode From(NavigationItem item, string? parentId, int depth, int order)
        {
            var id = item.Key;
            var metaValues = new List<string>();
            if (!string.IsNullOrWhiteSpace(item.Link)) metaValues.Add(item.Link!);
            if (item.Classes.Length > 0) metaValues.Add($"Classes: {string.Join(" ", item.Classes)}");
            if (!string.IsNullOrWhiteSpace(parentId)) metaValues.Add($"Parent: {parentId}");

            return new(id, item.Text, metaValues.Count == 0 ? $"Route group • depth {depth} • order {order}" : string.Join(" • ", metaValues), item.Items.Select((child, index) => From(child, id, depth + 1, index)).ToArray());
        }
    }
}
