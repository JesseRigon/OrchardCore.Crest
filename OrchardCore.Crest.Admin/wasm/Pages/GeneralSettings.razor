@page "/Settings/general"
@using Crest.Admin.Api
@using Crest.Admin.Components.Shared
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T.T("GeneralSettings_Heading", "General Settings")" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T.T("GeneralSettings_Description", "Manage standard Orchard site, resource, and cache settings.")" />
        </CrestStack>
        <CrestButton Text="@T.T("GeneralSettings_Refresh", "Refresh")" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="@LoadAsync" Disabled="@IsBusy" />
    </CrestStack>

    <CrestCard>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
        }
        else if (IsLoading)
        {
            <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <CrestProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <CrestText Text="@T.T("GeneralSettings_Loading", "Loading settings...")" />
            </CrestStack>
        }
        else
        {
            <CrestTemplateForm TItem="SiteSettingsModel" Data="@Model" Submit="@(_ => SaveAsync())">
                <CrestStack Gap="1rem">
                    <CrestMainContentTabs @bind-SelectedIndex="SelectedTabIndex" aria-label="@T.T("GeneralSettings_SectionsAriaLabel", "General settings sections")">
                        <CrestTabsItem Text="@T.T("GeneralSettings_GeneralTab", "General")" Icon="settings">
                            <CrestStack Gap="1rem">
                            <CrestText TextStyle="TextStyle.H5" Text="@T.T("GeneralSettings_GeneralTab", "General")" />
                            <CrestRow Gap="1rem">
                                <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T.T("GeneralSettings_SiteNameLabel", "Site name")" Style="width: 100%;"><CrestTextBox @bind-Value="Model.SiteName" Style="width: 100%;" /></CrestFormField></CrestColumn>
                                <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T.T("GeneralSettings_BaseUrlLabel", "Base URL")" Style="width: 100%;"><CrestTextBox @bind-Value="Model.BaseUrl" Style="width: 100%;" /></CrestFormField></CrestColumn>
                                <CrestColumn Size="12"><CrestFormField Text="@T.T("GeneralSettings_PageTitleFormatLabel", "Page title format")" Style="width: 100%;"><CrestTextBox @bind-Value="Model.PageTitleFormat" Style="width: 100%;" /></CrestFormField></CrestColumn>
                                <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T.T("GeneralSettings_TimeZoneLabel", "Default Time Zone")" Style="width: 100%;"><CrestTextBox @bind-Value="Model.TimeZoneId" Style="width: 100%;" /></CrestFormField></CrestColumn>
                                <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T.T("GeneralSettings_CalendarLabel", "Calendar")" Style="width: 100%;"><CrestTextBox @bind-Value="Model.Calendar" Style="width: 100%;" /></CrestFormField></CrestColumn>
                                <CrestColumn Size="12" SizeMD="4"><CrestFormField Text="@T.T("GeneralSettings_PageSizeLabel", "Page size")" Style="width: 100%;"><CrestNumeric @bind-Value="Model.PageSize" Style="width: 100%;" /></CrestFormField></CrestColumn>
                                <CrestColumn Size="12" SizeMD="4"><CrestFormField Text="@T.T("GeneralSettings_MaxPageSizeLabel", "Max page size")" Style="width: 100%;"><CrestNumeric @bind-Value="Model.MaxPageSize" Style="width: 100%;" /></CrestFormField></CrestColumn>
                                <CrestColumn Size="12" SizeMD="4"><CrestFormField Text="@T.T("GeneralSettings_MaxPagedCountLabel", "Max paged count")" Style="width: 100%;"><CrestNumeric @bind-Value="Model.MaxPagedCount" Style="width: 100%;" /></CrestFormField></CrestColumn>
                            </CrestRow>
                            </CrestStack>
                        </CrestTabsItem>
                        <CrestTabsItem Text="@T.T("GeneralSettings_ResourcesTab", "Resources")" Icon="widgets">
                            <CrestStack Gap="1rem">
                            <CrestText TextStyle="TextStyle.H5" Text="@T.T("GeneralSettings_ResourcesTab", "Resources")" />
                            <SettingsSwitch Label="@T.T("GeneralSettings_CacheBustingLabel", "Use resources cache busting")" Hint="@T.T("GeneralSettings_CacheBustingHint", "Whether cache busting (append a version) is used for scripts and stylesheets.")" @bind-Value="Model.AppendVersion" />
                            <SettingsSwitch Label="@T.T("GeneralSettings_UseCdnLabel", "Use framework CDN (Content Delivery Network)")" Hint="@T.T("GeneralSettings_UseCdnHint", "Whether a framework CDN is used for registered scripts and stylesheets, such as jQuery, or their local version.")" @bind-Value="Model.UseCdn" />
                            <CrestFormField Text="@T.T("GeneralSettings_CdnBaseUrlLabel", "Site CDN (Content Delivery Network) base URL")" Style="width: 100%;"><CrestTextBox @bind-Value="Model.CdnBaseUrl" Style="width: 100%;" /></CrestFormField>
                            <CrestFormField Text="@T.T("GeneralSettings_ResourceDebugModeLabel", "Resource Debug Mode")" Style="width: 100%; max-width: 48rem;"><CrestDropDown @bind-Value="Model.ResourceDebugMode" Data="ResourceDebugOptions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /></CrestFormField>
                            <CrestText TextStyle="TextStyle.Caption" Text="@T.T("GeneralSettings_ResourceDebugModeCaption", "Determines whether scripts and stylesheets load in their debuggable or minified form.")" />
                            </CrestStack>
                        </CrestTabsItem>
                        <CrestTabsItem Text="@T.T("GeneralSettings_CacheTab", "Cache")" Icon="cached">
                            <CrestStack Gap="1rem">
                            <CrestText TextStyle="TextStyle.H5" Text="@T.T("GeneralSettings_CacheTab", "Cache")" />
                            <CrestFormField Text="@T.T("GeneralSettings_CacheModeLabel", "Cache Mode")" Style="width: 100%; max-width: 48rem;"><CrestDropDown @bind-Value="Model.CacheMode" Data="CacheModeOptions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /></CrestFormField>
                            <CrestText TextStyle="TextStyle.Caption" Text="@T.T("GeneralSettings_CacheModeCaption", "Determines whether caches are enabled or disabled.")" />
                            </CrestStack>
                        </CrestTabsItem>
                    </CrestMainContentTabs>

                    <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <CrestButton Text="@T.T("GeneralSettings_SaveSettings", "Save settings")" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                    </CrestStack>
                </CrestStack>
            </CrestTemplateForm>
        }
    </CrestCard>
</CrestStack>

@code {
    // Properties (not static readonly fields) since they depend on T, which isn't set
    // yet during field initializer execution (constructor runs before [Inject]
    // properties are assigned).
    private SelectOption[] ResourceDebugOptions =>
    [
        new("FromConfiguration", T.T("GeneralSettings_ResourceDebugFromConfigOption", "From environment — disabled in Production, enabled otherwise")),
        new("Enabled", T.T("GeneralSettings_ResourceDebugEnabledOption", "Enabled — use debuggable version of resources")),
        new("Disabled", T.T("GeneralSettings_ResourceDebugDisabledOption", "Disabled — use minified version of resources")),
    ];

    private SelectOption[] CacheModeOptions =>
    [
        new("FromConfiguration", T.T("GeneralSettings_CacheModeFromConfigOption", "From environment — enabled in Production, disabled otherwise")),
        new("Enabled", T.T("GeneralSettings_CacheModeEnabledOption", "Enabled")),
        new("DebugEnabled", T.T("GeneralSettings_CacheModeDebugEnabledOption", "Enabled with cache debug mode")),
        new("Disabled", T.T("GeneralSettings_CacheModeDisabledOption", "Disabled")),
    ];

    private int SelectedTabIndex { get; set; }
    private SiteSettingsModel Model { get; set; } = new();
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Model = SiteSettingsModel.From(await Api.Crest.Rest.Site.GetAsync()); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        try
        {
            var saved = await Api.Crest.Rest.Site.UpdateAsync(Model.ToUpdate());
            if (saved is not null)
            {
                Model = SiteSettingsModel.From(saved);
                Notifications.Notify(NotificationSeverity.Success, T.T("GeneralSettings_SavedTitle", "Settings saved"), T.T("GeneralSettings_SavedMessage", "General settings were updated."));
            }
        }
        finally { IsSaving = false; }
    }

    private sealed record SelectOption(string Value, string Text);

    private sealed class SiteSettingsModel
    {
        public string SiteName { get; set; } = string.Empty;
        public string PageTitleFormat { get; set; } = string.Empty;
        public string BaseUrl { get; set; } = string.Empty;
        public string TimeZoneId { get; set; } = string.Empty;
        public string Calendar { get; set; } = string.Empty;
        public int PageSize { get; set; }
        public int MaxPageSize { get; set; }
        public int MaxPagedCount { get; set; }
        public bool AppendVersion { get; set; }
        public bool UseCdn { get; set; }
        public string CdnBaseUrl { get; set; } = string.Empty;
        public string ResourceDebugMode { get; set; } = "FromConfiguration";
        public string CacheMode { get; set; } = "FromConfiguration";

        public static SiteSettingsModel From(SiteSettings settings) => new()
        {
            SiteName = settings.SiteName,
            PageTitleFormat = settings.PageTitleFormat,
            BaseUrl = settings.BaseUrl,
            TimeZoneId = settings.TimeZoneId,
            Calendar = settings.Calendar,
            PageSize = settings.PageSize,
            MaxPageSize = settings.MaxPageSize,
            MaxPagedCount = settings.MaxPagedCount,
            AppendVersion = settings.AppendVersion,
            UseCdn = settings.UseCdn,
            CdnBaseUrl = settings.CdnBaseUrl,
            ResourceDebugMode = settings.ResourceDebugMode,
            CacheMode = settings.CacheMode,
        };

        public SiteSettingsUpdate ToUpdate() => new(SiteName, PageTitleFormat, BaseUrl, TimeZoneId, Calendar, PageSize, MaxPageSize, MaxPagedCount, AppendVersion, UseCdn, CdnBaseUrl, ResourceDebugMode, CacheMode);
    }
}
