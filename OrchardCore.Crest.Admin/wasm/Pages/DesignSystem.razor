@page "/DesignSystem"
@using Crest.Admin.Api
@using Crest.Admin.Components.Admin
@using Crest.Admin.DisplayManagement
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject DisplayManager DisplayManager
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

    <CrestStack Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["Design System"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["Edit Orchard Crest UI Framework primitive design tokens for the active tenant without switching or creating Orchard themes."]" />
        </CrestStack>

        <CrestAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
            @T["These settings are tenant site settings for now. They override Crest primitive design tokens at runtime while the selected Orchard theme remains the same."]
        </CrestAlert>

        <CrestCard>
            <CrestTemplateForm TItem="DesignSystemModel" Data="@Model" Submit="SaveAsync">
                <CrestStack Gap="1rem">
                    <CrestRow Gap="1rem">
                        <CrestColumn Size="12" SizeMD="6">
                            <CrestLabel Text="@T["Crest base theme"]" />
                            <CrestDropDown TValue="string" Data="@RadzenThemes" @bind-Value="Model.RadzenTheme" Style="width: 100%;" />
                        </CrestColumn>
                        <CrestColumn Size="12" SizeMD="6">
                            <CrestLabel Text="@T["Border radius"]" />
                            <CrestTextBox @bind-Value="Model.Radius" Placeholder="6px" Style="width: 100%;" />
                        </CrestColumn>
                    </CrestRow>

                    <CrestRow Gap="1rem">
                        <CrestColumn Size="12" SizeMD="3">
                            <CrestLabel Text="@T["Accent 1"]" />
                            <CrestColorPicker @bind-Value="Model.Primary" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </CrestColumn>
                        <CrestColumn Size="12" SizeMD="3">
                            <CrestLabel Text="@T["Accent 2"]" />
                            <CrestColorPicker @bind-Value="Model.Secondary" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </CrestColumn>
                        <CrestColumn Size="12" SizeMD="3">
                            <CrestLabel Text="@T["Surface 1"]" />
                            <CrestColorPicker @bind-Value="Model.Surface" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </CrestColumn>
                        <CrestColumn Size="12" SizeMD="3">
                            <CrestLabel Text="@T["Surface 2"]" />
                            <CrestColorPicker @bind-Value="Model.Background" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </CrestColumn>
                    </CrestRow>

                    <div class="design-system-preview">
                        <CrestText TextStyle="TextStyle.H6" Text="@T["Preview"]" />
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="flex-wrap: wrap;">
                            <CrestButton Text="@T["Primary Action"]" ButtonStyle="ButtonStyle.Primary" />
                            <CrestButton Text="@T["Secondary Action"]" ButtonStyle="ButtonStyle.Secondary" />
                            <CrestButton Text="@T["Light Action"]" ButtonStyle="ButtonStyle.Light" />
                        </CrestStack>
                    </div>

                    <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <CrestButton Text="@T["Save"]" Icon="save" ButtonType="ButtonType.Submit" Disabled="@DisplayManager.IsBusy" />
                        <CrestButton Text="@T["Reset defaults"]" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="ResetDefaults" ButtonType="ButtonType.Button" Disabled="@DisplayManager.IsBusy" />
                    </CrestStack>
                </CrestStack>
            </CrestTemplateForm>
        </CrestCard>
    </CrestStack>

@code {
    private static readonly string[] RadzenThemes =
    [
        "material-base",
        "material-dark-base",
        "standard-base",
        "standard-dark-base",
        "default",
        "dark",
        "software",
        "humanistic"
    ];

    private DesignSystemModel Model { get; set; } = new();

    protected override void OnInitialized()
    {
        Model = DesignSystemModel.From(DisplayManager.Theme);
    }

    private async Task SaveAsync()
    {
        var saved = await DisplayManager.UpdateThemeAsync(Model.ToSettings());
        if (saved is not null)
        {
            Model = DesignSystemModel.From(saved);
            Notifications.Notify(NotificationSeverity.Success, T["Design system saved"], T["The tenant design tokens were updated."]);
        }
        else
        {
            Notifications.Notify(NotificationSeverity.Error, T["Design system save failed"], T["The server could not save the design tokens."]);
        }
    }

    private void ResetDefaults()
    {
        Model = DesignSystemModel.From(CrestThemeSettings.Default);
    }

    private sealed class DesignSystemModel
    {
        public string RadzenTheme { get; set; } = CrestThemeSettings.Default.RadzenTheme;
        public string Primary { get; set; } = "#2f6f4e";
        public string Secondary { get; set; } = "#6d5d3f";
        public string Surface { get; set; } = "#ffffff";
        public string Background { get; set; } = "#f7f8f6";
        public string Radius { get; set; } = "6px";

        public static DesignSystemModel From(CrestThemeSettings settings) => new()
        {
            RadzenTheme = settings.RadzenTheme,
            Primary = Get(settings, "primary", "#2f6f4e"),
            Secondary = Get(settings, "secondary", "#6d5d3f"),
            Surface = Get(settings, "surface", "#ffffff"),
            Background = Get(settings, "background", "#f7f8f6"),
            Radius = Get(settings, "radius", "6px"),
        };

        public CrestThemeSettings ToSettings() => new(RadzenTheme, new(StringComparer.OrdinalIgnoreCase)
        {
            ["primary"] = Primary,
            ["secondary"] = Secondary,
            ["surface"] = Surface,
            ["background"] = Background,
            ["radius"] = Radius,
        });

        private static string Get(CrestThemeSettings settings, string key, string fallback) =>
            settings.Tokens.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : fallback;
    }
}
