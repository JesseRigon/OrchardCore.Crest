@page "/Tenants"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="tenants-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["Tenants"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["Manage tenants from the default Orchard tenant."]" />
        </CrestStack>
        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <CrestButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" />
            <CrestButton Text="@T["Add Tenant"]" Icon="add" Click="CreateTenant" Disabled="@IsBusy" />
        </CrestStack>
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    <CrestCard>
        <CrestRow AlignItems="AlignItems.End" Gap="0.75rem">
            <CrestColumn Size="12" SizeMD="4"><CrestFormField Text="@T["Search"]" Style="width: 100%;"><CrestTextBox @bind-Value="Search" Placeholder="@T["Search name, host, or prefix"]" Style="width: 100%;" /></CrestFormField></CrestColumn>
            <CrestColumn Size="12" SizeMD="2"><CrestFormField Text="@T["Category"]" Style="width: 100%;"><CrestDropDown @bind-Value="Category" Data="CategoryOptions" AllowClear="true" Style="width: 100%;" /></CrestFormField></CrestColumn>
            <CrestColumn Size="12" SizeMD="2"><CrestFormField Text="@T["State"]" Style="width: 100%;"><CrestDropDown @bind-Value="State" Data="StateOptions" AllowClear="true" Style="width: 100%;" /></CrestFormField></CrestColumn>
            <CrestColumn Size="12" SizeMD="2"><CrestFormField Text="@T["Sort"]" Style="width: 100%;"><CrestDropDown @bind-Value="OrderBy" Data="OrderOptions" Style="width: 100%;" /></CrestFormField></CrestColumn>
            <CrestColumn Size="12" SizeMD="2"><CrestButton Text="@T["Apply"]" Icon="filter_alt" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" /></CrestColumn>
        </CrestRow>
    </CrestCard>

    @if (ConfirmAction is not null)
    {
        <CrestAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                <span>@ConfirmMessage</span>
                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem"><CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelConfirm" Disabled="@IsBusy" /><CrestButton Text="@T["Confirm"]" ButtonStyle="ButtonStyle.Danger" Click="RunConfirmedActionAsync" Disabled="@IsBusy" /></CrestStack>
            </CrestStack>
        </CrestAlert>
    }

    <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <CrestButton Text="@T["Enable selected ({0})", SelectedNames.Count]" Icon="play_arrow" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmBulk("Enable"))" Disabled="@(SelectedNames.Count == 0 || IsBusy)" />
        <CrestButton Text="@T["Disable selected ({0})", SelectedNames.Count]" Icon="pause" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmBulk("Disable"))" Disabled="@(SelectedNames.Count == 0 || IsBusy)" />
    </CrestStack>

    <CrestCard>
        @if (IsLoading)
        {
            <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Catalog.Tenants.Length == 0)
        {
            <CrestText TextStyle="TextStyle.Body2" Text="@T["No tenants match this filter."]" />
        }
        else
        {
            <CrestDataGrid Data="@Catalog.Tenants" TItem="CrestTenant" AllowPaging="true" PageSize="20">
                <Columns>
                    <CrestDataGridColumn TItem="CrestTenant" Width="3.5rem" Sortable="false" Filterable="false"><HeaderTemplate><CrestCheckBox Value="@(Catalog.Tenants.Length > 0 && Catalog.Tenants.All(tenant => SelectedNames.Contains(tenant.Name)))" Change="@((bool value) => ToggleAll(value))" Name="select-all-tenants" /></HeaderTemplate><Template Context="tenant"><CrestCheckBox Value="@SelectedNames.Contains(tenant.Name)" Change="@((bool value) => Toggle(tenant.Name, value))" Name="@($"tenant-{tenant.Name}")" Disabled="@tenant.IsDefault" /></Template></CrestDataGridColumn>
                    <CrestDataGridColumn TItem="CrestTenant" Property="Name" Title="@T["Name"]"><Template Context="tenant"><CrestStack Gap="0.15rem"><CrestText TextStyle="TextStyle.Subtitle2" Text="@tenant.Name" />@if (tenant.IsDefault) { <CrestText TextStyle="TextStyle.Caption" Text="@T["Default tenant"]" /> }</CrestStack></Template></CrestDataGridColumn>
                    <CrestDataGridColumn TItem="CrestTenant" Property="State" Title="@T["State"]" />
                    <CrestDataGridColumn TItem="CrestTenant" Property="Category" Title="@T["Category"]"><Template Context="tenant">@(string.IsNullOrWhiteSpace(tenant.Category) ? "—" : tenant.Category)</Template></CrestDataGridColumn>
                    <CrestDataGridColumn TItem="CrestTenant" Title="@T["Host / prefix"]"><Template Context="tenant"><CrestStack Gap="0.1rem">@if (!string.IsNullOrWhiteSpace(tenant.RequestUrlHost)) { <CrestText TextStyle="TextStyle.Caption" Text="@tenant.RequestUrlHost" /> } @if (!string.IsNullOrWhiteSpace(tenant.RequestUrlPrefix)) { <CrestText TextStyle="TextStyle.Caption" Text="@tenant.RequestUrlPrefix" /> }</CrestStack></Template></CrestDataGridColumn>
                    <CrestDataGridColumn TItem="CrestTenant" Title="@T["Actions"]" Width="14rem"><Template Context="tenant"><CrestStack Orientation="Orientation.Horizontal" Gap="0.25rem"><CrestButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => EditTenant(tenant.Name))" title="@T["Edit"]" />@if (tenant.State == "Running" && !tenant.IsDefault) { <CrestButton Icon="pause" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmSingle("Disable", tenant.Name))" title="@T["Disable"]" /> } @if (tenant.State == "Disabled") { <CrestButton Icon="play_arrow" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmSingle("Enable", tenant.Name))" title="@T["Enable"]" /> }<CrestButton Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ReloadAsync(tenant.Name))" title="@T["Reload"]" />@if (Catalog.TenantRemovalAllowed && tenant.IsRemovable) { <CrestButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => ConfirmSingle("Remove", tenant.Name))" title="@T["Remove"]" /> }</CrestStack></Template></CrestDataGridColumn>
                </Columns>
            </CrestDataGrid>
        }
    </CrestCard>
</CrestStack>

@code {
    private CrestTenantCatalog Catalog { get; set; } = CrestTenantCatalog.Empty;
    private HashSet<string> SelectedNames { get; } = new(StringComparer.OrdinalIgnoreCase);
    private string? Search { get; set; }
    private string? Category { get; set; }
    private string? State { get; set; }
    private string OrderBy { get; set; } = "Name";
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }
    private string? ConfirmAction { get; set; }
    private string[] ConfirmNames { get; set; } = [];
    private string ConfirmMessage => ConfirmAction == "Remove"
        ? T["Remove tenant {0}? This cannot be undone.", ConfirmNames.FirstOrDefault()]
        : T["{0} {1} tenant{2}?", ConfirmAction, ConfirmNames.Length, ConfirmNames.Length == 1 ? string.Empty : "s"];
    private IEnumerable<string> CategoryOptions => Catalog.Categories;
    private static readonly string[] StateOptions = ["Running", "Disabled", "Uninitialized"];
    private static readonly string[] OrderOptions = ["Name", "State"];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Catalog = await Api.Crest.Rest.Tenants.ListAsync(Search, Category, State, OrderBy); }
        catch (Exception exception) { ErrorMessage = exception.Message; }
        finally { IsLoading = false; }
    }

    private void CreateTenant() => Navigation.NavigateTo("Tenants/Create");
    private void EditTenant(string name) => Navigation.NavigateTo($"Tenants/Edit/{Uri.EscapeDataString(name)}");
    private void Toggle(string name, bool selected) { if (selected) SelectedNames.Add(name); else SelectedNames.Remove(name); }
    private void ToggleAll(bool selected) { if (selected) foreach (var tenant in Catalog.Tenants.Where(tenant => !tenant.IsDefault)) SelectedNames.Add(tenant.Name); else SelectedNames.Clear(); }
    private void ConfirmSingle(string action, string name) { ConfirmAction = action; ConfirmNames = [name]; }
    private void ConfirmBulk(string action) { ConfirmAction = action; ConfirmNames = SelectedNames.ToArray(); }
    private void CancelConfirm() { ConfirmAction = null; ConfirmNames = []; }

    private async Task ReloadAsync(string name)
    {
        IsSaving = true;
        try
        {
            if (await Api.Crest.Rest.Tenants.ReloadAsync(name)) Notifications.Notify(NotificationSeverity.Success, T["Tenant reloaded"], T["{0} was reloaded.", name]);
            else Notifications.Notify(NotificationSeverity.Error, T["Tenant reload failed"], T["{0} could not be reloaded.", name]);
        }
        finally { IsSaving = false; }
    }

    private async Task RunConfirmedActionAsync()
    {
        if (ConfirmAction is null || ConfirmNames.Length == 0) return;
        IsSaving = true;
        try
        {
            var success = ConfirmAction switch
            {
                "Enable" when ConfirmNames.Length == 1 => await Api.Crest.Rest.Tenants.EnableAsync(ConfirmNames[0]) is not null,
                "Disable" when ConfirmNames.Length == 1 => await Api.Crest.Rest.Tenants.DisableAsync(ConfirmNames[0]) is not null,
                "Enable" or "Disable" => (await Api.Crest.Rest.Tenants.BulkAsync(ConfirmAction, ConfirmNames)).Length > 0,
                "Remove" => await Api.Crest.Rest.Tenants.RemoveAsync(ConfirmNames[0]),
                _ => false,
            };
            if (success)
            {
                Notifications.Notify(NotificationSeverity.Success, T["Tenant{0} {1}d", ConfirmNames.Length == 1 ? string.Empty : "s", ConfirmAction.ToLowerInvariant()], T["The tenant state was updated."]);
                foreach (var name in ConfirmNames) SelectedNames.Remove(name);
                CancelConfirm();
                await LoadAsync();
            }
            else Notifications.Notify(NotificationSeverity.Error, T["Tenant action failed"], T["Orchard did not accept the requested tenant action."]);
        }
        finally { IsSaving = false; }
    }
}
