@page "/Admin/Tenants"
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications

<RadzenStack Gap="1rem" data-testid="tenants-page">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H4" Text="Tenants" />
            <RadzenText TextStyle="TextStyle.Body2" Text="Manage tenants from the default Orchard tenant." />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" />
            <RadzenButton Text="Add tenant" Icon="add" Click="CreateTenant" Disabled="@IsBusy" />
        </RadzenStack>
    </RadzenStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</RadzenAlert>
    }

    <RadzenCard>
        <RadzenRow AlignItems="AlignItems.End" Gap="0.75rem">
            <RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Search" Style="width: 100%;"><RadzenTextBox @bind-Value="Search" Placeholder="Search name, host, or prefix" Style="width: 100%;" /></RadzenFormField></RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2"><RadzenFormField Text="Category" Style="width: 100%;"><CrestDropDown @bind-Value="Category" Data="CategoryOptions" AllowClear="true" Style="width: 100%;" /></RadzenFormField></RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2"><RadzenFormField Text="State" Style="width: 100%;"><CrestDropDown @bind-Value="State" Data="StateOptions" AllowClear="true" Style="width: 100%;" /></RadzenFormField></RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2"><RadzenFormField Text="Sort" Style="width: 100%;"><CrestDropDown @bind-Value="OrderBy" Data="OrderOptions" Style="width: 100%;" /></RadzenFormField></RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2"><RadzenButton Text="Apply" Icon="filter_alt" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" /></RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    @if (ConfirmAction is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                <span>@ConfirmMessage</span>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"><RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelConfirm" Disabled="@IsBusy" /><RadzenButton Text="Confirm" ButtonStyle="ButtonStyle.Danger" Click="RunConfirmedActionAsync" Disabled="@IsBusy" /></RadzenStack>
            </RadzenStack>
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="@($"Enable selected ({SelectedNames.Count})")" Icon="play_arrow" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmBulk("Enable"))" Disabled="@(SelectedNames.Count == 0 || IsBusy)" />
        <RadzenButton Text="@($"Disable selected ({SelectedNames.Count})")" Icon="pause" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmBulk("Disable"))" Disabled="@(SelectedNames.Count == 0 || IsBusy)" />
    </RadzenStack>

    <RadzenCard>
        @if (IsLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Catalog.Tenants.Length == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" Text="No tenants match this filter." />
        }
        else
        {
            <RadzenDataGrid Data="@Catalog.Tenants" TItem="CrestTenant" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="CrestTenant" Width="3.5rem" Sortable="false" Filterable="false"><HeaderTemplate><RadzenCheckBox Value="@(Catalog.Tenants.Length > 0 && Catalog.Tenants.All(tenant => SelectedNames.Contains(tenant.Name)))" Change="@((bool value) => ToggleAll(value))" Name="select-all-tenants" /></HeaderTemplate><Template Context="tenant"><RadzenCheckBox Value="@SelectedNames.Contains(tenant.Name)" Change="@((bool value) => Toggle(tenant.Name, value))" Name="@($"tenant-{tenant.Name}")" Disabled="@tenant.IsDefault" /></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CrestTenant" Property="Name" Title="Name"><Template Context="tenant"><RadzenStack Gap="0.15rem"><RadzenText TextStyle="TextStyle.Subtitle2" Text="@tenant.Name" />@if (tenant.IsDefault) { <RadzenText TextStyle="TextStyle.Caption" Text="Default tenant" /> }</RadzenStack></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CrestTenant" Property="State" Title="State" />
                    <RadzenDataGridColumn TItem="CrestTenant" Property="Category" Title="Category"><Template Context="tenant">@(string.IsNullOrWhiteSpace(tenant.Category) ? "—" : tenant.Category)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CrestTenant" Title="Host / prefix"><Template Context="tenant"><RadzenStack Gap="0.1rem">@if (!string.IsNullOrWhiteSpace(tenant.RequestUrlHost)) { <RadzenText TextStyle="TextStyle.Caption" Text="@tenant.RequestUrlHost" /> } @if (!string.IsNullOrWhiteSpace(tenant.RequestUrlPrefix)) { <RadzenText TextStyle="TextStyle.Caption" Text="@tenant.RequestUrlPrefix" /> }</RadzenStack></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CrestTenant" Title="Actions" Width="14rem"><Template Context="tenant"><RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem"><RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => EditTenant(tenant.Name))" title="Edit" />@if (tenant.State == "Running" && !tenant.IsDefault) { <RadzenButton Icon="pause" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmSingle("Disable", tenant.Name))" title="Disable" /> } @if (tenant.State == "Disabled") { <RadzenButton Icon="play_arrow" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ConfirmSingle("Enable", tenant.Name))" title="Enable" /> }<RadzenButton Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ReloadAsync(tenant.Name))" title="Reload" />@if (Catalog.TenantRemovalAllowed && tenant.IsRemovable) { <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => ConfirmSingle("Remove", tenant.Name))" title="Remove" /> }</RadzenStack></Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>
</RadzenStack>

@code {
    private CrestTenantCatalog Catalog { get; set; } = CrestTenantCatalog.Empty;
    private HashSet<string> SelectedNames { get; } = new(StringComparer.OrdinalIgnoreCase);
    private string? Search { get; set; }
    private string? Category { get; set; }
    private string? State { get; set; }
    private string OrderBy { get; set; } = "Name";
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }
    private string? ConfirmAction { get; set; }
    private string[] ConfirmNames { get; set; } = [];
    private string ConfirmMessage => ConfirmAction == "Remove" ? $"Remove tenant {ConfirmNames.FirstOrDefault()}? This cannot be undone." : $"{ConfirmAction} {ConfirmNames.Length} tenant{(ConfirmNames.Length == 1 ? string.Empty : "s")}?";
    private IEnumerable<string> CategoryOptions => Catalog.Categories;
    private static readonly string[] StateOptions = ["Running", "Disabled", "Uninitialized"];
    private static readonly string[] OrderOptions = ["Name", "State"];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Catalog = await Api.Crest.Rest.Tenants.ListAsync(Search, Category, State, OrderBy); }
        catch (Exception exception) { ErrorMessage = exception.Message; }
        finally { IsLoading = false; }
    }

    private void CreateTenant() => Navigation.NavigateTo("/Admin/Tenants/Create");
    private void EditTenant(string name) => Navigation.NavigateTo($"/Admin/Tenants/Edit/{Uri.EscapeDataString(name)}");
    private void Toggle(string name, bool selected) { if (selected) SelectedNames.Add(name); else SelectedNames.Remove(name); }
    private void ToggleAll(bool selected) { if (selected) foreach (var tenant in Catalog.Tenants.Where(tenant => !tenant.IsDefault)) SelectedNames.Add(tenant.Name); else SelectedNames.Clear(); }
    private void ConfirmSingle(string action, string name) { ConfirmAction = action; ConfirmNames = [name]; }
    private void ConfirmBulk(string action) { ConfirmAction = action; ConfirmNames = SelectedNames.ToArray(); }
    private void CancelConfirm() { ConfirmAction = null; ConfirmNames = []; }

    private async Task ReloadAsync(string name)
    {
        IsSaving = true;
        try
        {
            if (await Api.Crest.Rest.Tenants.ReloadAsync(name)) Notifications.Notify(NotificationSeverity.Success, "Tenant reloaded", $"{name} was reloaded.");
            else Notifications.Notify(NotificationSeverity.Error, "Tenant reload failed", $"{name} could not be reloaded.");
        }
        finally { IsSaving = false; }
    }

    private async Task RunConfirmedActionAsync()
    {
        if (ConfirmAction is null || ConfirmNames.Length == 0) return;
        IsSaving = true;
        try
        {
            var success = ConfirmAction switch
            {
                "Enable" when ConfirmNames.Length == 1 => await Api.Crest.Rest.Tenants.EnableAsync(ConfirmNames[0]) is not null,
                "Disable" when ConfirmNames.Length == 1 => await Api.Crest.Rest.Tenants.DisableAsync(ConfirmNames[0]) is not null,
                "Enable" or "Disable" => (await Api.Crest.Rest.Tenants.BulkAsync(ConfirmAction, ConfirmNames)).Length > 0,
                "Remove" => await Api.Crest.Rest.Tenants.RemoveAsync(ConfirmNames[0]),
                _ => false,
            };
            if (success)
            {
                Notifications.Notify(NotificationSeverity.Success, $"Tenant{(ConfirmNames.Length == 1 ? string.Empty : "s")} {ConfirmAction.ToLowerInvariant()}d", "The tenant state was updated.");
                foreach (var name in ConfirmNames) SelectedNames.Remove(name);
                CancelConfirm();
                await LoadAsync();
            }
            else Notifications.Notify(NotificationSeverity.Error, "Tenant action failed", "Orchard did not accept the requested tenant action.");
        }
        finally { IsSaving = false; }
    }
}
