@page "/Admin/Design/Icons"
@page "/Admin/Icons"
@using Crest.Admin.Api
@using Crest.Admin.Components.Shared
@using Crest.Icons.Components
@using Radzen
@using Radzen.Blazor
@inject IApi Api
@inject NotificationService Notifications

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H4" Text="Icons" />
            <RadzenText TextStyle="TextStyle.Body2" Text="Manage server-side icon providers used by the icon selector, admin menus, and icon packs." />
        </RadzenStack>
        <RadzenButton Text="Refresh" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="LoadAsync" Disabled="@IsBusy" />
    </RadzenStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</RadzenAlert>
    }

    @if (IsLoading)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <RadzenText Text="Loading icon provider settings..." />
        </RadzenStack>
    }
    else
    {
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeLG="6">
                <RadzenCard>
                    <RadzenTemplateForm TItem="IconifyProviderModel" Data="@Model" Submit="@(_ => SaveAsync())">
                        <RadzenStack Gap="1rem">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText TextStyle="TextStyle.H5" Text="Iconify" />
                                <RadzenText TextStyle="TextStyle.Body2" Text="Default example provider. Uses the Iconify API contract and can point at the public API or a self-hosted compatible server." />
                            </RadzenStack>

                            <SettingsSwitch Label="Enable Iconify provider" Hint="When enabled, Iconify appears in icon search and can resolve selected Iconify icon keys for response icon packs." @bind-Value="Model.Enabled" />

                            <RadzenFormField Text="API base URL" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="Model.BaseUrl" Placeholder="https://api.iconify.design" Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="API key" Style="width: 100%;">
                                <RadzenPassword @bind-Value="Model.ApiKey" Placeholder="Optional" Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="API key header" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="Model.ApiKeyHeader" Placeholder="Authorization" Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="Allowed prefixes" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="Model.Prefixes" Placeholder="Optional comma-separated list, for example mdi, lucide, material-symbols" Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenText TextStyle="TextStyle.Caption" Text="Leave prefixes empty to search every collection exposed by the configured Iconify-compatible API." />

                            @if (IsCustomIconifyServer)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                                    Custom Iconify servers are remote-only and are not cached by Orchard Crest UI Framework.
                                </RadzenAlert>
                            }

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                                <RadzenButton Text="Save provider settings" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                                <RadzenButton Text="Reset Iconify defaults" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="ResetDefaults" ButtonType="ButtonType.Button" Disabled="@IsSaving" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenTemplateForm>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeLG="6">
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.H5" Text="Public Iconify bundled cache" />
                            <RadzenText TextStyle="TextStyle.Body2" Text="Public Iconify data is bundled from the module submodule, shared across tenants, and searched locally by default. Custom Iconify servers bypass this cache." />
                        </RadzenStack>

                        <RadzenRow>
                            <RadzenColumn Size="6">
                                <RadzenText TextStyle="TextStyle.Caption" Text="Status" />
                                <RadzenText Text="@(LocalMirror.IsAvailable ? "Available" : "Remote fallback")" />
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenText TextStyle="TextStyle.Caption" Text="Version" />
                                <RadzenText Text="@(LocalMirror.Version ?? "Not initialized")" />
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenText TextStyle="TextStyle.Caption" Text="Prefixes" />
                                <RadzenText Text="@LocalMirror.PrefixCount.ToString("n0")" />
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenText TextStyle="TextStyle.Caption" Text="Icons" />
                                <RadzenText Text="@LocalMirror.IconCount.ToString("n0")" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenText TextStyle="TextStyle.Caption" Text="@($"Root: {(string.IsNullOrWhiteSpace(LocalMirror.RootPath) ? "not configured" : LocalMirror.RootPath)}")" />
                        @if (LocalMirror.LastSyncUtc is not null)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Text="@($"Source commit: {LocalMirror.LastSyncUtc:u}")" />
                        }
                        @if (!string.IsNullOrWhiteSpace(LocalMirror.LastError))
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                                Last cache error: @LocalMirror.LastError
                            </RadzenAlert>
                        }

                        <RadzenText TextStyle="TextStyle.Caption" Text="The runtime cache is seeded from the bundled module submodule and refreshed automatically once per day by the server." />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeLG="6">
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.H5" Text="Provider search preview" />
                            <RadzenText TextStyle="TextStyle.Body2" Text="This uses the same icon selector component as menu editors. Selecting an icon stores the normalized icon key." />
                        </RadzenStack>

                        <IconSelector @bind-Value="SelectedIcon" />

                        @if (!string.IsNullOrWhiteSpace(SelectedIcon))
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                                Selected icon: @SelectedIcon
                            </RadzenAlert>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>

@code {
    private IconifyProviderModel Model { get; set; } = IconifyProviderModel.From(IconifyIconProviderSettings.Default);
    private IconifyLocalMirrorStatus LocalMirror { get; set; } = IconifyLocalMirrorStatus.Empty;
    private string? SelectedIcon;
    private bool IsLoading = true;
    private bool IsSaving;
    private string? ErrorMessage;
    private bool IsBusy => IsLoading || IsSaving;
    private bool IsCustomIconifyServer => !string.Equals(
        (Model.BaseUrl ?? string.Empty).Trim().TrimEnd('/'),
        IconifyIconProviderSettings.Default.BaseUrl.TrimEnd('/'),
        StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var settings = await Api.Crest.Rest.Icons.GetProvidersAsync();
            Model = IconifyProviderModel.From(settings.Iconify);
            LocalMirror = await Api.Crest.Rest.Icons.GetIconifyLocalStatusAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var saved = await Api.Crest.Rest.Icons.UpdateProvidersAsync(new CrestIconProvidersSettings(Model.ToSettings()));
            if (saved is null)
            {
                Notifications.Notify(NotificationSeverity.Error, "Icon providers not saved", "The server rejected the provider settings.");
                return;
            }

            Model = IconifyProviderModel.From(saved.Iconify);
            Notifications.Notify(NotificationSeverity.Success, "Icon providers saved", "The Iconify provider settings were updated.");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ResetDefaults()
    {
        Model = IconifyProviderModel.From(IconifyIconProviderSettings.Default);
    }

    private sealed class IconifyProviderModel
    {
        public bool Enabled { get; set; }
        public string BaseUrl { get; set; } = IconifyIconProviderSettings.Default.BaseUrl;
        public string? ApiKey { get; set; }
        public string? ApiKeyHeader { get; set; }
        public string? Prefixes { get; set; }
        public bool LocalLibraryCacheEnabled { get; set; } = true;

        public static IconifyProviderModel From(IconifyIconProviderSettings settings) => new()
        {
            Enabled = settings.Enabled,
            BaseUrl = settings.BaseUrl,
            ApiKey = settings.ApiKey,
            ApiKeyHeader = settings.ApiKeyHeader,
            Prefixes = string.Join(", ", settings.Prefixes),
            LocalLibraryCacheEnabled = settings.LocalLibraryCacheEnabled,
        };

        public IconifyIconProviderSettings ToSettings() => new(
            Enabled,
            string.IsNullOrWhiteSpace(BaseUrl) ? IconifyIconProviderSettings.Default.BaseUrl : BaseUrl.Trim(),
            string.IsNullOrWhiteSpace(ApiKey) ? null : ApiKey.Trim(),
            string.IsNullOrWhiteSpace(ApiKeyHeader) ? null : ApiKeyHeader.Trim(),
            (Prefixes ?? string.Empty)
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(prefix => !string.IsNullOrWhiteSpace(prefix))
                .Select(prefix => prefix.ToLowerInvariant())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            LocalLibraryCacheEnabled);
    }
}
