@page "/Profile"
@using Crest.Admin.DisplayManagement
@inject NavigationManager Navigation
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" class="profile-page" data-testid="profile-page">
    <div>
        <CrestText TextStyle="TextStyle.H4" Text="@UserName" />
        <CrestText TextStyle="TextStyle.Body2" Text="@T.T("Profile_AccountTagline", "Your account.")" />
    </div>

    <CrestCard>
        <CrestStack Gap="0.5rem">
            <CrestText TextStyle="TextStyle.Subtitle1" Text="@T.T("Profile_AccountHeading", "Account")" />
            <div class="profile-page__field">
                <CrestText TextStyle="TextStyle.Caption" Text="@T.T("Profile_UsernameLabel", "Username")" />
                <CrestText TextStyle="TextStyle.Body1" Text="@UserName" />
            </div>
        </CrestStack>
    </CrestCard>

    <CrestButton Text="@T.T("Profile_SettingsButton", "Settings")" Icon="settings" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("Profile/Settings"))" />
</CrestStack>

@code {
    [CascadingParameter] public DisplayManager? DisplayManager { get; set; }

    private string UserName => DisplayManager?.User.UserName ?? T.T("Profile_DefaultUserName", "User");
}
