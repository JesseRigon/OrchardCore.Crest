@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject NavigationManager Navigation
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestAppContainer>
    <div class="legacy-admin-frame-page">
        <CrestStack Gap="1rem" Style="height: 100%; min-height: 0;">
                <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                    <CrestStack Gap="0.25rem">
                        <CrestText TextStyle="TextStyle.H4" Text="@Title" />
                        <CrestText TextStyle="TextStyle.Body2" Text="@T.T("LegacyAdminFrame_Description", "This Orchard admin page is running inside the Crest Admin shell.")" />
                    </CrestStack>
                    <CrestButton Text="@T.T("LegacyAdminFrame_OpenFullPage", "Open full page")" ButtonStyle="ButtonStyle.Light" Click="OpenFullPage" />
                </CrestStack>

                <iframe class="legacy-admin-frame" src="@FrameUrl" title="@Title"></iframe>
        </CrestStack>
    </div>
</CrestAppContainer>

@code {
    // Static SSR: Navigation.Uri here is the server-side REWRITTEN request path
    // (the rewrite that routed this request into the legacy host), not the URL the
    // browser is actually sitting at, so a FrameUrl computed during prerender would
    // point the iframe at the wrong legacy page - and the prerendered src would
    // start loading it before interactivity takes over. Render a src-less iframe
    // (about:blank) during prerender; the interactive phase (circuit or WASM)
    // recomputes it from the real browser URL.
    private string? FrameUrl => RendererInfo.IsInteractive ? EnsureLegacyFrame(Navigation.Uri) : null;

    private string Title
    {
        get
        {
            // Same rewritten-URL caveat as FrameUrl: only derive the title from
            // Navigation.Uri once interactive; prerender paints the default.
            if (!RendererInfo.IsInteractive)
            {
                return T.T("LegacyAdminFrame_DefaultTitle", "Admin");
            }

            var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
            return string.IsNullOrWhiteSpace(path) ? T.T("LegacyAdminFrame_DefaultTitle", "Admin") : path.Split('/').Last().Replace('-', ' ');
        }
    }

    private void OpenFullPage()
    {
        // FrameUrl is only null during prerender, where no click can occur - this
        // guard just keeps the null-flow honest.
        if (FrameUrl is { } url)
        {
            Navigation.NavigateTo(url, forceLoad: true);
        }
    }

    private static string EnsureLegacyFrame(string uri)
    {
        var builder = new UriBuilder(uri);
        var query = ParseQuery(builder.Query);
        query["legacy-frame"] = "1";
        builder.Query = string.Join("&", query.Select(pair => $"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(pair.Value)}"));
        return builder.Uri.PathAndQuery;
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var trimmed = query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return values;
        }

        foreach (var part in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var split = part.Split('=', 2);
            var key = Uri.UnescapeDataString(split[0]);
            var value = split.Length > 1 ? Uri.UnescapeDataString(split[1]) : string.Empty;
            values[key] = value;
        }

        return values;
    }
}
