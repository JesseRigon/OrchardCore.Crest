@using Crest.Admin.DisplayManagement
@using Crest.Admin.Components.Shared
@using Crest.Icons.Components
@using Crest.Components.Primitives
@inject Crest.Components.Theme.CrestApiLocalizer T

<ul class="primary-nav-menu__flyout-list" role="menu">
    @foreach (var item in Items)
    {
        var icon = item.Icon;
        var hasChildren = item.HasChildren;
        var itemClass = hasChildren
            ? "primary-nav-menu__flyout-item primary-nav-menu__flyout-item--has-children"
            : "primary-nav-menu__flyout-item";

        <li @key="item.StableKey" class="@itemClass" role="none">
            @if (item.HasLink && !hasChildren)
            {
                <a class="primary-nav-menu__flyout-link" href="@item.Link" target="@item.Target" role="menuitem">
                    <AdminMenuSubIcon Icon="@icon" />
                    <span class="primary-nav-menu__flyout-text">@item.Text</span>
                </a>
            }
            else
            {
                <div class="primary-nav-menu__flyout-link" role="menuitem" aria-haspopup="@(hasChildren ? "menu" : null)">
                    <AdminMenuSubIcon Icon="@icon" />
                    <span class="primary-nav-menu__flyout-text">@item.Text</span>
                    @if (hasChildren)
                    {
                        <OrchardIcon IconKey="iconify.mdi/current/default/chevron-right"
                                     Name="chevron-right"
                                     Library="iconify.mdi"
                                     Version="current"
                                     Alt="@T.T("PrimaryNavMenuFlyoutItems_OpenSubmenuAlt", "Open submenu")"
                                     Class="primary-nav-menu__flyout-chevron" />
                    }
                </div>
            }

            @if (hasChildren)
            {
                <div class="primary-nav-menu__flyout primary-nav-menu__flyout--nested" role="menu">
                    <PrimaryNavMenuFlyoutItems Items="item.Items" />
                </div>
            }
        </li>
    }
</ul>

@code {
    [Parameter]
    public DisplayMenuItem[] Items { get; set; } = [];
}
