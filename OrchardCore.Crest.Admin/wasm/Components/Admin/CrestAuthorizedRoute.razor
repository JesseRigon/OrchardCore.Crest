@using Crest.Admin.DisplayManagement
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject DisplayManager DisplayManager
@inject NavigationManager Navigation

@if (!DisplayManager.IsInitialized)
{
    <CrestStack Gap="1rem" Style="padding: 2rem;">
        <CrestText Text="Loading..." />
    </CrestStack>
}
else if (!DisplayManager.IsAuthenticated)
{
    <CrestStack Gap="1rem" Style="padding: 2rem;">
        <CrestText Text="Sign in is required." />
    </CrestStack>
}
else if (!DisplayManager.IsRouteAuthorized(Navigation.Uri))
{
    <CrestStack data-testid="crest-route-forbidden" Gap="0.5rem" Style="padding: 2rem;">
        <CrestText TextStyle="TextStyle.H4" Text="Access denied" />
        <CrestText Text="You do not have permission to access this admin page." />
    </CrestStack>
}
else
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await DisplayManager.EnsureInitializedAsync();
        if (!DisplayManager.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
