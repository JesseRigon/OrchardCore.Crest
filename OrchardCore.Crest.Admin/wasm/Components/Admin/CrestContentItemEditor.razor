@using System.Text.Json
@using System.Text.Json.Nodes
@using Crest.Admin.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="content-item-editor">
    @if (IsLoading)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }
    else
    {
        <CrestTemplateForm TItem="EditorModel" Data="@Model" Submit="@(_ => SaveAsync())">
            <CrestStack Gap="1rem">
                <CrestCard>
                    <CrestStack Gap="0.75rem">
                        <CrestText TextStyle="TextStyle.H4" Text="@(IsCreate ? T["New {0}", ContentType] : T["Edit {0}", Model.ContentType])" />
                        <CrestText TextStyle="TextStyle.Body2" Text="@T["Edit the Orchard content document directly. Changes are persisted through the standard content manager lifecycle."]" />
                        <CrestTextBox Name="displayText" @bind-Value="Model.DisplayText" Placeholder="@T["Title"]" Style="width: 100%;" />
                        <CrestCheckBox @bind-Value="Model.Publish" Name="publish" /> <label for="publish">@T["Publish after saving"]</label>
                    </CrestStack>
                </CrestCard>
                <CrestCard>
                    <CrestStack Gap="0.5rem">
                        <CrestText TextStyle="TextStyle.Subtitle1" Text="@T["Content document"]" />
                        <CrestText TextStyle="TextStyle.Caption" Text="@T["This is the content JSON consumed by Orchard parts and fields. Preserve fields you do not intend to change."]" />
                        <CrestTextArea @bind-Value="Model.ContentJson" Rows="22" Style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; width: 100%;" />
                    </CrestStack>
                </CrestCard>
                <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="Cancel" Disabled="@IsSaving" />
                    <CrestButton Text="@T["Save"]" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                </CrestStack>
            </CrestStack>
        </CrestTemplateForm>
    }
</CrestStack>

@code {
    [Parameter] public string? ContentType { get; set; }
    [Parameter] public string? ContentItemId { get; set; }

    private bool IsCreate => !string.IsNullOrWhiteSpace(ContentType);
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private string? ErrorMessage { get; set; }
    private EditorModel Model { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        ErrorMessage = null;
        if (IsCreate)
        {
            Model = new EditorModel { ContentType = ContentType!, ContentJson = "{}" };
            return;
        }

        if (string.IsNullOrWhiteSpace(ContentItemId)) { ErrorMessage = T["A content item identifier is required."]; return; }
        IsLoading = true;
        try
        {
            var item = await Api.Crest.Rest.Content.Items.GetAsync(ContentItemId);
            if (item is null) { ErrorMessage = T["The requested Orchard content item was not found."]; return; }
            Model = new EditorModel
            {
                ContentType = item.ContentType,
                DisplayText = item.DisplayText,
                Publish = item.Published,
                ContentJson = JsonSerializer.Serialize(item.Content, new JsonSerializerOptions { WriteIndented = true }),
            };
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task SaveAsync()
    {
        JsonObject? content;
        try { content = JsonNode.Parse(Model.ContentJson) as JsonObject ?? throw new InvalidOperationException(T["The content document must be a JSON object."]); }
        catch (Exception ex) { ErrorMessage = T["Content JSON is invalid: {0}", ex.Message]; return; }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var request = new ContentItemWriteRequest(Model.ContentType, Model.DisplayText, content, Model.Publish);
            var saved = IsCreate
                ? await Api.Crest.Rest.Content.Items.CreateAsync(request)
                : await Api.Crest.Rest.Content.Items.UpdateAsync(ContentItemId!, request);
            if (saved is null) throw new InvalidOperationException(T["Orchard did not accept the content item update."]);
            Notifications.Notify(NotificationSeverity.Success, T["Content Items"], T["{0} saved.", saved.DisplayText]);
            Navigation.NavigateTo("Contents/ContentItems");
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private void Cancel() => Navigation.NavigateTo("Contents/ContentItems");

    private sealed class EditorModel
    {
        public string ContentType { get; set; } = string.Empty;
        public string? DisplayText { get; set; }
        public bool Publish { get; set; }
        public string ContentJson { get; set; } = "{}";
    }
}
