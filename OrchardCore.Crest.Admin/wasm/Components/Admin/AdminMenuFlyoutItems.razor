@using Crest.Admin.DisplayManagement
@using Crest.Admin.Components.Shared
@using Radzen.Blazor

<ul class="admin-menu-sidebar__flyout-list" role="menu">
    @foreach (var item in Items)
    {
        var icon = item.Icon;
        var hasChildren = item.HasChildren;
        var itemClass = hasChildren
            ? "admin-menu-sidebar__flyout-item admin-menu-sidebar__flyout-item--has-children"
            : "admin-menu-sidebar__flyout-item";

        <li @key="item.StableKey" class="@itemClass" role="none">
            @if (item.HasLink && !hasChildren)
            {
                <a class="admin-menu-sidebar__flyout-link" href="@item.Link" target="@item.Target" role="menuitem">
                    <AdminMenuSubIcon Icon="@icon" />
                    <span class="admin-menu-sidebar__flyout-text">@item.Text</span>
                </a>
            }
            else
            {
                <div class="admin-menu-sidebar__flyout-link" role="menuitem" aria-haspopup="@(hasChildren ? "menu" : null)">
                    <AdminMenuSubIcon Icon="@icon" />
                    <span class="admin-menu-sidebar__flyout-text">@item.Text</span>
                    @if (hasChildren)
                    {
                        <RadzenIcon Icon="chevron_right" class="admin-menu-sidebar__flyout-chevron" title="Open submenu" />
                    }
                </div>
            }

            @if (hasChildren)
            {
                <div class="admin-menu-sidebar__flyout admin-menu-sidebar__flyout--nested" role="menu">
                    <AdminMenuFlyoutItems Items="item.Items" />
                </div>
            }
        </li>
    }
</ul>

@code {
    [Parameter]
    public DisplayMenuItem[] Items { get; set; } = [];
}
