@using Crest.Admin.Api
@using Crest.Admin.DisplayManagement
@using Crest.Admin.Options
@using Crest.Components.Inputs
@using Crest.Components.Display
@using Crest.Icons.Components
@using Microsoft.JSInterop
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject NavigationManager Navigation
@inject CrestRoutingOptions Routing
@inject IJSRuntime Js

<header class="admin-titlebar">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="admin-titlebar__left">
        <CrestAvatar ImageUrl="@TitleBarSettings.TenantAvatarImageUrl"
                     FallbackText="@TenantInitial"
                     AriaLabel="@($"{SelectedTenantName} tenant")"
                     BackgroundColor="var(--crest-color-accent-1, #2f6f4e)"
                     ForegroundColor="var(--crest-color-on-accent-1, #fff)"
                     Shape="@TenantAvatarShape"
                     ClipPath="@TitleBarSettings.TenantAvatarClipPath"
                     BorderRadius="@TitleBarSettings.TenantAvatarBorderRadius"
                     Class="admin-titlebar__tenant-avatar" />

        <CrestDropDown TItem="Tenant"
                        TValue="string"
                        Data="TenantOptions"
                        Value="@SelectedTenantName"
                        ValueChanged="SelectTenantByName"
                        LabelProperty="@nameof(Tenant.Name)"
                        ValueProperty="@nameof(Tenant.Name)"
                        Template="TenantOptionTemplate"
                        TriggerIcon="ChevronDownIcon"
                        ShowValueLabel="true"
                        AriaLabel="Select tenant"
                        Class="admin-titlebar__tenant-selector"
                        Style="--crest-dropdown-color: var(--crest-color-text-2, var(--crest-color-text-1, #1f2937)); --crest-dropdown-border-color: transparent; --crest-dropdown-popup-border-color: var(--crest-color-border-1, #e5e7eb); --crest-dropdown-popup-background: var(--crest-color-surface-1, #fff); --crest-dropdown-option-active-background: var(--crest-color-hover-surface-1, color-mix(in srgb, var(--crest-color-accent-1, #2f6f4e) 10%, transparent));" />
    </RadzenStack>

    @if (DisplayManager?.Manifest?.AdminSettings.DisplayTitlesInTopbar == true && !string.IsNullOrWhiteSpace(CurrentTitle))
    {
        <div class="admin-titlebar__page-title">@CurrentTitle</div>
    }

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="admin-titlebar__right">
        @if (CultureOptions.Length > 1)
        {
            <CrestDropDown TItem="CultureOption"
                            TValue="string"
                            Data="CultureOptions"
                            Value="@SelectedCulture"
                            ValueChanged="SelectCultureAsync"
                            LabelProperty="@nameof(CultureOption.Label)"
                            ValueProperty="@nameof(CultureOption.Value)"
                            Template="CultureOptionTemplate"
                            TriggerIcon="ChevronDownIcon"
                            ShowValueLabel="@TitleBarSettings.DisplayCultureLabel"
                            AllowFiltering="true"
                            FilterPlaceholder="Filter cultures"
                            AriaLabel="Select administration culture"
                            Class="admin-titlebar__culture-selector"
                            Style="--crest-dropdown-color: var(--crest-color-accent-1, #2f6f4e); --crest-dropdown-border-color: transparent; --crest-dropdown-popup-border-color: var(--crest-color-border-1, #e5e7eb); --crest-dropdown-popup-background: var(--crest-color-surface-1, #fff); --crest-dropdown-option-active-background: var(--crest-color-hover-surface-1, color-mix(in srgb, var(--crest-color-accent-1, #2f6f4e) 10%, transparent));" />
        }

        @if (DisplayManager?.Manifest?.AdminSettings.DisplayThemeToggler != false)
        {
            <button type="button" class="admin-titlebar__icon-button" @onclick="ToggleThemeAsync" title="Toggle dark/light mode" aria-label="Toggle dark/light mode">
                <OrchardIcon IconKey="@ThemeToggleIcon" Size="1.25rem" />
            </button>
        }

        <RadzenProfileMenu class="admin-titlebar__avatar-menu" ShowIcon="false" ToggleAriaLabel="Open user menu">
            <Template>
                <CrestAvatar FallbackText="@UserInitials"
                             AriaLabel="@UserName"
                             BackgroundColor="transparent"
                             ForegroundColor="var(--crest-color-accent-1, #2f6f4e)"
                             Shape="CrestAvatarShape.Circle"
                             Class="admin-titlebar__avatar" />
            </Template>
            <ChildContent>
                <RadzenProfileMenuItem Text="@UserName" Path="/Admin/Profile" />
                <RadzenProfileMenuItem Text="Admin dashboard" Path="/Admin" />
                <RadzenProfileMenuItem Text="Open site" Path="/" />
                <RadzenProfileMenuItem Text="Sign in as another user" Click="SignInAsAnotherUserAsync" class="admin-titlebar__profile-separator" />
                @foreach (var user in OtherKnownUsers)
                {
                    <RadzenProfileMenuItem Text="@UserLabel(user)" Click="@(() => SignInAsUserAsync(user))" />
                }
                <RadzenProfileMenuItem Text="Logout" Click="LogoutAsync" class="admin-titlebar__profile-separator" />
            </ChildContent>
        </RadzenProfileMenu>
    </RadzenStack>
</header>

@code {
    [CascadingParameter]
    public DisplayManager? DisplayManager { get; set; }

    private Tenant[] TenantOptions => DisplayManager?.Manifest?.Tenants is { Length: > 0 } tenants
        ? tenants
        : DisplayManager?.Manifest?.Tenant is { } tenant ? [tenant] : [];

    private string SelectedTenantName => DisplayManager?.Manifest?.Tenant.Name ?? "Tenant";
    private string UserName => DisplayManager?.User.UserName ?? "User";
    private string? CurrentTitle => FindCurrentTitle(DisplayManager?.AdminMenu?.Items);
    private string TenantInitial => string.IsNullOrWhiteSpace(SelectedTenantName) ? "?" : SelectedTenantName[..1].ToUpperInvariant();
    private string UserInitials => GetInitials(UserName);
    private LocalUser[] KnownUsers { get; set; } = [];
    private IEnumerable<LocalUser> OtherKnownUsers => KnownUsers
        .Where(user => !user.UserName.Equals(UserName, StringComparison.OrdinalIgnoreCase));
    private string ThemeToggleIcon { get; set; } = "iconify.mdi/current/default/weather-night";
    private string? LastRememberedUserContext { get; set; }
    private CultureOption[] CultureOptions => DisplayManager?.Manifest?.CultureSelector.Cultures ?? [];
    private string? SelectedCulture => DisplayManager?.Manifest?.CultureSelector.CurrentCulture;
    private CrestTitleBarSettingsDto TitleBarSettings => DisplayManager?.Manifest?.TitleBarSettings ?? CrestTitleBarSettingsDto.Default;
    private CrestAvatarShape TenantAvatarShape => Enum.TryParse<CrestAvatarShape>(TitleBarSettings.TenantAvatarShape, true, out var shape)
        ? shape
        : CrestAvatarShape.Circle;
    private RenderFragment<CrestDropDownRenderContext<CultureOption>> CultureOptionTemplate => context => builder =>
    {
        var culture = context.Item;
        builder.OpenComponent<OrchardIcon>(0);
        builder.AddAttribute(1, nameof(OrchardIcon.IconKey), culture.Icon);
        builder.AddAttribute(2, nameof(OrchardIcon.Size), "1.1rem");
        builder.CloseComponent();
        if (context.Surface == CrestDropDownSurface.Option)
        {
            builder.OpenElement(3, "span");
            builder.AddAttribute(4, "class", "admin-titlebar__culture-option-label");
            builder.AddContent(5, culture.Label);
            builder.CloseElement();
        }
    };
    private RenderFragment<CrestDropDownRenderContext<Tenant>> TenantOptionTemplate => context => builder =>
    {
        if (context.Surface == CrestDropDownSurface.Option && context.IsSelected)
        {
            builder.OpenComponent<OrchardIcon>(0);
            builder.AddAttribute(1, nameof(OrchardIcon.IconKey), "iconify.mdi/current/default/check");
            builder.AddAttribute(2, nameof(OrchardIcon.Size), "1rem");
            builder.CloseComponent();
        }

        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "admin-titlebar__tenant-option-label");
        builder.AddContent(5, context.Item.Name);
        builder.CloseElement();
    };
    private RenderFragment ChevronDownIcon => builder =>
    {
        builder.OpenComponent<OrchardIcon>(0);
        builder.AddAttribute(1, nameof(OrchardIcon.IconKey), "iconify.mdi/current/default/chevron-down");
        builder.AddAttribute(2, nameof(OrchardIcon.Size), "1rem");
        builder.CloseComponent();
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldRender = false;
        if (firstRender)
        {
            var isDark = await Js.InvokeAsync<bool>("crestTheme.isDarkMode");
            ThemeToggleIcon = isDark
                ? "iconify.mdi/current/default/weather-sunny"
                : "iconify.mdi/current/default/weather-night";
            shouldRender = true;
        }

        if (DisplayManager?.IsAuthenticated == true)
        {
            var tenantPrefix = DisplayManager.Manifest?.Tenant.RequestUrlPrefix ?? string.Empty;
            var context = $"{UserName}|{SelectedTenantName}|{tenantPrefix}";
            if (!string.Equals(context, LastRememberedUserContext, StringComparison.Ordinal))
            {
                KnownUsers = await Js.InvokeAsync<LocalUser[]>("crestTheme.rememberSignedInUser", UserName, SelectedTenantName, tenantPrefix);
                LastRememberedUserContext = context;
                shouldRender = true;
            }
        }

        if (shouldRender)
        {
            StateHasChanged();
        }
    }

    private bool IsSelectedTenant(Tenant tenant) => tenant.Name.Equals(SelectedTenantName, StringComparison.OrdinalIgnoreCase);

    private string? FindCurrentTitle(IEnumerable<DisplayMenuItem>? items)
    {
        if (items is null)
        {
            return null;
        }

        foreach (var item in items)
        {
            var childTitle = FindCurrentTitle(item.Items);
            if (!string.IsNullOrWhiteSpace(childTitle))
            {
                return childTitle;
            }

            if (IsActive(item))
            {
                return item.Text;
            }
        }

        return null;
    }

    private bool IsActive(DisplayMenuItem item)
    {
        if (!item.HasLink)
        {
            return false;
        }

        var current = '/' + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        var link = item.Link!.StartsWith('/') ? item.Link : '/' + item.Link;
        return current.Equals(link, StringComparison.OrdinalIgnoreCase)
            || current.StartsWith(link.TrimEnd('/') + '/', StringComparison.OrdinalIgnoreCase);
    }

    private void SelectTenant(Tenant tenant)
    {
        if (tenant.Name.Equals(SelectedTenantName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var path = string.IsNullOrWhiteSpace(tenant.RequestUrlPrefix) ? "/Admin" : $"/{tenant.RequestUrlPrefix.Trim('/')}/Admin";
        Navigation.NavigateTo(path, forceLoad: true);
    }

    private void SelectTenantByName(string? name)
    {
        var tenant = TenantOptions.FirstOrDefault(candidate =>
            candidate.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
        if (tenant is not null)
        {
            SelectTenant(tenant);
        }
    }

    private async Task ToggleThemeAsync()
    {
        var isDark = await Js.InvokeAsync<bool>("crestTheme.toggleMode");
        ThemeToggleIcon = isDark
            ? "iconify.mdi/current/default/weather-sunny"
            : "iconify.mdi/current/default/weather-night";
    }

    private async Task SelectCultureAsync(string? culture)
    {
        var selector = DisplayManager?.Manifest?.CultureSelector;
        if (selector is null || string.IsNullOrWhiteSpace(culture) ||
            string.Equals(culture, selector.CurrentCulture, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await Js.InvokeVoidAsync("crestTheme.setAdminCulture", selector.CookieName, selector.CookiePath, culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task SignInAsAnotherUserAsync()
    {
        if (DisplayManager is not null)
        {
            await DisplayManager.LogoutAsync();
        }

        Navigation.NavigateTo(BuildLoginPath(DisplayManager?.Manifest?.Tenant.RequestUrlPrefix, null), forceLoad: true);
    }

    private async Task SignInAsUserAsync(LocalUser user)
    {
        if (DisplayManager is not null)
        {
            await DisplayManager.LogoutAsync();
        }

        Navigation.NavigateTo(BuildLoginPath(user.LastTenantPrefix, user.UserName), forceLoad: true);
    }

    private async Task LogoutAsync()
    {
        if (DisplayManager is null)
        {
            return;
        }

        await DisplayManager.LogoutAsync();
        Navigation.NavigateTo(Routing.LoginPath);
    }

    private static string BuildLoginPath(string? tenantPrefix, string? userName)
    {
        var path = string.IsNullOrWhiteSpace(tenantPrefix) ? "/login" : $"/{tenantPrefix.Trim('/')}/login";
        var query = new List<string> { "switchUser=1" };
        if (!string.IsNullOrWhiteSpace(userName))
        {
            query.Add($"userName={Uri.EscapeDataString(userName)}");
        }

        return path + "?" + string.Join("&", query);
    }

    private static string UserLabel(LocalUser user) => string.IsNullOrWhiteSpace(user.LastTenantName)
        ? user.UserName
        : $"{user.UserName} · {user.LastTenantName}";

    private static string GetInitials(string value)
    {
        var parts = value.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
        }

        return value.Length switch
        {
            0 => "?",
            1 => value[..1].ToUpperInvariant(),
            _ => value[..2].ToUpperInvariant(),
        };
    }

    private sealed class LocalUser
    {
        public string UserName { get; set; } = string.Empty;
        public string LastTenantName { get; set; } = string.Empty;
        public string LastTenantPrefix { get; set; } = string.Empty;
        public string LastSeenUtc { get; set; } = string.Empty;
        public LocalTenantContext[] Tenants { get; set; } = [];
    }

    private sealed class LocalTenantContext
    {
        public string TenantName { get; set; } = string.Empty;
        public string TenantPrefix { get; set; } = string.Empty;
        public string LastSeenUtc { get; set; } = string.Empty;
    }
}
