@namespace Crest.Admin.Components.Admin
@using System.Net.Http.Json
@using Crest.Components.Models
@using Crest.Components.Primitives
@inject HttpClient Http
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The per-attachment settings editor - the INSTANCE layer of the picker system.
   What is configured here (source, columns, sort, search, filters, required) is the
   behaviour for every user of the field: there are deliberately no per-user
   overrides, and editing is definition work gated server-side by EditContentTypes. *@
<CrestCard data-testid="option-picker-editor">
    <CrestStack Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H6" Text="@T["Option picker: {0}", FieldName]" />
            <CrestText TextStyle="TextStyle.Caption" Text="@($"{PartName} · {FieldName}")" />
            @if (Attachment is { FieldExists: true, IsOptionPicker: false })
            {
                <CrestAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                    @T["This field is currently a {0}. Saving converts it to an option picker; content already stored on it is kept in each item's document.", Attachment.FieldType ?? "?"]
                </CrestAlert>
            }
        </CrestStack>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
        }

        @if (IsLoading)
        {
            <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <CrestFieldset Text="@T["Source"]">
                <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <CrestFormField Text="@T["Provider"]">
                        <CrestDropDown @bind-Value="ProviderKey" TValue="string" Data="@ProviderChoices" TextProperty="Label" ValueProperty="Value"
                                       Change="@(_ => OnSourceChangedAsync())" Disabled="@IsBusy" data-testid="picker-provider" />
                    </CrestFormField>
                    @if (ProviderKey == "contentpartlist")
                    {
                        <CrestFormField Text="@T["Content part list"]">
                            <CrestDropDown @bind-Value="Qualifier" TValue="string" Data="@ContentPartListChoices" TextProperty="Label" ValueProperty="Value"
                                           Change="@(_ => OnSourceChangedAsync())" Disabled="@IsBusy" data-testid="picker-list" />
                        </CrestFormField>
                    }
                    else if (ProviderKey == "contentitem")
                    {
                        <CrestFormField Text="@T["Content type"]">
                            <CrestTextBox @bind-Value="Qualifier" Placeholder="@T["e.g. Customer"]" Change="@(_ => OnSourceChangedAsync())" Disabled="@IsBusy" />
                        </CrestFormField>
                    }
                </CrestStack>
            </CrestFieldset>

            <CrestFieldset Text="@T["Displayed columns"]" AllowCollapse="true">
                <CrestStack Gap="0.5rem">
                    <CrestText TextStyle="TextStyle.Caption" Text="@T["The columns the dropdown shows, in order. Empty uses the source's default display column."]" />
                    @foreach (var column in Settings.Columns)
                    {
                        var row = column;
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                            <CrestFormField Text="@T["Path"]">
                                <CrestTextBox @bind-Value="row.Path" Disabled="@IsBusy" Style="width: 11rem;" />
                            </CrestFormField>
                            <CrestFormField Text="@T["Header"]">
                                <CrestTextBox @bind-Value="row.Label" Disabled="@IsBusy" Style="width: 10rem;" />
                            </CrestFormField>
                            <CrestFormField Text="@T["Width"]">
                                <CrestTextBox @bind-Value="row.Width" Placeholder="@T["auto"]" Disabled="@IsBusy" Style="width: 6rem;" />
                            </CrestFormField>
                            <CrestCheckBox @bind-Value="row.Visible" Text="@T["Visible"]" Disabled="@IsBusy" />
                            <CrestCheckBox @bind-Value="row.InChip" Text="@T["In chip"]" Disabled="@IsBusy" />
                            <CrestButton Icon="arrow_upward" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => MoveColumn(row, -1))" Disabled="@IsBusy" />
                            <CrestButton Icon="arrow_downward" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => MoveColumn(row, 1))" Disabled="@IsBusy" />
                            <CrestButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Settings.Columns.Remove(row))" Disabled="@IsBusy" />
                        </CrestStack>
                    }
                    <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                        <CrestFormField Text="@T["Add column"]">
                            <CrestDropDown @bind-Value="NewColumnPath" TValue="string" Data="@ColumnChoices" TextProperty="Label" ValueProperty="Value" Disabled="@IsBusy" data-testid="picker-add-column" />
                        </CrestFormField>
                        <CrestButton Text="@T["Add"]" Icon="add" Click="AddColumn" Disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewColumnPath))" />
                    </CrestStack>
                </CrestStack>
            </CrestFieldset>

            <CrestFieldset Text="@T["Sorting and search"]" AllowCollapse="true">
                <CrestStack Gap="0.5rem">
                    <CrestText TextStyle="TextStyle.Caption" Text="@T["Sort is applied in the listed order; the first column is the primary sort, later ones break ties. Empty keeps the source's natural order (for content part lists: the manual position order)."]" />
                    @PathListEditor(T["Sort by"], Settings.SortColumns, "picker-sort-columns")
                    @PathListEditor(T["Search in"], Settings.SearchColumns, "picker-search-columns")
                </CrestStack>
            </CrestFieldset>

            <CrestFieldset Text="@T["Behavior"]" AllowCollapse="true">
                <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <CrestCheckBox @bind-Value="Settings.Required" Text="@T["Required"]" Disabled="@IsBusy" />
                    <CrestCheckBox @bind-Value="Settings.Multiple" Text="@T["Multiple values"]" Disabled="@IsBusy" />
                    <CrestFormField Text="@T["Placeholder"]">
                        <CrestTextBox @bind-Value="Settings.Placeholder" Disabled="@IsBusy" />
                    </CrestFormField>
                    <CrestFormField Text="@T["Selected value template (optional)"]">
                        <CrestTextBox @bind-Value="Settings.DisplayTemplate" Placeholder="@T["{Name} ({Key})"]" Disabled="@IsBusy" Style="width: 16rem;" />
                    </CrestFormField>
                </CrestStack>
            </CrestFieldset>

            <CrestFieldset Text="@T["Filters and dependencies"]" AllowCollapse="true">
                <CrestStack Gap="0.75rem">
                    <CrestText TextStyle="TextStyle.Caption" Text="@T["Restrict what the dropdown offers. 'From field' makes it a dependent (cascading) dropdown that follows another field on this type; filters are always evaluated server-side."]" />
                    @foreach (var filter in Settings.Filters)
                    {
                        var row = filter;
                        <CrestStack Gap="0.35rem" Style="border-left: 2px solid var(--rz-base-300); padding-left: 0.75rem;">
                            <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                                <CrestFormField Text="@T["Column"]">
                                    @* The source's advertised columns, same list the column section
                                       offers; free text only when the source has none described or
                                       the stored path is a custom one the source does not list. *@
                                    @if (ColumnChoices.Length > 0 && (string.IsNullOrEmpty(row.Path) || ColumnChoices.Any(choice => choice.Value == row.Path)))
                                    {
                                        <CrestDropDown @bind-Value="row.Path" TValue="string" Data="@ColumnChoices" TextProperty="Label" ValueProperty="Value"
                                                       Disabled="@IsBusy" Style="width: 11rem;" data-testid="picker-filter-path" />
                                    }
                                    else
                                    {
                                        <CrestTextBox @bind-Value="row.Path" Placeholder="@T["e.g. Key"]" Disabled="@IsBusy" Style="width: 10rem;" />
                                    }
                                </CrestFormField>
                                <CrestFormField Text="@T["Operator"]">
                                    <CrestDropDown @bind-Value="row.Operator" TValue="string" Data="@OperatorChoices" TextProperty="Label" ValueProperty="Value" Disabled="@IsBusy" />
                                </CrestFormField>
                                <CrestFormField Text="@T["Value (literal)"]">
                                    <CrestTextBox @bind-Value="row.Value" Disabled="@(IsBusy || !string.IsNullOrWhiteSpace(row.ValueFrom))" Style="width: 9rem;" />
                                </CrestFormField>
                                <CrestFormField Text="@T["From field"]">
                                    <CrestDropDown @bind-Value="row.ValueFrom" TValue="string" Data="@SiblingFieldChoices" TextProperty="Label" ValueProperty="Value"
                                                   AllowClear="true" Change="@(_ => OnParentChangedAsync(row))" Disabled="@IsBusy" Style="width: 11rem;" />
                                </CrestFormField>
                                <CrestButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Settings.Filters.Remove(row))" Disabled="@IsBusy" />
                            </CrestStack>
                            @if (!string.IsNullOrWhiteSpace(row.ValueFrom))
                            {
                                <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                                    <CrestCheckBox @bind-Value="row.RequireParentValue" Text="@T["Offer nothing until the parent is chosen"]" Disabled="@IsBusy" />
                                    <CrestFormField Text="@T["When the parent changes"]">
                                        <CrestDropDown @bind-Value="row.OnParentChange" TValue="string" Data="@ParentChangeChoices" TextProperty="Label" ValueProperty="Value" Disabled="@IsBusy" />
                                    </CrestFormField>
                                    @if (ParentColumnChoicesFor(row.ValueFrom) is { Length: > 0 } parentColumns)
                                    {
                                        @* Which parent-row column supplies the comparison value.
                                           Cleared/absent = the option's technical Key - the identity
                                           rule's default. Only a picker parent offers columns; a
                                           scalar parent passes its raw value through. *@
                                        <CrestFormField Text="@T["Compare the parent's"]">
                                            <CrestDropDown @bind-Value="row.ValueFromColumn" TValue="string" Data="@parentColumns" TextProperty="Label" ValueProperty="Value"
                                                           AllowClear="true" Placeholder="@T["Key (default)"]" Disabled="@IsBusy" Style="width: 12rem;" data-testid="picker-valuefrom-column" />
                                        </CrestFormField>
                                    }
                                </CrestStack>
                            }
                        </CrestStack>
                    }
                    <CrestButton Text="@T["Add filter"]" Icon="add" ButtonStyle="ButtonStyle.Light" Click="@(() => Settings.Filters.Add(new OptionPickerFilterModel()))" Disabled="@IsBusy" data-testid="picker-add-filter" />
                </CrestStack>
            </CrestFieldset>

            <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                <CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => OnClose.InvokeAsync())" Disabled="@IsBusy" />
                <CrestButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="@(IsBusy || string.IsNullOrWhiteSpace(SourceKey))" data-testid="picker-save" />
            </CrestStack>
        }
    </CrestStack>
</CrestCard>

@code {
    /// <summary>The part DEFINITION the field lives on. For fields directly on a
    /// type, Orchard's implicit part shares the type's name.</summary>
    [Parameter] public string PartName { get; set; } = string.Empty;

    [Parameter] public string FieldName { get; set; } = string.Empty;

    /// <summary>Sibling field names on the same type, offered as 'From field'
    /// dependency sources.</summary>
    [Parameter] public string[] SiblingFields { get; set; } = [];

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private OptionPickerAttachmentModel? Attachment;
    private OptionPickerSettingsModel Settings = new();

    private bool IsLoading;
    private bool IsSaving;
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage;

    private string ProviderKey = "contentpartlist";
    private string Qualifier = string.Empty;
    private string NewColumnPath = string.Empty;

    private string[] Providers = [];
    private ContentPartListModel[] ContentPartListsAvailable = [];
    private OptionSourceColumnModel[] SourceColumns = [];

    private string SourceKey =>
        string.IsNullOrWhiteSpace(ProviderKey) ? string.Empty
        : string.IsNullOrWhiteSpace(Qualifier) ? ProviderKey
        : $"{ProviderKey}:{Qualifier}";

    private sealed record Choice(string Label, string Value);

    private Choice[] ProviderChoices => [.. Providers.Select(provider => new Choice(provider switch
    {
        "contentpartlist" => T["Content part list"],
        "users" => T["Users"],
        "contentitem" => T["Content items"],
        "currency" => T["Currencies"],
        "timezone" => T["Time zones"],
        "culture" => T["Cultures"],
        _ => provider,
    }, provider))];

    private Choice[] ContentPartListChoices => [.. ContentPartListsAvailable.Select(list => new Choice(list.DisplayText, list.Key))];

    private Choice[] ColumnChoices => [.. SourceColumns.Select(column => new Choice($"{column.Label} ({column.Path})", column.Path))];

    private Choice[] SiblingFieldChoices => [.. SiblingFields
        .Where(name => !string.Equals(name, FieldName, StringComparison.OrdinalIgnoreCase))
        .Select(name => new Choice(name, name))];

    private Choice[] OperatorChoices =>
    [
        new(T["Equals"], "Equals"),
        new(T["Not equals"], "NotEquals"),
        new(T["In (comma-separated)"], "In"),
        new(T["Contains"], "Contains"),
        new(T["Greater than"], "GreaterThan"),
        new(T["Less than"], "LessThan"),
    ];

    private Choice[] ParentChangeChoices =>
    [
        new(T["Warn, then clear the selection"], "WarnThenClear"),
        new(T["Clear the selection silently"], "SilentClear"),
    ];

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            Providers = await Http.GetFromJsonAsync<string[]>("api/crest/option-sources") ?? [];

            // The Content Part Lists feature is opt-in; a 404 here just means the provider
            // is not among the sources either, so the dropdown stays consistent.
            if (Providers.Contains("contentpartlist", StringComparer.OrdinalIgnoreCase))
            {
                try
                {
                    ContentPartListsAvailable = await Http.GetFromJsonAsync<ContentPartListModel[]>("api/crest/content-part-lists") ?? [];
                }
                catch
                {
                    ContentPartListsAvailable = [];
                }
            }

            Attachment = await Http.GetFromJsonAsync<OptionPickerAttachmentModel>(
                $"api/crest/option-picker/attachment?part={Uri.EscapeDataString(PartName)}&field={Uri.EscapeDataString(FieldName)}");
            Settings = Attachment?.Settings ?? new OptionPickerSettingsModel();

            var (provider, qualifier) = Split(Settings.SourceKey);
            ProviderKey = provider.Length > 0 ? provider : "contentpartlist";
            Qualifier = qualifier;

            await LoadSourceColumnsAsync();

            // Existing dependent filters: load their parents' columns so the
            // ValueFromColumn dropdown renders with the stored value visible.
            foreach (var filter in Settings.Filters)
            {
                await EnsureParentColumnsAsync(filter.ValueFrom);
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static (string Provider, string Qualifier) Split(string? sourceKey)
    {
        var value = sourceKey?.Trim() ?? string.Empty;
        var separator = value.IndexOf(':');
        return separator < 0 ? (value, string.Empty) : (value[..separator], value[(separator + 1)..]);
    }

    private async Task OnSourceChangedAsync()
    {
        Settings.SourceKey = SourceKey;
        await LoadSourceColumnsAsync();
    }

    private async Task LoadSourceColumnsAsync()
    {
        SourceColumns = [];
        if (string.IsNullOrWhiteSpace(SourceKey))
        {
            return;
        }

        try
        {
            SourceColumns = await Http.GetFromJsonAsync<OptionSourceColumnModel[]>(
                $"api/crest/option-sources/{Uri.EscapeDataString(SourceKey)}/columns") ?? [];
        }
        catch
        {
            // An unresolvable source (e.g. a half-typed content type) just offers no
            // column suggestions; paths can still be typed by hand.
        }
    }

    // Parent-field source columns, fetched once per parent and cached for the
    // editor's lifetime; empty = scalar parent (or unknown), no column choice.
    private readonly Dictionary<string, OptionSourceColumnModel[]> ParentColumns = new(StringComparer.OrdinalIgnoreCase);

    private Choice[] ParentColumnChoicesFor(string? parentField) =>
        !string.IsNullOrWhiteSpace(parentField) && ParentColumns.TryGetValue(parentField, out var columns) && columns.Length > 0
            ? [new Choice(T["Key (option key, default)"], "Key"), .. columns.Select(column => new Choice($"{column.Label} ({column.Path})", column.Path))]
            : [];

    private async Task OnParentChangedAsync(OptionPickerFilterModel row)
    {
        // A different parent projects different columns; the old choice is meaningless.
        row.ValueFromColumn = null;
        await EnsureParentColumnsAsync(row.ValueFrom);
    }

    private async Task EnsureParentColumnsAsync(string? parentField)
    {
        if (string.IsNullOrWhiteSpace(parentField) || ParentColumns.ContainsKey(parentField))
        {
            return;
        }

        ParentColumns[parentField] = [];
        try
        {
            var parent = await Http.GetFromJsonAsync<OptionPickerAttachmentModel>(
                $"api/crest/option-picker/attachment?part={Uri.EscapeDataString(PartName)}&field={Uri.EscapeDataString(parentField)}");

            // Only a picker parent projects columns; a scalar parent's raw value
            // passes straight through and there is nothing to choose.
            if (parent is { IsOptionPicker: true } && !string.IsNullOrWhiteSpace(parent.Settings?.SourceKey))
            {
                ParentColumns[parentField] = await Http.GetFromJsonAsync<OptionSourceColumnModel[]>(
                    $"api/crest/option-sources/{Uri.EscapeDataString(parent.Settings.SourceKey)}/columns") ?? [];
            }
        }
        catch
        {
            // No suggestions; the default Key comparison still applies.
        }
    }

    private void AddColumn()
    {
        var descriptor = SourceColumns.FirstOrDefault(column => column.Path == NewColumnPath);
        Settings.Columns.Add(new OptionPickerColumnModel
        {
            Path = NewColumnPath,
            Label = descriptor?.Label ?? NewColumnPath,
        });
        NewColumnPath = string.Empty;
    }

    private void MoveColumn(OptionPickerColumnModel column, int delta)
    {
        var index = Settings.Columns.IndexOf(column);
        var target = index + delta;
        if (index < 0 || target < 0 || target >= Settings.Columns.Count)
        {
            return;
        }

        Settings.Columns.RemoveAt(index);
        Settings.Columns.Insert(target, column);
    }

    // Shared editor for the two ordered path lists (sort, search): chips with
    // remove, a dropdown of the source's columns to append from.
    private RenderFragment PathListEditor(string label, List<string> paths, string testId) => @<CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap" data-testid="@testId">
        <CrestFormField Text="@label">
            <CrestStack Orientation="Orientation.Horizontal" Gap="0.35rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                @foreach (var path in paths.ToArray())
                {
                    var entry = path;
                    <CrestBadge Text="@entry" BadgeStyle="BadgeStyle.Secondary" />
                    <CrestButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => paths.Remove(entry))" Disabled="@IsBusy" />
                }
                <CrestDropDown TValue="string" Data="@ColumnChoices" TextProperty="Label" ValueProperty="Value"
                               Change="@(value => { if (value is string path && path.Length > 0 && !paths.Contains(path, StringComparer.OrdinalIgnoreCase)) { paths.Add(path); } })"
                               Placeholder="@T["Add..."]" Disabled="@IsBusy" Style="min-width: 9rem;" />
            </CrestStack>
        </CrestFormField>
    </CrestStack>;

    private async Task SaveAsync()
    {
        IsSaving = true;
        ErrorMessage = null;

        try
        {
            Settings.SourceKey = SourceKey;
            using var response = await Http.PutAsJsonAsync("api/crest/option-picker/attachment", new
            {
                Part = PartName,
                Field = FieldName,
                DisplayName = (string?)null,
                Settings,
            });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T["Option picker"], T["Field settings saved."]);
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}
