@namespace Crest.Admin.Components.Shared
@using Radzen.Blazor

<div class="settings-switch">
    <RadzenCheckBox TValue="bool" Value="@Value" Change="@OnChanged" />
    <div class="settings-switch__content">
        <label class="settings-switch__label" @onclick="ToggleAsync">@Label</label>
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <div class="settings-switch__hint">@Hint</div>
        }
    </div>
</div>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Hint { get; set; }

    private Task OnChanged(bool value) => ValueChanged.InvokeAsync(value);
    private Task ToggleAsync() => ValueChanged.InvokeAsync(!Value);
}

<style>
    .settings-switch {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.45rem 0;
    }

    .settings-switch__content {
        display: grid;
        gap: 0.2rem;
    }

    .settings-switch__label {
        font-weight: 600;
        cursor: pointer;
    }

    .settings-switch__hint {
        color: var(--rz-text-secondary-color);
        font-size: 0.875rem;
    }
</style>
