@using Microsoft.AspNetCore.Components.Routing
@using Crest.Admin.Components.Admin
@using Crest.Components.Primitives
@using Crest.Components.Primitives

<RadzenNotification />

<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@CrestModuleAssemblyRegistry.Assemblies">
    <Found Context="routeData">
        @if (IsShelllessRoute(routeData))
        {
            <RouteView RouteData="@routeData" />
        }
        else
        {
            <CrestAuthorizedRoute>
                <CrestAppContainer>
                    <RouteView RouteData="@routeData" />
                </CrestAppContainer>
            </CrestAuthorizedRoute>
        }
    </Found>
    <NotFound>
        <LegacyAdminFrame />
    </NotFound>
</Router>

@code {
    private static bool IsShelllessRoute(RouteData routeData)
        => string.Equals(routeData.PageType.Name, "Login", StringComparison.Ordinal)
            || string.Equals(routeData.PageType.Name, "Home", StringComparison.Ordinal);
}
