<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>OrchardCore.Crest.Admin.Manifest</AssemblyName>
    <RootNamespace>Crest.Admin.Manifest</RootNamespace>
    <OrchardCoreCompatibilityVersion>3.0.0</OrchardCoreCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(OrchardCoreCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(OrchardCoreCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(OrchardCoreCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wasm\**" />
    <Content Remove="wasm\**" />
    <EmbeddedResource Remove="wasm\**" />
    <None Remove="wasm\**" />
    <RazorGenerate Remove="wasm\**" />
    <RazorComponent Remove="wasm\**" />
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme.Targets, not Module.Targets: sets ModuleType=Theme so IsTheme() is true at
         runtime and ThemeViewLocationExpanderProvider contributes this theme's Views/
         paths. See the same note in OrchardCore.Crest.LegacyFrame.csproj. -->
    <PackageReference Include="OrchardCore.Theme.Targets" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
  </ItemGroup>

  <!-- Phase 8: the old BuildCrestAdminWasm Exec target (side-building the standalone
       WASM app for BlazorAdminThemeMiddleware's hand-served webroot) is gone - the
       admin client (wasm/OrchardCore.Crest.Admin.Client.csproj, now a Razor class
       library) builds as an ordinary member of the dependency graph via
       OrchardCore.Crest.Client -> Crest.Server -> the host app. -->
</Project>
